# iOS 26 (iPhone 11 root) on the S9, on top of tools/starlte-disabled.list:
# measured with STARLTE TOP on boot ios26-f (4 A55 cores, 300-400 % busy).
com.apple.analyticsd            # 90-99 % of a core, no network to send to
com.apple.audioanalyticsd
com.apple.ecosystemanalyticsd
com.apple.geoanalyticsd
com.apple.inputanalyticsd
com.apple.wifianalyticsd
com.apple.findmy.findmylocated  # 63-81 %
com.apple.nearbyd               # SIGSEGV loop (UWB hardware)
com.apple.familycircled         # SIGABRT loop (no account)
com.apple.ReportCrash           # 55-117 % writing reports for crash loops (kernel CRASH lines cover it)
com.apple.appplaceholdersyncd   # crash loop (26 in 200 s)
com.apple.dasd                  # SIGABRT loop (14 in 420 s, NSURL fileURLWithPath nil)
com.apple.audiomxd              # SIGTRAP loop in caulk audio_allocator (10 in 420 s)
com.apple.wifip2pd              # exit loop, restarted every 10 s (no Wi-Fi yet): 39 in 420 s

From 15d565910526c351fb585475036dc8dc5d3a8297 Mon Sep 17 00:00:00 2001
From: Claudius <claudiusthebot@gmail.com>
Date: Sun, 8 Nov 2026 21:33:19 +0000
Subject: [PATCH] starlte: shared region of 8 GiB (SHARED_REGION_SIZE_ARM64
 0x200000000)

The iOS 27 dyld shared cache plus its maximum slide need more than the 6 GiB this tree had.
---
 osfmk/mach/shared_region.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/osfmk/mach/shared_region.h b/osfmk/mach/shared_region.h
index f7c55b3b3..f1bc2dc2f 100644
--- a/osfmk/mach/shared_region.h
+++ b/osfmk/mach/shared_region.h
@@ -88,7 +88,7 @@
 /* ARM64_TODO: move to higher memory */
 #endif
 #define SHARED_REGION_BASE_ARM64                0x180000000ULL
-#define SHARED_REGION_SIZE_ARM64                0x180000000ULL
+#define SHARED_REGION_SIZE_ARM64                0x200000000ULL /* iOS 27 on STARLTE: its cache + max slide need > 6 GiB */
 #define SHARED_REGION_NESTING_BASE_ARM64        SHARED_REGION_BASE_ARM64
 #define SHARED_REGION_NESTING_SIZE_ARM64        SHARED_REGION_SIZE_ARM64
 #define SHARED_REGION_NESTING_MIN_ARM64         ?

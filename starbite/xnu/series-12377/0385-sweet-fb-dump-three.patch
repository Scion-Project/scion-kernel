From d8145659218196bf2360cfddf49f577f8d2d153a Mon Sep 17 00:00:00 2001
From: Starbite author <starbite@local>
Date: Wed, 4 Nov 2026 18:15:56 +0200
Subject: [PATCH] patch: 0385-sweet-fb-dump-three.patch - sweetfbdump: up to 3
 dumps (N, N+60, N+120 s)

---
 iokit/Kernel/arm/SweetFramebuffer.cpp | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 85f2021f..222c7bf1 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -855,9 +855,11 @@ AppleCLCD::present(const uint8_t *rec)
 			}
 			uint64_t up = 0;
 			absolutetime_to_nanoseconds(mach_absolute_time(), &up);
-			if (at > 0 && !done && src && bpe == 4 && s->width >= 256 && s->height >= 256 &&
-			    up / 1000000000ULL >= (uint64_t)at) {
-				done = 1;
+			/* up to 3 dumps: the first full-screen present after N, N + 60 and N + 120 s (a still
+			 * screen presents nothing, so one late dump often never came) */
+			if (at > 0 && done < 3 && src && bpe == 4 && s->width >= 256 && s->height >= 256 &&
+			    up / 1000000000ULL >= (uint64_t)at + 60ULL * (uint64_t)done) {
+				done++;
 				uint32_t W = s->width / 6, H = s->height / 6;
 				static const char hx[] = "0123456789abcdef";
 				char line[69 * 3 + 1];
@@ -874,7 +876,7 @@ AppleCLCD::present(const uint8_t *rec)
 						IOLog("SWEET FBDUMP %u %u %u %u %s\n", W, H, y, x0, line);
 					}
 				}
-				IOLog("SWEET FBDUMP end\n");
+				IOLog("SWEET FBDUMP end %d at %llu s\n", done, up / 1000000000ULL);
 			}
 		}
 #endif

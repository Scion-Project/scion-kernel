From 7f889488340dc8cb2465694a325c70eebd25d65a Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 4 Nov 2026 05:34:25 +0200
Subject: [PATCH] patch: 0370-starlte-sdlog.patch - sdlog=1: the kernel msgbuf
 ring to the card test range at the sweetreboot reset

---
 bsd/dev/herolte_ufs.c |  8 ++++++++
 bsd/dev/starlte_sd.c  | 48 +++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 56 insertions(+)

diff --git a/bsd/dev/herolte_ufs.c b/bsd/dev/herolte_ufs.c
index 0d5c9549..7fdb01cf 100644
--- a/bsd/dev/herolte_ufs.c
+++ b/bsd/dev/herolte_ufs.c
@@ -18,6 +18,7 @@
 #if defined(ARM64_BOARD_CONFIG_HEROLTE)
 #include <sys/param.h>
 #include <sys/systm.h>
+#include <sys/msgbuf.h>
 #include <sys/buf.h>
 #include <sys/conf.h>
 #include <sys/disk.h>
@@ -1059,6 +1060,13 @@ starlte_reboot_timer_thread(__unused void *arg, __unused wait_result_t wr)
 		return;                 /* herolte_log_thread flushes and resets itself */
 	}
 	printf("HEROLTE LOG: sweetreboot=%u reached with no UFS log: console tail to pmsg, reset to recovery\n", secs);
+	{
+		/* sdlog=1: the whole kernel log ring to the card's test range too (starlte_sd.c) */
+		extern struct msgbuf *msgbufp;
+		extern int starlte_sd_dump_log(const void *, uint32_t, uint32_t);
+		int lr = starlte_sd_dump_log(msgbufp->msg_bufc, (uint32_t)msgbufp->msg_size, (uint32_t)msgbufp->msg_bufx);
+		printf("HEROLTE LOG: kernel log to card: %d\n", lr);
+	}
 	starlte_dump_file();
 	starlte_panic_to_recovery();    /* no panic log: header + console tail */
 }
diff --git a/bsd/dev/starlte_sd.c b/bsd/dev/starlte_sd.c
index d5108d8f..2b5fb094 100644
--- a/bsd/dev/starlte_sd.c
+++ b/bsd/dev/starlte_sd.c
@@ -804,6 +804,54 @@ sd_write_sectors(uint64_t sector, uint32_t count, const void *src)
 	return 0;
 }
 
+/*
+ * The kernel log to the card (sdlog=1): the msgbuf ring, written at the sweetreboot reset into the
+ * card's last 64 MiB (the test range, p2's tail, 249868288 + 131072 on the 128 GB card), so TWRP
+ * reads megabytes of log instead of pmsg's 16 KiB tail. Block 0: "SBLOG001", ring size, write
+ * index, length; then the ring. Only on the 128 GB card (249999360 sectors), only that range.
+ */
+int starlte_sd_dump_log(const void *ring, uint32_t size, uint32_t bufx);
+int
+starlte_sd_dump_log(const void *ring, uint32_t size, uint32_t bufx)
+{
+	uint32_t on = 0;
+	PE_parse_boot_argn("sdlog", &on, sizeof(on));
+	if (!on || sd.state != 1 || sd.card_sectors != 249999360ULL || ((uintptr_t)ring & 7) ||
+	    size == 0 || size > (64u << 20) - SECTOR) {
+		return -1;
+	}
+	if (!lck_mtx_try_lock(&starlte_sd_lock)) {
+		return -2;
+	}
+	const uint64_t first = 249868288ULL, count = 131072ULL;
+	uint64_t hdr[SECTOR / 8] = { 0 };
+	memcpy(hdr, "SBLOG001", 8);
+	hdr[1] = size;
+	hdr[2] = bufx;
+	hdr[3] = mach_absolute_time();
+	int r = write_chunk(first, 1, hdr);
+	uint32_t sectors = (size + SECTOR - 1) / SECTOR;
+	const uint8_t *p = ring;
+	for (uint32_t done = 0; !r && done < sectors;) {
+		uint32_t n = MIN(sectors - done, CHUNK);
+		if (1 + done + n > count) {
+			r = -9;
+			break;
+		}
+		/* the ring's last chunk may be short: whole sectors only, the tail is ignored by the reader */
+		if ((uint64_t)(done + n) * SECTOR > size) {
+			n = (size - done * SECTOR) / SECTOR;
+			if (n == 0) {
+				break;
+			}
+		}
+		r = write_chunk(first + 1 + done, n, (const uint64_t *)(const void *)(p + (size_t)done * SECTOR));
+		done += n;
+	}
+	lck_mtx_unlock(&starlte_sd_lock);
+	return r;
+}
+
 /*
  * SD high speed (default, sdhs=0 turns it off): CMD6 switch to function group 1 = 1 (Linux core/sd_ops.c
  * mmc_sd_switch: arg 0x80fffff1, a 64-byte status block; core/sd.c: the result nibble

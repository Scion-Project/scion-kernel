From e9b205b6d343e427dd8c0c99ec9b41dfdbe8e817 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:31:59 +0200
Subject: [PATCH] patch: 0082-a5xelte-4k-entry.patch

---
 osfmk/arm64/arm_vm_init.c |  6 +++---
 osfmk/arm64/start.s       | 12 ++++++++++--
 osfmk/arm64/sweet_early.c |  8 +++++++-
 3 files changed, 20 insertions(+), 6 deletions(-)

diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 9e8f61d8..ce16f45c 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1820,7 +1820,7 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
 #define ARM64_PHYSMAP_ALIGNMENT_PADDING (PTOV_TABLE_SIZE * ARM_TT_TWIG_SIZE)
 #endif
 
-#if defined(SWEET)
+#if defined(SWEET) && !defined(A5XELTE)
 /*
  * The reserved low-globals/kernel region is excluded from VM allocation.
  * Use the otherwise empty 32MB block above low globals and below gVirtBase
@@ -2200,7 +2200,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	kasan_init();
 #endif /* KASAN */
 
-#if defined(SWEET)
+#if defined(SWEET) && !defined(A5XELTE)
 	/* phystokv() must still refer to the bootstrap aperture here. */
 	sweet_early_map_final();
 #endif
@@ -2209,7 +2209,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 	ml_enable_monitor();
 
-#if defined(SWEET)
+#if defined(SWEET) && !defined(A5XELTE)
 	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */
 	sweet_early_relocate(SWEET_EARLY_FB_VA);
 #endif
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 2a8e5a00..8a31df76 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -524,7 +524,15 @@ LEXT(start_first_cpu)
 	mov		x20, x0
 	mov		x21, #0
 
-#if defined(SWEET)
+#if defined(A5XELTE)
+	/* Earliest XNU-owned physical marker in preserved Samsung log RAM. */
+	MOV64	x10, 0x469ff100
+	MOV64	x11, 0x3145544c45554e58
+	str		x11, [x10]
+	dsb		sy
+#endif
+
+#if defined(SWEET) && !defined(A5XELTE)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
 	MOV64	x0, (0x9c000000 + 2368 * 4320)
 	mov		w1, #-1
@@ -689,7 +697,7 @@ Lkernelcache_base_found:
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
-#if defined(SWEET)
+#if defined(SWEET) && !defined(A5XELTE)
 	/*
 	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
 	 * L2 table. Both framebuffer and RAM use L1 index 0; another call to
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 69289572..17955fba 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -7,7 +7,13 @@
  */
 #include <arm64/sweet_early.h>
 
-#if defined(SWEET)
+#if defined(SWEET) && defined(A5XELTE)
+void sweet_early_putc(char c) { (void)c; }
+void sweet_early_mark(unsigned int stage, const char *label) { (void)stage; (void)label; }
+void sweet_early_panic(const char *fmt, va_list *args) { (void)fmt; (void)args; }
+void sweet_early_relocate(uint64_t base) { (void)base; }
+void sweet_early_disable(void) {}
+#elif defined(SWEET)
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
-- 
2.53.0


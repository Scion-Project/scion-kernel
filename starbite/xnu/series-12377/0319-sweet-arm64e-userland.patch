From b4902c22f96e24dda2769767bb927cff30a2f14b Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Sun, 1 Nov 2026 16:37:38 +0200
Subject: [PATCH] patch: 0319-sweet-arm64e-userland.patch

arm64e (iOS 26) userland on cores without ARMv8.3: ml_grade_binary takes
arm64e slices (below arm64), and user-mode undefined instructions go through
sweet_a64e_emulate() first: PAC/AUT/XPAC as no-ops, RETA*/BRA*/BLRA* as
RET/BR/BLR, LDRAA/LDRAB as LDR, PACGA as a fixed hash, FJCVTZS (JS ToInt32)
in integer code, FCADD with a scalar FP helper under the user's FPCR.
---
 bsd/dev/arm/kern_machdep.c  |  11 +-
 osfmk/arm64/sleh.c          |  10 ++
 osfmk/arm64/sweet_a64e.c    | 243 ++++++++++++++++++++++++++++++++++++
 osfmk/arm64/sweet_a64e_fp.s |  52 ++++++++
 osfmk/conf/files.arm64      |   2 +
 5 files changed, 317 insertions(+), 1 deletion(-)
 create mode 100644 osfmk/arm64/sweet_a64e.c
 create mode 100644 osfmk/arm64/sweet_a64e_fp.s

diff --git a/bsd/dev/arm/kern_machdep.c b/bsd/dev/arm/kern_machdep.c
index 58769e07..14535df7 100644
--- a/bsd/dev/arm/kern_machdep.c
+++ b/bsd/dev/arm/kern_machdep.c
@@ -72,7 +72,7 @@ grade_arm64e_binary(cpu_subtype_t execfeatures)
 *		not acceptable.
 **********************************************************************/
 int
-ml_grade_binary(cpu_type_t exectype, cpu_subtype_t execsubtype, cpu_subtype_t execfeatures __unused, bool allow_simulator_binary __unused)
+ml_grade_binary(cpu_type_t exectype, cpu_subtype_t execsubtype, cpu_subtype_t execfeatures, bool allow_simulator_binary __unused)
 {
 #if __arm64__
 	cpu_subtype_t hostsubtype =
@@ -91,6 +91,15 @@ ml_grade_binary(cpu_type_t exectype, cpu_subtype_t execsubtype, cpu_subtype_t ex
 				return 10;
 			case CPU_SUBTYPE_ARM64_ALL:
 				return 9;
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
+			case CPU_SUBTYPE_ARM64E:
+				/*
+				 * sweet: no PAC here, but arm64e-only userland (iOS 26)
+				 * runs with sweet_a64e.c emulating the ARMv8.3 ops; an
+				 * arm64 slice is still preferred when there is one.
+				 */
+				return (execfeatures & CPU_SUBTYPE_PTRAUTH_ABI) ? 8 : 0;
+#endif
 			}
 			break;
 
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index b33fae1c..8ddea96b 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1255,6 +1255,16 @@ handle_uncategorized(arm_saved_state_t *state)
 		}
 	}
 
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
+	/* arm64e (ARMv8.3+) instructions these cores lack: sweet_a64e.c. */
+	if (PSR64_IS_USER64(get_saved_state_cpsr(state))) {
+		extern bool sweet_a64e_emulate(arm_saved_state_t *, uint32_t);
+		if (sweet_a64e_emulate(state, instr)) {
+			return;
+		}
+	}
+#endif
+
 	/*
 	 * Check for GDB breakpoint via illegal opcode.
 	 */
diff --git a/osfmk/arm64/sweet_a64e.c b/osfmk/arm64/sweet_a64e.c
new file mode 100644
index 00000000..ba104af3
--- /dev/null
+++ b/osfmk/arm64/sweet_a64e.c
@@ -0,0 +1,243 @@
+/*
+ * sweet: user-mode emulation of the arm64e (ARMv8.3+) instructions the S9's
+ * cores lack (A55 is ARMv8.2, Mongoose M3 ARMv8.0), so iOS 26 userland, which
+ * is arm64e only, can run. Pointers are never signed on this kernel, so the
+ * pointer-authentication instructions reduce to their unauthenticated forms.
+ * This is the safety net behind the host-side translator (which rewrites
+ * these instructions in place) and covers code generated at run time (JIT).
+ *
+ *   PAC*, AUT*, XPAC* (register forms)    -> no change to the register
+ *   RETAA/RETAB, BRA*, BLRA*              -> RET / BR / BLR
+ *   LDRAA/LDRAB                           -> LDR (offset and pre-index forms)
+ *   PACGA                                 -> deterministic 32-bit hash << 32
+ *   FJCVTZS                               -> JavaScript ToInt32, Z = exact
+ *   FCADD (vector, H/S/D)                 -> lane-wise FADD/FSUB, user FPCR
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
+#include <mach/mach_types.h>
+#include <mach/arm/thread_status.h>
+#include <arm64/proc_reg.h>
+#include <kern/thread.h>
+#include <kern/misc_protos.h>
+#include <libkern/OSAtomic.h>
+#include <arm/thread.h>
+
+bool sweet_a64e_emulate(arm_saved_state_t *state, uint32_t instr);
+/* sweet_a64e_fp.s: one FP add/sub of `size` (1 = H, 2 = S, 3 = D) under fpcr. */
+extern uint64_t sweet_a64e_fp_addsub(uint64_t a, uint64_t b, uint32_t op_size, uint32_t fpcr,
+    uint32_t *fpsr);
+
+static uint64_t sweet_a64e_counts[8];
+
+/* r = 31 reads as XZR (sp31 false) or SP (sp31 true). */
+static uint64_t
+reg_get(arm_saved_state_t *ss, unsigned r, bool sp31)
+{
+	arm_saved_state64_t *s = saved_state64(ss);
+	if (r < 29) {
+		return s->x[r];
+	}
+	switch (r) {
+	case 29: return s->fp;
+	case 30: return s->lr;
+	default: return sp31 ? s->sp : 0;
+	}
+}
+
+static void
+reg_set(arm_saved_state_t *ss, unsigned r, bool sp31, uint64_t v)
+{
+	arm_saved_state64_t *s = saved_state64(ss);
+	if (r < 29) {
+		s->x[r] = v;
+	} else if (r == 29) {
+		s->fp = v;
+	} else if (r == 30) {
+		s->lr = v;
+	} else if (sp31) {
+		s->sp = v;
+	}
+}
+
+static uint64_t
+pacga_hash(uint64_t a, uint64_t b)
+{
+	uint64_t h = a * 0x9e3779b97f4a7c15ULL ^ (b + 0x632be59bd9b4e019ULL);
+	h ^= h >> 31;
+	h *= 0xbf58476d1ce4e5b9ULL;
+	h ^= h >> 29;
+	return h & 0xffffffff00000000ULL;
+}
+
+/* JavaScript ToInt32 of an IEEE double, integer arithmetic only. */
+static uint32_t
+fjcvtzs(uint64_t bits, bool *exact)
+{
+	int exp = (int)((bits >> 52) & 0x7ff);
+	uint64_t mant = bits & ((1ULL << 52) - 1);
+	bool neg = (bits >> 63) != 0;
+	uint32_t r;
+
+	*exact = false;
+	if (exp == 0x7ff) {
+		return 0;                       /* NaN, Inf */
+	}
+	if (exp == 0) {
+		*exact = (mant == 0 && !neg);   /* +0 exact; -0 and denormals not */
+		return 0;
+	}
+	int e = exp - 1075;                     /* value = (mant|1<<52) * 2^e */
+	mant |= 1ULL << 52;
+	bool frac = false;
+	if (e <= -53) {
+		frac = true;
+		r = 0;
+	} else if (e < 0) {
+		frac = (mant & ((1ULL << -e) - 1)) != 0;
+		r = (uint32_t)(mant >> -e);
+	} else if (e < 32) {
+		r = (uint32_t)(mant << e);
+	} else {
+		r = 0;                          /* multiple of 2^32 */
+	}
+	/* magnitude fits int32 exactly? (before the modulo) */
+	bool in_range;
+	if (e >= 32) {
+		in_range = false;
+	} else if (e >= 0) {
+		in_range = e <= 11 && (mant << e) <= (neg ? 0x80000000ULL : 0x7fffffffULL);
+	} else {
+		uint64_t m = mant >> -e;
+		in_range = m <= (neg ? 0x80000000ULL : 0x7fffffffULL);
+	}
+	if (neg) {
+		r = (uint32_t)(0u - r);
+	}
+	*exact = in_range && !frac;
+	return r;
+}
+
+static bool
+emulate_fcadd(arm_saved_state_t *ss, uint32_t w)
+{
+	thread_t th = current_thread();
+	if (th->machine.uNeon == NULL) {
+		return false;
+	}
+	arm_neon_saved_state64_t *ns = &th->machine.uNeon->ns_64;
+	unsigned size = (w >> 22) & 3, q = (w >> 30) & 1, rot270 = (w >> 12) & 1;
+	unsigned rd = w & 31, rn = (w >> 5) & 31, rm = (w >> 16) & 31;
+	if (size == 0 || (size == 3 && !q)) {
+		return false;
+	}
+	unsigned esize = 8u << size;            /* 16, 32, 64 bits */
+	unsigned lanes = (q ? 128 : 64) / esize;
+	uint64_t mask = esize == 64 ? ~0ULL : ((1ULL << esize) - 1);
+	uint8_t n[16], m[16], d[16];
+	memcpy(n, &ns->v.q[rn], 16);
+	memcpy(m, &ns->v.q[rm], 16);
+	memset(d, 0, 16);
+	uint32_t fpsr = 0;
+	for (unsigned i = 0; i < lanes; i += 2) {
+		uint64_t nre = 0, nim = 0, mre = 0, mim = 0;
+		memcpy(&nre, n + i * esize / 8, esize / 8);
+		memcpy(&nim, n + (i + 1) * esize / 8, esize / 8);
+		memcpy(&mre, m + i * esize / 8, esize / 8);
+		memcpy(&mim, m + (i + 1) * esize / 8, esize / 8);
+		/* rot 90: re = n.re - m.im, im = n.im + m.re; rot 270: re = n.re + m.im, im = n.im - m.re */
+		uint64_t re = sweet_a64e_fp_addsub(nre, mim, (rot270 ? 0 : 1) << 4 | size, ns->fpcr, &fpsr);
+		uint64_t im = sweet_a64e_fp_addsub(nim, mre, (rot270 ? 1 : 0) << 4 | size, ns->fpcr, &fpsr);
+		re &= mask;
+		im &= mask;
+		memcpy(d + i * esize / 8, &re, esize / 8);
+		memcpy(d + (i + 1) * esize / 8, &im, esize / 8);
+	}
+	memcpy(&ns->v.q[rd], d, 16);            /* 64-bit form clears the top half */
+	ns->fpsr |= fpsr;
+	(void)ss;
+	return true;
+}
+
+bool
+sweet_a64e_emulate(arm_saved_state_t *ss, uint32_t w)
+{
+	uint64_t pc = get_saved_state_pc(ss);
+
+	if ((w & 0xFFFFFBFF) == 0xD65F0BFF) {                   /* RETAA, RETAB */
+		set_saved_state_pc(ss, reg_get(ss, 30, false));
+		sweet_a64e_counts[0]++;
+		return true;
+	}
+	if ((w & 0xFE9FF800) == 0xD61F0800) {                   /* BRA*, BLRA* (Z and register forms) */
+		unsigned op = (w >> 21) & 3;
+		uint64_t target = reg_get(ss, (w >> 5) & 31, false);
+		if (op == 1) {
+			reg_set(ss, 30, false, pc + 4);
+		} else if (op != 0) {
+			return false;
+		}
+		set_saved_state_pc(ss, target);
+		sweet_a64e_counts[1]++;
+		return true;
+	}
+	if ((w & 0xFF200400) == 0xF8200400) {                   /* LDRAA, LDRAB */
+		unsigned rt = w & 31, rn = (w >> 5) & 31;
+		int64_t imm = (int64_t)(((w >> 12) & 0x1ff) | ((w >> 22) & 1) << 9);
+		if (imm & 0x200) {
+			imm -= 0x400;
+		}
+		uint64_t addr = reg_get(ss, rn, true) + (uint64_t)(imm * 8);
+		uint64_t val;
+		if (copyin((user_addr_t)addr, &val, sizeof(val)) != 0) {
+			return false;                           /* let the fault become a crash */
+		}
+		if (w & (1u << 11)) {
+			reg_set(ss, rn, true, addr);
+		}
+		reg_set(ss, rt, false, val);
+		set_saved_state_pc(ss, pc + 4);
+		sweet_a64e_counts[2]++;
+		return true;
+	}
+	if ((w & 0xFFFF8000) == 0xDAC10000 && ((w >> 10) & 0x3f) <= 17) {
+		/* PACIA..AUTDB, PACIZA..AUTDZB, XPACI, XPACD: no signature to add or check */
+		set_saved_state_pc(ss, pc + 4);
+		sweet_a64e_counts[3]++;
+		return true;
+	}
+	if ((w & 0xFFE0FC00) == 0x9AC03000) {                   /* PACGA Xd, Xn, Xm|SP */
+		uint64_t v = pacga_hash(reg_get(ss, (w >> 5) & 31, false), reg_get(ss, (w >> 16) & 31, true));
+		reg_set(ss, w & 31, false, v);
+		set_saved_state_pc(ss, pc + 4);
+		sweet_a64e_counts[4]++;
+		return true;
+	}
+	if ((w & 0xFFFFFC00) == 0x1E7E0000) {                   /* FJCVTZS Wd, Dn */
+		thread_t th = current_thread();
+		if (th->machine.uNeon == NULL) {
+			return false;
+		}
+		uint64_t bits;
+		memcpy(&bits, &th->machine.uNeon->ns_64.v.q[(w >> 5) & 31], sizeof(bits));
+		bool exact;
+		uint32_t r = fjcvtzs(bits, &exact);
+		reg_set(ss, w & 31, false, r);
+		uint32_t cpsr = get_saved_state_cpsr(ss) & ~PSR64_NZCV_MASK;
+		set_saved_state_cpsr(ss, cpsr | (exact ? PSR64_Z : 0));
+		set_saved_state_pc(ss, pc + 4);
+		sweet_a64e_counts[5]++;
+		return true;
+	}
+	if ((w & 0xBF20EC00) == 0x2E00E400) {                   /* FCADD (vector) */
+		if (!emulate_fcadd(ss, w)) {
+			return false;
+		}
+		set_saved_state_pc(ss, pc + 4);
+		sweet_a64e_counts[6]++;
+		return true;
+	}
+	return false;
+}
+#endif /* SWEET || A5XELTE */
diff --git a/osfmk/arm64/sweet_a64e_fp.s b/osfmk/arm64/sweet_a64e_fp.s
new file mode 100644
index 00000000..577f8e4d
--- /dev/null
+++ b/osfmk/arm64/sweet_a64e_fp.s
@@ -0,0 +1,52 @@
+/*
+ * sweet: FP helper for sweet_a64e.c (FCADD emulation). The kernel C code is
+ * built without FP; this runs one scalar FADD or FSUB with the user's FPCR.
+ *   uint64_t sweet_a64e_fp_addsub(uint64_t a, uint64_t b, uint32_t op_size,
+ *       uint32_t fpcr, uint32_t *fpsr)
+ *   op_size: bits 3:0 size (1 = H, 2 = S, 3 = D), bit 4: 0 add, 1 sub.
+ *   *fpsr |= the exception flags raised. Uses v0/v1 only (caller-saved).
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
+#include <arm64/asm.h>
+	.arch	armv8.2-a+fp16
+	.text
+	.align	2
+	.globl	EXT(sweet_a64e_fp_addsub)
+LEXT(sweet_a64e_fp_addsub)
+	mrs	x9, FPCR
+	mrs	x10, FPSR
+	msr	FPCR, x3
+	msr	FPSR, xzr
+	fmov	d0, x0
+	fmov	d1, x1
+	and	w11, w2, #0xf
+	tbnz	w2, #4, Lsub
+	cmp	w11, #1
+	b.eq	Ladd_h
+	cmp	w11, #2
+	b.eq	Ladd_s
+	fadd	d0, d0, d1
+	b	Ldone
+Ladd_s:	fadd	s0, s0, s1
+	b	Ldone
+Ladd_h:	fadd	h0, h0, h1
+	b	Ldone
+Lsub:	cmp	w11, #1
+	b.eq	Lsub_h
+	cmp	w11, #2
+	b.eq	Lsub_s
+	fsub	d0, d0, d1
+	b	Ldone
+Lsub_s:	fsub	s0, s0, s1
+	b	Ldone
+Lsub_h:	fsub	h0, h0, h1
+Ldone:	fmov	x0, d0
+	mrs	x12, FPSR
+	ldr	w13, [x4]
+	orr	w13, w13, w12
+	str	w13, [x4]
+	msr	FPCR, x9
+	msr	FPSR, x10
+	ret
+#endif

From 36536f5d0d1204913ba2aff7a3c507883ae8fdb7 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:31:03 +0200
Subject: [PATCH] patch: 0067-sweet-console-mute.patch

port: mute check added after the ported 0047 hook
---
 iokit/Kernel/arm/SweetFramebuffer.cpp | 12 +++++++-----
 osfmk/console/serial_console.c        |  9 +++++++++
 2 files changed, 16 insertions(+), 5 deletions(-)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index df966ca9..e032cfb4 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -26,11 +26,13 @@
  *
  * The panel memory itself is published as an IOSurface and returned as the
  * default framebuffer surface. The kernel text console keeps drawing over
- * the GUI by default: pausing it (boot-arg sweetfb_noconsole=1, on the
- * first swap) switches the console to serial, which also hides panics.
+ * the GUI by default: boot-arg sweetfb_noconsole=1 stops drawing it from
+ * the first swap on (it still reaches the persistent log; panics draw).
  */
 #include "SweetSurface.h"
 
+extern "C" int sweet_console_muted;     /* osfmk/console/serial_console.c */
+
 #if defined(SWEET)
 #include <IOKit/IOService.h>
 #include <IOKit/IOUserClient.h>
@@ -290,9 +292,9 @@ AppleCLCD::present(const uint8_t *rec)
 		int quiet = 0;
 		fConsolePaused = true;
 		if (PE_parse_boot_argn("sweetfb_noconsole", &quiet, sizeof(quiet)) && quiet != 0) {
-			PE_Video video;
-			PE_current_console(&video);
-			PE_initialize_console(&video, kPEDisableScreen);
+			/* Not PE_initialize_console(kPEDisableScreen): its console switch
+			 * writes the read-only-late cons_ops_index and panics. */
+			sweet_console_muted = 1;
 		}
 	}
 
diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
index b3efad49..9a0bfc14 100644
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -277,6 +277,12 @@ _cnputc(char c, bool poll)
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 extern void sweet_log_append(const char *c, int size);  /* bsd/dev/sweet_ufs.c */
+/*
+ * Set by AppleCLCD (boot-arg sweetfb_noconsole=1) once the GUI presents:
+ * console text still goes to the persistent log, but is not drawn over
+ * the GUI. A panic draws again.
+ */
+int sweet_console_muted;
 #endif
 
 static inline void
@@ -284,6 +290,9 @@ _cnputs(char *c, int size, bool poll)
 {
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 	sweet_log_append(c, size);
+	if (sweet_console_muted && !panic_active()) {
+		return;
+	}
 #endif
 
 	if (disableConsoleOutput) {
-- 
2.53.0


From 9a3a2588833618b65f16bd0e15a487e19b17117a Mon Sep 17 00:00:00 2001
From: Claudius <claudiusthebot@gmail.com>
Date: Sun, 8 Nov 2026 21:33:19 +0000
Subject: [PATCH] starlte: kauth: ACL entries that name a group by its compat
 GUID are checked against the credential's groups

This kernel is built with CONFIG_EXT_RESOLVER (macOS config) but iOS runs no identity resolver, so ACL entries naming a group by
its compat GUID (ABCDEFAB-CDEF-ABCD-EFAB-CDEF<gid>, e.g. systemusers 299 on the SystemGroup containers) never matched: EACCES for
every uid-501 daemon. kauth_cred_ismember_guid() now translates that form directly, and kauth_acl_evaluate() asks it even when
the caller's own GUID could not be resolved. systemusers (299) is granted to everyone, as the sandbox stand-in is permissive.
---
 bsd/kern/kern_authorization.c |  4 +++-
 bsd/kern/kern_credential.c    | 32 +++++++++++++++++++++++++++++++-
 2 files changed, 34 insertions(+), 2 deletions(-)

diff --git a/bsd/kern/kern_authorization.c b/bsd/kern/kern_authorization.c
index 835a8ff8a..a27b2c357 100644
--- a/bsd/kern/kern_authorization.c
+++ b/bsd/kern/kern_authorization.c
@@ -721,7 +721,9 @@ kauth_acl_evaluate(kauth_cred_t cred, kauth_acl_eval_t eval)
 			    K_UUID_ARG(ace->ace_applicable), K_UUID_ARG(guid), applies ? "" : "not ");
 
 			if (!applies) {
-				error = !gotguid ? ENOENT : kauth_cred_ismember_guid(cred, &ace->ace_applicable, &applies);
+				/* iOS 27 on STARLTE: no identity resolver on iOS, so the caller's own GUID is unknown;
+				 * group membership (kern_credential.c translates compat group GUIDs) is still checked */
+				error = kauth_cred_ismember_guid(cred, &ace->ace_applicable, &applies);
 				/*
 				 * If we can't resolve group membership, we have to limit misbehaviour.
 				 * If the ACE is an 'allow' ACE, assume the cred is not a member (avoid
diff --git a/bsd/kern/kern_credential.c b/bsd/kern/kern_credential.c
index cd24987f0..cb114d8d5 100644
--- a/bsd/kern/kern_credential.c
+++ b/bsd/kern/kern_credential.c
@@ -3119,7 +3119,7 @@ kauth_cred_ismember_gid(kauth_cred_t cred, gid_t gid, int *resultp)
  *					0	Is not member
  */
 int
-kauth_cred_ismember_guid(__unused kauth_cred_t cred, guid_t *guidp, int *resultp)
+kauth_cred_ismember_guid(kauth_cred_t cred, guid_t *guidp, int *resultp)
 {
 	int error = 0;
 
@@ -3133,6 +3133,36 @@ kauth_cred_ismember_guid(__unused kauth_cred_t cred, guid_t *guidp, int *resultp
 	default:
 	{
 		gid_t gid;
+		/*
+		 * iOS 27 on STARLTE: this kernel is built with CONFIG_EXT_RESOLVER (macOS config)
+		 * but iOS runs no identity resolver, so ACL entries naming a group by its compat GUID
+		 * (ABCDEFAB-CDEF-ABCD-EFAB-CDEF<gid>, e.g. systemusers 299 on the SystemGroup containers)
+		 * never matched: EACCES for every uid-501 daemon. Translate that form directly.
+		 */
+		{
+			static const uint8_t grp_prefix[12] = {0xab, 0xcd, 0xef, 0xab, 0xcd, 0xef, 0xab, 0xcd, 0xef, 0xab, 0xcd, 0xef};
+			if (memcmp(guidp, grp_prefix, sizeof(grp_prefix)) == 0) {
+				uint32_t g;
+				memcpy(&g, (const uint8_t *)guidp + 12, sizeof(g));
+				gid = (gid_t)ntohl(g);
+				if (kauth_cred_ismember_gid(cred, gid, resultp) != 0) {
+					*resultp = 0;
+				}
+				if (*resultp == 0 && gid == 299) {
+					/* systemusers (299): /etc/group lists mobile and ~20 daemon users, but the
+					 * credentials here do not carry it (no initgroups through a resolver).
+					 * Permissive like the sandbox stand-in: everyone is in it. */
+					static int said;
+					if (!said) {
+						said = 1;
+						printf("SWEET KAUTH: uid %d not in systemusers by its groups (%d of them); granted\n",
+						    kauth_cred_getuid(cred), posix_cred_get(cred)->cr_ngroups);
+					}
+					*resultp = 1;
+				}
+				return 0;
+			}
+		}
 #if CONFIG_EXT_RESOLVER
 		struct kauth_identity ki;
 

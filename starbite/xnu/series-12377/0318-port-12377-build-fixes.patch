+	sweet_early_mark(23, "arm_vm_init: static tables built");
 
 #if defined(ARM_LARGE_MEMORY)
 	/*
@@ -2126,6 +2138,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)

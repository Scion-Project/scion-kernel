 osfmk/arm/pmap/pmap.c            | 19 +++++++--
 osfmk/arm64/amcc_rorgn_pv_ctrr.c |  9 ++++
 osfmk/arm64/arm_vm_init.c        | 21 ++++++++++
 osfmk/arm64/cpu.c                |  1 -
 osfmk/arm64/machine_routines.c   | 19 +++++++++
 osfmk/arm64/sleh.c               | 21 +++++++++-
 osfmk/arm64/sweet_early.c        | 16 ++++---
 osfmk/kern/exception.c           | 71 +++++++++++++++++---------------
 osfmk/kern/exclaves.c            |  4 +-
 osfmk/vm/vm_kern.c               |  4 +-
 osfmk/vm/vm_map_lock.c           | 24 +++++++++++
 osfmk/vm/vm_map_store.c          | 10 +++++

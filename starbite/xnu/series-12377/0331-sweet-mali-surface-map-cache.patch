From a4146f2dc0ad35a77a585b2311c346d062e264e4 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Sun, 1 Nov 2026 21:42:45 +0200
Subject: [PATCH] patch: 0331-sweet-mali-surface-map-cache.patch

sweet: a CPU mapping of an imported surface keeps the surface's cache mode. Write-combined, it set the physical pages' attribute to WCOMB, which changes every mapping of them: a wrapped image's 16 KiB page in the client's own heap became Normal-NC there too, and the atomics of neighbouring objects (objc_release...) took external aborts (GPU boot 8, PAR attr 0x44).
- StarbiteMali.cpp: imported surfaces mapped with their own cache mode
- SweetSurface.cpp: kernel mapping with the surface's cache mode
- copy-back instead of default cache for shared surface mappings (default deadlocked in vm_page_sleep)
---
 iokit/Kernel/arm/StarbiteMali.cpp | 13 +++++++++++--
 iokit/Kernel/arm/SweetSurface.cpp |  9 ++++++++-
 2 files changed, 19 insertions(+), 3 deletions(-)

diff --git a/iokit/Kernel/arm/StarbiteMali.cpp b/iokit/Kernel/arm/StarbiteMali.cpp
index 1b716679..438059bc 100644
--- a/iokit/Kernel/arm/StarbiteMali.cpp
+++ b/iokit/Kernel/arm/StarbiteMali.cpp
@@ -425,8 +425,17 @@ StarbiteMaliUserClient::mmapBO(sbm_mmap_bo *a)
 		return kIOReturnBadArgument;
 	}
 	if (bo->map == NULL) {
-		bo->map = bo->mem->createMappingInTask(fTask, 0,
-		    kIOMapAnywhere | kIOMapWriteCombineCache);
+		/*
+		 * The cache mode is the physical pages', for every mapping of them: an imported
+		 * surface may be a wrapped piece of the client's own heap, which must stay
+		 * cacheable (atomics on Normal-NC memory are external aborts here). Only buffers
+		 * of ours, which nothing else maps, are write-combined. Copy-back (= the default
+		 * attribute, VM_WIMG_COPYBACK == VM_WIMG_DEFAULT) and not kIOMapDefaultCache: that
+		 * shares the task's own VM object a second time, and backboardd faulting on its
+		 * wired pages through it slept in vm_page_sleep for good (GPU boot 9).
+		 */
+		IOOptionBits cache = bo->surface != 0 ? kIOMapCopybackCache : kIOMapWriteCombineCache;
+		bo->map = bo->mem->createMappingInTask(fTask, 0, kIOMapAnywhere | cache);
 		if (bo->map == NULL) {
 			return kIOReturnVMError;
 		}
diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index 5a7a435b..3f221f86 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -105,7 +105,14 @@ SweetSurface::kernelAddress()
 	}
 	IOLockLock(sweet_surface_lock);
 	if (kernelMap == NULL && memory != NULL) {
-		kernelMap = memory->map(kIOMapWriteCombineCache);
+		/*
+		 * The surface's own cache mode: the attribute is the physical pages', for every
+		 * mapping of them, and client memory or a wrapped image is part of a task's heap,
+		 * which must stay cacheable (atomics on Normal-NC take external aborts).
+		 * Copy-back rather than kIOMapDefaultCache (see StarbiteMali's mmapBO).
+		 */
+		IOOptionBits cache = mapCache & kIOMapCacheMask;
+		kernelMap = memory->map(cache != kIOMapDefaultCache ? cache : kIOMapCopybackCache);
 	}
 	IOLockUnlock(sweet_surface_lock);
 	return kernelMap != NULL ? (uintptr_t)kernelMap->getVirtualAddress() : 0;

From 270cfcfa30887a4df561f8b16522b6cad7effb71 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 23:30:08 +0200
Subject: [PATCH] patch: 0314-port-4k-pages-above-1g.patch

arm_init: SWEET/A5XELTE boards keep the 4 KiB hardware page size at any RAM
size. Stock XNU switches to 16 KiB VM pages over 4 KiB hardware pages above
1 GiB (TEST_PAGE_RATIO_4), which panics intermittently on the S7 and S9
("unaligned pmap_enter" at 1.5 GiB) and is not the mode the iOS 18 fixes
were made in. Lets iPadOS have more than 1 GiB.
---
 osfmk/arm/arm_init.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index c369561a..4da449ce 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -436,7 +436,19 @@ arm_init(
 		/*
 		 * Select the advertised kernel page size.
 		 */
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
+		/*
+		 * sweet: keep the 4 KiB hardware page size at any RAM size. Above
+		 * 1 GiB stock XNU switches to 16 KiB VM pages over 4 KiB hardware
+		 * pages (TEST_PAGE_RATIO_4, last used on A7/A8), which panics
+		 * intermittently here ("unaligned pmap_enter", S7 and S9 at
+		 * 1.5 GiB); every iOS 18 fix in this series was made and tested
+		 * with 4 KiB kernel pages under 16 KiB user maps.
+		 */
+		if (false) {
+#else
 		if (args->memSize > 1ULL * 1024 * 1024 * 1024) {
+#endif
 			/*
 			 * arm64 device with > 1GB of RAM:
 			 * kernel uses 16KB pages.
-- 

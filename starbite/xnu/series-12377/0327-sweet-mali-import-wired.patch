From 9ae9e9e8be1dbd19af324f56442788156c67c7af Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Sun, 1 Nov 2026 21:22:36 +0200
Subject: [PATCH] patch: 0327-sweet-mali-import-wired.patch

sweet: an IOSurface imported as a GPU buffer keeps its pages wired (prepare/complete on the buffer's own count) until the buffer is closed. SweetSurface::free() unwired a wrapped or client-memory surface while the GPU still had its pages mapped; they were reused (heap, page tables) and GPU writes into them broke backboardd's memory: synchronous external aborts in objc_release/os_object_retain on ordinary heap addresses (GPU boot 5).
- StarbiteMali.cpp: imported surfaces stay wired while mapped for the GPU
---
 iokit/Kernel/arm/StarbiteMali.cpp | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/iokit/Kernel/arm/StarbiteMali.cpp b/iokit/Kernel/arm/StarbiteMali.cpp
index 61ed6431..6da1989d 100644
--- a/iokit/Kernel/arm/StarbiteMali.cpp
+++ b/iokit/Kernel/arm/StarbiteMali.cpp
@@ -243,6 +243,10 @@ StarbiteMaliUserClient::closeBO(sbm_bo *bo)
 	starlte_gpu_user_unmap(bo->va, bo->pages);
 	sbm_va_free(bo->va, (uint64_t)bo->pages * 0x1000);
 	OSSafeReleaseNULL(bo->map);
+	/* an imported surface's pages were wired for the GPU (importSurface) */
+	if (bo->surface != 0 && bo->mem != NULL) {
+		bo->mem->complete();
+	}
 	OSSafeReleaseNULL(bo->mem);
 	bo->va = 0;
 	bo->pages = 0;
@@ -357,8 +361,18 @@ StarbiteMaliUserClient::importSurface(sbm_surface *a)
 		handle = ++fCount;
 	}
 	uint32_t pages = (uint32_t)(a->size / 0x1000);
+	/*
+	 * The GPU keeps the surface's pages mapped until the buffer is closed: they stay wired
+	 * that long (a wrapped or client-memory surface is unwired when the surface goes, and
+	 * its pages would be reused while the GPU still writes into them).
+	 */
+	if (s->memory->prepare() != kIOReturnSuccess) {
+		s->release();
+		return kIOReturnVMError;
+	}
 	uint64_t va = sbm_va_alloc(a->size);
 	if (va == 0) {
+		s->memory->complete();
 		s->release();
 		return kIOReturnNoSpace;
 	}
@@ -374,6 +388,7 @@ StarbiteMaliUserClient::importSurface(sbm_surface *a)
 		IOFreeData(pa, (vm_size_t)pages * sizeof(uint64_t));
 	}
 	if (!ok) {
+		s->memory->complete();
 		s->release();
 		sbm_va_free(va, a->size);
 		return kIOReturnVMError;

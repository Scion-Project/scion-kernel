From 9847227255bd0a7d989f5c059fe2e00c37e076bd Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:33:10 +0200
Subject: [PATCH] patch: 0097-a5xelte-zone-va-size.patch

port: same, whitespace of the #if differs upstream
---
 osfmk/kern/zalloc.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/osfmk/kern/zalloc.c b/osfmk/kern/zalloc.c
index 9edf8c5c..c8dbd15b 100644
--- a/osfmk/kern/zalloc.c
+++ b/osfmk/kern/zalloc.c
@@ -167,7 +167,12 @@ ZONE_DEFINE_TYPE(percpu_u64_zone, "percpu.64", uint64_t,
 #define ZONE_MAX_CHUNK_ALLOC_NUM        (10)
 #endif /* ZSECURITY_CONFIG(SAD_FENG_SHUI) */
 
-#if   XNU_PLATFORM_MacOSX
+/* The A5XELTE 4 KiB kernel uses the compact 48 GiB heap VA layout even
+ * though the development build selects MacOSX platform facilities. */
+#if defined(A5XELTE)
+#define ZONE_MAP_MAX            (8ULL << 30)
+#define ZONE_MAP_VA_SIZE        (24ULL << 30)
+#elif XNU_PLATFORM_MacOSX
 #define ZONE_MAP_MAX            (32ULL << 30)
 #define ZONE_MAP_VA_SIZE        (128ULL << 30)
 #else

From 20d3095616bd65e927c0180bf46e3a78a67b565e Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:33:26 +0200
Subject: [PATCH] patch: 0102-a5xelte-builtin-pthread.patch

---
 bsd/pthread/sweet_pthread_init.c    | 8 ++++++--
 bsd/pthread/sweet_pthread_support.c | 4 ++--
 bsd/pthread/sweet_pthread_synch.c   | 4 ++--
 bsd/sys/pthread_internal.h          | 2 +-
 4 files changed, 11 insertions(+), 7 deletions(-)

diff --git a/bsd/pthread/sweet_pthread_init.c b/bsd/pthread/sweet_pthread_init.c
index 5a82439b..cc0a095f 100644
--- a/bsd/pthread/sweet_pthread_init.c
+++ b/bsd/pthread/sweet_pthread_init.c
@@ -1,5 +1,5 @@
 /* Built-in provider: Apple libpthread-514.100.2, paired with xnu-8796.141.3. */
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 #include "sweet_pthread_compat.h"
 #include "sweet_libpthread/kern/kern_init.c"
 
@@ -20,7 +20,11 @@ sweet_pthread_register(void)
     if (kr != KERN_SUCCESS || sweet_pthread_kern == NULL) {
         panic("SWEET: pthread provider registration failed: %d", kr);
     }
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+    kprintf("A5XELTE pthread: libpthread-514.100.2 registered\n");
+#else
     kprintf("SWEET pthread: libpthread-514.100.2 registered\n");
+#endif
 }
 STARTUP(EARLY_BOOT, STARTUP_RANK_SECOND, sweet_pthread_register);
-#endif /* ARM64_BOARD_CONFIG_SWEET */
+#endif /* SWEET || A5XELTE */
diff --git a/bsd/pthread/sweet_pthread_support.c b/bsd/pthread/sweet_pthread_support.c
index beae7772..672fce26 100644
--- a/bsd/pthread/sweet_pthread_support.c
+++ b/bsd/pthread/sweet_pthread_support.c
@@ -1,5 +1,5 @@
 /* Built-in provider: Apple libpthread-514.100.2, paired with xnu-8796.141.3. */
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 #include "sweet_pthread_compat.h"
 #include "sweet_libpthread/kern/kern_support.c"
-#endif /* ARM64_BOARD_CONFIG_SWEET */
+#endif /* SWEET || A5XELTE */
diff --git a/bsd/pthread/sweet_pthread_synch.c b/bsd/pthread/sweet_pthread_synch.c
index 08baa1b3..9b35020a 100644
--- a/bsd/pthread/sweet_pthread_synch.c
+++ b/bsd/pthread/sweet_pthread_synch.c
@@ -1,5 +1,5 @@
 /* Built-in provider: Apple libpthread-514.100.2, paired with xnu-8796.141.3. */
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 #include "sweet_pthread_compat.h"
 #include "sweet_libpthread/kern/kern_synch.c"
-#endif /* ARM64_BOARD_CONFIG_SWEET */
+#endif /* SWEET || A5XELTE */
diff --git a/bsd/sys/pthread_internal.h b/bsd/sys/pthread_internal.h
index 135405e0..0042011e 100644
--- a/bsd/sys/pthread_internal.h
+++ b/bsd/sys/pthread_internal.h
@@ -34,7 +34,7 @@
 
 struct ksyn_waitq_element {
 #if __LP64__
-	#if defined(ARM64_BOARD_CONFIG_SWEET)
+	#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 	/* libpthread-514.100.2 includes the trailing kwe_uth pointer. */
 	char opaque[56];
 #else
-- 

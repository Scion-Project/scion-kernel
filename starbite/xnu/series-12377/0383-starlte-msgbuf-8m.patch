From 5592d1e4d09a4d34993826eebcd1eb9a656db0aa Mon Sep 17 00:00:00 2001
From: Starbite author <starbite@local>
Date: Wed, 4 Nov 2026 16:18:03 +0200
Subject: [PATCH] patch: 0383-starlte-msgbuf-8m.patch - STARLTE: kernel log
 ring up to 8 MiB

---
 bsd/sys/msgbuf.h | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/bsd/sys/msgbuf.h b/bsd/sys/msgbuf.h
index 96455095..7375a38b 100644
--- a/bsd/sys/msgbuf.h
+++ b/bsd/sys/msgbuf.h
@@ -65,7 +65,13 @@
 
 #include <sys/cdefs.h>
 
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+/* STARLTE: up to 8 MiB (msgbuf=8388608), the card log region (sdlog=1) holds 64 MiB; the macOS
+ * desktop's console output overran 1 MiB in about 40 s */
+#define MAX_MSG_BSIZE   (8*1024*1024)
+#else
 #define MAX_MSG_BSIZE   (1*1024*1024)
+#endif
 struct  msgbuf {
 #define MSG_MAGIC       0x063061
 	int             msg_magic;
-- 
2.53.0


From eed0adcb7660d45294e30c05a7599d32f1f6cccc Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Sun, 1 Nov 2026 21:06:59 +0200
Subject: [PATCH] patch: 0326-sweet-surface-16k-pages.patch

sweet: IOSurfaces (allocated and wrapped) are whole 16 KiB user pages. Rounded to the kernel's 4 KiB pages, a surface mapped into a 16 KiB-page task left the rest of its last user page without memory behind it; touching it (CoreAnimation reading an image) was a bus error (GPU boots 2-3). A wrapped address is taken from the start of its 16 KiB page (the task owns all of it). The physical display surfaces keep their exact size.
- SweetSurface.cpp: 16 KiB surface pages
---
 iokit/Kernel/arm/SweetSurface.cpp | 17 +++++++++++++----
 1 file changed, 13 insertions(+), 4 deletions(-)

diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index b9aa6ff9..5a7a435b 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -255,6 +255,14 @@ sweet_surface_create_physical(uint64_t phys, uint32_t width, uint32_t height,
 	return s;
 }
 
+/*
+ * Tasks map memory in 16 KiB pages on this kernel (4 KiB pages): a surface mapped into one
+ * must fill its last user page, or what is past its end in that page has no memory behind it
+ * and touching it is a bus error.
+ */
+#define SWEET_SURFACE_PAGE      16384ULL
+#define sweet_surface_round(x)  (((uint64_t)(x) + SWEET_SURFACE_PAGE - 1) & ~(SWEET_SURFACE_PAGE - 1))
+
 SweetSurface *
 sweet_surface_create_buffer(uint32_t width, uint32_t height, uint32_t pixelFormat)
 {
@@ -268,7 +276,7 @@ sweet_surface_create_buffer(uint32_t width, uint32_t height, uint32_t pixelForma
 	s->bytesPerElement = 4;
 	s->elementWidth = s->elementHeight = 1;
 	s->pixelFormat = pixelFormat;
-	s->allocSize = (uint32_t)round_page((uint64_t)s->bytesPerRow * height);
+	s->allocSize = (uint32_t)sweet_surface_round((uint64_t)s->bytesPerRow * height);
 	IOBufferMemoryDescriptor *mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
 	    kIODirectionInOut | kIOMemoryKernelUserShared, s->allocSize, page_size);
 	if (mem == NULL) {
@@ -378,7 +386,7 @@ sweet_surface_layout(SweetSurface *s, OSDictionary *props)
 	if (alloc < end) {
 		alloc = end;
 	}
-	alloc = round_page(alloc);
+	alloc = sweet_surface_round(alloc);
 	if (alloc == 0 || alloc > SWEET_SURFACE_MAX_ALLOC) {
 		return kIOReturnNoMemory;
 	}
@@ -751,8 +759,9 @@ IOSurfaceRootUserClient::returnSurface(SweetSurface *s, IOExternalMethodArgument
 static IOReturn
 sweet_surface_wrap_memory(SweetSurface *s, task_t task, uint64_t address, uint64_t size)
 {
-	uint64_t lead = address & PAGE_MASK;
-	uint64_t length = round_page(lead + size);
+	/* (the task owns the whole 16 KiB page the address is in) */
+	uint64_t lead = address & (SWEET_SURFACE_PAGE - 1);
+	uint64_t length = sweet_surface_round(lead + size);
 	bool readOnly = false;
 
 	if (size == 0 || length > SWEET_SURFACE_MAX_ALLOC) {

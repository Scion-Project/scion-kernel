From 98137f15a7668a0cfa087c55a0c6e1801d15a921 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:30:20 +0200
Subject: [PATCH] patch: 0034-sweet-ufs-dma-above-4g.patch

---
 bsd/dev/sweet_ufs.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index b2d76017..e530dacc 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -43,6 +43,7 @@ extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
 /* osfmk/arm/machine_routines.h, not exported to the BSD layer */
 extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
 
+#define REG_CAP         0x00
 #define REG_IS          0x20
 #define REG_IE          0x24
 #define REG_HCS         0x30
@@ -55,6 +56,7 @@ extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
 
 #define HCS_DP          (1u << 0)
 #define HCS_UTRLRDY     (1u << 1)
+#define CAP_64AS        (1u << 24)              /* 64-bit DMA addressing */
 
 #define UFS_BLOCK       4096u
 #define BOUNCE_SIZE     (1u << 20)
@@ -306,6 +308,12 @@ ufs_take_over_host(void)
 		printf("SWEET UFS: requests outstanding from the bootloader\n");
 		return EBUSY;
 	}
+	/* With RAM above 4 GiB (mkadt.py --highmem) the DMA memory can be there too. */
+	if (((su.dma_pa + DMA_SIZE - 1) >> 32) && !(ufs_rd(REG_CAP) & CAP_64AS)) {
+		printf("SWEET UFS: DMA memory at 0x%llx but the host has no 64-bit addressing\n",
+		    su.dma_pa);
+		return ENXIO;
+	}
 	ufs_wr(REG_IE, 0);                      /* polled operation */
 	ufs_wr(REG_IS, ufs_rd(REG_IS));
 	ufs_wr(REG_UTRLRSR, 0);
@@ -581,9 +589,9 @@ sweet_ufs_init(void)
 	/* Only now, with the partition bounds known, can writes be allowed. */
 	su.writable = (rw != 0);
 	su.ready = true;
-	printf("SWEET UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, %s\n",
+	printf("SWEET UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, %s, DMA at 0x%llx\n",
 	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20,
-	    su.writable ? "read-write" : "read-only");
+	    su.writable ? "read-write" : "read-only", su.dma_pa);
 	return 0;
 }
 
-- 

From 16b00e8e49c122a810361a0331376735c3350378 Mon Sep 17 00:00:00 2001
From: Starbite author <starbite@local>
Date: Thu, 5 Nov 2026 14:58:28 +0200
Subject: [PATCH] patch: 0398-sweet-touch-steer-robust.patch - direct touch:
 the pointer from any small upper layer; dead reckoning when no redraw comes
 (the desktop stalled the steering)

---
 iokit/Kernel/arm/SweetFramebuffer.cpp |  2 +-
 iokit/Kernel/arm/hid/SweetHID.cpp     | 31 ++++++++++++++++++++++-----
 2 files changed, 27 insertions(+), 6 deletions(-)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index c008b6bd..e11fe0ca 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -1047,7 +1047,7 @@ AppleCLCD::present(const uint8_t *rec)
 		 * panel pixels under it are saved; a pointer-only swap first puts them back. A swap with layer 0
 		 * covers everything, so the saved copy is dropped.
 		 */
-		if (layer == 1 && src != 0) {
+		if (layer > 0 && src != 0 && w <= 256 && h <= 256) {	/* the pointer: whichever upper layer holds it */
 			/* 0397: where the pointer layer is drawn (logical), for the touch driver's direct touch */
 			extern volatile int32_t sweet_fb_cur_x, sweet_fb_cur_y;
 			extern volatile uint32_t sweet_fb_cur_seq;
diff --git a/iokit/Kernel/arm/hid/SweetHID.cpp b/iokit/Kernel/arm/hid/SweetHID.cpp
index 06e29e57..35091fa1 100644
--- a/iokit/Kernel/arm/hid/SweetHID.cpp
+++ b/iokit/Kernel/arm/hid/SweetHID.cpp
@@ -690,6 +690,9 @@ static struct {
 	int calTicks;
 	int32_t hotX, hotY;
 	uint32_t sentSeq;
+	int stale;                      /* ticks since the last correction without a redrawn pointer */
+	int32_t estX, estY;             /* the pointer by dead reckoning when no redraw tells us */
+	bool estValid;
 	UInt32 buttons;
 	UInt32 clickButton;             /* a click to make once the pointer is there */
 	int clickTicks;
@@ -732,23 +735,41 @@ SweetHIDTouch::steerTick(void)
 		st.cal = 1;
 		st.calTicks = 0;
 		st.sentSeq = seq;
+		st.estX = st.estY = 0;
+		st.estValid = true;
 	} else if (st.cal == 1) {
 		if (seq != st.sentSeq && ++st.calTicks >= 3) {
 			st.hotX = -sweet_fb_cur_x;
 			st.hotY = -sweet_fb_cur_y;
 			st.cal = 2;
 			IOLog("SWEET HID: pointer hotspot %d,%d\n", st.hotX, st.hotY);
-		} else if (st.calTicks++ > 60) {
-			st.cal = 0;     /* no pointer drawn in a second: try again */
+		} else if (st.calTicks++ > 30) {
+			st.hotX = st.hotY = 0;  /* no pointer drawn in half a second: dead reckoning only */
+			st.cal = 2;
+			IOLog("SWEET HID: no pointer layer seen, steering by dead reckoning\n");
+		}
+	} else if (seq != st.sentSeq || st.sentSeq == 0 || ++st.stale >= 3) {
+		/* one correction per drawn frame; without a redraw for 3 ticks (a pointer WindowServer draws
+		 * itself, or not at all), by dead reckoning from what was sent */
+		int cw, ch;
+		sweet_canvas(&cw, &ch);
+		int32_t px, py;
+		if (seq != st.sentSeq || !st.estValid) {
+			px = sweet_fb_cur_x + st.hotX;
+			py = sweet_fb_cur_y + st.hotY;
+		} else {
+			px = st.estX;
+			py = st.estY;
 		}
-	} else if (seq != st.sentSeq || st.sentSeq == 0) {
-		/* one correction per drawn frame */
-		int32_t px = sweet_fb_cur_x + st.hotX, py = sweet_fb_cur_y + st.hotY;
+		st.stale = 0;
 		int32_t ex = st.tgtX - px, ey = st.tgtY - py;
 		bool there = (ex < 0 ? -ex : ex) <= 2 && (ey < 0 ? -ey : ey) <= 2;
 		if (!there && !st.two) {
 			events[0] = IOHIDEvent::relativePointerEvent(now, ex, ey, 0, st.buttons, st.buttons);
 			st.sentSeq = seq;
+			st.estX = st.tgtX < 0 ? 0 : (st.tgtX >= cw ? cw - 1 : st.tgtX);
+			st.estY = st.tgtY < 0 ? 0 : (st.tgtY >= ch ? ch - 1 : st.tgtY);
+			st.estValid = true;
 		}
 		if (st.clickButton && (there || ++st.clickTicks > 20)) {
 			events[1] = IOHIDEvent::relativePointerEvent(now, 0, 0, 0, st.clickButton, st.buttons);
-- 
2.53.0


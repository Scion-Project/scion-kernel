From 14d1d35183b2cbdb313c01229f1dc670df6ac6f5 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 4 Nov 2026 04:14:56 +0200
Subject: [PATCH] patch: 0369-sweet-crash-terse-traced.patch - terse crash log
 keeps the full log for the traced process

---
 osfmk/kern/exception.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index 84a65a2e..c9474888 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -1050,7 +1050,8 @@ sweet_crash_log(const char *name, int pid, int sig, uint64_t code, uint64_t subc
 			terse = 0;
 			PE_parse_boot_argn("sweetcrashterse", &terse, sizeof(terse));
 		}
-		if (terse) {
+		extern bool sweet_trace_match(const char *, int);
+		if (terse && !sweet_trace_match(name, pid)) {   /* the traced process keeps the full log */
 			printf("CRASH %s pc 0x%llx lr 0x%llx\n", name, get_saved_state_pc(ss), get_saved_state_lr(ss));
 			return;
 		}

+/* DWC3 registers and fields: drivers/usb/dwc3/core.h of the BSP, line numbers given */
+#define GSBUSCFG0               0xc100u         /* :83 */
+#define  GSBUSCFG0_INCRBRSTEN   (1u << 0)       /* :161 */
+#define  GSBUSCFG0_INCR16BRSTEN (1u << 3)       /* :164 */
+#define  GSBUSCFG0_REQINFO      ((2u << 16) | (2u << 20) | (2u << 24) | (2u << 28))    /* :169-172 */
+#define GSBUSCFG1               0xc104u         /* :84 */
+#define  GSBUSCFG1_BREQLIMIT(n) ((n) << 8)      /* :177 */
+#define GCTL                    0xc110u         /* :87 */
+#define  GCTL_DSBLCLKGTNG       (1u << 0)       /* :227 */
+#define  GCTL_SCALEDOWN_MASK    (3u << 4)       /* :222-223 */
+#define  GCTL_SOFITPSYNC        (1u << 10)      /* :207, 221 */
+#define  GCTL_PRTCAPDIR_MASK    (3u << 12)      /* :215, 218 */
+#define  GCTL_PRTCAP_DEVICE     (2u << 12)      /* :215, 217 */
+#define GSTS                    0xc118u         /* :89 */
+#define GSNPSID                 0xc120u         /* :91; 0x5533xxxx DWC_usb3, 0x3331xxxx DWC_usb31 (core.c:804-807) */
+#define GUCTL                   0xc12cu         /* :94 */
+#define  GUCTL_USBHSTINAUTORETRYEN (1u << 14)   /* :231 */
+#define  GUCTL_REFCLKPER_MASK   (0x3ffu << 22)  /* :229-230 */
+#define  GUCTL_REFCLKPER(n)     ((n) << 22)
+#define GHWPARAMS0              0xc140u         /* :99 */
+#define GHWPARAMS1              0xc144u         /* :100 */
+#define GHWPARAMS3              0xc14cu         /* :102 */
+#define GUSB2PHYCFG             0xc200u         /* :118, port 0 */
+#define  GUSB2_PHYSOFTRST       (1u << 31)      /* :235 */
+#define  GUSB2_U2_FREECLK_EXISTS (1u << 30)     /* :236 */
+#define  GUSB2_SUSPHY           (1u << 6)       /* :237 */
+#define  GUSB2_ENBLSLPM         (1u << 8)       /* :239 */
+#define GUSB3PIPECTL            0xc2c0u         /* :123, port 0 */
+#define GEVNTADRLO              0xc400u         /* :128, buffer 0 */
+#define GEVNTADRHI              0xc404u         /* :129 */
+#define GEVNTSIZ                0xc408u         /* :130 */
+#define  GEVNTSIZ_INTMASK       (1u << 31)      /* :281 */
+#define GEVNTCOUNT              0xc40cu         /* :131 */
+#define  GEVNTCOUNT_MASK        0xfffcu         /* :68 */
+#define DCFG                    0xc700u         /* :137 */
+#define  DCFG_SPEED_MASK        7u              /* :345 */
+#define  DCFG_HIGHSPEED         0u              /* :348 */
+#define  DCFG_FULLSPEED         1u              /* :349 */
+#define  DCFG_DEVADDR_MASK      (0x7fu << 3)    /* :342-343 */
+#define  DCFG_DEVADDR(a)        ((uint32_t)(a) << 3)
+#define  DCFG_LPM_CAP           (1u << 22)      /* :356 */
+#define DCTL                    0xc704u         /* :138 */
+#define  DCTL_RUN_STOP          (1u << 31)      /* :359 */
+#define  DCTL_CSFTRST           (1u << 30)      /* :360 */
+#define  DCTL_KEEP_CONNECT      (1u << 19)      /* :381 */
+#define  DCTL_U1U2_MASK         (0xfu << 9)     /* :386-389: INITU2ENA, ACCEPTU2ENA, INITU1ENA, ACCEPTU1ENA */
+#define DEVTEN                  0xc708u         /* :139 */
+#define  DEVTEN_DISCONNEVTEN    (1u << 0)       /* :416 */
+#define  DEVTEN_USBRSTEN        (1u << 1)       /* :415 */
+#define  DEVTEN_CONNECTDONEEN   (1u << 2)       /* :414 */
+#define  DEVTEN_ULSTCNGEN       (1u << 3)       /* :413 */
+#define DSTS                    0xc70cu         /* :140 */
+#define  DSTS_CONNECTSPD        7u              /* :439; 0 high, 1 full (and 3), 4 super (:442-444) */
+#define  DSTS_USBLNKST(v)       (((v) >> 18) & 0xfu)   /* :431-432 */
+#define  DSTS_DEVCTRLHLT        (1u << 22)      /* :429 */
+#define DALEPENA                0xc720u         /* :143; bit n: physical endpoint n (:498) */
+#define DEP_BASE(n)             (0xc800u + (n) * 0x10u)        /* :145 */
+#define  DEPCMDPAR2             0x00u           /* :146 */
+#define  DEPCMDPAR1             0x04u           /* :147 */
+#define  DEPCMDPAR0             0x08u           /* :148 */
+#define  DEPCMD                 0x0cu           /* :149 */
+#define  DEPCMD_PARAM(x)        ((uint32_t)(x) << 16)  /* :475-476 */
+#define  DEPCMD_RSC_IDX(x)      (((x) >> 16) & 0x7fu)  /* :477 */
+#define  DEPCMD_STATUS(x)       (((x) >> 12) & 0xfu)   /* :478 */
+#define  DEPCMD_HIPRI_FORCERM   (1u << 11)      /* :479 */
+#define  DEPCMD_CMDACT          (1u << 10)      /* :481 */
+#define  CMD_SETEPCONFIG        0x01u           /* :495 */
+#define  CMD_SETTRANSFRESOURCE  0x02u           /* :494 */
+#define  CMD_SETSTALL           0x04u           /* :489 */
+#define  CMD_CLEARSTALL         0x05u           /* :488 */
+#define  CMD_STARTTRANSFER      0x06u           /* :487 */
+#define  CMD_ENDTRANSFER        0x08u           /* :485 */
+#define  CMD_DEPSTARTCFG        0x09u           /* :484 */
+/* DEPCFG's parameters (gadget.h) */
+#define DEPCFG_EP_TYPE(t)       (((t) & 3u) << 1)              /* gadget.h:44 */
+#define DEPCFG_MPS(n)           (((n) & 0x7ffu) << 3)          /* gadget.h:45 */
+#define DEPCFG_FIFO_NUMBER(n)   (((n) & 0x1fu) << 17)          /* gadget.h:46 */
+#define DEPCFG_ACTION_INIT      (0u << 30)                     /* gadget.h:52 */
+#define DEPCFG_ACTION_MODIFY    (2u << 30)                     /* gadget.h:54 */
+#define DEPCFG_XFER_COMPLETE_EN (1u << 8)                      /* gadget.h:32 */
+#define DEPCFG_XFER_IN_PROGRESS_EN (1u << 9)                   /* gadget.h:33 */
+#define DEPCFG_XFER_NOT_READY_EN (1u << 10)                    /* gadget.h:34 */
+#define DEPCFG_BINTERVAL_M1(n)  (((n) & 0xffu) << 16)          /* gadget.h:37 */
+#define DEPCFG_EP_NUMBER(n)     (((n) & 0x1fu) << 25)          /* gadget.h:39 */
+#define DEPXFERCFG_NUM_XFER_RES(n) ((n) & 0xffffu)             /* gadget.h:57 */
+/* the TRB (core.h:676-710) */
+#define TRB_SIZE_MASK           0x00ffffffu     /* :682 */
+#define TRB_SIZE_TRBSTS(s)      (((s) >> 28) & 0xfu)   /* :685; SETUP_PENDING 2 (:689) */
+#define TRB_CTRL_HWO            (1u << 0)       /* :693 */
+#define TRB_CTRL_LST            (1u << 1)       /* :694 */
+#define TRB_CTRL_ISP_IMI        (1u << 10)      /* :698 */
+#define TRB_CTRL_IOC            (1u << 11)      /* :699 */
+#define TRBCTL_NORMAL           (1u << 4)       /* :697, 703-707 */
+#define TRBCTL_CONTROL_SETUP    (2u << 4)
+#define TRBCTL_CONTROL_STATUS2  (3u << 4)
+#define TRBCTL_CONTROL_STATUS3  (4u << 4)
+#define TRBCTL_CONTROL_DATA     (5u << 4)
+#define TRBSTS_SETUP_PENDING    2u
+/* events (core.h:52-66, 1095-1205): bit 0 clear, an endpoint's: [5:1] the endpoint, [9:6] the event, [15:12] status */
+#define DEPEVT_XFERCOMPLETE     1u              /* :1103 */
+#define DEPEVT_XFERNOTREADY     3u              /* :1105 */
+#define DEPEVT_STATUS_CONTROL_DATA   1u         /* :1150 */
+#define DEPEVT_STATUS_CONTROL_STATUS 2u         /* :1151 */
+#define DEVT_DISCONNECT         0u              /* :56-59 */
+#define DEVT_RESET              1u
+#define DEVT_CONNECT_DONE       2u
+#define DEVT_LINK_STATUS_CHANGE 3u
+
+/* physical endpoints: 0 ep0 OUT, 1 ep0 IN, 2 EP1 OUT, 3 EP1 IN, 5 EP2 IN */
+#define PEP_OUT                 2
+#define PEP_IN                  3
+#define PEP_NOTIFY              5
+#define NPEPS                   6
+
+/* memory the controller reaches: one 32 KB block, mapped uncached (see dma_alloc()) */
+#define DMA_SIZE                (32 * 1024)
+#define EVT_OFF                 0x0000u
+#define EVT_SIZE                4096u
+#define TRB_OFF(slot)           (0x1000u + (slot) * 64u)       /* one TRB per cache line */
+#define EP0_OFF                 0x2000u         /* 512 bytes */
+#define OUT_OFF                 0x2400u         /* 512 bytes */
+#define IN_OFF                  0x4000u
+#define IN_CHUNK                16384u
+
+#define RING_SIZE               (1024u * 1024u)        /* the log on its way out; a power of two */
+
+struct trb {
+	uint32_t bpl, bph, size, ctrl;
+};
+
+enum { EP0_IDLE, EP0_SETUP, EP0_DATA, EP0_STATUS_WAIT, EP0_STATUS };
+
+static uint32_t steps, poll_ms = 2, drain_ms = 1000, crlf = 1, full_speed, susphy, glue_flags;
+static const struct hakios_usb_glue *glue;
+static vm_offset_t regs;
+static volatile uint8_t *dma;
+static uint64_t dma_pa;
+static uint32_t ev_pos;
+static thread_call_t call;
+static int stage;                       /* how far the bring-up got: 0 none ... 5 */
+static bool started, connected, high_speed;
+static uint32_t busy;                   /* the poll, or the way back to the loader, has the controller */
+static bool want_return;                /* the console asked to end the run */
+static bool wifi_report_said, want_wifi_report;           /* the console is up: the radio's log said again, once (hakios.lx.c) */
+static thread_call_t return_call;       /* ... which end_the_run() does, on a thread of its own */
+static uint64_t return_asked_at;        /* when it was started (mach_absolute_time), 0: not yet */
+#define RETURN_FORCE_SECONDS    15      /* then the poll returns to the loader itself, without the save and the stops */
+
+/* The cable: see "The cable" in the head comment */
+#define VBUS_UNKNOWN            (-1)
+#define VBUS_SILENT_SECONDS     3       /* a stopped link goes back up when VBUS has not been heard of for this long */
+#define STORM_NO_SETUP          4       /* resets with no SETUP after them */
+#define STORM_NO_CONFIG         12      /* resets with no SET_CONFIGURATION after them */
+#define RESTART_WAIT_FIRST      2       /* seconds between restarts, doubling ... */
+#define RESTART_WAIT_MOST       30      /* ... up to this; back to the first once the host has configured the link */
+#define QUIET_SECONDS           5       /* VBUS there and no SOF or reset from a host for this long ... */
+#define QUIET_RESTARTS          5       /* ... restarts for that, then none until the next change (a wall charger never talks) */
+static int vbus_report = VBUS_UNKNOWN, vbus_seen = VBUS_UNKNOWN;
+static uint64_t vbus_heard_at;          /* mach_absolute_time of the last report */
+static bool link_stopped;               /* VBUS went: transfers ended, the pull-up off, the PHY down */
+static bool watch_storms = true;        /* the console's usb watch */
+static bool want_restart;               /* the console's usb restart */
+static uint32_t want_drop_ms;           /* the console's usb drop */
+static uint32_t resets_no_setup, resets_no_config, quiet_restarts;
+static uint64_t last_heard;             /* mach_absolute_time of the host's last SOF or reset, or of the last restart */
+static uint32_t last_sof;               /* DSTS's frame number when last looked at */
+static uint32_t restart_wait = RESTART_WAIT_FIRST;
+static uint64_t restart_after;          /* mach_absolute_time before which no storm restarts the link */
+static uint64_t n_restarts;
+static uint64_t hold_log_until;         /* after a restart: the log waits for the host to open the port, until this time */
+static uint64_t hold_open_at;           /* when the host opened the port, while the log is held */
+#define HOLD_LOG_SECONDS        10
+static uint32_t say_resets = 16, say_setups = 64;      /* log lines left; a restart gives some back */
+
+static struct usbacm acm;
+static struct usbacm_line cline;
+static int ep0_state;
+static bool ep0_in, ep0_three;          /* the data stage's direction; a data stage there was */
+static uint16_t ep0_out_len;
+static int ep0_status_pep = -1, ep0_notready_pep = -1;
+static struct { bool active; uint32_t rsc; uint32_t len; } pep[NPEPS];
+
+static char *ring;
+static uint32_t ring_head, ring_tail, ring_dropped;
+static uint64_t n_resets, n_setups, n_stalls, n_in, n_out, n_events, last_phy_say;
+static int usb_speed_v;
+static char usb_state[24] = "off";
+
+/* a picture of the panel on its way out (the console's shot): the phase, and where in it */
+enum { SHOT_OFF, SHOT_LOG, SHOT_HEAD, SHOT_PIXELS, SHOT_END, SHOT_PREP };
+static struct {
+	int phase;                      /* SHOT_PREP: taken, being set up (nothing is sent meanwhile) */
+	uint32_t mark;                  /* the log up to here goes out before the picture */
+	uint32_t n, w, h, x, y, rowbytes, sent;
+	uintptr_t base;
+	bool rgb;                       /* base is w x h RGB888 as it goes out (a camshot), not the panel's BGRA */
+	uint64_t start;
+} shot;
+static uint64_t n_shots;
+
+SYSCTL_NODE(_kern_hakios, OID_AUTO, usb, CTLFLAG_RW | CTLFLAG_LOCKED, 0, "the USB gadget link (drivers/usb/hakios.dwc3.c, usb_gadget=N)");
+SYSCTL_STRING(_kern_hakios_usb, OID_AUTO, state, CTLFLAG_RD | CTLFLAG_LOCKED, usb_state, 0, "off, phy, core, waiting, default, address, configured");
+SYSCTL_QUAD(_kern_hakios_usb, OID_AUTO, bytes_in, CTLFLAG_RD | CTLFLAG_LOCKED, &n_in, "log bytes the host has taken");
+SYSCTL_QUAD(_kern_hakios_usb, OID_AUTO, bytes_out, CTLFLAG_RD | CTLFLAG_LOCKED, &n_out, "bytes the host has sent");
+SYSCTL_QUAD(_kern_hakios_usb, OID_AUTO, resets, CTLFLAG_RD | CTLFLAG_LOCKED, &n_resets, "bus resets");
+SYSCTL_UINT(_kern_hakios_usb, OID_AUTO, dropped, CTLFLAG_RD | CTLFLAG_LOCKED, &ring_dropped, 0, "log bytes dropped: the host did not read fast enough");
+SYSCTL_QUAD(_kern_hakios_usb, OID_AUTO, restarts, CTLFLAG_RD | CTLFLAG_LOCKED, &n_restarts, "the link restarted: a replug, or a host that got no answer");
+
+/* the console's answers: into the log (and so to the host) as whole lines, not onto the screen */
+static void con(const char *format, ...) __printflike(1, 2);
+
+static void
+con(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	loader_log_line(line);
+}
+
+static void
+set_state(const char *s)
+{
+	strlcpy(usb_state, s, sizeof(usb_state));
+}
+
+static inline uint32_t
+rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(regs + off);
+}
+
+static inline void
+wr(uint32_t off, uint32_t value)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(regs + off) = value;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline volatile struct trb *
+trb_of(int p)
+{
+	int slot = p == PEP_NOTIFY ? 4 : p;
+
+	return (volatile struct trb *)(dma + TRB_OFF(slot));
+}
+
+static inline uint64_t
+trb_pa(int p)
+{
+	return dma_pa + TRB_OFF(p == PEP_NOTIFY ? 4 : p);
+}
+
+/* The log's way out: a ring the log fills (under its lock) and the poll empties. */
+
+static void
+tap(char c)
+{
+	uint32_t h = ring_head, t = os_atomic_load(&ring_tail, acquire);
+
+	if (h - t >= RING_SIZE) {
+		ring_dropped++;
+		return;
+	}
+	ring[h & (RING_SIZE - 1)] = c;
+	os_atomic_store(&ring_head, h + 1, release);
+}
+
+static void
+history(const char *text, uint32_t len)
+{
+	for (uint32_t i = 0; i < len; i++) {
+		tap(text[i]);
+	}
+}
+
+/* Endpoint commands. */
+
+static int
+depcmd(int p, uint32_t cmd, uint32_t p0, uint32_t p1, uint32_t p2, uint32_t *out)
+{
+	uint32_t base = DEP_BASE((uint32_t)p), v = 0;
+
+	wr(base + DEPCMDPAR2, p2);
+	wr(base + DEPCMDPAR1, p1);
+	wr(base + DEPCMDPAR0, p0);
+	wr(base + DEPCMD, cmd | DEPCMD_CMDACT);
+	for (int us = 0; us < 5000; us++) {
+		v = rd(base + DEPCMD);
+		if (!(v & DEPCMD_CMDACT)) {
+			if (out != NULL) {
+				*out = v;
+			}
+			if (DEPCMD_STATUS(v) != 0) {
+				say("usb: endpoint %d command %x: status %u\n", p, cmd & 0xf, DEPCMD_STATUS(v));
+				return EIO;
+			}
+			return 0;
+		}
+		delay(1);
+	}
+	say("usb: endpoint %d command %x: no answer in 5 ms (DEPCMD %08x)\n", p, cmd & 0xf, v);
+	return ETIMEDOUT;
+}
+
+static int
+start_xfer(int p, uint64_t buf_pa, uint32_t len, uint32_t trbctl)
+{
+	volatile struct trb *t = trb_of(p);
+	uint32_t v = 0;
+	uint64_t tp = trb_pa(p);
+
+	t->bpl = (uint32_t)buf_pa;
+	t->bph = (uint32_t)(buf_pa >> 32);
+	t->size = len & TRB_SIZE_MASK;
+	t->ctrl = trbctl | TRB_CTRL_LST | TRB_CTRL_IOC | TRB_CTRL_ISP_IMI | TRB_CTRL_HWO;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	if (depcmd(p, CMD_STARTTRANSFER, (uint32_t)(tp >> 32), (uint32_t)tp, 0, &v) != 0) {
+		return EIO;
+	}
+	pep[p].active = true;
+	pep[p].rsc = DEPCMD_RSC_IDX(v);
+	pep[p].len = len;
+	return 0;
+}
+
+static void
+end_xfer(int p)
+{
+	if (!pep[p].active) {
+		return;
+	}
+	(void)depcmd(p, CMD_ENDTRANSFER | DEPCMD_HIPRI_FORCERM | DEPCMD_PARAM(pep[p].rsc), 0, 0, 0, NULL);
+	delay(100);             /* as gadget.c's dwc3_stop_active_transfer waits */
+	pep[p].active = false;
+}
+
+static int
+ep_config(int p, uint32_t type, uint32_t mps, uint32_t action, uint32_t interval_m1)
+{
+	uint32_t p0 = DEPCFG_EP_TYPE(type) | DEPCFG_MPS(mps) | action;
+	uint32_t p1 = DEPCFG_XFER_COMPLETE_EN | DEPCFG_EP_NUMBER((uint32_t)p);
+
+	if (p & 1) {
+		p0 |= DEPCFG_FIFO_NUMBER((uint32_t)p >> 1);
+	}
+	if (type == 0) {
+		p1 |= DEPCFG_XFER_NOT_READY_EN;
+	} else {
+		p1 |= DEPCFG_XFER_IN_PROGRESS_EN;
+	}
+	if (type == 3) {
+		p1 |= DEPCFG_BINTERVAL_M1(interval_m1);
+	}
+	return depcmd(p, CMD_SETEPCONFIG, p0, p1, 0, NULL);
+}
+
+/* Endpoint 0. */
+
+static void
+ep0_setup_start(void)
+{
+	ep0_state = EP0_SETUP;
+	ep0_status_pep = -1;
+	ep0_notready_pep = -1;
+	if (start_xfer(0, dma_pa + EP0_OFF, 8, TRBCTL_CONTROL_SETUP) != 0) {
+		ep0_state = EP0_IDLE;
+	}
+}
+
+static void
+ep0_stall(void)
+{
+	n_stalls++;
+	(void)depcmd(0, CMD_SETSTALL, 0, 0, 0, NULL);
+	ep0_setup_start();
+}
+
+static void
+ep0_try_status(void)
+{
+	if (ep0_state != EP0_STATUS_WAIT || ep0_notready_pep != ep0_status_pep) {
+		return;
+	}
+	ep0_state = EP0_STATUS;
+	if (start_xfer(ep0_status_pep, dma_pa + EP0_OFF, 0, ep0_three ? TRBCTL_CONTROL_STATUS3 : TRBCTL_CONTROL_STATUS2) != 0) {
+		ep0_stall();
+	}
+}
+
+static void bulk_down(void);
+static void bulk_up(void);
+static void pump_in(void);
+
+static void
+apply(const struct usbacm_reply *r)
+{
+	if (r->effects & USBACM_EFF_ADDRESS) {
+		wr(DCFG, (rd(DCFG) & ~DCFG_DEVADDR_MASK) | DCFG_DEVADDR(r->value));    /* before the status stage (ep0.c:553) */
+		say("usb: address %u\n", r->value);
+		set_state(r->value ? "address" : "default");
+	}
+	if (r->effects & USBACM_EFF_CONFIG) {
+		bulk_down();
+		if (r->value) {
+			bulk_up();
+			set_state("configured");
+			resets_no_config = 0;
+			quiet_restarts = 0;
+			restart_wait = RESTART_WAIT_FIRST;
+			say("usb: configured (%s speed): /dev/ttyACM* on a Linux host, /dev/cu.usbmodem* on a Mac\n", high_speed ? "high" : "full");
+			hakios_ufs_summary("the USB console is up", 1 | 4);    /* ufs=3 only: what the storage did before the link */
+			if (!wifi_report_said) {
+				wifi_report_said = true;
+				want_wifi_report = true;
+			}
+		} else {
+			set_state("address");
+			say("usb: unconfigured\n");
+		}
+	}
+	if (r->effects & (USBACM_EFF_HALT | USBACM_EFF_CLEAR_HALT)) {
+		int p = r->ep == USBACM_EP_OUT ? PEP_OUT : r->ep == USBACM_EP_IN ? PEP_IN : PEP_NOTIFY;
+
+		if (r->effects & USBACM_EFF_HALT) {
+			end_xfer(p);
+			(void)depcmd(p, CMD_SETSTALL, 0, 0, 0, NULL);
+		} else {
+			(void)depcmd(p, CMD_CLEARSTALL, 0, 0, 0, NULL);
+			if (p == PEP_OUT && steps >= 5 && !pep[PEP_OUT].active) {
+				(void)start_xfer(PEP_OUT, dma_pa + OUT_OFF, 512, TRBCTL_NORMAL);
+			}
+		}
+	}
+	if (r->effects & USBACM_EFF_LINES) {
+		say("usb: the host %s the port (DTR %u RTS %u)\n", (acm.lines & 1) ? "opened" : "closed", acm.lines & 1, (acm.lines >> 1) & 1);
+	}
+}
+
+static void
+ep0_complete(int p)
+{
+	volatile struct trb *t = trb_of(p);
+	uint32_t sts = TRB_SIZE_TRBSTS(t->size);
+	struct usbacm_reply r;
+	uint8_t pkt[8];
+
+	switch (ep0_state) {
+	case EP0_SETUP:
+		for (int i = 0; i < 8; i++) {
+			pkt[i] = dma[EP0_OFF + (uint32_t)i];
+		}
+		n_setups++;
+		resets_no_setup = 0;
+		usbacm_setup(&acm, pkt, &r);
+		if (say_setups > 0 || n_setups % 100 == 0) {
+			say_setups -= say_setups > 0 ? 1 : 0;
+			static const char *const what[] = { "stall", "status", "in", "out" };
+			say("usb: setup %llu: %02x %02x %02x%02x %02x%02x %02x%02x -> %s %u\n", n_setups, pkt[0], pkt[1], pkt[3], pkt[2],
+			    pkt[5], pkt[4], pkt[7], pkt[6], what[r.action & 3], r.len);
+		}
+		apply(&r);
+		switch (r.action) {
+		case USBACM_STATUS:
+			ep0_three = false;
+			ep0_status_pep = 1;
+			ep0_state = EP0_STATUS_WAIT;
+			ep0_try_status();
+			break;
+		case USBACM_IN:
+			for (uint32_t i = 0; i < r.len; i++) {
+				dma[EP0_OFF + i] = r.data[i];
+			}
+			ep0_in = true;
+			ep0_three = true;
+			ep0_state = EP0_DATA;
+			if (start_xfer(1, dma_pa + EP0_OFF, r.len, TRBCTL_CONTROL_DATA) != 0) {
+				ep0_stall();
+			}
+			break;
+		case USBACM_OUT:
+			ep0_in = false;
+			ep0_three = true;
+			ep0_out_len = r.len;
+			ep0_state = EP0_DATA;
+			/* an OUT data stage is received in whole packets (ep0.c __dwc3_ep0_do_control_data) */
+			if (start_xfer(0, dma_pa + EP0_OFF, USBACM_EP0_MPS, TRBCTL_CONTROL_DATA) != 0) {
+				ep0_stall();
+			}
+			break;
+		default:
+			ep0_stall();
+			break;
+		}
+		break;
+	case EP0_DATA:
+		if (sts == TRBSTS_SETUP_PENDING) {
+			ep0_setup_start();
+			break;
+		}
+		if (!ep0_in) {
+			uint32_t got = USBACM_EP0_MPS - (t->size & TRB_SIZE_MASK);
+			uint8_t data[USBACM_EP0_MPS];
+
+			for (uint32_t i = 0; i < got && i < sizeof(data); i++) {
+				data[i] = dma[EP0_OFF + i];
+			}
+			if (usbacm_out_done(&acm, data, MIN(got, (uint32_t)ep0_out_len), &r) == USBACM_STALL) {
+				ep0_stall();
+				break;
+			}
+			apply(&r);
+		}
+		ep0_status_pep = ep0_in ? 0 : 1;
+		ep0_state = EP0_STATUS_WAIT;
+		ep0_try_status();
+		break;
+	case EP0_STATUS:
+		ep0_setup_start();
+		break;
+	default:
+		break;
+	}
+}
+
+static void
+ep0_notready(int p, uint32_t status)
+{
+	if (status == DEPEVT_STATUS_CONTROL_STATUS) {
+		ep0_notready_pep = p;
+		ep0_try_status();
+	}
+}
+
+/* Bulk endpoints. */
+
+static void
+bulk_down(void)
+{
+	end_xfer(PEP_OUT);
+	end_xfer(PEP_IN);
+	end_xfer(PEP_NOTIFY);
+	wr(DALEPENA, rd(DALEPENA) & ~((1u << PEP_OUT) | (1u << PEP_IN) | (1u << PEP_NOTIFY)));
+}
+
+static void
+bulk_up(void)
+{
+	uint32_t mps = high_speed ? USBACM_HS_BULK : USBACM_FS_BULK;
+
+	if (ep_config(PEP_OUT, 2, mps, DEPCFG_ACTION_INIT, 0) != 0 || ep_config(PEP_IN, 2, mps, DEPCFG_ACTION_INIT, 0) != 0 ||
+	    ep_config(PEP_NOTIFY, 3, 16, DEPCFG_ACTION_INIT, high_speed ? 8 : 0) != 0) {
+		say("usb: the bulk endpoints could not be configured\n");
+		return;
+	}
+	wr(DALEPENA, rd(DALEPENA) | (1u << PEP_OUT) | (1u << PEP_IN) | (1u << PEP_NOTIFY));
+	if (steps >= 5) {
+		(void)start_xfer(PEP_OUT, dma_pa + OUT_OFF, mps, TRBCTL_NORMAL);
+		pump_in();
+	}
+}
+
+/*
+ * The console's shot, one bulk IN transfer at a time: first the log as far as it had got when the command came, then
+ * the header line, the pixels (as many whole pixels as fit in a transfer), "END". The log that comes meanwhile waits
+ * in the ring (1 MB; a shot at N=4 is 0.8 MB and takes some 0.1 s at high speed) and goes out after END.
+ */
+static uint32_t
+shot_fill(void)
+{
+	volatile uint8_t *out = dma + IN_OFF;
+	uint32_t n = 0;
+
+	if (shot.phase == SHOT_LOG) {
+		uint32_t t = ring_tail;
+
+		while (t != shot.mark && n + 2 <= IN_CHUNK) {
+			char c = ring[t & (RING_SIZE - 1)];
+
+			if (c == '\n' && crlf) {
+				out[n++] = '\r';
+			}
+			out[n++] = (uint8_t)c;
+			t++;
+		}
+		os_atomic_store(&ring_tail, t, release);
+		if (t != shot.mark || n != 0) {
+			if (t == shot.mark) {
+				shot.phase = SHOT_HEAD;
+			}
+			return n;
+		}
+		shot.phase = SHOT_HEAD;
+	}
+	if (shot.phase == SHOT_HEAD) {
+		shot.phase = SHOT_PIXELS;
+		shot.x = shot.y = 0;
+		shot.start = mach_absolute_time();
+		return (uint32_t)snprintf((char *)(uintptr_t)out, 96, "SHOT %u %u %u rgb888 %u\n", shot.w, shot.h, shot.w * 3,
+		           shot.w * shot.h * 3);
+	}
+	if (shot.phase == SHOT_PIXELS && shot.rgb) {
+		uint32_t total = shot.w * shot.h * 3, take = total - shot.sent;
+
+		take = take > IN_CHUNK ? IN_CHUNK : take;
+		memcpy((void *)(uintptr_t)out, (const void *)(shot.base + shot.sent), take);
+		shot.sent += take;
+		if (shot.sent < total) {
+			return take;
+		}
+		shot.y = shot.h;
+		shot.phase = SHOT_END;
+		if (take != 0) {
+			return take;
+		}
+	}
+	if (shot.phase == SHOT_PIXELS) {
+		while (shot.y < shot.h && n + 3 <= IN_CHUNK) {
+			const volatile uint32_t *row = (const volatile uint32_t *)(shot.base +
+			    (size_t)(shot.y * shot.n + shot.n / 2) * shot.rowbytes);
+			uint32_t px = row[shot.x * shot.n + shot.n / 2];      /* B G R A in memory */
+
+			out[n++] = (uint8_t)(px >> 16);
+			out[n++] = (uint8_t)(px >> 8);
+			out[n++] = (uint8_t)px;
+			if (++shot.x == shot.w) {
+				shot.x = 0;
+				shot.y++;
+			}
+		}
+		shot.sent += n;
+		if (shot.y < shot.h) {
+			return n;
+		}
+		shot.phase = SHOT_END;
+		if (n != 0) {
+			return n;
+		}
+	}
+	/* SHOT_END */
+	out[0] = 'E';
+	out[1] = 'N';
+	out[2] = 'D';
+	out[3] = '\n';
+	shot.phase = SHOT_OFF;
+	n_shots++;
+	{
+		uint64_t ns;
+
+		absolutetime_to_nanoseconds(mach_absolute_time() - shot.start, &ns);
+		con("usb: %s %llu sent: %ux%u, %u bytes of pixels in %llu ms\n", shot.rgb ? "camshot" : "shot", n_shots, shot.w,
+		    shot.h, shot.sent, ns / NSEC_PER_MSEC);
+	}
+	return 4;
+}
+
+/* the console's "shot [N]": the panel's picture, every Nth pixel, queued behind what the log has already said */
+static void
+shot_begin(const char *arg)
+{
+	uint32_t n = 0;
+
+	for (; *arg >= '0' && *arg <= '9' && n < 1000; arg++) {
+		n = n * 10 + (uint32_t)(*arg - '0');
+	}
+	if (n == 0) {
+		n = 4;
+	}
+	if (n > 16 || *arg != 0) {
+		con("usb: shot failed: N is a number from 1 to 16 (shot 4: a quarter of the panel's width and height)\n");
+		return;
+	}
+	/*
+	 * With fb_dpp=1 the boot framebuffer is no longer shown (it keeps the boot logo): the buffer VGF0 scans out is the
+	 * presenter's, the display's own size (1125x2436), and the shot is of that; with fb_flip=1 the flip buffer shown.
+	 */
+	uintptr_t base = (uintptr_t)vinfo.v_baseaddr;
+	uint32_t width = vinfo.v_width, height = vinfo.v_height, rowbytes = vinfo.v_rowbytes;
+	unsigned index = 0;
+	int scanned = hakios_fb_scanned(&base, &width, &height, &rowbytes, &index);
+
+	if (scanned == 0 && (vinfo.v_baseaddr == 0 || vinfo.v_depth != 32)) {
+		con("usb: shot failed: no 32-bit panel framebuffer (%ux%u, depth %u)\n", vinfo.v_width, vinfo.v_height, vinfo.v_depth);
+		return;
+	}
+	if (width < n || height < n) {
+		con("usb: shot failed: a picture of %ux%u, smaller than every %uth pixel\n", width, height, n);
+		return;
+	}
+	if (!os_atomic_cmpxchg(&shot.phase, SHOT_OFF, SHOT_PREP, acq_rel)) {
+		con("usb: shot failed: one is on its way already\n");
+		return;
+	}
+	shot.rgb = false;
+	shot.n = n;
+	shot.w = width / n;
+	shot.h = height / n;
+	shot.rowbytes = rowbytes;
+	shot.base = base;
+	shot.sent = 0;
+	if (scanned != 0) {
+		con("usb: shot: %s buffer %u (%ux%u, %u bytes a row), every %uth pixel: %ux%u RGB, %u bytes, after this line\n",
+		    scanned == 2 ? "fb_dpp: VGF0's" : "fb_flip: the shown", index, width, height, rowbytes, n, shot.w, shot.h,
+		    shot.w * shot.h * 3);
+	} else {
+		con("usb: shot: the panel (%ux%u, %u bytes a row), every %uth pixel: %ux%u RGB, %u bytes, after this line\n",
+		    width, height, rowbytes, n, shot.w, shot.h, shot.w * shot.h * 3);
+	}
+	shot.mark = os_atomic_load(&ring_head, acquire);
+	os_atomic_store(&shot.phase, SHOT_LOG, release);
+}
+
+int hakios_usb_picture(uintptr_t rgb, uint32_t width, uint32_t height, const char *what);
+
+/*
+ * A picture someone else made, w x h RGB888 at rgb (the camera's camshot, from its own thread): sent as a shot is, after
+ * what the log has said so far. The memory must stay as it is until "camshot ... sent" (the camera takes no new picture
+ * before the console asks for one, and the console asks none while this one is on its way). 0: on its way.
+ */
+int
+hakios_usb_picture(uintptr_t rgb, uint32_t width, uint32_t height, const char *what)
+{
+	if (steps < 5 || acm.config == 0 || rgb == 0 || width == 0 || height == 0) {
+		return -1;
+	}
+	if (!os_atomic_cmpxchg(&shot.phase, SHOT_OFF, SHOT_PREP, acq_rel)) {
+		return -1;
+	}
+	shot.rgb = true;
+	shot.n = 1;
+	shot.w = width;
+	shot.h = height;
+	shot.rowbytes = width * 3;
+	shot.base = rgb;
+	shot.sent = 0;
+	con("usb: camshot: %s, %ux%u RGB, %u bytes, after this line\n", what, width, height, width * height * 3);
+	shot.mark = os_atomic_load(&ring_head, acquire);
+	os_atomic_store(&shot.phase, SHOT_LOG, release);
+	return 0;
+}
+
+const char *hakios_exynos_camera_shot(uint32_t n, int pattern);         /* hakios.exynos_camera.c (or the stub) */
+const char *hakios_exynos_iris_shot(uint32_t n);                         /* hakios.exynos_iris.c (or the stub) */
+
+/* the console's "irshot [N]": asked of the iris camera's thread, which sends the picture when it has one */
+static void
+irshot_begin(const char *arg)
+{
+	uint32_t n = 0;
+	const char *no;
+
+	for (; *arg >= '0' && *arg <= '9' && n < 1000; arg++) {
+		n = n * 10 + (uint32_t)(*arg - '0');
+	}
+	if (n == 0) {
+		n = 2;
+	}
+	if (n < 2 || n > 8 || *arg != 0) {
+		con("usb: irshot failed: irshot [N]: N from 2 to 8 (2: 1200 x 1200)\n");
+		return;
+	}
+	if (os_atomic_load(&shot.phase, acquire) != SHOT_OFF) {
+		con("usb: irshot failed: a picture is on its way already\n");
+		return;
+	}
+	no = hakios_exynos_iris_shot(n);
+	if (no != NULL) {
+		con("usb: irshot failed: %s\n", no);
+		return;
+	}
+	con("usb: irshot: asked of the iris camera (N = %u); its log, then the picture\n", n);
+}
+
+/* the console's "camshot [N] [tp]": asked of the camera's thread, which sends the picture when it has one */
+static void
+camshot_begin(const char *arg)
+{
+	uint32_t n = 0;
+	int pattern = 0;
+	const char *no;
+
+	for (; *arg >= '0' && *arg <= '9' && n < 1000; arg++) {
+		n = n * 10 + (uint32_t)(*arg - '0');
+	}
+	while (*arg == ' ') {
+		arg++;
+	}
+	if (strcmp(arg, "tp") == 0) {
+		pattern = 1;
+		arg += 2;
+	}
+	if (n == 0) {
+		n = 1;
+	}
+	if (n > 16 || *arg != 0) {
+		con("usb: camshot failed: camshot [N] [tp]: N from 1 to 16 (1: the whole 1632 x 1224, 2: 816 x 612), tp the test pattern\n");
+		return;
+	}
+	if (os_atomic_load(&shot.phase, acquire) != SHOT_OFF) {
+		con("usb: camshot failed: a picture is on its way already\n");
+		return;
+	}
+	no = hakios_exynos_camera_shot(n, pattern);
+	if (no != NULL) {
+		con("usb: camshot failed: %s\n", no);
+		return;
+	}
+	con("usb: camshot: asked of the camera (%s, N = %u); its log, then the picture\n",
+	    pattern ? "the test pattern" : "the sensor", n);
+}
+
+static void
+pump_in(void)
+{
+	uint32_t n = 0, lost;
+	int phase;
+
+	if (steps < 5 || acm.config == 0 || pep[PEP_IN].active || (acm.halted & 2)) {
+		return;
+	}
+	if (hold_log_until != 0) {
+		/*
+		 * A host that opens the port and closes it before reading would lose what was sent meanwhile, so the log waits
+		 * until the port has stayed open for 300 ms, or until the hold runs out. A reader that sets the port up (stty)
+		 * closes it again before it starts reading.
+		 */
+		uint64_t now = mach_absolute_time(), ns = 0;
+
+		if (acm.lines & 1) {
+			hold_open_at = hold_open_at != 0 ? hold_open_at : now;
+			absolutetime_to_nanoseconds(now - hold_open_at, &ns);
+		} else {
+			hold_open_at = 0;
+		}
+		if (ns < 300 * NSEC_PER_MSEC && now < hold_log_until) {
+			return;
+		}
+		hold_log_until = 0;
+		hold_open_at = 0;
+	}
+	phase = os_atomic_load(&shot.phase, acquire);    /* the camera's thread sets a camshot up (hakios_usb_picture) */
+	if (phase == SHOT_PREP) {
+		return;                 /* a picture being set up: the log waits for it */
+	}
+	if (phase != SHOT_OFF) {
+		n = shot_fill();
+		if (n != 0) {
+			(void)start_xfer(PEP_IN, dma_pa + IN_OFF, n, TRBCTL_NORMAL);
+		}
+		return;
+	}
+	lost = os_atomic_xchg(&ring_dropped, 0, relaxed);
+	if (lost != 0) {
+		n = (uint32_t)snprintf((char *)(uintptr_t)(dma + IN_OFF), 64, "\r\n[usb: %u bytes of the log lost]\r\n", lost);
+	}
+	uint32_t t = ring_tail, h = os_atomic_load(&ring_head, acquire);
+	while (t != h && n + 2 <= IN_CHUNK) {
+		char c = ring[t & (RING_SIZE - 1)];
+
+		if (c == '\n' && crlf) {
+			dma[IN_OFF + n++] = '\r';
+		}
+		dma[IN_OFF + n++] = (uint8_t)c;
+		t++;
+	}
+	os_atomic_store(&ring_tail, t, release);
+	if (n != 0) {
+		(void)start_xfer(PEP_IN, dma_pa + IN_OFF, n, TRBCTL_NORMAL);
+	}
+}
+
+static void console(char *line);
+
+static void
+bulk_complete(int p)
+{
+	volatile struct trb *t = trb_of(p);
+	uint32_t left = t->size & TRB_SIZE_MASK, done = pep[p].len > left ? pep[p].len - left : 0;
+
+	if (p == PEP_IN) {
+		n_in += done;
+		pump_in();
+	} else if (p == PEP_OUT) {
+		n_out += done;
+		for (uint32_t i = 0; i < done; i++) {
+			if (usbacm_line_feed(&cline, dma[OUT_OFF + i])) {
+				console(cline.line);
+			}
+		}
+		if (acm.config != 0 && !(acm.halted & 1)) {
+			(void)start_xfer(PEP_OUT, dma_pa + OUT_OFF, high_speed ? USBACM_HS_BULK : USBACM_FS_BULK, TRBCTL_NORMAL);
+		}
+	}
+}
+
+/* Device events. */
+
+/* the log waits, for a while, for the host to have the port open: see pump_in() */
+static void
+hold_log(void)
+{
+	uint64_t ns;
+
+	nanoseconds_to_absolutetime((uint64_t)HOLD_LOG_SECONDS * NSEC_PER_SEC, &ns);
+	hold_log_until = mach_absolute_time() + ns;
+	hold_open_at = 0;
+}
+
+static void
+on_reset(void)
+{
+	hold_log();
+	n_resets++;
+	last_heard = mach_absolute_time();
+	resets_no_setup++;
+	resets_no_config++;
+	if (say_resets > 0) {
+		say_resets--;
+		say("usb: bus reset %llu\n", n_resets);
+	}
+	bulk_down();
+	for (int p = 2; p < NPEPS; p++) {
+		if (p != 4) {
+			(void)depcmd(p, CMD_CLEARSTALL, 0, 0, 0, NULL);
+		}
+	}
+	wr(DCFG, rd(DCFG) & ~DCFG_DEVADDR_MASK);
+	usbacm_reset(&acm);
+	set_state("default");
+	if (ep0_state != EP0_SETUP) {
+		end_xfer(0);
+		end_xfer(1);
+		ep0_setup_start();
+	}
+}
+
+static void
+on_connect_done(void)
+{
+	uint32_t speed = rd(DSTS) & DSTS_CONNECTSPD;
+
+	high_speed = speed == 0;
+	acm.high_speed = high_speed;
+	connected = true;
+	usb_speed_v = (int)speed;
+	(void)ep_config(0, 0, USBACM_EP0_MPS, DEPCFG_ACTION_MODIFY, 0);
+	(void)ep_config(1, 0, USBACM_EP0_MPS, DEPCFG_ACTION_MODIFY, 0);
+	if (say_resets > 0 || n_resets % 100 == 0) {
+		say("usb: connected at %s speed (DSTS %08x)\n", speed == 0 ? "high" : speed == 4 ? "super (unexpected)" : "full", rd(DSTS));
+	}
+}
+
+static void
+events(void)
+{
+	uint32_t count = rd(GEVNTCOUNT) & GEVNTCOUNT_MASK;
+
+	while (count >= 4) {
+		uint32_t ev = *(volatile uint32_t *)(dma + EVT_OFF + ev_pos);
+
+		ev_pos = (ev_pos + 4) % EVT_SIZE;
+		count -= 4;
+		n_events++;
+		if (!(ev & 1)) {
+			int p = (int)((ev >> 1) & 0x1f);
+			uint32_t type = (ev >> 6) & 0xf, status = (ev >> 12) & 0xf;
+
+			if (p < NPEPS && type == DEPEVT_XFERCOMPLETE) {
+				pep[p].active = false;
+				if (p <= 1) {
+					ep0_complete(p);
+				} else {
+					bulk_complete(p);
+				}
+			} else if (p <= 1 && type == DEPEVT_XFERNOTREADY) {
+				ep0_notready(p, status & 3);
+			}
+		} else if (((ev >> 1) & 0x7f) == 0) {
+			switch ((ev >> 8) & 0xf) {
+			case DEVT_DISCONNECT:
+				say("usb: disconnected\n");
+				connected = false;
+				bulk_down();
+				usbacm_reset(&acm);
+				set_state("waiting");
+				break;
+			case DEVT_RESET:
+				on_reset();
+				break;
+			case DEVT_CONNECT_DONE:
+				on_connect_done();
+				break;
+			default:
+				break;
+			}
+		}
+		wr(GEVNTCOUNT, 4);
+	}
+}
+
+/* Line console. */
+
+static const char *
+errno_name(int error)
+{
+	switch (error) {
+	case ENOENT: return "ENOENT: no such name";
+	case EPERM: return "EPERM: not marked CTLFLAG_KERN, so the kernel may not reach it (user space may)";
+	case EISDIR: return "EISDIR: a node, not a value";
+	case EINVAL: return "EINVAL: the value was refused";
+	case EIO: return "EIO: the hardware did not take it";
+	case ENODEV: return "ENODEV: no driver behind it";
+	case ENOMEM: return "ENOMEM: longer than 256 bytes";
+	default: return "error";
+	}
+}
+
+/* sysctl NAME: read; sysctl NAME=N: an integer set, then read back */
+static void
+console_sysctl(char *arg)
+{
+	union { char s[256]; int32_t i; int64_t q; } v;
+	size_t len = sizeof(v.s);
+	bool text = true;
+	char *equals = strchr(arg, '=');
+	int error;
+
+	if (equals != NULL) {
+		const char *p = equals + 1;
+		bool negative = *p == '-';
+		int32_t value = 0;
+
+		*equals = 0;
+		p += negative ? 1 : 0;
+		if (*p < '0' || *p > '9') {
+			con("usb: sysctl %s=%s: an integer is wanted\n", arg, equals + 1);
+			return;
+		}
+		while (*p >= '0' && *p <= '9' && value < 100000000) {
+			value = value * 10 + (*p++ - '0');
+		}
+		value = negative ? -value : value;
+		error = kernel_sysctlbyname(arg, NULL, NULL, &value, sizeof(value));
+		con("usb: sysctl %s=%d: %s (%d)\n", arg, value, error == 0 ? "set" : errno_name(error), error);
+		if (error != 0) {
+			return;
+		}
+	}
+	memset(&v, 0, sizeof(v));
+	if ((error = kernel_sysctlbyname(arg, &v, &len, NULL, 0)) != 0) {
+		con("usb: sysctl %s: %s (%d)\n", arg, errno_name(error), error);
+		return;
+	}
+	for (size_t i = 0; i < len; i++) {
+		if (v.s[i] == 0 && i + 1 == len) {
+			break;
+		}
+		if (v.s[i] < 32 || v.s[i] > 126) {
+			text = false;
+		}
+	}
+	if (text && len > 0) {
+		v.s[MIN(len, sizeof(v.s) - 1)] = 0;
+		con("usb: %s = %s\n", arg, v.s);
+	} else if (len == 4) {
+		con("usb: %s = %d\n", arg, v.i);
+	} else if (len == 8) {
+		con("usb: %s = %lld\n", arg, v.q);
+	} else {
+		con("usb: %s: %zu bytes, not shown\n", arg, len);
+	}
+}
+
+/*
+ * swipe [l|r|u|d|lr|ud] [N] [MS] [GAP]: a finger drawn across the screen N times (default lr 6 250 1000: left, right,
+ * left ..., each stroke 250 ms, a second apart), posted to the touch queue as the touch screen's driver posts its
+ * events (hakios_touch_post(), one every 8 ms, the S6SY761's pace, with the governor's touch boost), so a run can be
+ * repeated without a finger. Strokes keep 20% from the edges: from the bottom edge
+ * one would go home. Left and right page the home screen; up and down scroll a list. On a thread of its own.
+ */
+#define SWIPE_STEP_MS   8
+static struct {
+	char pattern[3];
+	uint32_t count, ms, gap;
+} swipe_job;
+static volatile uint32_t swipe_running;
+
+static void
+swipe_stroke(char dir, uint32_t ms)
+{
+	uint32_t x0 = 32768, y0 = 32768, x1 = 32768, y1 = 32768, steps = ms / SWIPE_STEP_MS;
+
+	switch (dir) {
+	case 'l': x0 = 52428; x1 = 13107; break;       /* 80% to 20% of the width */
+	case 'r': x0 = 13107; x1 = 52428; break;
+	case 'u': y0 = 45875; y1 = 19660; break;       /* 70% to 30% of the height */
+	default: y0 = 19660; y1 = 45875; break;
+	}
+	steps = steps < 2 ? 2 : steps;
+	hakios_exynos_cpufreq_touch();
+	hakios_touch_post(HAKIOS_TOUCH_DOWN, 0, x0, y0);
+	for (uint32_t i = 1; i <= steps; i++) {
+		IOSleep(SWIPE_STEP_MS);
+		hakios_exynos_cpufreq_touch();
+		hakios_touch_post(HAKIOS_TOUCH_MOVE, 0, x0 + (uint32_t)(((int64_t)x1 - x0) * i / steps),
+		    y0 + (uint32_t)(((int64_t)y1 - y0) * i / steps));
+	}
+	IOSleep(SWIPE_STEP_MS);
+	hakios_touch_post(HAKIOS_TOUCH_UP, 0, x1, y1);
+}
+
+static void
+swipe_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	size_t kinds = strlen(swipe_job.pattern);
+	uint64_t ns;
+
+	for (uint32_t n = 0; n < swipe_job.count; n++) {
+		if (n > 0) {
+			IOSleep(swipe_job.gap);
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+		con("usb: swipe %u of %u: %c at %llu.%03llu s\n", n + 1, swipe_job.count, swipe_job.pattern[n % kinds],
+		    ns / NSEC_PER_SEC, (ns / NSEC_PER_MSEC) % 1000);
+		swipe_stroke(swipe_job.pattern[n % kinds], swipe_job.ms);
+	}
+	con("usb: swipe: done\n");
+	swipe_running = 0;
+}
+
+static uint32_t
+console_number(const char **arg, uint32_t otherwise, uint32_t least, uint32_t most)
+{
+	uint32_t n = 0;
+	bool any = false;
+
+	while (**arg == ' ') {
+		(*arg)++;
+	}
+	for (; **arg >= '0' && **arg <= '9' && n < 100000; (*arg)++) {
+		n = n * 10 + (uint32_t)(**arg - '0');
+		any = true;
+	}
+	return !any ? otherwise : n < least ? least : n > most ? most : n;
+}
+
+static void
+console_swipe(const char *arg)
+{
+	thread_t thread;
+	size_t k = 0;
+
+	if (swipe_running) {
+		con("usb: swipe: one is going on\n");
+		return;
+	}
+	while (*arg == ' ') {
+		arg++;
+	}
+	while (k < 2 && (*arg == 'l' || *arg == 'r' || *arg == 'u' || *arg == 'd')) {
+		swipe_job.pattern[k++] = *arg++;
+	}
+	swipe_job.pattern[k] = 0;
+	if (k == 0) {
+		strlcpy(swipe_job.pattern, "lr", sizeof(swipe_job.pattern));
+	}
+	swipe_job.count = console_number(&arg, 6, 1, 1000);
+	swipe_job.ms = console_number(&arg, 250, 16, 5000);
+	swipe_job.gap = console_number(&arg, 1000, 0, 60000);
+	con("usb: swipe %s: %u strokes of %u ms, %u ms apart\n", swipe_job.pattern, swipe_job.count, swipe_job.ms, swipe_job.gap);
+	swipe_running = 1;
+	if (kernel_thread_start(swipe_thread, NULL, &thread) != KERN_SUCCESS) {
+		swipe_running = 0;
+		con("usb: swipe: no thread\n");
+		return;
+	}
+	thread_deallocate(thread);
+}
+
+/* bl: the panel's brightness; bl N: set, straight to the panel driver (not through sysctl), and the answer */
+static void
+console_bl(const char *arg)
+{
+	int level = 0, error;
+	uint64_t t0, t1;
+
+	if (*arg == 0) {
+		console_sysctl((char *)(uintptr_t)"kern.hakios.brightness");
+		return;
+	}
+	if (*arg < '0' || *arg > '9') {
+		con("usb: bl %s: a level 0-255 is wanted\n", arg);
+		return;
+	}
+	while (*arg >= '0' && *arg <= '9' && level < 1000) {
+		level = level * 10 + (*arg++ - '0');
+	}
+	if (level > 255) {
+		con("usb: bl %d: 0-255\n", level);
+		return;
+	}
+	t0 = mach_absolute_time();
+	error = hakios_panel_brightness(level);
+	t1 = mach_absolute_time();
+	absolutetime_to_nanoseconds(t1 - t0, &t1);
+	con("usb: bl %d: %s (%d) in %llu us%s\n", level, error == 0 ? "sent: the panel driver took it and the DSIM took "
+	    "every packet" : errno_name(error), error, t1 / NSEC_PER_USEC, error == ENODEV ? " (panel=1 not given?)" : "");
+}
+
+/* what the link is doing, for the log; said before a restart too, so that a bad one leaves a trace */
+static void
+say_link(int (*out)(const char *, ...), const char *when)
+{
+	char st[120] = "";
+
+	if (glue->phy_state != NULL) {
+		glue->phy_state(st, sizeof(st));
+	}
+	out("usb: link %s: %s (%s); DCTL %08x DCFG %08x DSTS %08x DALEPENA %08x events %08x; ep0 state %d, OUT active %d (TRB %08x %08x), "
+	    "IN active %d (TRB %08x %08x); bulk IN active %d OUT active %d, config %u; %llu resets, %llu requests, %u/%u resets since a "
+	    "SETUP/a configuration; VBUS %d, stopped %d, %llu restarts\n", when, usb_state, st, rd(DCTL), rd(DCFG), rd(DSTS), rd(DALEPENA),
+	    rd(GEVNTCOUNT), ep0_state, pep[0].active, trb_of(0)->size, trb_of(0)->ctrl, pep[1].active, trb_of(1)->size, trb_of(1)->ctrl,
+	    pep[PEP_IN].active, pep[PEP_OUT].active, acm.config, n_resets, n_setups, resets_no_setup, resets_no_config, vbus_seen,
+	    link_stopped, n_restarts);
+}
+
+/* A printf-style logger that returns int, for say_link(). */
+static int
+con_say(const char *format, ...)
+{
+	char line[600];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	loader_log_line(line);
+	return 0;
+}
+
+/* usb, usb restart, usb drop MS, usb unplug MS, usb muic MS, usb watch on|off */
+static void
+console_usb(const char *arg)
+{
+	if (*arg == 0) {
+		say_link(con_say, "now");
+		hakios_max77705_usb_console("");
+	} else if (strcmp(arg, "restart") == 0) {
+		want_restart = true;            /* tick() does it, after this event */
+	} else if (strncmp(arg, "drop ", 5) == 0) {
+		const char *p = arg + 5;
+
+		want_drop_ms = console_number(&p, 3000, 1, 60000);
+	} else if (strcmp(arg, "watch off") == 0 || strcmp(arg, "watch on") == 0) {
+		watch_storms = arg[7] == 'n';
+		con("usb: the check for resets with no SETUP: %s\n", watch_storms ? "on" : "off");
+	} else if (strncmp(arg, "unplug ", 7) == 0 || strncmp(arg, "muic ", 5) == 0 || strncmp(arg, "vbus ", 5) == 0) {
+		hakios_max77705_usb_console(arg);
+	} else {
+		con("usb: usb [restart | drop MS | unplug MS | muic MS | vbus MS | watch on|off]\n");
+	}
+}
+
+static void
+console(char *line)
+{
+	char *arg = line;
+
+	while (*arg != 0 && *arg != ' ') {
+		arg++;
+	}
+	if (*arg == ' ') {
+		*arg++ = 0;
+		while (*arg == ' ') {
+			arg++;
+		}
+	}
+	con("usb> %s%s%s\n", line, *arg ? " " : "", arg);
+	if (strcmp(line, "help") == 0) {
+		con("usb: help, stat, uptime, sysctl NAME, sysctl NAME=N, bl (the panel's brightness), bl N (set it, 0-255), "
+		    "log (the kernel's log again from its start), shot [N] (the panel's picture, binary: tools/usb-shot.py), "
+		    "camshot [N] [tp] (the S9's front camera, cam_s9=6: tools/usb-shot.py --cam), "
+		    "irshot [N] (the S9's iris camera, iris_s9=5: tools/usb-shot.py --iris), "
+		    "ufs (the storage's ufs=3 summary), "
+		    "abox [tone [S] | rec [S] | r BLOCK OFF [N] | w BLOCK OFF VALUE | set NAME VALUE] (the S9's speaker path, abox=N; "
+		    "rec: S seconds of the codec's microphone, sent as a camshot's bytes), "
+		    "codec [power | r REG [N] | w REG VALUE] (the S9's audio codec, cs47l93=N), "
+		    "swipe [l|r|u|d|lr|ud] [N] [MS] [GAP] (a finger drawn across the screen N times, MS each, GAP apart; default "
+		    "lr 6 250 1000), "
+		    "sensors [on N | off N | fake X Y Z S | pins | retry ...] (the S9's sensor hub and its sensors' last samples, shub=N), "
+		    "wifi (the radio's log kept, and its driver's state now), wifi scan (a scan of every channel by the station, and "
+		    "the access points heard), bt (the S9's Bluetooth at bt=7: its state), bt scan (an inquiry and an LE scan: the devices "
+		    "heard), wifi ip (en0's address and gateway), wifi ping [A.B.C.D] [SIZE] (four echo requests; the "
+		    "gateway by default, 64 bytes), wifi dns NAME [A.B.C.D] (a DNS question; DHCP's server by default), wifi tcp HOST "
+		    "[PORT [PATH]] (a TCP connection and an HTTP GET, the bytes back), wifi stat (en0's frames by size and kind, IP, UDP "
+		    "and TCP counts), wifi names [off] (DNS questions and answers, TCP connections, as they come), touch X Y "
+		    "[X2 Y2 [MS]] (a tap or a swipe, in thousandths of the screen), button lock|home|up|down (a press), usb [restart | "
+		    "drop MS | unplug MS | muic MS | vbus MS | watch on|off] (the link and the cable), return (end the run)\n");
+	} else if (strcmp(line, "stat") == 0) {
+		con("usb: %s, %s speed, %llu resets, %llu requests (%llu stalled), %llu bytes sent, %llu received, %u lost, %llu events, "
+		    "%llu shots, %llu restarts\n", usb_state, high_speed ? "high" : "full", n_resets, n_setups, n_stalls, n_in, n_out,
+		    ring_dropped, n_events, n_shots, n_restarts);
+	} else if (strcmp(line, "usb") == 0) {
+		console_usb(arg);
+	} else if (strcmp(line, "uptime") == 0) {
+		uint64_t ns;
+
+		absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+		con("usb: up %llu.%03llu s\n", ns / NSEC_PER_SEC, (ns / NSEC_PER_MSEC) % 1000);
+	} else if (strcmp(line, "sysctl") == 0 && *arg != 0) {
+		console_sysctl(arg);
+	} else if (strcmp(line, "bl") == 0) {
+		console_bl(arg);
+	} else if (strcmp(line, "swipe") == 0) {
+		console_swipe(arg);
+	} else if (strcmp(line, "wifi") == 0 && strcmp(arg, "scan") == 0) {
+		hakios_sta_console_scan();
+	} else if (strcmp(line, "wifi") == 0 && strcmp(arg, "ip") == 0) {
+		hakios_net_console_ip();
+	} else if (strcmp(line, "wifi") == 0 && strncmp(arg, "ping", 4) == 0 && (arg[4] == 0 || arg[4] == ' ')) {
+		const char *to = arg + 4;
+
+		while (*to == ' ') {
+			to++;
+		}
+		hakios_net_console_ping(to);
+	} else if (strcmp(line, "wifi") == 0 && strncmp(arg, "dns", 3) == 0 && (arg[3] == 0 || arg[3] == ' ')) {
+		hakios_net_console_dns(arg + 3 + (arg[3] == ' '));
+	} else if (strcmp(line, "wifi") == 0 && strncmp(arg, "tcp", 3) == 0 && (arg[3] == 0 || arg[3] == ' ')) {
+		hakios_net_console_tcp(arg + 3 + (arg[3] == ' '));
+	} else if (strcmp(line, "wifi") == 0 && strcmp(arg, "stat") == 0) {
+		hakios_net_console_stat();
+	} else if (strcmp(line, "wifi") == 0 && strncmp(arg, "names", 5) == 0 && (arg[5] == 0 || arg[5] == ' ')) {
+		hakios_net_console_names(arg + 5 + (arg[5] == ' '));
+	} else if (strcmp(line, "wifi") == 0) {
+		hakios_wifi_report(false);
+	} else if (strcmp(line, "touch") == 0) {
+		hakios_input_console_touch(arg);
+	} else if (strcmp(line, "button") == 0) {
+		hakios_input_console_button(arg);
+	} else if (strcmp(line, "log") == 0) {
+		con("usb: the kernel's log from its start:\n");
+		(void)loader_log_tap_set(tap, history);
+		con("usb: (end of what the kernel keeps; the rest was sent as it came)\n");
+	} else if (strcmp(line, "shot") == 0) {
+		shot_begin(arg);
+	} else if (strcmp(line, "camshot") == 0) {
+		camshot_begin(arg);
+	} else if (strcmp(line, "irshot") == 0) {
+		irshot_begin(arg);
+	} else if (strcmp(line, "abox") == 0) {
+		hakios_abox_console(arg);
+	} else if (strcmp(line, "codec") == 0) {
+		hakios_cs47l93_console(arg);
+	} else if (strcmp(line, "sensors") == 0) {
+		hakios_ssp_console(arg);
+	} else if (strcmp(line, "bt") == 0) {
+		hakios_bt_console(arg);
+	} else if (strcmp(line, "ufs") == 0) {
+		hakios_ufs_summary("asked on the USB console", 1);
+	} else if (strcmp(line, "return") == 0) {
+		con("usb: ending the run: the loader will restart the phone\n");
+		want_return = true;     /* done by tick() once this event is handled and the controller let go */
+	} else {
+		con("usb: %s: not a command (help)\n", line);
+	}
+}
+
+/*
+ * The console's "return": what loader_return_timer() does before it returns, then the return. Not on the poll's thread:
+ * the save can wait for the storage, and the poll is what moves the log meanwhile.
+ */
+static void
+end_the_run(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	hakios_var_save_on_return();
+	hakios_adreno_stop();
+	hakios_wifi_stop();
+	hakios_adsp_stop();
+	loader_return();
+}
+
+/* from the poll, once the console has asked: start the end of the run, or force it when it has not come */
+static void
+return_check(void)
+{
+	uint64_t now = mach_absolute_time(), ns;
+
+	if (return_asked_at == 0) {
+		return_asked_at = now;
+		if (return_call != NULL) {
+			thread_call_enter(return_call);
+		} else {
+			end_the_run(NULL, NULL);
+		}
+		return;
+	}
+	absolutetime_to_nanoseconds(now - return_asked_at, &ns);
+	if (ns >= (uint64_t)RETURN_FORCE_SECONDS * NSEC_PER_SEC) {
+		say("usb: the run has not ended %u s after \"return\" (the data volume's save or a driver's stop is waiting): "
+		    "back to the loader without them\n", RETURN_FORCE_SECONDS);
+		loader_return();
+	}
+}
+
+/* Bring-up. */
+
+static void
+say_dwc3(const char *when)
+{
+	say("usb: DWC3 %s: GSNPSID %08x GCTL %08x GSTS %08x GUSB2PHYCFG %08x GUSB3PIPECTL %08x GHWPARAMS0/1/3 %08x %08x %08x\n", when,
+	    rd(GSNPSID), rd(GCTL), rd(GSTS), rd(GUSB2PHYCFG), rd(GUSB3PIPECTL), rd(GHWPARAMS0), rd(GHWPARAMS1), rd(GHWPARAMS3));
+	say("usb: DWC3 %s: DCFG %08x DCTL %08x (RUN_STOP %u) DSTS %08x (link state %u, halted %u) DEVTEN %08x event buffer %08x%08x size %08x count %08x\n",
+	    when, rd(DCFG), rd(DCTL), (rd(DCTL) & DCTL_RUN_STOP) ? 1 : 0, rd(DSTS), DSTS_USBLNKST(rd(DSTS)),
+	    (rd(DSTS) & DSTS_DEVCTRLHLT) ? 1 : 0, rd(DEVTEN), rd(GEVNTADRHI), rd(GEVNTADRLO), rd(GEVNTSIZ), rd(GEVNTCOUNT));
+}
+
+/* the controller stopped: pull-up off, then its events masked (gadget.c dwc3_gadget_run_stop(, 0), 1733-1800) */
+static bool
+stop_controller(void)
+{
+	wr(DCTL, rd(DCTL) & ~DCTL_RUN_STOP);
+	for (int i = 0; i < 100; i++) {
+		uint32_t pending = rd(GEVNTCOUNT) & GEVNTCOUNT_MASK;
+
+		if (rd(DSTS) & DSTS_DEVCTRLHLT) {
+			break;
+		}
+		if (pending != 0) {
+			wr(GEVNTCOUNT, pending);        /* the controller does not halt with events waiting to be taken */
+			ev_pos = (ev_pos + pending) % EVT_SIZE;
+		}
+		delay(1000);
+	}
+	wr(GEVNTSIZ, GEVNTSIZ_INTMASK | rd(GEVNTSIZ));
+	return (rd(DSTS) & DSTS_DEVCTRLHLT) != 0;
+}
+
+static int
+dma_alloc(void)
+{
+	vm_offset_t va = 0;
+	/* Any address: the 9810's DWC3 takes 64-bit TRB and event-buffer pointers, and RAM sits above 4 GB
+	 * (0x880000000 seen on the S9). */
+
+	if (kmem_alloc_contig(kernel_map, &va, round_page(DMA_SIZE), PAGE_MASK, 0, 0,
+	    KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	FlushPoC_DcacheRegion(va, round_page(DMA_SIZE));
+	dma_pa = kvtophys(va);
+	dma = (volatile uint8_t *)ml_io_map_unmappable((vm_offset_t)dma_pa, round_page(DMA_SIZE), VM_WIMG_WCOMB);
+	if (dma == NULL) {
+		return ENOMEM;
+	}
+	for (uint32_t i = 0; i < DMA_SIZE; i += 4) {
+		*(volatile uint32_t *)(dma + i) = 0;
+	}
+	return 0;
+}
+
+/* step 3: the core reset and set up as a device, the pull-up still off */
+static int
+core_init(void)
+{
+	uint32_t id = rd(GSNPSID), v;
+	int us;
+
+	if ((id & 0xffff0000u) != 0x55330000u && (id & 0xffff0000u) != 0x33310000u) {
+		say("usb: 3: GSNPSID %08x is not a DWC3's: stopping\n", id);
+		return ENODEV;
+	}
+	say("usb: 3: device soft reset (DCTL CSFTRST)\n");
+	wr(DCTL, DCTL_CSFTRST);
+	for (us = 0; us < 500000 && (rd(DCTL) & DCTL_CSFTRST); us += 10) {
+		delay(10);
+	}
+	if (rd(DCTL) & DCTL_CSFTRST) {
+		say("usb: 3: the soft reset did not finish in 500 ms (DCTL %08x): the PHY's clock is not there? stopping\n", rd(DCTL));
+		return ETIMEDOUT;
+	}
+	say("usb: 3: reset done in %d us\n", us);
+
+	/* the 2.0 PHY interface: dwc3_phy_setup (core.c:637-765); the dt's snps,dis-u2-freeclk-exists-quirk (core.c:761) */
+	v = rd(GUSB2PHYCFG) & ~(GUSB2_U2_FREECLK_EXISTS | GUSB2_ENBLSLPM | GUSB2_SUSPHY);
+	if (susphy) {
+		v |= GUSB2_SUSPHY;
+	}
+	wr(GUSB2PHYCFG, v);
+
+	/* GCTL: device mode; SOFITPSYNC for the same quirk (core.c:921) */
+	v = rd(GCTL) & ~(GCTL_SCALEDOWN_MASK | GCTL_PRTCAPDIR_MASK);
+	wr(GCTL, v | GCTL_PRTCAP_DEVICE | GCTL_SOFITPSYNC);
+
+	/* the bus: dwc3_core_config (core.c:140-186) */
+	v = rd(GSBUSCFG0) | GSBUSCFG0_INCRBRSTEN | GSBUSCFG0_INCR16BRSTEN;
+	if ((id & 0xffff0000u) == 0x33310000u || id >= 0x5533220au) {
+		v |= GSBUSCFG0_REQINFO;
+	}
+	wr(GSBUSCFG0, v);
+	wr(GSBUSCFG1, rd(GSBUSCFG1) | GSBUSCFG1_BREQLIMIT(3));
+	wr(GUCTL, (rd(GUCTL) & ~GUCTL_REFCLKPER_MASK) | GUCTL_USBHSTINAUTORETRYEN | GUCTL_REFCLKPER(0x14));
+
+	/* the event buffer (core.c dwc3_event_buffers_setup, 476-495) */
+	ev_pos = 0;
+	wr(GEVNTADRLO, (uint32_t)(dma_pa + EVT_OFF));
+	wr(GEVNTADRHI, (uint32_t)((dma_pa + EVT_OFF) >> 32));
+	wr(GEVNTSIZ, EVT_SIZE);
+	wr(GEVNTCOUNT, 0);
+
+	/* DCFG: the speed, address 0, no LPM (bcdUSB 2.00) */
+	v = rd(DCFG) & ~(DCFG_SPEED_MASK | DCFG_DEVADDR_MASK | DCFG_LPM_CAP);
+	wr(DCFG, v | (full_speed ? DCFG_FULLSPEED : DCFG_HIGHSPEED));
+	wr(DEVTEN, DEVTEN_DISCONNEVTEN | DEVTEN_USBRSTEN | DEVTEN_CONNECTDONEEN | DEVTEN_ULSTCNGEN);
+
+	/* endpoint 0 (gadget.c __dwc3_gadget_ep_enable -> dwc3_gadget_start_config, 533-562) */
+	if (depcmd(0, CMD_DEPSTARTCFG, 0, 0, 0, NULL) != 0) {
+		return EIO;
+	}
+	for (int p = 0; p < NPEPS; p++) {
+		if (depcmd(p, CMD_SETTRANSFRESOURCE, DEPXFERCFG_NUM_XFER_RES(1), 0, 0, NULL) != 0) {
+			return EIO;
+		}
+	}
+	if (ep_config(0, 0, USBACM_EP0_MPS, DEPCFG_ACTION_INIT, 0) != 0 || ep_config(1, 0, USBACM_EP0_MPS, DEPCFG_ACTION_INIT, 0) != 0) {
+		return EIO;
+	}
+	wr(DALEPENA, 3);
+	usbacm_init(&acm);
+	ep0_setup_start();
+	if (ep0_state != EP0_SETUP) {
+		return EIO;
+	}
+	say_dwc3("set up");
+	return 0;
+}
+
+static int
+run(void)
+{
+	uint32_t v = rd(DCTL) & ~(DCTL_KEEP_CONNECT | DCTL_U1U2_MASK);
+
+	wr(DCTL, v | DCTL_RUN_STOP);
+	for (int i = 0; i < 100; i++) {
+		if (!(rd(DSTS) & DSTS_DEVCTRLHLT)) {
+			return 0;
+		}
+		delay(1000);
+	}
+	say("usb: 4: still halted 100 ms after RUN_STOP (DSTS %08x)\n", rd(DSTS));
+	return ETIMEDOUT;
+}
+
+static bool
+bring_up(void)
+{
+	int e;
+
+	say("usb: steps 1-%u (1 look, 2 PHY, 3 core, 4 enumerate, 5 log and console) on %s's glue\n", steps, glue->name);
+	say("usb: 1: reading what the boot left\n");
+	bool readable = glue->look(say, glue_flags);
+	regs = ml_io_map((vm_offset_t)glue->dwc3_pa, glue->dwc3_size);
+	if (regs == 0) {
+		say("usb: could not map the DWC3 at %#llx; off\n", glue->dwc3_pa);
+		return false;
+	}
+	if (readable) {
+		say_dwc3("as the boot left it");
+	}
+	stage = 1;
+	if (steps < 2) {
+		return false;
+	}
+
+	if (readable && (rd(DCTL) & DCTL_RUN_STOP)) {
+		say("usb: 2: the controller was left running (DCTL %08x): stopping it first\n", rd(DCTL));
+		say("usb: 2: %s\n", stop_controller() ? "halted" : "NOT halted after 100 ms; going on");
+	}
+	say("usb: 2: the PHY (%s)\n", glue->name);
+	if ((e = glue->phy_on(say, glue_flags)) != 0) {
+		say("usb: 2: the PHY did not come up (%d); off\n", e);
+		return false;
+	}
+	stage = 2;
+	set_state("phy");
+	if (steps < 3) {
+		return false;
+	}
+
+	say("usb: 3: memory for the controller (32 KB, uncached)\n");
+	if (dma_alloc() != 0) {
+		say("usb: 3: no memory for the controller; off\n");
+		return false;
+	}
+	say("usb: 3: at %#llx; resetting the core and setting it up as a device (%s speed), pull-up off\n", dma_pa,
+	    full_speed ? "full" : "high");
+	if ((e = core_init()) != 0) {
+		say("usb: 3: failed (%d); off\n", e);
+		return false;
+	}
+	stage = 3;
+	set_state("core");
+	if (steps < 4) {
+		return false;
+	}
+
+	if (steps >= 5) {
+		ring = kalloc_data(RING_SIZE, Z_WAITOK | Z_ZERO);
+		if (ring == NULL) {
+			say("usb: 5: no memory for the log's ring; going on without it (step 4)\n");
+			steps = 4;
+		} else {
+			say("usb: 5: the kernel's log goes out on bulk IN from its first line; lines from the host to the console\n");
+			(void)loader_log_tap_set(tap, history);
+		}
+	}
+	say("usb: 4: pull-up on (DCTL RUN_STOP): a host should see %04x:%04x \"%s\"\n", USBACM_VID, USBACM_PID, "HakiOS kernel log and console");
+	if (run() != 0) {
+		return false;
+	}
+	stage = steps >= 5 ? 5 : 4;
+	set_state("waiting");
+	return true;
+}
+
+static int
+say_nothing(__unused const char *format, ...)
+{
+	return 0;
+}
+
+/* Take the link down: controller stopped, transfers ended, a picture being sent dropped. */
+static void
+link_down(void)
+{
+	int phase = os_atomic_load(&shot.phase, acquire);
+
+	for (int p = 0; p < NPEPS; p++) {
+		if (p != 4) {
+			end_xfer(p);
+		}
+	}
+	(void)stop_controller();
+	if (phase != SHOT_OFF && phase != SHOT_PREP) {
+		os_atomic_store(&shot.phase, SHOT_OFF, release);
+	}
+	connected = false;
+	usbacm_reset(&acm);
+	memset(&cline, 0, sizeof(cline));
+}
+
+/*
+ * The link up again as from the start of the run (the steps' 2, 3 and 4), in the memory it already has: what Android does
+ * on every attach (dwc3/otg.c dwc3_otg_start_gadget: dwc3_phy_setup, dwc3_core_init, the pull-up). false: it stays down, for
+ * the next try.
+ */
+static bool
+link_restart(const char *why)
+{
+	uint64_t ns;
+	bool ok = false;
+	int e;
+
+	n_restarts++;
+	say_link(say, why);
+	say("usb: restarting the link (%llu; %s)\n", n_restarts, why);
+	link_down();
+	if ((e = glue->phy_on(say_nothing, glue_flags)) != 0) {
+		say("usb: the PHY did not come back (%d)\n", e);
+		goto out;
+	}
+	for (uint32_t i = 0; i < EVT_SIZE + 0x1000u; i += 4) {
+		*(volatile uint32_t *)(dma + i) = 0;    /* the event buffer and the TRBs */
+	}
+	memset(pep, 0, sizeof(pep));
+	if ((e = core_init()) != 0) {
+		say("usb: the core did not come back (%d)\n", e);
+		goto out;
+	}
+	if (run() != 0) {
+		goto out;
+	}
+	ok = true;
+out:
+	link_stopped = false;
+	resets_no_setup = ok ? 0 : STORM_NO_SETUP;      /* a failed one is tried again by the check for storms */
+	resets_no_config = 0;
+	say_resets = 16;
+	say_setups = 16;
+	last_phy_say = 0;
+	set_state(ok ? "waiting" : "stuck");
+	nanoseconds_to_absolutetime((uint64_t)restart_wait * NSEC_PER_SEC, &ns);
+	restart_after = mach_absolute_time() + ns;
+	hold_log();
+	last_heard = mach_absolute_time();
+	restart_wait = restart_wait * 2 > RESTART_WAIT_MOST ? RESTART_WAIT_MOST : restart_wait * 2;
+	return ok;
+}
+
+/* from hakios.max77705.c, every read of VBUS (a low only when it has stayed low): the poll does what follows from it */
+void
+hakios_usb_gadget_vbus(bool present)
+{
+	os_atomic_store(&vbus_heard_at, mach_absolute_time(), relaxed);
+	os_atomic_store(&vbus_report, present ? 1 : 0, release);
+}
+
+/* From the cable and the link's state, decide whether to stop or restart the link. Runs in the poll. */
+static void
+link_watch(void)
+{
+	int vbus = os_atomic_load(&vbus_report, acquire);
+	uint64_t now = mach_absolute_time(), ns;
+	uint32_t sof = link_stopped ? last_sof : (rd(DSTS) >> 3) & 0x3fffu;     /* [16:3], SOFFN */
+
+	if (vbus != VBUS_UNKNOWN && vbus != vbus_seen) {
+		int was = vbus_seen;
+
+		vbus_seen = vbus;
+		if (vbus == 0 && was == 1) {
+			say("usb: VBUS gone: the cable is out; the link down until it is back, the log kept\n");
+			say_link(say, "at the unplug");
+			link_down();
+			if (glue->phy_off != NULL) {
+				glue->phy_off();
+			}
+			link_stopped = true;
+			set_state("unplugged");
+			return;
+		}
+		if (vbus == 1 && was == 0) {
+			say("usb: VBUS back: a cable in\n");
+			quiet_restarts = 0;
+			if (link_stopped || acm.config == 0) {
+				restart_wait = RESTART_WAIT_FIRST;
+				(void)link_restart("VBUS back");
+				return;
+			}
+		}
+	}
+	if (want_restart) {
+		want_restart = false;
+		(void)link_restart("asked on the console");
+		return;
+	}
+	if (want_drop_ms != 0) {
+		uint32_t ms = want_drop_ms;
+
+		want_drop_ms = 0;
+		say("usb: the pull-up off for %u ms\n", ms);
+		wr(DCTL, rd(DCTL) & ~DCTL_RUN_STOP);
+		IOSleep(ms);
+		wr(DCTL, rd(DCTL) | DCTL_RUN_STOP);
+		say("usb: the pull-up on again\n");
+		return;
+	}
+	if (link_stopped) {
+		absolutetime_to_nanoseconds(now - os_atomic_load(&vbus_heard_at, relaxed), &ns);
+		if (ns > (uint64_t)VBUS_SILENT_SECONDS * NSEC_PER_SEC) {
+			(void)link_restart("nothing heard of VBUS");
+		}
+		return;
+	}
+	if (watch_storms && (resets_no_setup >= STORM_NO_SETUP || resets_no_config >= STORM_NO_CONFIG) && now >= restart_after) {
+		(void)link_restart(resets_no_setup >= STORM_NO_SETUP ? "bus resets, no SETUP" : "bus resets, no configuration");
+		return;
+	}
+	if (sof != last_sof || last_heard == 0) {
+		last_sof = sof;
+		last_heard = now;
+	}
+	if (watch_storms && vbus_seen == 1 && quiet_restarts < QUIET_RESTARTS && now >= restart_after) {
+		absolutetime_to_nanoseconds(now - last_heard, &ns);
+		if (ns > (uint64_t)QUIET_SECONDS * NSEC_PER_SEC) {
+			quiet_restarts++;
+			hakios_max77705_usb_close();
+			(void)link_restart("VBUS there, no host talking");
+		}
+	}
+}
+
+static void
+tick(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	uint64_t deadline;
+
+	if (!os_atomic_cmpxchg(&busy, 0, 1, acquire)) {
+		goto again;
+	}
+	if (!started) {
+		started = true;
+		if (!bring_up()) {
+			os_atomic_store(&busy, 0, release);
+			return;
+		}
+	}
+	if (stage >= 4) {
+		link_watch();
+	}
+	if (!link_stopped) {
+		events();
+		pump_in();
+	}
+	if (!connected && !link_stopped && glue->phy_state != NULL) {
+		uint64_t now = mach_absolute_time(), ns;
+
+		absolutetime_to_nanoseconds(now - last_phy_say, &ns);
+		if (last_phy_say == 0 || ns > 10 * NSEC_PER_SEC) {
+			char st[120];
+
+			glue->phy_state(st, sizeof(st));
+			say("usb: waiting for a host: %s; DSTS %08x\n", st, rd(DSTS));
+			last_phy_say = now;
+		}
+	}
+	os_atomic_store(&busy, 0, release);
+	if (want_wifi_report) {
+		want_wifi_report = false;
+		hakios_wifi_report(true);
+	}
+	if (want_return) {
+		return_check();
+	}
+again:
+	clock_interval_to_deadline(connected ? poll_ms : 20, NSEC_PER_MSEC, &deadline);
+	thread_call_enter_delayed(call, deadline);
+}
+
+/*
+ * On the way back to the loader (loader_return(), the other processors already stopped, the panic text appended): what
+ * is left of the log sent while the host takes it, for up to usb_gadget_drain ms; then the pull-up off, the events
+ * masked, the PHY powered down. Nothing of this kernel's memory is used by the controller after it.
+ */
+void
+hakios_usb_gadget_quiesce(void)
+{
+	if (stage < 3 || regs == 0) {
+		return;
+	}
+	for (int i = 0; i < 1000 && !os_atomic_cmpxchg(&busy, 0, 1, acquire); i++) {
+		delay(100);     /* the poll is mid-way; after 100 ms it is taken to be gone with its processor */
+	}
+	hold_log_until = 0;
+	if (stage >= 5 && acm.config != 0) {
+		for (uint32_t ms = 0; ms < drain_ms; ms++) {
+			events();
+			pump_in();
+			if (!pep[PEP_IN].active && os_atomic_load(&ring_head, acquire) == ring_tail) {
+				break;
+			}
+			delay(1000);
+		}
+	}
+	(void)loader_log_tap_set(NULL, NULL);
+	bulk_down();
+	(void)stop_controller();
+	if (glue->phy_off != NULL) {
+		glue->phy_off();
+	}
+	stage = 0;
+}
+
+__startup_func
+static void
+usb_gadget_init(void)
+{
+	char soc[32] = "exynos9810";
+	uint32_t value = 0;
+
+	if (!PE_parse_boot_argn("usb_gadget", &steps, sizeof(steps)) || steps == 0) {
+		return;
+	}
+	steps = steps > 5 ? 5 : steps;
+	(void)PE_parse_boot_argn("usb_gadget_soc", soc, sizeof(soc));
+	if (PE_parse_boot_argn("usb_gadget_clk", &value, sizeof(value)) && value) {
+		glue_flags |= USB_GLUE_CLK;
+	}
+	if (PE_parse_boot_argn("usb_gadget_ldo", &value, sizeof(value)) && value) {
+		glue_flags |= USB_GLUE_LDO;
+	}
+	(void)PE_parse_boot_argn("usb_gadget_fs", &full_speed, sizeof(full_speed));
+	(void)PE_parse_boot_argn("usb_gadget_susphy", &susphy, sizeof(susphy));
+	(void)PE_parse_boot_argn("usb_gadget_crlf", &crlf, sizeof(crlf));
+	if (PE_parse_boot_argn("usb_gadget_poll", &value, sizeof(value)) && value >= 1 && value <= 50) {
+		poll_ms = value;
+	}
+	if (PE_parse_boot_argn("usb_gadget_drain", &value, sizeof(value)) && value <= 5000) {
+		drain_ms = value;
+	}
+	if (strcmp(soc, "exynos9810") == 0) {
+		glue = hakios_usb_glue_exynos9810();
+	}
+	if (glue == NULL) {
+		say("usb: usb_gadget=%u, but no glue for \"%s\" in this kernel; off\n", steps, soc);
+		return;
+	}
+	/*
+	 * The poll uses the kernel-high group, not the group thread_call_allocate() gives ("high"). That group runs its calls
+	 * one at a time (thread_call.c: TCG_NONE), and most drivers' periodic calls are in it, so a long one there would hold
+	 * up the console and the log. kernel-high holds the IOKit timers that ask for it and little else. The end of the run
+	 * goes to the "high" group, where the timed return (loader_return_after=) runs it; if it waits there, the poll can
+	 * force the return (return_check).
+	 */
+	call = thread_call_allocate_with_priority(tick, NULL, THREAD_CALL_PRIORITY_KERNEL_HIGH);
+	return_call = thread_call_allocate(end_the_run, NULL);
+	thread_call_enter(call);
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, usb_gadget_init);
diff --git a/bsd/dev/hakios.exynos_hsi2c.c b/bsd/dev/hakios.exynos_hsi2c.c
new file mode 100644
index 000000000..a6ff7c8a6
--- /dev/null
+++ b/bsd/dev/hakios.exynos_hsi2c.c
@@ -0,0 +1,251 @@
+/*
+ * Exynos HSI2C: the I2C master of a USI block. sys/hakios.exynos_hsi2c.h says how a driver describes its bus.
+ *
+ * UEFI sets up none of this, so before the first transfer: force the block's clock gates on and enable its Q-channel
+ * (in its CMU), make the USI block an I2C (mode word 4), set its pins to their function, reset the controller, clear
+ * USI_CON (its reset value holds the block in reset), then set the timing for the bus speed, master and auto mode.
+ *
+ * A message: FIFO triggers, master with the channel on, the target's address, the length (read, STOP) in AUTO_CONF, RUN.
+ * Done when INT_STAT says so and the transmit FIFO is empty, or when all bytes are in. Abort, no ack, no device and
+ * time-out (INT_STAT bits 8-11) reset the bus.
+ *
+ * Sources: i2c-exynos5.c and soc/samsung/usi_v2.c of Samsung's GPL kernel and the 9810's CMU tables (read for these facts,
+ * not copied); the WoA port for the S9+ (github.com/ntdevlabs/exynos9810-woa).
+ */
+#include <kern/clock.h>
+#include <libkern/libkern.h>
+#include <mach/mach_time.h>
+#include <mach/mach_types.h>
+#include <sys/hakios.exynos_hsi2c.h>
+#include <sys/hakios.xnu.h>
+
+
+#define CTL                     0x00
+#define  CTL_MASTER             (1u << 3)
+#define  CTL_RXCHON             (1u << 6)
+#define  CTL_TXCHON             (1u << 7)
+#define  CTL_SW_RST             (1u << 31)
+#define FIFO_CTL                0x04
+#define TRAILING                0x08
+#define INT_EN                  0x20
+#define INT_STAT                0x24
+#define  INT_DONE               (1u << 7)
+#define  INT_ERRORS             (0xfu << 8)
+#define FIFO_STAT               0x30
+#define  TX_FULL                (1u << 7)
+#define  TX_EMPTY               (1u << 8)
+#define  RX_EMPTY               (1u << 24)
+#define TX_DATA                 0x34
+#define RX_DATA                 0x38
+#define CONF                    0x40
+#define  CONF_AUTO              (1u << 31)
+#define AUTO_CONF               0x44
+#define  AUTO_READ              (1u << 16)
+#define  AUTO_STOP              (1u << 17)
+#define  AUTO_RUN               (1u << 31)
+#define TIMEOUT                 0x48
+#define TRANS_STATUS            0x50
+#define  MASTER_BUSY            (1u << 17)
+#define TIMING_FS1              0x60
+#define TIMING_FS2              0x64
+#define TIMING_FS3              0x68
+#define ADDR                    0x70
+#define USI_CON                 0xC4
+
+#define CMU_GATE_MANUAL         (1u << 20)
+#define CMU_GATE_ON             (1u << 21)
+#define USI_MODE_I2C            0x4
+
+/* a moment `us` microseconds from now, by the clock: a loop bounded by it spins, where delay() would sleep a tick */
+static uint64_t
+deadline_us(uint64_t us)
+{
+	uint64_t interval;
+
+	nanoseconds_to_absolutetime(us * NSEC_PER_USEC, &interval);
+	return mach_absolute_time() + interval;
+}
+
+static inline uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static inline void
+wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+}
+
+/* a register of its own page, wherever in it */
+static vm_offset_t
+map_word(uint64_t pa)
+{
+	vm_offset_t page = ml_io_map(pa & ~0xfffULL, 0x1000);
+
+	return page ? page + (pa & 0xfff) : 0;
+}
+
+bool
+hakios_hsi2c_map(struct hakios_hsi2c *bus, int (*say)(const char *, ...))
+{
+	bus->regs = ml_io_map(bus->regs_pa, 0x1000);
+	bus->usi = map_word(bus->usi_mode_pa);
+	bus->cmu = bus->cmu_pa ? ml_io_map(bus->cmu_pa, bus->cmu_size) : 0;
+	bus->pins = bus->pins_pa ? map_word(bus->pins_pa) : 0;
+	if (!bus->regs || !bus->usi || (bus->cmu_pa && !bus->cmu) || (bus->pins_pa && !bus->pins)) {
+		say("%s: a block of the bus could not be mapped\n", bus->name);
+		return false;
+	}
+	if (bus->cmu) {
+		uint32_t div = rd(bus->cmu, bus->div);
+
+		say("%s: USI mode %x (4 is I2C), CMU mux %x, divider %x (400 MHz / %u = %u MHz if the mux takes the 400 MHz "
+		    "branch; assumed %u), gates %x %x %x %x, Q-channel %x\n", bus->name, *(volatile uint32_t *)bus->usi,
+		    rd(bus->cmu, bus->mux), div, (div & 0xf) + 1, 400 / ((div & 0xf) + 1), bus->ipclk_mhz,
+		    bus->ngates > 0 ? rd(bus->cmu, bus->gates[0]) : 0, bus->ngates > 1 ? rd(bus->cmu, bus->gates[1]) : 0,
+		    bus->ngates > 2 ? rd(bus->cmu, bus->gates[2]) : 0, bus->ngates > 3 ? rd(bus->cmu, bus->gates[3]) : 0,
+		    bus->qch ? rd(bus->cmu, bus->qch) : 0);
+	}
+	if (bus->pins) {
+		say("%s: the pins' CON %x (function 2 is I2C)\n", bus->name, *(volatile uint32_t *)bus->pins);
+	}
+	return true;
+}
+
+void
+hakios_hsi2c_power(struct hakios_hsi2c *bus)
+{
+	for (uint32_t i = 0; bus->cmu && i < bus->ngates; i++) {
+		wr(bus->cmu, bus->gates[i], rd(bus->cmu, bus->gates[i]) | CMU_GATE_MANUAL | CMU_GATE_ON);
+	}
+	if (bus->cmu && bus->qch) {
+		wr(bus->cmu, bus->qch, rd(bus->cmu, bus->qch) | 3);
+	}
+	*(volatile uint32_t *)bus->usi = USI_MODE_I2C;
+	if (bus->pins) {
+		uint32_t con = *(volatile uint32_t *)bus->pins;
+
+		if ((con & bus->pins_mask) != bus->pins_want) {
+			*(volatile uint32_t *)bus->pins = (con & ~bus->pins_mask) | bus->pins_want;
+		}
+		/* no pull on the two pins (PUD at +8, the same 4-bit fields as CON): the device tree's pin-pud = <0> */
+		*(volatile uint32_t *)(bus->pins + 8) &= ~bus->pins_mask;
+	}
+}
+
+/*
+ * The bus speed from the input clock, the way both other drivers work it out: the divider for 15 clocks of the input
+ * per bit, then the high time and the start's hold as masks of n bits (n at most 7).
+ */
+static void
+bus_timing(struct hakios_hsi2c *bus)
+{
+	uint32_t div = bus->ipclk_mhz * 1000000 / (bus->bus_hz * 15);
+	uint32_t n = (9 * bus->ipclk_mhz) / ((div + 1) * 10);
+
+	if (n > 7) {
+		n = 7;
+	}
+	uint32_t scl_h = (0xFFFFFFFFu >> n << n) & 0xff;
+	uint32_t m = n ? n - 1 : 0;
+	uint32_t start_hd = (0xFFFFFFFFu >> m << m) & 0xff;
+
+	wr(bus->regs, TIMING_FS3, (rd(bus->regs, TIMING_FS3) & ~(0xffu << 16)) | (div & 0xff) << 16);
+	wr(bus->regs, TIMING_FS2, (rd(bus->regs, TIMING_FS2) & ~0xffu) | scl_h);
+	wr(bus->regs, TIMING_FS1, (rd(bus->regs, TIMING_FS1) & ~(0xffu << 16)) | start_hd << 16);
+}
+
+void
+hakios_hsi2c_reset(struct hakios_hsi2c *bus)
+{
+	vm_offset_t r = bus->regs;
+
+	wr(r, USI_CON, 0);
+	wr(r, INT_STAT, rd(r, INT_STAT));
+	wr(r, CTL, rd(r, CTL) | CTL_SW_RST);
+	delay(10);
+	wr(r, CTL, rd(r, CTL) & ~CTL_SW_RST);
+	bus_timing(bus);
+	wr(r, CTL, CTL_MASTER);
+	wr(r, TRAILING, 0xffffff);
+	wr(r, TIMEOUT, rd(r, TIMEOUT) & ~(1u << 31));
+	wr(r, CONF, rd(r, CONF) | CONF_AUTO);
+}
+
+uint32_t
+hakios_hsi2c_message(struct hakios_hsi2c *bus, uint8_t addr, bool reading, uint8_t *buf, uint32_t len, bool stop)
+{
+	vm_offset_t r = bus->regs;
+	uint32_t trigger = len < 8 ? len : 8, done = 0, status = 0;
+	uint64_t deadline;
+	bool late = false;
+
+	bus->transfers++;
+	wr(r, INT_STAT, rd(r, INT_STAT));
+	wr(r, FIFO_CTL, 0x3 | trigger << 4 | trigger << 16);
+	wr(r, CTL, CTL_MASTER | (reading ? CTL_RXCHON : CTL_TXCHON));
+	wr(r, ADDR, (uint32_t)addr << 10);
+	wr(r, INT_EN, INT_DONE | INT_ERRORS);
+	wr(r, AUTO_CONF, len | (reading ? AUTO_READ : 0) | (stop ? AUTO_STOP : 0));
+	wr(r, AUTO_CONF, rd(r, AUTO_CONF) | AUTO_RUN);
+
+	/* a second at most, by the clock */
+	for (deadline = deadline_us(1000000);;) {
+		uint32_t fifo = rd(r, FIFO_STAT);
+
+		status = rd(r, INT_STAT);
+		if (status & INT_ERRORS) {
+			break;
+		}
+		if (reading) {
+			while (done < len && !(fifo & RX_EMPTY)) {
+				buf[done++] = (uint8_t)rd(r, RX_DATA);
+				fifo = rd(r, FIFO_STAT);
+			}
+			if (done == len) {
+				break;
+			}
+		} else {
+			while (done < len && !(fifo & TX_FULL)) {
+				wr(r, TX_DATA, buf[done++]);
+				fifo = rd(r, FIFO_STAT);
+			}
+			if (done == len && (status & INT_DONE) && (fifo & TX_EMPTY)) {
+				break;
+			}
+		}
+		if (mach_absolute_time() > deadline) {
+			late = true;
+			break;
+		}
+	}
+	/* after a STOP: the master no longer busy (the target may stretch the clock); without one it holds the bus */
+	for (deadline = deadline_us(100000); stop && (rd(r, TRANS_STATUS) & MASTER_BUSY) && mach_absolute_time() < deadline;) {
+	}
+	if ((status & INT_ERRORS) || late) {
+		bus->errors++;
+		bus->last_error = (status & INT_ERRORS) ? (status & INT_ERRORS) : 1;
+		if (bus->errors <= 3) {
+			printf("%s: hsi2c failed (addr %02x %s len %u done %u late %d): CTL %08x FIFO_CTL %08x INT_EN %08x INT_STAT %08x "
+			    "FIFO_STAT %08x CONF %08x AUTO_CONF %08x TIMEOUT %08x TRANS_STATUS %08x FS1 %08x FS2 %08x FS3 %08x "
+			    "ADDR %08x USI_CON %08x USI_OPT %08x; pins CON %08x DAT %08x\n", bus->name, addr, reading ? "read" : "write",
+			    len, done, late, rd(r, CTL), rd(r, FIFO_CTL), rd(r, INT_EN), rd(r, INT_STAT), rd(r, FIFO_STAT), rd(r, CONF),
+			    rd(r, AUTO_CONF), rd(r, TIMEOUT), rd(r, TRANS_STATUS), rd(r, TIMING_FS1), rd(r, TIMING_FS2),
+			    rd(r, TIMING_FS3), rd(r, ADDR), rd(r, USI_CON), rd(r, 0xC8),
+			    bus->pins ? *(volatile uint32_t *)bus->pins : 0, bus->pins ? *(volatile uint32_t *)(bus->pins + 4) : 0);
+		}
+		hakios_hsi2c_reset(bus);
+		return bus->last_error;
+	}
+	return 0;
+}
+
+uint32_t
+hakios_hsi2c_read_reg(struct hakios_hsi2c *bus, uint8_t addr, uint8_t reg, uint8_t *buf, uint32_t len)
+{
+	uint32_t error = hakios_hsi2c_message(bus, addr, false, &reg, 1, false);
+
+	return error ? error : hakios_hsi2c_message(bus, addr, true, buf, len, true);
+}
diff --git a/bsd/dev/hakios.exynos_usb.c b/bsd/dev/hakios.exynos_usb.c
new file mode 100644
index 000000000..7a67f6880
--- /dev/null
+++ b/bsd/dev/hakios.exynos_usb.c
@@ -0,0 +1,391 @@
+#define HAKIOS_SOC_FIXED
+/*
+ * The Galaxy S9's USB port, the SoC's half: the Exynos 9810's clocks, power isolation and USB PHY, brought up for the
+ * device-neutral gadget driver (drivers/usb/hakios.dwc3.c, which owns the boot-args: usb_gadget=N). This file is the
+ * glue (sys: hakios.usb_glue.h); the DWC3 controller itself is the gadget driver's.
+ *
+ * The hardware. The DWC3 (DesignWare USB 3.0 DRD) at 0x10C00000, interrupt SPI 244 (the gadget driver polls). Its
+ * USB 2.0 PHY and link control ("USBCON", Samsung's USB 3.1 CAL, version 0x300) at 0x11100000; the USB/DisplayPort
+ * combo PHY for SuperSpeed at 0x110A0000/0x110B0000, which is NOT used: the link runs at high speed with its PIPE3
+ * side forced idle, as the BSP itself leaves it until the SuperSpeed PHY is set up. Power: the PMU's USB PHY
+ * isolation at 0x14060000 + 0x72C bit 0 (the DP/SuperSpeed one, +0x704, left alone). Clocks: CMU_TOP's
+ * CLKCMU_FSYS0_USB30DRD (mux, divider, gate at 0x1A240000 +0x1060/+0x1858/+0x2064) into CMU_FSYS0's user mux
+ * (0x11000000 +0x1E0) and the link's Q-channel gates (+0x304C/+0x3050/+0x3054/+0x3058), which Linux leaves to
+ * the hardware (composite.c:1375: enabling a VCLK_GATE is a no-op). Supplies: the S2MPS18's LDO9-14, always on
+ * (the dt's regulator-always-on, mode 1); Android's USB stack puts them into mode 3 (normal) while USB is in use.
+ *
+ * What UEFI did. Nothing: Silicium's starlte FD at uefi/BASE (e51cd877) has no USB driver in its DXE list
+ * (Platforms/Samsung/starltePkg/Include/DXE.inc), and the S5E9810 has only the null PlatformUsbfnLib, so its
+ * UsbfnDwc3Dxe would refuse the SoC even if it were there. What S-Boot did is not known (it has a USB download
+ * mode and charger detection): step 1 reads it, and step 3 (the gadget driver) stops a running controller and
+ * resets it whatever it finds. The PHY sequence of step 2 resets the link and the PHY itself (CLKRST).
+ *
+ * THE SEQUENCE (step 2), each write read back and said; the BSP's order (dwc3_core_soft_reset: phy_power_on, then
+ * phy_init's exynos_usbdrd_utmi_init: phy_exynos_usb_v3p1_enable then _pipe_ovrd):
+ *   a  PMU +0x72C bit 0 set: the PHY out of isolation (phy-exynos-usbdrd.c:415-426, 1495, 1777; dt pmu_offset 0x72C,
+ *      pmu_mask 0 -> BIT(0))
+ *   b  LINK_CTRL: the Q-channel workaround: DIS_QACT_ID0/VBUS_VALID/BVALID/LINKGATE set, FORCE_QACT clear, 500 us,
+ *      then FORCE_QACT set (phy-exynos-usb3p1.c:26-45)
+ *   c  CLKRST LINK_SW_RST pulsed 10 us (usb3p1.c:230-239)
+ *   d  CLKRST PHY_SW_RST and PHY_RST_SEL set (:101-116)
+ *   e  HSP_TEST SIDDQ clear: the 2.0 PHY powered (:87-94, version 3.0.0)
+ *   f  UTMI FORCE_SUSPEND, FORCE_SLEEP, DP_PULLDOWN, DM_PULLDOWN clear (:252-257)
+ *   g  HSP EN_UTMISUSPEND set, COMMONONN set (dt common_block_disable = 1) (:259-265)
+ *   h  100 us, then CLKRST PHY_RST_SEL set, PHY_SW_RST and PORT_RST clear (:279-280, 118-134)
+ *   i  VBUS from the PHY's own pad is not used (dt is_not_vbus_pad = 1): LINK_CTRL BUS_FILTER_BYPASS = 0xF, UTMI
+ *      FORCE_BVALID and FORCE_VBUSVALID set, HSP VBUSVLDEXTSEL and VBUSVLDEXT set (:56-67, 307-325)
+ *   j  LINK_PORT HUB_PORT_SEL_OCD_U3/U2 set (dt use_io_for_ovc = 0) (:327-336)
+ *   k  (not done: ReWA, the BSP's hs_rewa = 1 (usbdrd.c:1009, usb3p1.c:339-340), is the wake-up assist of a suspended
+ *      link; a link that never suspends does not need it)
+ *   l  pipe_ovrd: LINK_CTRL PIPE3_FORCE_EN and PIPE3_FORCE_RX_ELEC_IDLE set, PIPE3_FORCE_PHY_STATUS clear;
+ *      COMBO_PMA_CTRL PMA_LOW_PWRN set (:196-212). The BSP undoes this in pipe3_init (pma_ready, :136-165) when it
+ *      brings the SuperSpeed PHY up; this driver does not, so the link sees the SuperSpeed lanes as idle.
+ * Not done: the PHY tuning (HSP_TUNE from the dt's hs_tune_param; the value the boot left is said), the OTP tuning
+ * (CONFIG_EXYNOS_OTP), the Type-C orientation GPIO (SuperSpeed only).
+ *
+ * Registers: phy-exynos-usb3p1-reg.h (CTRL_VER :22, LINK_CTRL :24-35, LINK_PORT :40, :48-49, CLKRST :64-73, PWR :75,
+ * COMBO_PMA_CTRL :139, :146, UTMI :153-161, HSP :163, :173-176, HSP_TUNE :185, HSP_TEST :215, :218-219).
+ * Clocks: cmucal-sfr.c (CMU_TOP 0x1A240000 :14, FSYS0 0x11000000 :24; +0x1060/+0x2064/+0x1858 :456-458; FSYS0 user
+ * mux +0x1E0 :1060, REF_CLK gate +0x206C :1063, the Q-channels :1087-1090; MUX SELECT [1:0], BUSY 16 :3133-3135; gate
+ * CG_VAL 21, MANUAL 20 :3136-3137; divider ratio [3:0] :3141; user mux MUX_SEL bit 4, BUSY 7 :5064-5065; Q-channel
+ * ENABLE 0, CLOCK_REQ 1 :5151-5164); Android's setting, mux 1 (PLL_SHARED0 / 4) and divider 7: cmucal-vclklut.c:158-163
+ * through cmucal-vclk.c:187-190, 1833-1836; parents cmucal-node.c:195-200, 609-611; the dt's clocks 0x2C0 and 0x2C7 are
+ * GATE_USB30DRD_USB30DRD_LINK and USB30DRD (include/dt-bindings/clock/exynos9810.h:260, 265, 272; clk-exynos9810.c:191,
+ * 416). PMU 0x14060000: the dt's system-controller@14060000 (starlte.dts:4969-4971), the phy node's pmu_offset
+ * (starlte.dts:5340-5342). The LDOs: s2mps18.c:127-148 (s2m_ldo_set_mode: L9CTRL + n - 9, mode << 6, mask 0xC0),
+ * s2mps18-private.h:116, 272; dwc3/otg.c:196-210 (mode 3 on, 1 off); the dt's LDO9-14 (starlte_eur_open_26.dts:8997-9062).
+ * All of Samsung's kernel fork (Scion-Project/android_kernel_samsung_exynos9810, lineage-24.0, e5906667068e), GPL-2.0:
+ * read for facts only, no code taken.
+ */
+#include <stdarg.h>
+#include <stdint.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/systm.h>
+#include <sys/hakios.exynos_acpm.h>
+#include <sys/hakios.exynos_soc.h>
+#include "hakios.usb_glue.h"
+#include <sys/hakios.xnu.h>
+
+
+#define DWC3_PA                 ((uint32_t)EXYNOS_USB_DWC3_PA)
+#define DWC3_SIZE               0x10000u
+#define USBCON_PA               ((uint32_t)EXYNOS_USB_CON_PA)
+#define USBCON_SIZE             0x1000u         /* the dt's 0x200, mapped as a page */
+#define PMU_PA                  ((uint32_t)EXYNOS_PMU_PA)
+#define PMU_USB_PHY             EXYNOS_USB_PMU_USB_PHY         /* bit 0: out of isolation */
+#define PMU_USB_DP_PHY          EXYNOS_USB_PMU_USB_DP_PHY
+#define PMU_ISOL_BIT            (1u << 0)
+#define CMU_TOP_PA              ((uint32_t)EXYNOS_CMU_TOP_PA)
+#define TOP_MUX_USB30DRD        EXYNOS_USB_TOP_MUX_USB30DRD
+#define TOP_DIV_USB30DRD        EXYNOS_USB_TOP_DIV_USB30DRD
+#define TOP_GATE_USB30DRD       EXYNOS_USB_TOP_GATE_USB30DRD
+#define CMU_FSYS0_PA            ((uint32_t)EXYNOS_CMU_FSYS0_PA)
+#define FSYS0_USER_MUX          EXYNOS_USB_FSYS0_USER_MUX         /* MUX_SEL bit 4: 0 OSCCLK, 1 CMU_TOP's CLKCMU_FSYS0_USB30DRD */
+#define FSYS0_REFCLK_GATE       EXYNOS_USB_FSYS0_REFCLK_GATE
+#define FSYS0_QCH_CTRL          EXYNOS_USB_FSYS0_QCH_CTRL
+#define FSYS0_QCH_LINK          EXYNOS_USB_FSYS0_QCH_LINK
+#define FSYS0_QCH_DPPHY         EXYNOS_USB_FSYS0_QCH_DPPHY
+#define FSYS0_QCH_PCS           EXYNOS_USB_FSYS0_QCH_PCS
+#define GATE_MANUAL             (1u << 20)
+#define GATE_CG_VAL             (1u << 21)
+#define USER_MUX_SEL            (1u << 4)
+#define ANDROID_TOP_MUX         EXYNOS_USB_ANDROID_TOP_MUX              /* DIV_PLL_SHARED0_DIV4 */
+#define ANDROID_TOP_DIV         EXYNOS_USB_ANDROID_TOP_DIV
+
+/* USBCON (phy-exynos-usb3p1-reg.h) */
+#define CTRL_VER                0x00u
+#define LINK_CTRL               0x04u
+#define  LC_FORCE_RX_ELEC_IDLE  (1u << 18)
+#define  LC_FORCE_PHY_STATUS    (1u << 17)
+#define  LC_PIPE3_FORCE_EN      (1u << 16)
+#define  LC_DIS_QACT_LINKGATE   (1u << 12)
+#define  LC_DIS_QACT_ID0        (1u << 11)
+#define  LC_DIS_QACT_VBUS_VALID (1u << 10)
+#define  LC_DIS_QACT_BVALID     (1u << 9)
+#define  LC_FORCE_QACT          (1u << 8)
+#define  LC_BUS_FILTER_BYPASS   (0xFu << 4)
+#define LINK_PORT               0x08u
+#define  LP_SEL_OCD_U3          (1u << 3)
+#define  LP_SEL_OCD_U2          (1u << 2)
+#define CLKRST                  0x20u
+#define  CR_LINK_PCLK_SEL       (1u << 7)
+#define  CR_PHY_SW_RST          (1u << 3)
+#define  CR_PHY_RST_SEL         (1u << 2)
+#define  CR_PORT_RST            (1u << 1)
+#define  CR_LINK_SW_RST         (1u << 0)
+#define PWR                     0x24u
+#define COMBO_PMA_CTRL          0x48u
+#define  PMA_LOW_PWRN           (1u << 4)
+#define UTMI                    0x50u
+#define  UTMI_FORCE_VBUSVALID   (1u << 5)
+#define  UTMI_FORCE_BVALID      (1u << 4)
+#define  UTMI_DP_PULLDOWN       (1u << 3)
+#define  UTMI_DM_PULLDOWN       (1u << 2)
+#define  UTMI_FORCE_SUSPEND     (1u << 1)
+#define  UTMI_FORCE_SLEEP       (1u << 0)
+#define HSP                     0x54u
+#define  HSP_VBUSVLDEXTSEL      (1u << 13)
+#define  HSP_VBUSVLDEXT         (1u << 12)
+#define  HSP_EN_UTMISUSPEND     (1u << 9)
+#define  HSP_COMMONONN          (1u << 8)
+#define HSP_TUNE                0x58u
+#define HSP_TEST                0x5Cu
+#define  HSP_TEST_SIDDQ         (1u << 24)
+#define  HSP_TEST_LINESTATE(v)  (((v) >> 20) & 3u)
+
+/* the S2MPS18's LDO9-14 (s2mps18-private.h:116, 272) */
+#define S2MPS18_L9CTRL          0x52u
+#define LDO_MODE_SHIFT          6
+#define LDO_MODE_MASK           0xC0u
+
+static vm_offset_t usbcon, pmu, top, fsys0;
+static bool mapped;
+
+static inline uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static inline void
+wr(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static bool
+map_all(usb_glue_say_t say)
+{
+	if (mapped) {
+		return true;
+	}
+	pmu = ml_io_map(PMU_PA, 0x1000);
+	top = ml_io_map(CMU_TOP_PA, 0x4000);
+	fsys0 = ml_io_map(CMU_FSYS0_PA, 0x4000);
+	usbcon = ml_io_map(USBCON_PA, USBCON_SIZE);
+	if (pmu == 0 || top == 0 || fsys0 == 0 || usbcon == 0) {
+		say("usb: exynos9810: could not map the PMU, CMU_TOP, CMU_FSYS0 or USBCON\n");
+		return false;
+	}
+	mapped = true;
+	return true;
+}
+
+static const char *const linestates[4] = { "SE0", "J", "K", "SE1" };
+
+static void
+say_usbcon(usb_glue_say_t say, const char *when)
+{
+	uint32_t test = rd(usbcon, HSP_TEST);
+
+	say("usb: exynos9810: USBCON %s: VER %08x LINK_CTRL %08x LINK_PORT %08x CLKRST %08x PWR %08x PMA %08x\n", when,
+	    rd(usbcon, CTRL_VER), rd(usbcon, LINK_CTRL), rd(usbcon, LINK_PORT), rd(usbcon, CLKRST), rd(usbcon, PWR),
+	    rd(usbcon, COMBO_PMA_CTRL));
+	say("usb: exynos9810: USBCON %s: UTMI %08x HSP %08x HSP_TUNE %08x HSP_TEST %08x (SIDDQ %u, line %s)\n", when,
+	    rd(usbcon, UTMI), rd(usbcon, HSP), rd(usbcon, HSP_TUNE), test, (test & HSP_TEST_SIDDQ) ? 1 : 0,
+	    linestates[HSP_TEST_LINESTATE(test)]);
+}
+
+static void
+say_ldos(usb_glue_say_t say)
+{
+	char line[160];
+	int n = 0;
+
+	if (!hakios_acpm_init(say)) {
+		say("usb: exynos9810: ACPM not usable: the S2MPS18's LDO9-14 not read\n");
+		return;
+	}
+	for (uint32_t i = 0; i < 6; i++) {
+		uint8_t v = 0;
+		int e = hakios_acpm_pmic_read(HAKIOS_ACPM_PMIC_PMIC, S2MPS18_L9CTRL + i, &v);
+
+		n += snprintf(line + n, sizeof(line) - (size_t)n, " L%u %s%02x(mode %u)", 9 + i, e ? "err " : "", v,
+		    (unsigned)(v >> LDO_MODE_SHIFT));
+	}
+	say("usb: exynos9810: S2MPS18 LDO9-14 CTRL:%s (mode 1 on with the AP, 3 Android's USB mode)\n", line);
+}
+
+/* the clocks as the boot left them; true when the DWC3 and USBCON have a clock to be read with */
+static bool
+say_clocks(usb_glue_say_t say)
+{
+	uint32_t gate = rd(top, TOP_GATE_USB30DRD), mux = rd(top, TOP_MUX_USB30DRD), div = rd(top, TOP_DIV_USB30DRD);
+	uint32_t user = rd(fsys0, FSYS0_USER_MUX);
+	bool top_shut = (gate & GATE_MANUAL) && !(gate & GATE_CG_VAL);
+	bool from_top = (user & USER_MUX_SEL) != 0;
+
+	say("usb: exynos9810: CMU_TOP CLKCMU_FSYS0_USB30DRD: mux %08x (select %u; Android 1), div %08x (ratio %u; Android 7), "
+	    "gate %08x (MANUAL %u CG_VAL %u)%s\n", mux, mux & 3, div, div & 0xf, gate, (gate & GATE_MANUAL) ? 1 : 0,
+	    (gate & GATE_CG_VAL) ? 1 : 0, top_shut ? ": SHUT" : "");
+	say("usb: exynos9810: CMU_FSYS0: user mux %08x (%s), REF_CLK gate %08x, QCH CTRL %08x LINK %08x DPPHY %08x PCS %08x\n",
+	    user, from_top ? "from CMU_TOP" : "OSCCLK", rd(fsys0, FSYS0_REFCLK_GATE), rd(fsys0, FSYS0_QCH_CTRL),
+	    rd(fsys0, FSYS0_QCH_LINK), rd(fsys0, FSYS0_QCH_DPPHY), rd(fsys0, FSYS0_QCH_PCS));
+	return !(from_top && top_shut);
+}
+
+static bool
+exynos_look(usb_glue_say_t say, __unused uint32_t flags)
+{
+	if (!map_all(say)) {
+		return false;
+	}
+	uint32_t iso = rd(pmu, PMU_USB_PHY), iso_dp = rd(pmu, PMU_USB_DP_PHY);
+
+	say("usb: exynos9810: PMU USB PHY %08x (%s), DP/SS PHY %08x (%s)\n", iso, (iso & PMU_ISOL_BIT) ? "out of isolation" : "isolated",
+	    iso_dp, (iso_dp & PMU_ISOL_BIT) ? "out of isolation" : "isolated");
+	bool readable = say_clocks(say);
+	say_ldos(say);
+	if (!readable) {
+		say("usb: exynos9810: the controller's clock is shut at CMU_TOP: USBCON and the DWC3 are not read (usb_gadget_clk=1 opens it)\n");
+		return false;
+	}
+	say_usbcon(say, "as the boot left it");
+	return true;
+}
+
+/* one register: set and clear bits, read back, said */
+static uint32_t
+change(usb_glue_say_t say, const char *step, const char *name, uint32_t off, uint32_t set, uint32_t clear)
+{
+	uint32_t before = rd(usbcon, off), want = (before & ~clear) | set;
+
+	wr(usbcon, off, want);
+	uint32_t after = rd(usbcon, off);
+	say("usb: exynos9810: 2%s: %s %08x -> %08x%s\n", step, name, before, after, after == want ? "" : " (NOT as written)");
+	return after;
+}
+
+static int
+exynos_phy_on(usb_glue_say_t say, uint32_t flags)
+{
+	if (!map_all(say)) {
+		return ENXIO;
+	}
+
+	/* the clocks: open only what is shut, and only as Android sets it */
+	uint32_t gate = rd(top, TOP_GATE_USB30DRD), user = rd(fsys0, FSYS0_USER_MUX);
+	if ((gate & GATE_MANUAL) && !(gate & GATE_CG_VAL)) {
+		if (!(flags & USB_GLUE_CLK)) {
+			say("usb: exynos9810: 2: CMU_TOP's USB30DRD gate is shut and usb_gadget_clk is not 1: stopping here\n");
+			return ENXIO;
+		}
+		uint32_t mux = rd(top, TOP_MUX_USB30DRD), div = rd(top, TOP_DIV_USB30DRD);
+		if ((mux & 3) != ANDROID_TOP_MUX) {
+			wr(top, TOP_MUX_USB30DRD, (mux & ~3u) | ANDROID_TOP_MUX);
+		}
+		if ((div & 0xf) != ANDROID_TOP_DIV) {
+			wr(top, TOP_DIV_USB30DRD, (div & ~0xfu) | ANDROID_TOP_DIV);
+		}
+		wr(top, TOP_GATE_USB30DRD, gate | GATE_CG_VAL);
+		say("usb: exynos9810: 2: usb_gadget_clk=1: CMU_TOP mux %08x div %08x gate %08x\n", rd(top, TOP_MUX_USB30DRD),
+		    rd(top, TOP_DIV_USB30DRD), rd(top, TOP_GATE_USB30DRD));
+		if (!(rd(top, TOP_GATE_USB30DRD) & GATE_CG_VAL)) {
+			return EIO;
+		}
+	}
+	if (!(user & USER_MUX_SEL) && (flags & USB_GLUE_CLK)) {
+		wr(fsys0, FSYS0_USER_MUX, user | USER_MUX_SEL);
+		delay(10);
+		say("usb: exynos9810: 2: usb_gadget_clk=1: CMU_FSYS0 user mux %08x -> %08x (from CMU_TOP)\n", user, rd(fsys0, FSYS0_USER_MUX));
+	}
+
+	/* the supplies: mode 3 (Android's while USB is up), only when asked, each read back */
+	if ((flags & USB_GLUE_LDO) && hakios_acpm_init(say)) {
+		for (uint32_t i = 0; i < 6; i++) {
+			uint8_t v = 0;
+
+			if (hakios_acpm_pmic_update(HAKIOS_ACPM_PMIC_PMIC, S2MPS18_L9CTRL + i, 3u << LDO_MODE_SHIFT, LDO_MODE_MASK) != 0 ||
+			    hakios_acpm_pmic_read(HAKIOS_ACPM_PMIC_PMIC, S2MPS18_L9CTRL + i, &v) != 0) {
+				say("usb: exynos9810: 2: usb_gadget_ldo=1: LDO%u: ACPM failed\n", 9 + i);
+				continue;
+			}
+			say("usb: exynos9810: 2: usb_gadget_ldo=1: LDO%u CTRL now %02x (mode %u)\n", 9 + i, v, (unsigned)(v >> LDO_MODE_SHIFT));
+		}
+	}
+
+	say_usbcon(say, "before");
+
+	/* a */
+	uint32_t iso = rd(pmu, PMU_USB_PHY);
+	wr(pmu, PMU_USB_PHY, iso | PMU_ISOL_BIT);
+	say("usb: exynos9810: 2a: PMU +0x72C %08x -> %08x (the PHY out of isolation)\n", iso, rd(pmu, PMU_USB_PHY));
+
+	/* b: the Q-channel workaround (phy-exynos-usb3p1.c exynos_cal_usbphy_q_ch(, 1)) */
+	uint32_t v = rd(usbcon, LINK_CTRL);
+	v |= LC_DIS_QACT_ID0 | LC_DIS_QACT_VBUS_VALID | LC_DIS_QACT_BVALID | LC_DIS_QACT_LINKGATE;
+	v &= ~LC_FORCE_QACT;
+	delay(500);
+	wr(usbcon, LINK_CTRL, v);
+	delay(500);
+	v = rd(usbcon, LINK_CTRL) | LC_FORCE_QACT;
+	delay(500);
+	wr(usbcon, LINK_CTRL, v);
+	say("usb: exynos9810: 2b: LINK_CTRL %08x (Q-channel: QACT forced, its other sources off)\n", rd(usbcon, LINK_CTRL));
+
+	/* c: the link reset */
+	v = rd(usbcon, CLKRST);
+	wr(usbcon, CLKRST, v | CR_LINK_SW_RST);
+	delay(10);
+	wr(usbcon, CLKRST, v & ~CR_LINK_SW_RST);
+	say("usb: exynos9810: 2c: CLKRST %08x (LINK_SW_RST pulsed)\n", rd(usbcon, CLKRST));
+
+	change(say, "d", "CLKRST", CLKRST, CR_PHY_SW_RST | CR_PHY_RST_SEL, 0);                 /* d */
+	change(say, "e", "HSP_TEST", HSP_TEST, 0, HSP_TEST_SIDDQ);                             /* e */
+	change(say, "f", "UTMI", UTMI, 0, UTMI_FORCE_SUSPEND | UTMI_FORCE_SLEEP | UTMI_DP_PULLDOWN | UTMI_DM_PULLDOWN);
+	change(say, "g", "HSP", HSP, HSP_EN_UTMISUSPEND | HSP_COMMONONN, 0);                  /* g */
+	delay(100);                                                                             /* h */
+	change(say, "h", "CLKRST", CLKRST, CR_PHY_RST_SEL, CR_PHY_SW_RST | CR_PORT_RST);
+	change(say, "i", "LINK_CTRL", LINK_CTRL, LC_BUS_FILTER_BYPASS, 0);                     /* i */
+	change(say, "i", "UTMI", UTMI, UTMI_FORCE_BVALID | UTMI_FORCE_VBUSVALID, 0);
+	change(say, "i", "HSP", HSP, HSP_VBUSVLDEXTSEL | HSP_VBUSVLDEXT, 0);
+	change(say, "j", "LINK_PORT", LINK_PORT, LP_SEL_OCD_U3 | LP_SEL_OCD_U2, 0);            /* j */
+	change(say, "l", "LINK_CTRL", LINK_CTRL, LC_PIPE3_FORCE_EN | LC_FORCE_RX_ELEC_IDLE, LC_FORCE_PHY_STATUS);   /* l */
+	change(say, "l", "COMBO_PMA_CTRL", COMBO_PMA_CTRL, PMA_LOW_PWRN, 0);
+	say_usbcon(say, "after");
+	return 0;
+}
+
+static void
+exynos_phy_state(char *out, unsigned size)
+{
+	if (!mapped) {
+		snprintf(out, size, "(not mapped)");
+		return;
+	}
+	uint32_t test = rd(usbcon, HSP_TEST), utmi = rd(usbcon, UTMI);
+
+	snprintf(out, size, "line %s, UTMI %08x (VBUSVALID forced %u), SIDDQ %u", linestates[HSP_TEST_LINESTATE(test)], utmi,
+	    (utmi & UTMI_FORCE_VBUSVALID) ? 1 : 0, (test & HSP_TEST_SIDDQ) ? 1 : 0);
+}
+
+/* the 2.0 PHY powered down (SIDDQ) and isolated again, as phy_power_en(, 0) and phy_power_off do (usb3p1.c:87-94, usbdrd.c:1502-1511) */
+static void
+exynos_phy_off(void)
+{
+	if (!mapped) {
+		return;
+	}
+	wr(usbcon, HSP_TEST, rd(usbcon, HSP_TEST) | HSP_TEST_SIDDQ);
+	wr(pmu, PMU_USB_PHY, rd(pmu, PMU_USB_PHY) & ~PMU_ISOL_BIT);
+}
+
+static const struct hakios_usb_glue exynos9810_glue = {
+	.name = "exynos9810",
+	.dwc3_pa = DWC3_PA,
+	.dwc3_size = DWC3_SIZE,
+	.look = exynos_look,
+	.phy_on = exynos_phy_on,
+	.phy_state = exynos_phy_state,
+	.phy_off = exynos_phy_off,
+};
+
+const struct hakios_usb_glue *
+hakios_usb_glue_exynos9810(void)
+{
+	return &exynos9810_glue;
+}
diff --git a/bsd/dev/hakios.usb_acm.h b/bsd/dev/hakios.usb_acm.h
new file mode 100644
index 000000000..cbdeee6fe
--- /dev/null
+++ b/bsd/dev/hakios.usb_acm.h
@@ -0,0 +1,422 @@
+/*
+ * A USB CDC-ACM function's descriptors and its control requests, as plain C: what the USB gadget driver
+ * (drivers/usb/hakios.dwc3.c) answers a host with, and what tools/usb_acm_test.c checks on the build machine
+ * (tools/usb-acm-test.sh) by playing the requests Linux, macOS and Windows make when a device is plugged in.
+ *
+ * Nothing here touches hardware or the kernel: a setup packet goes in, an answer comes out (data to send, data
+ * to expect, a status stage, or a stall) with what the controller has to do about it (an address, a
+ * configuration, an endpoint's halt, the host opening the port). The controller driver does the transfers.
+ *
+ * The device: USB 2.0 (high speed, full speed), one configuration, class 02 (communications) at the device
+ * level, so that no interface association is needed: interface 0 is the ACM control interface with an interrupt
+ * IN endpoint (0x82) that is never sent on, interface 1 the data interface with bulk OUT 0x01 and bulk IN 0x81.
+ * Linux binds cdc_acm to it (/dev/ttyACM0), macOS AppleUSBCDCACM (/dev/cu.usbmodem*), Windows 10 and later
+ * usbser.sys. Protocol 0 (no AT commands) keeps modem managers from talking to it as a modem.
+ *
+ * The identity is pid.codes' test VID/PID (0x1209/0x0001): for development only, never to be shipped.
+ *
+ * Sources: the USB 2.0 specification, chapter 9 (requests, descriptors); the USB CDC 1.2 and PSTN 1.2
+ * specifications (the functional descriptors, SET/GET_LINE_CODING, SET_CONTROL_LINE_STATE, SEND_BREAK).
+ * No code of any other implementation was used.
+ */
+#ifndef _HAKIOS_USB_ACM_H_
+#define _HAKIOS_USB_ACM_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#if defined(KERNEL)
+#include <libkern/libkern.h>
+#else
+#include <string.h>
+#endif
+
+#define USBACM_VID              0x1209  /* pid.codes */
+#define USBACM_PID              0x0001  /* pid.codes' test PID: development only */
+#define USBACM_EP0_MPS          64
+#define USBACM_EP_OUT           0x01
+#define USBACM_EP_IN            0x81
+#define USBACM_EP_NOTIFY        0x82
+#define USBACM_HS_BULK          512
+#define USBACM_FS_BULK          64
+#define USBACM_CONFIG_LEN       67
+#define USBACM_STRINGS          5
+
+/* what the controller is to do with a setup packet */
+enum usbacm_action {
+	USBACM_STALL = 0,       /* stall ep0, then wait for the next setup */
+	USBACM_STATUS,          /* no data stage: the status stage at once (IN, zero length) */
+	USBACM_IN,              /* send r.data (r.len bytes), then the status stage (OUT) */
+	USBACM_OUT,             /* receive r.len bytes, give them to usbacm_out_done(), then the status stage (IN) */
+};
+
+/* side effects, for the controller; more than one can be set */
+#define USBACM_EFF_ADDRESS      0x01u   /* r.value: the new address; set it before the status stage */
+#define USBACM_EFF_CONFIG       0x02u   /* r.value: the configuration (1: endpoints up, 0: down) */
+#define USBACM_EFF_HALT         0x04u   /* r.ep: halt that endpoint */
+#define USBACM_EFF_CLEAR_HALT   0x08u   /* r.ep: clear that endpoint's halt (and reset its toggle) */
+#define USBACM_EFF_LINES        0x10u   /* SET_CONTROL_LINE_STATE: s.lines has DTR (bit 0) and RTS (bit 1) */
+#define USBACM_EFF_LINE_CODING  0x20u   /* SET_LINE_CODING's data arrived: s.line_coding */
+#define USBACM_EFF_BREAK        0x40u
+
+struct usbacm_reply {
+	int             action;
+	const uint8_t   *data;
+	uint16_t        len;
+	uint32_t        effects;
+	uint8_t         value;
+	uint8_t         ep;
+};
+
+struct usbacm {
+	bool            high_speed;     /* the controller says which, at connect-done */
+	uint8_t         address;
+	uint8_t         config;
+	uint16_t        lines;          /* DTR bit 0, RTS bit 1 */
+	uint8_t         line_coding[7]; /* dwDTERate (LE), bCharFormat, bParityType, bDataBits */
+	uint8_t         halted;         /* bit 0: 0x01, bit 1: 0x81, bit 2: 0x82 */
+	uint8_t         out_request;    /* the request whose OUT data stage is under way, 0 if none */
+	const char      *strings[USBACM_STRINGS];      /* 1-4 used; ASCII */
+	uint8_t         buf[256];       /* answers are built here */
+};
+
+static const uint8_t usbacm_device_desc[18] = {
+	18, 1, 0x00, 0x02,              /* bLength, DEVICE, bcdUSB 2.00 (no BOS asked for) */
+	0x02, 0x00, 0x00,               /* class: communications, at device level */
+	USBACM_EP0_MPS,
+	USBACM_VID & 0xff, USBACM_VID >> 8, USBACM_PID & 0xff, USBACM_PID >> 8,
+	0x00, 0x01,                     /* bcdDevice 1.00 */
+	1, 2, 3, 1                      /* iManufacturer, iProduct, iSerialNumber, bNumConfigurations */
+};
+
+static const uint8_t usbacm_qualifier_desc[10] = {
+	10, 6, 0x00, 0x02, 0x02, 0x00, 0x00, USBACM_EP0_MPS, 1, 0
+};
+
+static const uint8_t usbacm_lang_desc[4] = { 4, 3, 0x09, 0x04 };   /* English (United States) */
+
+static inline void
+usbacm_init(struct usbacm *s)
+{
+	memset(s, 0, sizeof(*s));
+	s->line_coding[0] = 0x00;       /* 115200 8N1: a value to answer GET_LINE_CODING with, nothing depends on it */
+	s->line_coding[1] = 0xc2;
+	s->line_coding[2] = 0x01;
+	s->line_coding[6] = 8;
+	s->strings[1] = "HakiOS";
+	s->strings[2] = "HakiOS kernel log and console";
+	s->strings[3] = "0";
+	s->strings[4] = "log";
+}
+
+/* the configuration descriptor at a speed (type 2, or 7 for "other speed"); USBACM_CONFIG_LEN bytes into out */
+static inline size_t
+usbacm_config_desc(uint8_t *out, bool high_speed, uint8_t type)
+{
+	uint16_t bulk = high_speed ? USBACM_HS_BULK : USBACM_FS_BULK;
+	const uint8_t d[USBACM_CONFIG_LEN] = {
+		9, type, USBACM_CONFIG_LEN, 0, 2, 1, 0, 0xc0, 50,     /* 2 interfaces, value 1, self-powered, 100 mA */
+		9, 4, 0, 0, 1, 0x02, 0x02, 0x00, 4,                     /* interface 0: CDC, ACM, no protocol */
+		5, 0x24, 0x00, 0x10, 0x01,                              /* header, CDC 1.10 */
+		5, 0x24, 0x01, 0x00, 1,                                 /* call management: none, data interface 1 */
+		4, 0x24, 0x02, 0x02,                                    /* ACM: line coding and serial state */
+		5, 0x24, 0x06, 0, 1,                                    /* union: control 0, data 1 */
+		7, 5, USBACM_EP_NOTIFY, 3, 16, 0, (uint8_t)(high_speed ? 9 : 32),  /* interrupt IN, 16 bytes, 32 ms */
+		9, 4, 1, 0, 2, 0x0a, 0x00, 0x00, 0,                     /* interface 1: CDC data */
+		7, 5, USBACM_EP_OUT, 2, (uint8_t)(bulk & 0xff), (uint8_t)(bulk >> 8), 0,
+		7, 5, USBACM_EP_IN, 2, (uint8_t)(bulk & 0xff), (uint8_t)(bulk >> 8), 0,
+	};
+
+	memcpy(out, d, sizeof(d));
+	return sizeof(d);
+}
+
+/* a string descriptor of ASCII text (UTF-16LE), at most cap bytes; its length */
+static inline size_t
+usbacm_string_desc(uint8_t *out, size_t cap, const char *ascii)
+{
+	size_t n = 2;
+
+	for (; *ascii != 0 && n + 2 <= cap && n + 2 <= 254; ascii++, n += 2) {
+		out[n] = (uint8_t)*ascii;
+		out[n + 1] = 0;
+	}
+	out[0] = (uint8_t)n;
+	out[1] = 3;
+	return n;
+}
+
+static inline uint8_t
+usbacm_ep_bit(uint8_t ep)
+{
+	return ep == USBACM_EP_OUT ? 1 : ep == USBACM_EP_IN ? 2 : ep == USBACM_EP_NOTIFY ? 4 : 0;
+}
+
+static inline void
+usbacm_in(struct usbacm_reply *r, const uint8_t *data, size_t len, uint16_t wlength)
+{
+	r->data = data;
+	r->len = (uint16_t)(len < wlength ? len : wlength);
+	/* nothing asked for (wLength 0): no data stage */
+	r->action = r->len == 0 && wlength == 0 ? USBACM_STATUS : USBACM_IN;
+}
+
+/*
+ * One setup packet. The answer in *r; returns r->action. s->buf holds what an IN answer points at, until the next
+ * call.
+ */
+static inline int
+usbacm_setup(struct usbacm *s, const uint8_t p[8], struct usbacm_reply *r)
+{
+	uint8_t type = p[0], req = p[1];
+	uint16_t value = (uint16_t)(p[2] | p[3] << 8), index = (uint16_t)(p[4] | p[5] << 8), length = (uint16_t)(p[6] | p[7] << 8);
+	bool in = (type & 0x80) != 0;
+	uint8_t recipient = type & 0x1f;
+
+	memset(r, 0, sizeof(*r));
+	r->action = USBACM_STALL;
+	s->out_request = 0;
+
+	if ((type & 0x60) == 0x00) {            /* standard */
+		switch (req) {
+		case 0x00:                      /* GET_STATUS */
+			if (!in || length < 2 || value != 0) {
+				break;
+			}
+			s->buf[0] = 0;
+			s->buf[1] = 0;
+			if (recipient == 0) {
+				s->buf[0] = 1;  /* self-powered */
+			} else if (recipient == 1) {
+				if (s->config == 0 || index > 1) {
+					break;
+				}
+			} else if (recipient == 2) {
+				uint8_t bit = usbacm_ep_bit((uint8_t)index);
+
+				if ((index & 0x7f) != 0 && (bit == 0 || s->config == 0)) {
+					break;
+				}
+				s->buf[0] = (s->halted & bit) ? 1 : 0;
+			} else {
+				break;
+			}
+			usbacm_in(r, s->buf, 2, length);
+			break;
+		case 0x01:                      /* CLEAR_FEATURE */
+		case 0x03:                      /* SET_FEATURE */
+			if (in || length != 0) {
+				break;
+			}
+			if (recipient == 0 && value == 1) {     /* DEVICE_REMOTE_WAKEUP: not offered, accepted as no-op */
+				r->action = USBACM_STATUS;
+			} else if (recipient == 2 && value == 0) {  /* ENDPOINT_HALT */
+				uint8_t bit = usbacm_ep_bit((uint8_t)index);
+
+				if ((index & 0x7f) == 0) {
+					r->action = USBACM_STATUS;      /* ep0's halt clears itself */
+					break;
+				}
+				if (bit == 0 || s->config == 0) {
+					break;
+				}
+				if (req == 0x01) {
+					s->halted &= (uint8_t)~bit;
+					r->effects |= USBACM_EFF_CLEAR_HALT;
+				} else {
+					s->halted |= bit;
+					r->effects |= USBACM_EFF_HALT;
+				}
+				r->ep = (uint8_t)index;
+				r->action = USBACM_STATUS;
+			}
+			break;
+		case 0x05:                      /* SET_ADDRESS */
+			if (in || recipient != 0 || length != 0 || index != 0 || value > 127 || s->config != 0) {
+				break;
+			}
+			s->address = (uint8_t)value;
+			r->effects |= USBACM_EFF_ADDRESS;
+			r->value = (uint8_t)value;
+			r->action = USBACM_STATUS;
+			break;
+		case 0x06: {                    /* GET_DESCRIPTOR */
+			uint8_t dtype = (uint8_t)(value >> 8), dindex = (uint8_t)value;
+			size_t n;
+
+			if (!in || recipient != 0) {
+				break;
+			}
+			switch (dtype) {
+			case 1:
+				usbacm_in(r, usbacm_device_desc, sizeof(usbacm_device_desc), length);
+				break;
+			case 2:
+			case 7:
+				if (dindex != 0) {
+					break;
+				}
+				/* 7, other speed: the configuration at the speed this is not running at */
+				n = usbacm_config_desc(s->buf, dtype == 2 ? s->high_speed : !s->high_speed, dtype);
+				usbacm_in(r, s->buf, n, length);
+				break;
+			case 3:
+				if (dindex == 0) {
+					usbacm_in(r, usbacm_lang_desc, sizeof(usbacm_lang_desc), length);
+				} else if (dindex < USBACM_STRINGS && s->strings[dindex] != NULL) {
+					n = usbacm_string_desc(s->buf, sizeof(s->buf), s->strings[dindex]);
+					usbacm_in(r, s->buf, n, length);
+				}
+				break;
+			case 6:
+				/* a high-speed capable device answers it at either speed */
+				usbacm_in(r, usbacm_qualifier_desc, sizeof(usbacm_qualifier_desc), length);
+				break;
+			default:                        /* BOS (15) and the rest: not had */
+				break;
+			}
+			break;
+		}
+		case 0x08:                      /* GET_CONFIGURATION */
+			if (!in || recipient != 0 || length < 1) {
+				break;
+			}
+			s->buf[0] = s->config;
+			usbacm_in(r, s->buf, 1, length);
+			break;
+		case 0x09:                      /* SET_CONFIGURATION */
+			if (in || recipient != 0 || length != 0 || value > 1 || s->address == 0) {
+				break;
+			}
+			s->config = (uint8_t)value;
+			s->halted = 0;
+			r->effects |= USBACM_EFF_CONFIG;
+			r->value = (uint8_t)value;
+			r->action = USBACM_STATUS;
+			break;
+		case 0x0a:                      /* GET_INTERFACE */
+			if (!in || recipient != 1 || s->config == 0 || index > 1 || length < 1) {
+				break;
+			}
+			s->buf[0] = 0;
+			usbacm_in(r, s->buf, 1, length);
+			break;
+		case 0x0b:                      /* SET_INTERFACE: alternate 0 only */
+			if (in || recipient != 1 || s->config == 0 || index > 1 || value != 0 || length != 0) {
+				break;
+			}
+			r->action = USBACM_STATUS;
+			break;
+		default:
+			break;
+		}
+		return r->action;
+	}
+
+	if ((type & 0x60) == 0x20 && recipient == 1 && index == 0) {    /* class, to the ACM interface */
+		switch (req) {
+		case 0x20:                      /* SET_LINE_CODING */
+			if (in || length != 7) {
+				break;
+			}
+			s->out_request = req;
+			r->len = 7;
+			r->action = USBACM_OUT;
+			break;
+		case 0x21:                      /* GET_LINE_CODING */
+			if (!in || length < 7) {
+				break;
+			}
+			memcpy(s->buf, s->line_coding, 7);
+			usbacm_in(r, s->buf, 7, length);
+			break;
+		case 0x22:                      /* SET_CONTROL_LINE_STATE */
+			if (in || length != 0) {
+				break;
+			}
+			s->lines = value & 3;
+			r->effects |= USBACM_EFF_LINES;
+			r->action = USBACM_STATUS;
+			break;
+		case 0x23:                      /* SEND_BREAK */
+			if (in || length != 0) {
+				break;
+			}
+			r->effects |= USBACM_EFF_BREAK;
+			r->action = USBACM_STATUS;
+			break;
+		default:
+			break;
+		}
+	}
+	return r->action;
+}
+
+/* The OUT data stage of the request usbacm_setup() answered USBACM_OUT to: len bytes. USBACM_STATUS or USBACM_STALL. */
+static inline int
+usbacm_out_done(struct usbacm *s, const uint8_t *data, size_t len, struct usbacm_reply *r)
+{
+	memset(r, 0, sizeof(*r));
+	r->action = USBACM_STALL;
+	if (s->out_request == 0x20 && len == 7) {
+		memcpy(s->line_coding, data, 7);
+		r->effects |= USBACM_EFF_LINE_CODING;
+		r->action = USBACM_STATUS;
+	}
+	s->out_request = 0;
+	return r->action;
+}
+
+/* A bus reset: the default state again (address 0, not configured, nothing halted). */
+static inline void
+usbacm_reset(struct usbacm *s)
+{
+	s->address = 0;
+	s->config = 0;
+	s->halted = 0;
+	s->lines = 0;
+	s->out_request = 0;
+}
+
+/*
+ * The line console's input: bytes from the host gathered into a line. Returns true when c ended a line (CR or LF;
+ * an empty line is not one), which is then in l->line, NUL-terminated. Backspace and DEL take a character back;
+ * other control characters and anything past the buffer are dropped.
+ */
+struct usbacm_line {
+	char            line[128];
+	uint32_t        len;
+	bool            overflow;
+};
+
+static inline bool
+usbacm_line_feed(struct usbacm_line *l, uint8_t c)
+{
+	if (c == '\r' || c == '\n') {
+		if (l->len == 0) {
+			l->overflow = false;
+			return false;
+		}
+		l->line[l->len] = 0;
+		l->len = 0;
+		l->overflow = false;
+		return true;
+	}
+	if (c == 8 || c == 127) {
+		if (l->len > 0) {
+			l->len--;
+		}
+		return false;
+	}
+	if (c < 32 || c > 126) {
+		return false;
+	}
+	if (l->len + 1 >= sizeof(l->line)) {
+		l->overflow = true;
+		return false;
+	}
+	l->line[l->len++] = (char)c;
+	return false;
+}
+
+#endif /* _HAKIOS_USB_ACM_H_ */
diff --git a/bsd/dev/hakios.usb_glue.h b/bsd/dev/hakios.usb_glue.h
new file mode 100644
index 000000000..37adad572
--- /dev/null
+++ b/bsd/dev/hakios.usb_glue.h
@@ -0,0 +1,34 @@
+/*
+ * What the USB gadget driver (drivers/usb/hakios.dwc3.c, device-neutral: a DesignWare DWC3 in device mode with a
+ * CDC-ACM function) needs from the SoC it runs on: where the controller is, and how its clocks, power and PHY are
+ * brought up. One of these per SoC; the Exynos 9810's is drivers/usb/hakios.exynos_usb.c.
+ */
+#ifndef _HAKIOS_USB_GLUE_H_
+#define _HAKIOS_USB_GLUE_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define USB_GLUE_CLK    0x1u    /* usb_gadget_clk=1: open the controller's clocks where the boot left them shut */
+#define USB_GLUE_LDO    0x2u    /* usb_gadget_ldo=1: the PHY's supplies into Android's USB mode */
+
+typedef int (*usb_glue_say_t)(const char *format, ...);
+
+struct hakios_usb_glue {
+	const char      *name;
+	uint64_t        dwc3_pa;        /* the DWC3's registers (its global ones at +0xc100) */
+	uint32_t        dwc3_size;
+	/* step 1: read what the boot left and say it; true when the DWC3's registers can be read without a bus hang */
+	bool            (*look)(usb_glue_say_t say, uint32_t flags);
+	/* step 2: power, clocks, the PHY up in device mode (high speed; the SuperSpeed lanes held idle); 0 or an errno */
+	int             (*phy_on)(usb_glue_say_t say, uint32_t flags);
+	/* a line of the PHY's state (the D+/D- line state, VBUS as the link sees it), for the log while enumerating */
+	void            (*phy_state)(char *out, unsigned size);
+	/* the way back to the loader: the PHY into reset and isolated again (the link already stopped) */
+	void            (*phy_off)(void);
+};
+
+/* drivers/usb/hakios.exynos_usb.c; NULL from hakios.stubs.c when that driver is left out */
+const struct hakios_usb_glue *hakios_usb_glue_exynos9810(void);
+
+#endif /* _HAKIOS_USB_GLUE_H_ */

diff --git a/bsd/dev/starlte_muic.c b/bsd/dev/starlte_muic.c
new file mode 100644
index 000000000..9f827ecb3
--- /dev/null
+++ b/bsd/dev/starlte_muic.c
@@ -0,0 +1,122 @@
+/*
+ * iOS 27 on STARLTE (8 Nov 2026): close the Galaxy S9's USB-C switch
+ * (MAX77705 MUIC CONTROL1 = COM_USB, D+/D- to the AP's USB) so the DWC3 gadget console
+ * (hakios.dwc3.c, usb_gadget=5) can be seen by the host. The facts and the opcode sequence are
+ * those of Scion's hakios.max77705.c (max77705_usbsw=1); bus through hakios.exynos_hsi2c.c.
+ * No interrupt, no VBUS tracking: close it at boot and re-check every 2 s for 2 minutes.
+ * Boot-arg usb_muic=1 (default 1 when usb_gadget is set).
+ */
+#include <stdbool.h>
+#include <stdint.h>
+#include <kern/clock.h>
+#include <kern/thread_call.h>
+#include <kern/startup.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <sys/hakios.exynos_hsi2c.h>
+#include <sys/hakios.xnu.h>
+
+#define MUIC                    0x25
+#define OPCODE_WRITE            0x21
+#define OPCODE_WRITE_END        0x41
+#define OPCODE_READ             0x51
+#define OPCODE_CTRL1_R          0x05
+#define OPCODE_CTRL1_W          0x06
+#define COM_USB                 0x09
+#define MUIC_BC_STATUS          0x08
+
+extern int hakios_say(const char *format, ...);
+
+static struct hakios_hsi2c bus = {
+	.name = "muic",
+	.regs_pa = 0x14360000UL, .usi_mode_pa = 0x14212030UL,
+	.cmu_pa = 0x14200000UL, .cmu_size = 0x4000,
+	.gates = { 0x2014, 0x20A8, 0x20AC, 0x2074 }, .ngates = 4,
+	.qch = 0x3050, .div = 0x1814, .mux = 0x1018,
+	.pins_pa = 0, .ipclk_mhz = 400, .bus_hz = 400000,
+};
+static thread_call_t muic_call;
+static int muic_ticks;
+static bool muic_up;
+
+static uint32_t
+ctrl1_write(uint8_t value)
+{
+	uint8_t w1[3] = { OPCODE_WRITE, OPCODE_CTRL1_W, value }, w2[2] = { OPCODE_WRITE_END, 0 };
+	uint32_t e = hakios_hsi2c_message(&bus, MUIC, false, w1, 3, true);
+	return e ? e : hakios_hsi2c_message(&bus, MUIC, false, w2, 2, true);
+}
+
+static int
+ctrl1_read(void)
+{
+	uint8_t w1[2] = { OPCODE_WRITE, OPCODE_CTRL1_R }, w2[2] = { OPCODE_WRITE_END, 0 }, a[2] = { 0, 0 };
+	uint32_t e = hakios_hsi2c_message(&bus, MUIC, false, w1, 2, true);
+	if (e == 0) {
+		e = hakios_hsi2c_message(&bus, MUIC, false, w2, 2, true);
+	}
+	for (int i = 0; e == 0 && i < 10; i++) {
+		delay(10000);
+		if ((e = hakios_hsi2c_read_reg(&bus, MUIC, OPCODE_READ, a, 2)) == 0 && a[0] == OPCODE_CTRL1_R) {
+			return a[1];
+		}
+	}
+	return -1;
+}
+
+static void
+muic_tick(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	if (!muic_up) {
+		if (!hakios_hsi2c_map(&bus, hakios_say)) {
+			printf("STARLTE MUIC: HSI2C map failed\n");
+			return;
+		}
+		hakios_hsi2c_power(&bus);
+		vm_offset_t g = ml_io_map(0x14220000, 0x1000);         /* GPM14-0 SCL, GPM15-0 SDA: function 2, no pull */
+		if (g != 0) {
+			for (uint32_t b = 0x180; b <= 0x1A0; b += 0x20) {
+				volatile uint32_t *con = (volatile uint32_t *)(g + b), *pud = (volatile uint32_t *)(g + b + 8);
+				*con = (*con & ~0xfu) | 2;
+				*pud = *pud & ~0xfu;
+			}
+		}
+		hakios_hsi2c_reset(&bus);
+		muic_up = true;
+	}
+	uint8_t bc = 0;
+	(void)hakios_hsi2c_read_reg(&bus, MUIC, MUIC_BC_STATUS, &bc, 1);
+	int c = ctrl1_read();
+	if (c != COM_USB) {
+		uint32_t e = ctrl1_write(COM_USB);
+		delay(50000);
+		int c2 = ctrl1_read();
+		printf("STARLTE MUIC: CONTROL1 %#x -> write COM_USB (%u) -> %#x; BC_STATUS %#x (VBUS %u type %u)\n",
+		    c, e, c2, bc, bc >> 7, bc & 3);
+	} else if (muic_ticks % 15 == 0) {
+		printf("STARLTE MUIC: CONTROL1 %#x (USB to the AP); BC_STATUS %#x\n", c, bc);
+	}
+	if (++muic_ticks < 60) {
+		uint64_t deadline;
+		clock_interval_to_deadline(2, NSEC_PER_SEC, &deadline);
+		thread_call_enter_delayed(muic_call, deadline);
+	}
+}
+
+__startup_func
+static void
+starlte_muic_init(void)
+{
+	uint32_t gadget = 0, on = 1;
+	if (!PE_parse_boot_argn("usb_gadget", &gadget, sizeof(gadget)) || gadget == 0) {
+		return;
+	}
+	(void)PE_parse_boot_argn("usb_muic", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	muic_call = thread_call_allocate_with_priority(muic_tick, NULL, THREAD_CALL_PRIORITY_KERNEL_HIGH);
+	thread_call_enter(muic_call);
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, starlte_muic_init);
diff --git a/bsd/dev/starlte_usbcon.c b/bsd/dev/starlte_usbcon.c
new file mode 100644
index 000000000..72b0aaa4f
--- /dev/null
+++ b/bsd/dev/starlte_usbcon.c
@@ -0,0 +1,159 @@
+/*
+ * iOS 27 on STARLTE (8 Nov 2026): what Scion/hakios's DWC3 gadget console
+ * (hakios.dwc3.c + hakios.exynos_usb.c, usb_gadget=5) needs from its own kernel, provided on Starbite's
+ * xnu-12377 STARLTE tree: the log tap (fed from a5xelte_log_append, the console ring every printf goes
+ * through) and stubs for the hakios subsystems this tree does not have.
+ */
+#include <stdint.h>
+#include <stdbool.h>
+#include <os/atomic_private.h>
+#include <arm64/proc_reg.h>
+#include <mach/mach_types.h>
+#include <sys/errno.h>
+#include <sys/systm.h>
+
+extern void a5xelte_log_snapshot(const char **ring, uint32_t *size, uint64_t *total);
+
+static void (*volatile starlte_usb_tap)(char c);
+static uint32_t starlte_usb_tap_lock;
+
+static bool
+tap_lock(uint64_t *daif)
+{
+	bool locked = false;
+	*daif = __builtin_arm_rsr64("DAIF");
+	__builtin_arm_wsr("DAIFSet", DAIFSC_IRQF | DAIFSC_FIQF);
+	for (uint32_t tries = 0; !locked && tries < 1000000; tries++) {
+		locked = os_atomic_cmpxchg(&starlte_usb_tap_lock, 0, 1, acquire);
+	}
+	return locked;
+}
+
+static void
+tap_unlock(bool locked, uint64_t daif)
+{
+	if (locked) {
+		os_atomic_store(&starlte_usb_tap_lock, 0, release);
+	}
+	__builtin_arm_wsr64("DAIF", daif);
+}
+
+/* Called by a5xelte_log_append (bsd/dev/a5xelte_emmc.c) with every piece of console text. */
+void starlte_usb_tap_text(const char *c, int size);
+void
+starlte_usb_tap_text(const char *c, int size)
+{
+	void (*tap)(char) = starlte_usb_tap;
+	uint64_t daif;
+	if (tap == NULL || size <= 0) {
+		return;
+	}
+	bool locked = tap_lock(&daif);
+	for (int i = 0; i < size; i++) {
+		if (c[i] != '\r') {
+			tap(c[i]);
+		}
+	}
+	tap_unlock(locked, daif);
+}
+
+uint32_t loader_log_tap_set(void (*tap)(char c), void (*history)(const char *text, uint32_t len));
+uint32_t
+loader_log_tap_set(void (*tap)(char c), void (*history)(const char *text, uint32_t len))
+{
+	const char *ring;
+	uint32_t rsize;
+	uint64_t total, daif;
+	bool locked = tap_lock(&daif);
+	a5xelte_log_snapshot(&ring, &rsize, &total);
+	if (history != NULL && total > 0) {
+		if (total <= rsize) {
+			history(ring, (uint32_t)total);
+		} else {
+			uint32_t at = (uint32_t)(total % rsize);
+			history(ring + at, rsize - at);
+			history(ring, at);
+		}
+	}
+	starlte_usb_tap = tap;
+	tap_unlock(locked, daif);
+	return (uint32_t)total;
+}
+
+void loader_log_line(const char *line);
+void
+loader_log_line(const char *line)
+{
+	printf("%s", line);
+}
+
+void loader_return(void);
+extern void starlte_return_to_recovery(void);
+void loader_return(void) { starlte_return_to_recovery(); }
+void hakios_var_save_on_return(void);
+void hakios_var_save_on_return(void) {}
+void hakios_ufs_summary(const char *when, int how);
+void hakios_ufs_summary(__unused const char *when, __unused int how) {}
+void hakios_adreno_stop(void);
+void hakios_adreno_stop(void) {}
+void hakios_wifi_stop(void);
+void hakios_wifi_stop(void) {}
+void hakios_wifi_report(bool first);
+void hakios_wifi_report(__unused bool first) {}
+void hakios_sta_console_scan(void);
+void hakios_sta_console_scan(void) {}
+#define STUB_ARG(fn) void fn(const char *arg); void fn(__unused const char *arg) { printf("usb: " #fn ": not on this kernel\n"); }
+STUB_ARG(hakios_bt_console)
+STUB_ARG(hakios_net_console_ping)
+STUB_ARG(hakios_net_console_dns)
+STUB_ARG(hakios_net_console_tcp)
+STUB_ARG(hakios_net_console_names)
+STUB_ARG(hakios_input_console_touch)
+STUB_ARG(hakios_input_console_button)
+STUB_ARG(hakios_abox_console)
+STUB_ARG(hakios_cs47l93_console)
+STUB_ARG(hakios_ssp_console)
+STUB_ARG(hakios_max77705_usb_console)
+void hakios_net_console_ip(void);
+void hakios_net_console_ip(void) {}
+void hakios_net_console_stat(void);
+void hakios_net_console_stat(void) {}
+void hakios_adsp_stop(void);
+void hakios_adsp_stop(void) {}
+void hakios_max77705_usb_close(void);
+void hakios_max77705_usb_close(void) {}
+int hakios_panel_brightness(int level);
+int hakios_panel_brightness(__unused int level) { return ENODEV; }
+void hakios_exynos_cpufreq_touch(void);
+void hakios_exynos_cpufreq_touch(void) {}
+int hakios_fb_scanned(uintptr_t *base, uint32_t *width, uint32_t *height, uint32_t *rowbytes, unsigned *index);
+int hakios_fb_scanned(__unused uintptr_t *base, __unused uint32_t *width, __unused uint32_t *height,
+    __unused uint32_t *rowbytes, __unused unsigned *index) { return ENODEV; }
+bool hakios_acpm_init(int (*say)(const char *, ...));
+bool hakios_acpm_init(__unused int (*say)(const char *, ...)) { return false; }
+int hakios_acpm_pmic_read(uint32_t type, uint32_t reg, uint8_t *value);
+int hakios_acpm_pmic_read(__unused uint32_t type, __unused uint32_t reg, __unused uint8_t *value) { return ENODEV; }
+int hakios_acpm_pmic_update(uint32_t type, uint32_t reg, uint8_t value, uint8_t mask);
+int hakios_acpm_pmic_update(__unused uint32_t type, __unused uint32_t reg, __unused uint8_t value, __unused uint8_t mask) { return ENODEV; }
+
+#include <stdarg.h>
+int hakios_say(const char *format, ...) __printflike(1, 2);
+int
+hakios_say(const char *format, ...)
+{
+	va_list ap;
+	va_start(ap, format);
+	vprintf(format, ap);
+	va_end(ap);
+	return 0;
+}
+
+/* the console's camshot/irshot/swipe and the kern.hakios sysctl node, which this tree does not have */
+#include <sys/sysctl.h>
+SYSCTL_NODE(_kern, OID_AUTO, hakios, CTLFLAG_RW | CTLFLAG_LOCKED, NULL, "hakios (USB console only)");
+void hakios_touch_post(uint32_t type, uint32_t finger, uint32_t x, uint32_t y);
+void hakios_touch_post(__unused uint32_t type, __unused uint32_t finger, __unused uint32_t x, __unused uint32_t y) {}
+const char *hakios_exynos_camera_shot(uint32_t n, int pattern);
+const char *hakios_exynos_camera_shot(__unused uint32_t n, __unused int pattern) { return "no camera driver on this kernel"; }
+const char *hakios_exynos_iris_shot(uint32_t n);
+const char *hakios_exynos_iris_shot(__unused uint32_t n) { return "no iris driver on this kernel"; }
diff --git a/bsd/sys/hakios.exynos9810_soc.h b/bsd/sys/hakios.exynos9810_soc.h
new file mode 100644
index 000000000..06496fd4c
--- /dev/null
+++ b/bsd/sys/hakios.exynos9810_soc.h
@@ -0,0 +1,284 @@
+/*
+ * The Samsung Exynos 9810 (S5E9810), whatever phone it is in: where its blocks are and the SoC-specific offsets the shared
+ * Exynos drivers use. Nothing but numbers. A driver includes <sys/hakios.exynos_soc.h>, which picks this file by the build's
+ * CONFIG_SOC, and keeps its own name for each number, so a new SoC is a new socs/<soc>/include/hakios.<soc>_soc.h and no
+ * edit of the driver unless the hardware itself differs (docs/porting/repositories.md, "A new Exynos").
+ *
+ * Sources: the phones' device trees and Samsung's GPL kernel; each driver names the place beside its macro. How the memory
+ * outside XNU's RAM is used is in sys/hakios.exynos9810_mem.h.
+ */
+#ifndef _SYS_HAKIOS_EXYNOS9810_SOC_H_
+#define _SYS_HAKIOS_EXYNOS9810_SOC_H_
+
+/* The SoC, and the power processor */
+#define EXYNOS_APM_SRAM_PA                      0x02039000UL
+#define EXYNOS_SOC_BASE_PA                      0x10000000UL
+#define EXYNOS_CHIPID_PA                        0x10000000UL
+#define EXYNOS_PRODUCT_ID                       0xE9810000u
+#define EXYNOS_PMU_PA                           0x14060000UL
+#define EXYNOS_APM_MBOX_PA                      0x14100000UL
+
+/* Clock controllers (CMU) */
+#define EXYNOS_CMU_PERIS_PA                     0x10020000UL
+#define EXYNOS_CMU_PERIC0_PA                    0x10400000UL
+#define EXYNOS_CMU_PERIC1_PA                    0x10800000UL
+#define EXYNOS_CMU_FSYS0_PA                     0x11000000UL
+#define EXYNOS_CMU_FSYS1_PA                     0x11400000UL
+#define EXYNOS_CMU_CHUB_PA                      0x13A00000UL
+#define EXYNOS_CMU_CMGP_PA                      0x14200000UL
+#define EXYNOS_CMU_ISPPRE_PA                    0x16200000UL
+#define EXYNOS_CMU_G3D_PA                       0x17400000UL
+#define EXYNOS_CMU_MFC_PA                       0x17800000UL
+#define EXYNOS_CMU_AUD_PA                       0x17C00000UL
+#define EXYNOS_CMU_BUSC_PA                      0x1A200000UL
+#define EXYNOS_CMU_TOP_PA                       0x1A240000UL
+#define EXYNOS_CMU_TOP_PAGE2_PA                 0x1A242000UL
+
+/* GPIO */
+#define EXYNOS_GPIO_PERIC0_PA                   0x10430000UL
+#define EXYNOS_GPIO_PERIC1_PA                   0x10830000UL
+#define EXYNOS_GPIO_FSYS1_PA                    0x11430000UL
+#define EXYNOS_GPIO_CHUB_PA                     0x13A80000UL
+#define EXYNOS_GPIO_ALIVE_PA                    0x14050000UL
+#define EXYNOS_GPIO_AUD_PA                      0x17C60000UL
+
+/* System registers */
+#define EXYNOS_SYSREG_PERIC0_PA                 0x10410000UL
+#define EXYNOS_SYSREG_FSYS1_PA                  0x11410000UL
+#define EXYNOS_SYSREG_FSYS1_PAGE2_PA            0x11411000UL
+#define EXYNOS_SYSREG_ISPPRE_PA                 0x16210000UL
+
+/* USB */
+#define EXYNOS_USB_DWC3_PA                      0x10C00000UL
+#define EXYNOS_USB_CON_PA                       0x11100000UL
+
+/* Thermal */
+#define EXYNOS_TMU_TOP_PA                       0x10070000UL
+#define EXYNOS_TMU_SUB_PA                       0x10074000UL
+
+/* UFS */
+#define EXYNOS_UFS_SYSREG_COH_PA                0x11010700UL
+#define EXYNOS_UFS_UNIPRO_PA                    0x11110000UL
+#define EXYNOS_UFS_HCI_PA                       0x11120000UL
+#define EXYNOS_UFS_VS_PA                        0x11121100UL
+#define EXYNOS_UFS_PMA_PA                       0x11124000UL
+#define EXYNOS_UFS_PMU_PHY_PA                   0x14060724UL
+
+/* Display */
+#define EXYNOS_DPP_PA                           0x16020000UL
+#define EXYNOS_DECON_PA                         0x16030000UL
+#define EXYNOS_DPU_DMA_PA                       0x16070000UL
+#define EXYNOS_DSIM0_PA                         0x16080000UL
+
+/* GPU */
+#define EXYNOS_MALI_PA                          0x17500000UL
+
+/* Video */
+#define EXYNOS_MFC_SYSMMU0_PA                   0x17880000UL
+#define EXYNOS_MFC_SYSMMU1_PA                   0x178A0000UL
+#define EXYNOS_MFC_PA                           0x178D0000UL
+
+/* PCIe (Wi-Fi) */
+#define EXYNOS_PCIE_SYSMMU_PA                   0x11420000UL
+#define EXYNOS_PCIE_ELBI_PA                     0x116A0000UL
+#define EXYNOS_PCIE_PCS_PA                      0x116C0000UL
+#define EXYNOS_PCIE_PHY_PA                      0x116D0000UL
+#define EXYNOS_PCIE_DBI_PA                      0x11700000UL
+#define EXYNOS_PCIE_MEM_PA                      0x11800000UL
+#define EXYNOS_PCIE_CFG_PA                      0x127FE000UL
+
+/* Camera: CSIS and its DMA */
+#define EXYNOS_CSIS1_PHY_PA                     0x16180000UL

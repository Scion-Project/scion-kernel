+/* ABOX: power and clocks */
+#define EXYNOS_ABOX_CMU_DIV_UAIF0               0x1824
+#define EXYNOS_ABOX_CMU_MUX_UAIF0               0x1004
+#define EXYNOS_ABOX_CMU_QCH_BCLK0               0x3028

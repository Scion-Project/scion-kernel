From 4d555896ff12c247f3b1b33f77b1cc7f9773a282 Mon Sep 17 00:00:00 2001
From: Starbite author <starbite@local>
Date: Wed, 4 Nov 2026 01:50:47 +0200
Subject: [PATCH] patch: 0362-sweet-surface-limits-macos.patch - IOSurface
 limits (sel 13) for macOS callers: the 0x28 form's maxima (+0x08 bytes per
 row, +0x10 width, +0x18 height; macOS 26.5 IOSurfaceClientGetPropertyMaximum
 read zeros), PLATFORM_MACOS only, iOS unchanged

---
 iokit/Kernel/arm/SweetSurface.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index ef88257e..f6338fc7 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -1016,6 +1016,18 @@ IOSurfaceRootUserClient::externalMethodInner(uint32_t selector, IOExternalMethod
 		put32(limits, 0x0, SWEET_SURFACE_ROW_ALIGN - 1);
 		put32(limits, 0x4, SWEET_SURFACE_ROW_ALIGN - 1);
 		limits[len == 0x28 ? 0x22 : 0x16] = 1;
+		/*
+		 * macOS 26.5 IOSurface.framework (IOSurfaceClientGetPropertyMaximum) reads
+		 * the 0x28 form's maxima: +0x08 bytes per row, +0x10 width, +0x18 height
+		 * (u64; with zeros every maximum is 0). +0x0 / +0x4 are the offset and
+		 * row alignment masks (IOSurfaceClientAlignProperty). Filled for macOS
+		 * callers only (PLATFORM_MACOS = 1): iOS 26 keeps the answer it boots with.
+		 */
+		if (len == 0x28 && proc_platform(current_proc()) == 1) {
+			put64(limits, 0x08, (uint64_t)SWEET_SURFACE_MAX_DIM * 64);
+			put64(limits, 0x10, SWEET_SURFACE_MAX_DIM);
+			put64(limits, 0x18, SWEET_SURFACE_MAX_DIM);
+		}
 		sweet_surf_log_once("sel", selector);
 		return sweet_struct_out(args, limits, len);
 	}

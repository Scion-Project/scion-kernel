From 784bab65c5a6bcd7c9e19c8cc3785a434d50f8b7 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:30:32 +0200
Subject: [PATCH] patch: 0059-sweet-iphone-identity.patch

---
 bsd/kern/kern_mib.c                      |  4 +++-
 iokit/Kernel/arm/SweetPlatformExpert.cpp | 26 +++++-------------------
 2 files changed, 8 insertions(+), 22 deletions(-)

diff --git a/bsd/kern/kern_mib.c b/bsd/kern/kern_mib.c
index e67ea79a..1658d855 100644
--- a/bsd/kern/kern_mib.c
+++ b/bsd/kern/kern_mib.c
@@ -542,7 +542,9 @@ sysctl_hw_generic(__unused struct sysctl_oid *oidp, void *arg1,
 		 * Deprecated variables.  We still support these for
 		 * backwards compatibility purposes only.
 		 */
-#if XNU_TARGET_OS_OSX && defined(__arm64__)
+#if XNU_TARGET_OS_OSX && defined(__arm64__) && !defined(ARM64_BOARD_CONFIG_SWEET)
+	/* SWEET: the macOS config runs the iOS userland, which wants the
+	 * device-tree names (hw.machine iPhone10,3, hw.model D22AP). */
 	/* The following two are kludged for backward
 	 * compatibility. Use hw.product/hw.target for something
 	 * consistent instead. */
diff --git a/iokit/Kernel/arm/SweetPlatformExpert.cpp b/iokit/Kernel/arm/SweetPlatformExpert.cpp
index a8f07042..0631685e 100644
--- a/iokit/Kernel/arm/SweetPlatformExpert.cpp
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp
@@ -18,8 +18,6 @@ public:
 	void processTopLevel(IORegistryEntry *root) APPLE_KEXT_OVERRIDE;
 	const char *deleteList(void) APPLE_KEXT_OVERRIDE;
 	const char *excludeList(void) APPLE_KEXT_OVERRIDE;
-	bool getTargetName(char *name, int maxLength) APPLE_KEXT_OVERRIDE;
-	bool getProductName(char *name, int maxLength) APPLE_KEXT_OVERRIDE;
 };
 
 OSDefineMetaClassAndStructors(SweetPlatformExpert, IODTPlatformExpert);
@@ -76,23 +74,9 @@ SweetPlatformExpert::processTopLevel(IORegistryEntry *root)
 	}
 }
 
-bool
-SweetPlatformExpert::getTargetName(char *name, int maxLength)
-{
-	if (name == NULL || maxLength <= 0) {
-		return false;
-	}
-	strlcpy(name, "sweet", (size_t)maxLength);
-	return true;
-}
-
-bool
-SweetPlatformExpert::getProductName(char *name, int maxLength)
-{
-	if (name == NULL || maxLength <= 0) {
-		return false;
-	}
-	strlcpy(name, "Redmi Note 10 Pro", (size_t)maxLength);
-	return true;
-}
+/*
+ * hw.target / hw.product come from IODTPlatformExpert: the first root
+ * "compatible" string and "model" (D22AP / iPhone10,3 in the ADT), which
+ * is what the iPhone userland (MobileGestalt) expects.
+ */
 #endif /* SWEET */
-- 
2.53.0


diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -13852,7 +13852,10 @@
 
 		/* Disable PAN; pmap shouldn't be the kernel pmap. */
 #if __ARM_PAN_AVAILABLE__
-		__builtin_arm_wsr("pan", 0);
+		extern uint32_t hakios_pan_off;
+		if (!hakios_pan_off) {
+			__builtin_arm_wsr("pan", 0);
+		}
 #endif /* __ARM_PAN_AVAILABLE__ */
 	}
 
@@ -13871,7 +13874,10 @@
 
 	if (pmap != NULL) {
 #if __ARM_PAN_AVAILABLE__
-		__builtin_arm_wsr("pan", 1);
+		extern uint32_t hakios_pan_off;
+		if (!hakios_pan_off) {
+			__builtin_arm_wsr("pan", 1);
+		}
 #endif /* __ARM_PAN_AVAILABLE__ */
 
 		pmap_switch(old_pmap);
diff --git a/osfmk/arm64/copyio.c b/osfmk/arm64/copyio.c
--- a/osfmk/arm64/copyio.c
+++ b/osfmk/arm64/copyio.c
@@ -82,12 +82,18 @@
 	COPYIO_ATOMIC                   = 0x0010,
 });
 
+#if __ARM_PAN_AVAILABLE__
+extern uint32_t hakios_pan_off;         /* osfmk/arm/arm_init.c (patch 1509): no PAN instruction at all */
+#endif
+
 static inline void
 user_access_enable(void)
 {
 #if __ARM_PAN_AVAILABLE__
-	assert(__builtin_arm_rsr("pan") != 0);
-	__builtin_arm_wsr("pan", 0);
+	if (!hakios_pan_off) {
+		assert(__builtin_arm_rsr("pan") != 0);
+		__builtin_arm_wsr("pan", 0);
+	}
 #endif  /* __ARM_PAN_AVAILABLE__ */
 
 }
@@ -96,7 +102,9 @@
 user_access_disable(void)
 {
 #if __ARM_PAN_AVAILABLE__
-	__builtin_arm_wsr("pan", 1);
+	if (!hakios_pan_off) {
+		__builtin_arm_wsr("pan", 1);
+	}
 #endif  /* __ARM_PAN_AVAILABLE__ */
 
 }

diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -165,6 +165,32 @@
 	adrp	x19, EXT(ResetHandlerData)@page			// Get address of the reset handler data
 	add		x19, x19, EXT(ResetHandlerData)@pageoff
 	mrs		x15, MPIDR_EL1						// Load MPIDR to get CPU number
+	// HakiOS diagnostic (S9 M3 bring-up): this core's ID registers, MMU off, to the start of exynos-snapshot's
+	// log_kernel (0xFDA10000) at 32 * Affinity1: MMFR0, MIDR, MPIDR, PFR0 -- read back from TWRP's /proc/last_kmsg
+	movz	x2, #0xFDA1, lsl #16
+	ubfx	x3, x15, #8, #4
+	add		x2, x2, x3, lsl #5
+	mrs		x3, ID_AA64MMFR0_EL1
+	str		x3, [x2]
+	mrs		x3, MIDR_EL1
+	str		x3, [x2, #8]
+	str		x15, [x2, #16]
+	mrs		x3, ID_AA64PFR0_EL1
+	str		x3, [x2, #24]
+	dsb		sy
+	// a big core (MT clear, Affinity1 1) parks here when asked (boot-arg m3_ids=1): its IDs read by the boot core
+	adrp	x2, EXT(hakios_m3_park)@page
+	add		x2, x2, EXT(hakios_m3_park)@pageoff
+	ldr		w2, [x2]
+	cbz		w2, Lm3_nopark
+	tbnz	x15, #24, Lm3_nopark
+	ubfx	x3, x15, #8, #4
+	cmp		x3, #1
+	b.ne	Lm3_nopark
+Lm3_park:
+	wfe
+	b		Lm3_park
+Lm3_nopark:
 #if HAS_CLUSTER || defined(GENERIC_PSCI_SMP)
 	// (generic boards: some number their cores in Affinity1 and leave Affinity0 at zero;
 	// a cpu data's phys id is both fields, as the device tree's "reg" has them)
@@ -402,7 +428,8 @@
 
 	.align	3
 Lsecondary_early_exception:
-	// struct psci_smp_start_fault: { valid, MPIDR, ESR, ELR, FAR, LR, SP }
+	// struct psci_smp_start_fault (psci_smp.c, patch 1509: two cache lines): { valid, MPIDR, ESR, ELR,
+	// FAR, LR, SP, SPSR, TPIDR_EL1, TTBR0, TTBR1, TCR, SCTLR, VBAR, x21 (start.s: the cpu data's PA), source }
 	adrp	x9, EXT(psci_smp_start_fault)@page
 	add		x9, x9, EXT(psci_smp_start_fault)@pageoff
 	mrs		x10, MPIDR_EL1
@@ -416,10 +443,41 @@
 	str		lr, [x9, #40]
 	mov		x10, sp
 	str		x10, [x9, #48]
+	mrs		x10, SPSR_EL1
+	str		x10, [x9, #56]
+	mrs		x10, TPIDR_EL1
+	str		x10, [x9, #64]
+	mrs		x10, TTBR0_EL1
+	str		x10, [x9, #72]
+	mrs		x10, TTBR1_EL1
+	str		x10, [x9, #80]
+	mrs		x10, TCR_EL1
+	str		x10, [x9, #88]
+	mrs		x10, SCTLR_EL1
+	str		x10, [x9, #96]
+	mrs		x10, VBAR_EL1
+	str		x10, [x9, #104]
+	str		x21, [x9, #112]
+	mov		x10, #1								// source 1: the early vectors
+	str		x10, [x9, #120]
+	add		x10, x9, #64
+	dc		civac, x10							// the second line first: valid is in the first
+	dsb		sy
 	mov		x10, #1
 	str		x10, [x9]
-	dc		cvac, x9
+	dc		civac, x9
 	dsb		sy
+	// m3_diag=1: park here (an M3 does not come back from CPU_OFF, and Carbon leaves VBAR_EL2 unset on a
+	// secondary core, so neither HVC nor CPU_OFF is safe on the core being diagnosed)
+	adrp	x10, EXT(psci_smp_diag)@page
+	add		x10, x10, EXT(psci_smp_diag)@pageoff
+	ldr		w10, [x10]
+	cbz		w10, Lsecondary_early_off
+	msr		DAIFSet, #(DAIFSC_ALL)
+Lsecondary_early_park:
+	wfe
+	b		Lsecondary_early_park
+Lsecondary_early_off:
 	// PSCI CPU_OFF, by the firmware's calling convention (psci_smp_hvc)
 	adrp	x9, EXT(psci_smp_hvc)@page
 	add		x9, x9, EXT(psci_smp_hvc)@pageoff
@@ -935,7 +993,22 @@
 	add		x0, x0, x22									// Convert exception vector address to KVA
 	sub		x0, x0, x23
 1:
+#if defined(GENERIC_PSCI_SMP)
+	// HakiOS (patch 1509): with m3_diag=1 a core being started keeps the physical early vectors
+	// (LowSecondaryExceptionVectorBase, reached through the V=P map once the MMU is on) until
+	// arm_init_cpu() has its thread in TPIDR_EL1 (psci_smp_diag_vectors()). Its first exception is then
+	// recorded in full and the core parks, instead of entering sleh with no thread and recursing.
+	cbz		x21, Lvbar_kernel
+	adrp	x9, EXT(psci_smp_diag)@page
+	add		x9, x9, EXT(psci_smp_diag)@pageoff
+	ldr		w9, [x9]
+	cbnz	w9, Lvbar_done
+Lvbar_kernel:
+#endif
 	MSR_VBAR_EL1_X0
+#if defined(GENERIC_PSCI_SMP)
+Lvbar_done:
+#endif
 

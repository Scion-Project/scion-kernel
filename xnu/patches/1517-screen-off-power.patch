diff --git a/osfmk/arm/cpu_common.c b/osfmk/arm/cpu_common.c
--- a/osfmk/arm/cpu_common.c
+++ b/osfmk/arm/cpu_common.c
@@ -57,6 +57,7 @@
 #include <arm/machine_routines.h>
 #include <arm64/proc_reg.h>
 #include <libkern/OSAtomic.h>
+#include <pexpert/arm64/board_config.h>
 
 SECURITY_READ_ONLY_LATE(struct percpu_base) percpu_base;
 vm_address_t     percpu_base_cur;
@@ -670,6 +671,10 @@
 		;
 	}
 }
+
+#if defined(GENERIC_PSCI_SMP)
+uint32_t hakios_cpu_exit_mask;          /* patch 1517: a bit per cpu number, set by GenericARMPE.cpp (sleep_cores=) */
+#endif
 
 boolean_t
 cpu_can_exit(__unused int cpu)
@@ -877,7 +882,18 @@
 	}
 #else
 	(void)reason;
+#if defined(GENERIC_PSCI_SMP)
+	/*
+	 * Scion (patch 1517): the cores GenericARMPE.cpp's sleep_cores= takes off while the screen is off, and only those
+	 * (never the boot processor): their bits are set in hakios_cpu_exit_mask just before processor_exit(). Without
+	 * sleep_cores= the mask stays 0 and nothing changes: processor_exit() is refused, as it always was here.
+	 */
+	if (cpu_id >= 0 && cpu_id < 32 && (*(volatile uint32_t *)&hakios_cpu_exit_mask & (1u << cpu_id)) != 0 &&
+	    CpuDataEntries[cpu_id].cpu_data_vaddr != &BootCpuData) {
+		return true;
+	}
 #endif
+#endif
 	return false;
 }
 
diff --git a/osfmk/arm64/cpu.c b/osfmk/arm64/cpu.c
--- a/osfmk/arm64/cpu.c
+++ b/osfmk/arm64/cpu.c
@@ -349,6 +349,16 @@
 #endif
 	}
 #else
+#if defined(GENERIC_PSCI_SMP)
+	/*
+	 * Scion (patch 1517): processor_exit() (sleep_cores=, GenericARMPE.cpp) waits in cpu_exit_wait() for this token,
+	 * which only the Apple path above sets. The caches are clean; what is left is the firmware's CPU_OFF
+	 * (PE_cpu_machine_quiesce() -> GenericARMCPU::quiesceCPU() -> psci_smp_cpu_off()), which cleans this core's own.
+	 * A start of this core waits for the firmware to say it is off (psci_smp_start_cpu()).
+	 */
+	cpu_data_ptr->cpu_sleep_token = ARM_CPU_ON_SLEEP_PATH;
+	__builtin_arm_dsb(DSB_ISH);
+#endif
 	PE_cpu_machine_quiesce(cpu_data_ptr->cpu_id);
 #endif
 	/*NOTREACHED*/

0100: minicrypto (patches/xnu-8796/0280, applied before this from that directory) built on this base: the crypto provider in place of Apple's corecrypto kext.
Its digests, AES and HMAC-DRBG only; not the key store's parts (mc_keywrap.c, third_party/). It registers only in a SCION_NATIVE_PAC kernel, and at the end of the SYSCTL stage: xnu-12377 runs EARLY_BOOT after PE_init_iokit, whose platform UUID already takes a SHA-1.
Scion's change to Apple's xnu, under the APSL 2.0.

diff --git a/osfmk/conf/files b/osfmk/conf/files
index 75bbfc1c1a4da193c8ea34ec0c5dcf1b0e640510..acbf640721d00e1de075166e44c24977bb225f7e 100644
--- a/osfmk/conf/files
+++ b/osfmk/conf/files
@@ -372,6 +372,13 @@ osfmk/kern/telemetry.c			optional config_telemetry
 osfmk/kern/trap_telemetry.c		optional config_telemetry
 osfmk/kern/bootprofile.c		optional config_telemetry
 
+# Scion: minicrypto, the crypto provider in place of Apple's corecrypto kext (patches/xnu-8796/0280); on this base
+# it registers only in a SCION_NATIVE_PAC kernel (mc_provider.c). The key store's parts (mc_keywrap.c, third_party/) are not built here.
+osfmk/minicrypto/mc_digests.c	standard
+osfmk/minicrypto/mc_provider.c	standard
+osfmk/minicrypto/mc_aes.c	standard
+osfmk/minicrypto/mc_ce.c	standard
+
 # Built-in corecrypto for early_random():
 osfmk/corecrypto/cc_clear.c	standard
 osfmk/corecrypto/cc_cmp_safe.c	standard
diff --git a/osfmk/minicrypto/mc_provider.c b/osfmk/minicrypto/mc_provider.c
index 4ba60565d8ccb9943a7dba22e91b69df28b02db2..ea1427c3e04c18c88ef7f4f20e37cd63d4f6dd72 100644
--- a/osfmk/minicrypto/mc_provider.c
+++ b/osfmk/minicrypto/mc_provider.c
@@ -468,4 +468,13 @@ minicrypto_init(void)
 	register_and_init_prng((struct cckprng_ctx *)(void *)&mc_prng, &mc_prng_funcs);
 	printf("minicrypto: registered (md5, sha1, sha2, hmac, aes-ecb/cbc/ctr, hmac-drbg prng); no xts/gcm, no RSA; the ARMv8 crypto instructions %s\n", mc_ce_on ? "in use" : "not in use");
 }
+#if !defined(ARM64_BOARD_CONFIG_VMAPPLE)
 STARTUP(EARLY_BOOT, STARTUP_RANK_FIRST, minicrypto_init);
+#elif SCION_NATIVE_PAC
+/*
+ * xnu-12377 (VMAPPLE; patches/xnu-12377/0100): only in a kernel for a VM without Apple's hypervisor, and a stage
+ * earlier, because this base runs EARLY_BOOT after PE_init_iokit, whose platform UUID already takes a SHA-1:
+ * the last of SYSCTL is the last stage kernel_bootstrap_thread runs before it.
+ */
+STARTUP(SYSCTL, STARTUP_RANK_LAST, minicrypto_init);
+#endif

0092: no Apple implementation-defined registers (the spurious-IPI clear after wfi) on a non-Apple CPU; NO_CPU_OVRD itself is 0070's.
From Scion-Project/scion-avf vmapple/patches/0003 (PR 23).
Scion's change to Apple's xnu, under the APSL 2.0 like the rest of this series. Behaviour only with SCION_NATIVE_PAC=1 (make kernel SCION_NATIVE_PAC=1).

diff --git a/osfmk/arm64/machine_routines_asm.s b/osfmk/arm64/machine_routines_asm.s
index f72582fafd99e82d7c67abf8957a3be26aaa152f..d5fe8bfc0aa563c4de7516c449de92a2970aff87 100644
--- a/osfmk/arm64/machine_routines_asm.s
+++ b/osfmk/arm64/machine_routines_asm.s
@@ -1663,7 +1663,7 @@ Lwfi_inst:
 	dsb		sy
 	isb		sy
 	wfi
-#if NO_CPU_OVRD
+#if NO_CPU_OVRD && !SCION_NO_APPLE_IMPDEF_REGS
 	// Clear any spurious IPIs received during CPU shutdown
 	mov     x9, #0x1
 	msr     S3_5_C15_C1_1, x9
diff --git a/pexpert/pexpert/arm64/VMAPPLE.h b/pexpert/pexpert/arm64/VMAPPLE.h
index e531c28a493ea1d3d7df84069b136e2a02fd68ea..c2e4f1a951f6266446a1dbc54ea54b4ba3866256 100644
--- a/pexpert/pexpert/arm64/VMAPPLE.h
+++ b/pexpert/pexpert/arm64/VMAPPLE.h
@@ -44,6 +44,7 @@
  * registers itself (see SCION_NATIVE_PAC in arm64/pac_asm.h). The keys are
  * one set per boot, shared by EL0 and EL1: there are no per-process keys.
  */
+#define SCION_NO_APPLE_IMPDEF_REGS 1 /* a non-Apple CPU has no Apple implementation-defined registers */
 #else
 #define HAS_PARAVIRTUALIZED_PAC   1
 #endif

From db3205cee25d8e30a5469c48fc0d3cbb92aa0169 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:32:53 +0200
Subject: [PATCH] patch: 0093-a5xelte-39bit-kernel-va.patch

port: same A5XELTE override after the MacOSX ARM_LARGE_MEMORY block
---
 makedefs/MakeInc.def | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 87f28176..9a68db92 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -451,6 +451,14 @@ ARM64_PLKSEG_ADDR  = 0xfffffe0004004000
 ARM64_LINK_ADDR    = 0xfffffe0007004000
 endif
 
+# Exynos7580 uses 4 KiB pages: TTBR1 has a 39-bit range. The macOS
+# ARM_LARGE_MEMORY link address at -2 TiB is outside that range. Keep this
+# board inside the existing compact kernel VA layout instead.
+ifeq ($(CURRENT_MACHINE_CONFIG),A5XELTE)
+LARGE_MEMORY_DEFINE=-UARM_LARGE_MEMORY
+ARM64_PLKSEG_ADDR  =0xfffffff004004000
+ARM64_LINK_ADDR    =0xfffffff007004000
+endif
 
 ifeq ($(ARM64_LARGE_MEMORY),1)
 	ARM64_EXTRA_BUILD_FLAGS += -DARM_LARGE_MEMORY=1
-- 
2.53.0


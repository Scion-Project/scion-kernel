From faf78eb9eade018d2fdb56171a3df701713bd609 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:33:50 +0200
Subject: [PATCH] patch: 0200-herolte-board-target.patch

port: board lists: HEROLTE appended (BCM2837 gone)
---
 bsd/conf/Makefile.template            |   2 +-
 config/MASTER.arm64.herolte           | 117 ++++++++++++++++++++++++++
 iokit/Kernel/arm/SweetFramebuffer.cpp |  11 +--
 iokit/bsddev/IOKitBSDInit.cpp         |   3 +
 libkern/conf/Makefile.template        |   2 +-
 makedefs/MakeInc.def                  |   8 +-
 osfmk/arm64/start.s                   |  38 ++++-----
 osfmk/arm64/sweet_early.c             |  10 +--
 pexpert/pexpert/arm64/A5XELTE.h       |  23 +++++
 9 files changed, 180 insertions(+), 34 deletions(-)
 create mode 100644 config/MASTER.arm64.herolte

diff --git a/bsd/conf/Makefile.template b/bsd/conf/Makefile.template
index e5ffcf1b..a973853d 100644
--- a/bsd/conf/Makefile.template
+++ b/bsd/conf/Makefile.template
@@ -45,7 +45,7 @@ CFLAGS+= -include meta_features.h -DDRIVER_PRIVATE \
 SFLAGS+= -include meta_features.h
 
 # This provider is built into SWEET; other boards use their normal kext.
-ifneq ($(filter $(CURRENT_MACHINE_CONFIG),SWEET A5XELTE),)
+ifneq ($(filter $(CURRENT_MACHINE_CONFIG),SWEET A5XELTE HEROLTE),)
 SWEET_PTHREAD_ROOT = $(SRCROOT)/bsd/pthread/sweet_libpthread
 SWEET_PTHREAD_INC = -I$(SWEET_PTHREAD_ROOT) -I$(SWEET_PTHREAD_ROOT)/private -I$(SWEET_PTHREAD_ROOT)/include
 sweet_pthread_init.o_INCFLAGS = $(SWEET_PTHREAD_INC)
diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
index 32f0a062..de416d4c 100644
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -801,8 +801,11 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 	}
 
 #if defined(ARM64_BOARD_CONFIG_A5XELTE)
+#if !defined(ARM64_BOARD_CONFIG_HEROLTE)
+	/* Exynos 7580 GPIO/I2C addresses; HEROLTE needs its own drivers. */
 	a5xelte_keys_init();
 	a5xelte_touch_probe();
+#endif
 	{
 	uint32_t emmcprobe = 0;
 	PE_parse_boot_argn("emmcprobe", &emmcprobe, sizeof(emmcprobe));
diff --git a/libkern/conf/Makefile.template b/libkern/conf/Makefile.template
index 3fa441cf..c20cd98c 100644
--- a/libkern/conf/Makefile.template
+++ b/libkern/conf/Makefile.template
@@ -19,7 +19,7 @@ include $(MakeInc_def)
 CFLAGS+= -include meta_features.h -DLIBKERN_KERNEL_PRIVATE -DOSALLOCDEBUG=1
 SFLAGS+= -include meta_features.h
 
-ifneq ($(filter $(CURRENT_MACHINE_CONFIG),SWEET A5XELTE),)
+ifneq ($(filter $(CURRENT_MACHINE_CONFIG),SWEET A5XELTE HEROLTE),)
 SWEET_AES_ROOT = $(SRCROOT)/libkern/crypto/sweet_bearssl
 SWEET_AES_INC = -I$(SWEET_AES_ROOT)/inc -I$(SWEET_AES_ROOT)/src
 sweet_aes.o_INCFLAGS = $(SWEET_AES_INC)
diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index b6785bd7..248949c5 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -29,7 +29,7 @@ SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else ifneq ($(findstring _host,$(RC_ProjectName)),)
 SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else
-SUPPORTED_ARM64_MACHINE_CONFIGS = T6000 T6020 T6030 T6031 T6041 T6050 T8101 T8103 T8112 T8122 T8132 T8142 VMAPPLE SWEET A5XELTE
+SUPPORTED_ARM64_MACHINE_CONFIGS = T6000 T6020 T6030 T6031 T6041 T6050 T8101 T8103 T8112 T8122 T8132 T8142 VMAPPLE SWEET A5XELTE HEROLTE
 
 SPTM_ENABLED_SOCS_MacOSX = t6000 t8112 t6020 t8122 t6030 t6031 t6041 t6050 t8132 t8142
 EXCLAVES_ENABLED_SOCS_MacOSX = t8142 t6050
@@ -95,6 +95,8 @@ MACHINE_FLAGS_ARM64_T8142 = -DARM64_BOARD_CONFIG_T8142 			-mcpu=apple-m4+memtag+
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a+sme2
 MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=armv8.2-a+crypto
 MACHINE_FLAGS_ARM64_A5XELTE = -DARM64_BOARD_CONFIG_A5XELTE            -mcpu=cortex-a53 -march=armv8-a+crypto
+# Galaxy S7 (Exynos 8890) boots on a Cortex-A53 and reuses the A5XELTE port.
+MACHINE_FLAGS_ARM64_HEROLTE = -DARM64_BOARD_CONFIG_A5XELTE -DARM64_BOARD_CONFIG_HEROLTE -mcpu=cortex-a53 -march=armv8-a+crypto
 
 
 #
@@ -373,7 +375,7 @@ ifeq ($(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG),)
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := $(shell echo $(CURRENT_ARCH_CONFIG) | tr A-Z a-z)
 ifneq ($(filter arm64,$(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG)),)
 # These generic ARMv8 targets do not use Apple's arm64e pointer authentication.
-ifeq ($(filter $(CURRENT_MACHINE_CONFIG),SWEET A5XELTE),)
+ifeq ($(filter $(CURRENT_MACHINE_CONFIG),SWEET A5XELTE HEROLTE),)
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := arm64e
 endif
 endif
@@ -454,7 +456,7 @@ endif
 # Exynos7580 uses 4 KiB pages: TTBR1 has a 39-bit range. The macOS
 # ARM_LARGE_MEMORY link address at -2 TiB is outside that range. Keep this
 # board inside the existing compact kernel VA layout instead.
-ifeq ($(CURRENT_MACHINE_CONFIG),A5XELTE)
+ifneq ($(filter $(CURRENT_MACHINE_CONFIG),A5XELTE HEROLTE),)
 LARGE_MEMORY_DEFINE=-UARM_LARGE_MEMORY
 ARM64_PLKSEG_ADDR  =0xfffffff004004000
 ARM64_LINK_ADDR    =0xfffffff007004000
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 3fcb3d26..f446d0cf 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -526,15 +526,15 @@ LEXT(start_first_cpu)
 
 #if defined(A5XELTE)
 	/* Earliest XNU-owned physical marker in preserved Samsung log RAM. */
-	MOV64	x10, 0x469ff100
+	MOV64	x10, A5XELTE_MARKER_PA
 	MOV64	x11, 0x3145544c45554e58
 	str		x11, [x10]
 	dsb		sy
 	/* XNU-owned green entry block on the Exynos DECON scanout buffer. */
-	MOV64	x10, 0x6705d0c0
+	MOV64	x10, (A5XELTE_FB_PA+88*A5XELTE_FB_STRIDE+960)
 	MOV64	x11, 0xff00ff00
 	mov		x12, #21
-	mov		x15, #4320
+	mov		x15, #A5XELTE_FB_STRIDE
 La5_entry_row:
 	mov		x14, x10
 	mov		x13, #36
@@ -719,18 +719,18 @@ Lkernelcache_base_found:
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
 #if defined(A5XELTE)
-	/* Five 2 MiB blocks map the 1080x1920 scanout buffer VA=PA.
+	/* A5XELTE_FB_BLOCKS 2 MiB blocks map the scanout buffer VA=PA.
 	 * Its L1 index differs from isolated XNU RAM, so this uses one extra
 	 * bootstrap L2 page. Mark it write-combined for DECON DMA visibility. */
-	MOV64	x0, 0x67000000
+	MOV64	x0, A5XELTE_FB_PA
 	mov		x4, x0
-	mov		x5, #5
+	mov		x5, #A5XELTE_FB_BLOCKS
 	create_bootstrap_mapping x0, x4, x5, x1, x2, x6, x10, x11, x12, x13
-	MOV64	x10, 0x67000000
+	MOV64	x10, A5XELTE_FB_PA
 	and		x11, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x11, x11, #(ARM_TT_L2_SHIFT)
 	add		x12, x2, x11, lsl #TTE_SHIFT
-	mov		x13, #5
+	mov		x13, #A5XELTE_FB_BLOCKS
 La5_fb_attr:
 	ldr		x11, [x12]
 	bic		x11, x11, #(ARM_TTE_BLOCK_ATTRINDXMASK)
@@ -897,10 +897,10 @@ common_start:
 
 #if defined(A5XELTE)
 	/* Blue block: the 4 KiB MMU is active and the framebuffer alias works. */
-	MOV64	x10, 0x6707ecc0
+	MOV64	x10, (A5XELTE_FB_PA+120*A5XELTE_FB_STRIDE+960)
 	MOV64	x11, 0xff0000ff
 	mov		x12, #21
-	mov		x15, #4320
+	mov		x15, #A5XELTE_FB_STRIDE
 La5_mmu_row:
 	mov		x14, x10
 	mov		x13, #36
@@ -941,10 +941,10 @@ La5_mmu_pixel:
 
 #if defined(A5XELTE)
 	/* fp_enabled: write directly to the DECON scanout alias. */
-	MOV64	x10, 0x670a08c0
+	MOV64	x10, (A5XELTE_FB_PA+152*A5XELTE_FB_STRIDE+960)
 	MOV64	x11, 0xff00ffff
 	mov	x12, #21
-	mov	x15, #4320
+	mov	x15, #A5XELTE_FB_STRIDE
 La5_fp_enabled_row:
 	mov	x14, x10
 	mov	x13, #36
@@ -976,10 +976,10 @@ La5_fp_enabled_pixel:
 
 #if defined(A5XELTE)
 	/* tunables_done: write directly to the DECON scanout alias. */
-	MOV64	x10, 0x670c24c0
+	MOV64	x10, (A5XELTE_FB_PA+184*A5XELTE_FB_STRIDE+960)
 	MOV64	x11, 0xffff00ff
 	mov	x12, #21
-	mov	x15, #4320
+	mov	x15, #A5XELTE_FB_STRIDE
 La5_tunables_done_row:
 	mov	x14, x10
 	mov	x13, #36
@@ -1022,10 +1022,10 @@ La5_tunables_done_pixel:
 
 #if defined(A5XELTE)
 	/* arm_init_jump: write directly to the DECON scanout alias. */
-	MOV64	x10, 0x670e40c0
+	MOV64	x10, (A5XELTE_FB_PA+216*A5XELTE_FB_STRIDE+960)
 	MOV64	x11, 0xffffff00
 	mov	x12, #21
-	mov	x15, #4320
+	mov	x15, #A5XELTE_FB_STRIDE
 La5_arm_init_jump_row:
 	mov	x14, x10
 	mov	x13, #36
@@ -1108,8 +1108,8 @@ arm_init_tramp:
 La5_draw_text:
 	adrp	x3, EXT(iso_font)@page
 	add	x3, x3, EXT(iso_font)@pageoff
-	MOV64	x4, 0x67000000
-	mov	x5, #4320
+	MOV64	x4, A5XELTE_FB_PA
+	mov	x5, #A5XELTE_FB_STRIDE
 	madd	x4, x2, x5, x4
 	add	x4, x4, x1, lsl #2
 La5_text_next_char:
@@ -1125,7 +1125,7 @@ La5_text_column:
 	lsl	w11, w11, w10
 	tst	w9, w11
 	b.eq	La5_text_skip_pixel
-	mov	x13, #8640
+	mov	x13, #(2*A5XELTE_FB_STRIDE)
 	madd	x12, x8, x13, x4
 	add	x12, x12, x10, lsl #3
 	mov	w14, #-1

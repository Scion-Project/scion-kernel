From: Claudius <claudiusthebot@gmail.com>
Date: Mon, 9 Nov 2026 13:00:00 +0000
Subject: [PATCH] S9: the optimisation run's hooks (SWEET PROF, extra RAM canary, late-MIDR retry, recommended cores)

The Apple-file half of the ios27-opt work (docs/ios27/OPTIMISE.md); the port's own files (xnu/files-12377: sweet_prof.c,
sweet_a64e.c, starlte_smp.c, hakios.exynos_cpufreq.c) carry the rest. New sweetspeed bits
(xnu/files-12377/osfmk/arm64/sweet_a64e.c has the table): 16384 SWEET PROF, 32768 extra RAM canary, 65536 recommended
cores 0xf1, 131072 A55 floor 1456 MHz. Always on, and only on the M3 trap path: a trap taken on an M3 but handled after the
thread migrated to an A55 is retried (sleh.c, at most 4 times in a row at one pc) instead of ending in SIGILL. The hooks
of the other bits are one flag test.
---
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -56,6 +56,7 @@ extern "C" uint64_t a5xelte_power_pressed_at;   /* bsd/dev/a5xelte_keys.c */
 #include <kern/thread.h>
 #include <sys/proc.h>
 extern "C" uint32_t sweet_speed_flags(void);     /* boot-arg sweetspeed (osfmk/arm64/sweet_a64e.c) */
+static uint32_t sweet_fb_gaps[5];       /* vsync ticks between presented frames (sweetspeed&16384, see the present path) */
 #if defined(ARM64_BOARD_CONFIG_STARLTE)
 /* the S6E3HA8 panel brightness (bsd/dev/hakios.s6e3ha8.c; on with boot-arg sweetspeed&512) */
 extern "C" void hakios_s6e3ha8_init(void);
@@ -561,6 +562,15 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 			uint64_t ns = 0;
 			absolutetime_to_nanoseconds(mach_absolute_time() - before, &ns);
 			fb->fPerfFrames++;
+			{
+				/* sweetspeed&16384: vsync ticks between presented frames (1 = 60 fps, 2 = one tick missed, 7+ = idle) */
+				static uint64_t last_tick;
+				uint64_t gap = count - last_tick;
+				last_tick = count;
+				if ((sweet_fb_sbx & 16384) != 0) {
+					sweet_fb_gaps[gap <= 1 ? 0 : gap == 2 ? 1 : gap == 3 ? 2 : gap <= 6 ? 3 : 4]++;
+				}
+			}
 			fb->fPerfBytes += bytes;
 			fb->fPerfNS += ns;
 			if (ns > fb->fPerfMaxNS) {
@@ -585,7 +595,12 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 			    fb->fPerfFrames, elapsedNS / 1000000, fpsTenths / 10,
 			    fpsTenths % 10, fb->fPerfBytes,
 			    fb->fPerfNS / fb->fPerfFrames / 1000, fb->fPerfMaxNS / 1000);
+			if ((sweet_fb_sbx & 16384) != 0) {
+				IOLog("A5XELTE FB gaps: 1:%u 2:%u 3:%u 4-6:%u 7+:%u\n", sweet_fb_gaps[0], sweet_fb_gaps[1], sweet_fb_gaps[2],
+				    sweet_fb_gaps[3], sweet_fb_gaps[4]);
+			}
 		}
+		bzero(sweet_fb_gaps, sizeof(sweet_fb_gaps));
 		fb->fPerfFrames = fb->fPerfBytes = fb->fPerfNS = fb->fPerfMaxNS = 0;
 		fb->fPerfWindowStart = finished;
 	}
diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -820,6 +820,9 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 		extern bool hakios_exynos_cpufreq_gov_start(void);
 		(void)hakios_exynos_cpufreq_gov_start();
 		/* Boot-arg wifi_pcie=N (1-5): Scion's Wi-Fi stage 1, PCIe channel 0 to the BCM4361 (bsd/dev/hakios.exynos_pcie.c). */
+		/* Boot-arg extra_ram_canary=1 (with extra_ram=1): the extra RAM's canary pages checked every 10 s (arm_vm_init.c). */
+		extern void hakios_extra_ram_canary_start(void);
+		hakios_extra_ram_canary_start();
 		extern void hakios_exynos_pcie_init(void);
 		hakios_exynos_pcie_init();
 		/* Boot-arg dpu_probe=1: Scion's DPU scan-out service, its read-only probe (bsd/dev/hakios.exynos_dpu.c). */
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -30,6 +30,7 @@
 #include <debug.h>
 
 #include <kern/assert.h>
+#include <kern/thread.h>
 #include <kern/misc_protos.h>
 #include <kern/monotonic.h>
 #include <mach/vm_types.h>
@@ -44,6 +45,7 @@
 #include <arm64/sweet_early.h>
 #include <arm/cpu_data_internal.h>
 #include <arm/misc_protos.h>
+#include <arm/caches_internal.h>
 #include <pexpert/arm64/boot.h>
 #include <pexpert/device_tree.h>
 
@@ -390,6 +392,7 @@ SECURITY_READ_ONLY_LATE(unsigned int) hakios_extra_ram_count = 0;
 SECURITY_READ_ONLY_LATE(unsigned int) hakios_extra_ram_pages = 0;
 SECURITY_READ_ONLY_LATE(static unsigned int) hakios_extra_ram_refused = 0;
 SECURITY_READ_ONLY_LATE(static unsigned int) hakios_extra_ram_offered = 0;
+extern unsigned int hakios_extra_ram_canary_stride;       /* (below: extra_ram_canary=1) */
 
 static void
 hakios_extra_ram_init(void)
@@ -403,6 +406,16 @@ hakios_extra_ram_init(void)
 		return;
 	}
 	(void)PE_parse_boot_argn("extra_ram_mask", &mask, sizeof(mask));
+	uint32_t canary = 0;
+	uint32_t canary_bit = 0;
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
+	extern uint32_t sweet_speed_flags(void);        /* sweetspeed&32768 = extra_ram_canary=1 (for a command line that is full) */
+	canary_bit = sweet_speed_flags() & 32768;
+#endif
+	if (canary_bit != 0 ||
+	    (PE_parse_boot_argn("extra_ram_canary", &canary, sizeof(canary)) && canary != 0)) {
+		hakios_extra_ram_canary_stride = (unsigned int)((4u << 20) / PAGE_SIZE);
+	}
 	cap_mb = on > 1 ? on : 0;
 	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
 	    SecureDTGetProperty(chosen, "hakios-extra-ram", (void const **)&ranges, &size) != kSuccess) {
@@ -448,6 +461,87 @@ hakios_extra_ram_init(void)
 	}
 }
 
+/*
+ * extra_ram_canary=1: one 4 KB page every 4 MB of each extra range is kept out of the VM, filled with a pattern (its own
+ * address, so a page moved or copied shows too), and checked every 10 s by hakios_extra_ram_canary_thread() (started from
+ * IOKitBSDInit.cpp), out of the cache: a page that changes says that something outside the kernel (the firmware, a DMA
+ * engine left running by S-Boot) writes in that range. A diagnostic for the S-Boot path's ranges; costs 1/1024 of them.
+ */
+SECURITY_READ_ONLY_LATE(unsigned int) hakios_extra_ram_canary_stride = 0;
+#define HAKIOS_CANARY_WORD(pa) ((uint64_t)(pa) ^ 0xC0FFEE005CA1AB1EULL)
+
+static void
+hakios_extra_ram_canary_fill(pmap_paddr_t pa)
+{
+	volatile uint64_t *w = (volatile uint64_t *)phystokv(pa);
+
+	for (unsigned k = 0; k < ARM_PGBYTES / 8; k++) {
+		w[k] = HAKIOS_CANARY_WORD(pa + 8 * k);
+	}
+	FlushPoC_DcacheRegion((vm_offset_t)w, ARM_PGBYTES);
+}
+
+void hakios_extra_ram_canary_start(void);
+static void
+hakios_extra_ram_canary_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	unsigned pages = 0, total = 0, round = 0;
+
+	for (unsigned i = 0; i < hakios_extra_ram_count; i++) {
+		pages += (unsigned)((atop(hakios_extra_ram[i].end - hakios_extra_ram[i].pa) + hakios_extra_ram_canary_stride - 1) /
+		    hakios_extra_ram_canary_stride);
+	}
+	printf("hakios: extra RAM canary: %u pages (one every %u KB), checked every 10 s\n", pages,
+	    hakios_extra_ram_canary_stride * (unsigned)(PAGE_SIZE >> 10));
+	for (;;) {
+		unsigned changed = 0;
+		for (unsigned i = 0; i < hakios_extra_ram_count; i++) {
+			for (pmap_paddr_t pa = hakios_extra_ram[i].pa; pa < hakios_extra_ram[i].end;
+			    pa += ptoa((pmap_paddr_t)hakios_extra_ram_canary_stride)) {
+				volatile uint64_t *w = (volatile uint64_t *)phystokv(pa);
+				FlushPoC_DcacheRegion((vm_offset_t)w, ARM_PGBYTES);
+				unsigned bad = 0, first = 0;
+				uint64_t got = 0;
+				for (unsigned k = 0; k < ARM_PGBYTES / 8; k++) {
+					if (w[k] != HAKIOS_CANARY_WORD(pa + 8 * k)) {
+						if (bad++ == 0) {
+							first = k;
+							got = w[k];
+						}
+					}
+				}
+				if (bad) {
+					changed++;
+					total++;
+					if (total <= 64) {
+						printf("hakios: extra RAM canary: page 0x%llx changed (range %u): %u words, first at +0x%x = 0x%llx\n",
+						    (unsigned long long)pa, i, bad, first * 8, got);
+					}
+					hakios_extra_ram_canary_fill(pa);
+				}
+			}
+		}
+		if (changed || round % 30 == 0) {
+			printf("hakios: extra RAM canary: round %u: %u of %u pages changed (%u in all)\n", round, changed, pages, total);
+		}
+		round++;
+		delay_for_interval(10 * 1000, NSEC_PER_MSEC);
+	}
+}
+
+void
+hakios_extra_ram_canary_start(void)
+{
+	thread_t thread;
+
+	if (hakios_extra_ram_canary_stride == 0 || hakios_extra_ram_count == 0) {
+		return;
+	}
+	if (kernel_thread_start(hakios_extra_ram_canary_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
 /* [pa, pa + len) is all in one of the extra ranges */
 static bool
 hakios_extra_ram_covers(pmap_paddr_t pa, pmap_paddr_t len)
@@ -1804,6 +1898,10 @@ arm_vm_prot_finalize(boot_args * args __unused)
 	 */
 	for (unsigned int i = 0; i < hakios_extra_ram_count; i++) {
 		extern void hakios_extra_ram_give(ppnum_t first, ppnum_t end);
+		for (pmap_paddr_t pa = hakios_extra_ram[i].pa; hakios_extra_ram_canary_stride != 0 && pa < hakios_extra_ram[i].end;
+		    pa += ptoa((pmap_paddr_t)hakios_extra_ram_canary_stride)) {
+			hakios_extra_ram_canary_fill(pa);
+		}
 		hakios_extra_ram_give((ppnum_t)atop(hakios_extra_ram[i].pa), (ppnum_t)atop(hakios_extra_ram[i].end));
 		printf("hakios: extra RAM 0x%llx..0x%llx (%llu MB) given to the VM\n", (unsigned long long)hakios_extra_ram[i].pa,
 		    (unsigned long long)hakios_extra_ram[i].end - 1,
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -2208,10 +2208,17 @@ ml_release_deferred_pages(void)
  * does for its pages.
  */
 void hakios_extra_ram_give(ppnum_t first, ppnum_t end);
+extern unsigned int hakios_extra_ram_canary_stride;     /* arm_vm_init.c: pages kept out as canaries, one in this many */
 void
 hakios_extra_ram_give(ppnum_t first, ppnum_t end)
 {
+	unsigned int kept = 0;
+
 	for (ppnum_t ppn = first; ppn < end; ppn++) {
+		if (hakios_extra_ram_canary_stride != 0 && (ppn - first) % hakios_extra_ram_canary_stride == 0) {
+			kept++;         /* a canary: not the VM's (extra_ram_canary=1) */
+			continue;
+		}
 		if (__probable(!ml_static_mfree_queue_up)) {
 			vm_page_create_canonical(ppn);
 		} else {
@@ -2221,8 +2228,8 @@ hakios_extra_ram_give(ppnum_t first, ppnum_t end)
 		}
 	}
 	vm_page_lockspin_queues();
-	vm_page_wire_count -= (unsigned int)(end - first);
-	vm_page_wire_count_initial -= (unsigned int)(end - first);
+	vm_page_wire_count -= (unsigned int)(end - first) - kept;
+	vm_page_wire_count_initial -= (unsigned int)(end - first) - kept;
 	vm_page_unlock_queues();
 }
 
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1369,6 +1369,12 @@ handle_uncategorized(arm_saved_state_t *state)
 				thread_block(THREAD_CONTINUE_NULL);
 				return;
 			}
+		} else {
+			/* trapped on an M3, migrated to an A55 before the checks above: run it again here */
+			extern bool sweet_a55_retry_ok(uint32_t, thread_t, uint64_t);
+			if (sweet_a55_retry_ok(instr, current_thread(), get_saved_state_pc(state))) {
+				return;
+			}
 		}
 	}
 #endif

+++ b/osfmk/kern/processor.c
@@ -214,11 +214,13 @@ pset_is_primary(pset_id_t pset_id)
 #if !SCHED_TEST_HARNESS
 
 struct processor        PERCPU_DATA(processor);
+extern void sweet_prof_expire(timer_call_param_t, timer_call_param_t);
 static timer_call_func_t running_timer_funcs[] = {
 	[RUNNING_TIMER_QUANTUM] = thread_quantum_expire,
 	[RUNNING_TIMER_PREEMPT] = thread_preempt_expire,
 	[RUNNING_TIMER_KPERF] = kperf_timer_expire,
 	[RUNNING_TIMER_PERFCONTROL] = perfcontrol_timer_expire,
+	[RUNNING_TIMER_SWEETPROF] = sweet_prof_expire,
 };
 static_assert(sizeof(running_timer_funcs) / sizeof(running_timer_funcs[0])
     == RUNNING_TIMER_MAX, "missing running timer function");
diff --git a/osfmk/kern/sched_prim.c b/osfmk/kern/sched_prim.c
--- a/osfmk/kern/sched_prim.c
+++ b/osfmk/kern/sched_prim.c
@@ -3857,6 +3857,8 @@ thread_dispatch(
 			 * CPU is not running.
 			 */
 			kperf_running_setup(processor, processor->last_dispatch);
+			extern void sweet_prof_running_setup(processor_t, uint64_t);
+			sweet_prof_running_setup(processor, processor->last_dispatch);
 		}
 		running_timers_activate(processor);
 		processor->first_timeslice = TRUE;
diff --git a/osfmk/kern/timer_call.h b/osfmk/kern/timer_call.h
--- a/osfmk/kern/timer_call.h
+++ b/osfmk/kern/timer_call.h
@@ -215,6 +215,7 @@ enum running_timer {
 	RUNNING_TIMER_KPERF,
 #endif /* KPERF */
 	RUNNING_TIMER_PERFCONTROL,
+	RUNNING_TIMER_SWEETPROF,        /* osfmk/arm64/sweet_prof.c (sweetspeed&16384) */
 	RUNNING_TIMER_MAX,
 };
 

From dd1843216e7265f79b64aa22c9d39ec27d9df592 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:33:41 +0200
Subject: [PATCH] patch: 0118-a5xelte-home-hid-display-probe.patch

port: pid_hibernate guard lives in bsd/kern/kern_proc.c now (see 0070)
---
 bsd/conf/files                        |   2 +
 bsd/dev/a5xelte_keys.c                | 110 ++++++++++++++++++++++++++
 bsd/dev/a5xelte_touch.c               |  58 ++++++++++++++
 bsd/kern/kern_core.c                  |   6 +-
 bsd/kern/kern_proc.c                  |   6 +-
 bsd/kern/syscalls.master              |   2 +-
 iokit/Kernel/arm/SweetFramebuffer.cpp |   7 ++
 iokit/Kernel/arm/hid/SweetHID.cpp     |  14 +++-
 iokit/KernelConfigTables.cpp          |   2 +-
 iokit/bsddev/IOKitBSDInit.cpp         |   4 +
 10 files changed, 201 insertions(+), 10 deletions(-)
 create mode 100644 bsd/dev/a5xelte_keys.c
 create mode 100644 bsd/dev/a5xelte_touch.c

diff --git a/bsd/conf/files b/bsd/conf/files
index 4421e952..93482f36 100644
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -105,6 +105,8 @@ bsd/dev/random/randomdev.c		standard
 bsd/dev/memdev.c			standard
 bsd/dev/sweet_ufs.c			standard
 bsd/dev/a5xelte_emmc.c			standard
+bsd/dev/a5xelte_keys.c			standard
+bsd/dev/a5xelte_touch.c			standard
 bsd/dev/sweet_sample.c			standard
 bsd/dev/sweet_keys.c			standard
 bsd/dev/sweet_touch.c			standard
diff --git a/bsd/kern/kern_core.c b/bsd/kern/kern_core.c
index e939d032..4bc11f9b 100644
--- a/bsd/kern/kern_core.c
+++ b/bsd/kern/kern_core.c
@@ -87,11 +87,11 @@ kern_return_t thread_getstatus(thread_t act, int flavor,
     thread_state_t tstate, mach_msg_type_number_t *count);
 void task_act_iterate_wth_args(task_t, void (*)(thread_t, void *), void *);
 
-#if defined(SECURE_KERNEL) || defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(SECURE_KERNEL) || defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 /*
- * SWEET: off by default (sysctl kern.coredump=1 enables it). A crashing iOS
+ * iOS donor boards: off by default (sysctl kern.coredump=1 enables it). A crashing iOS
  * daemon maps the whole shared region, so one core is gigabytes on the root
- * volume and takes minutes on the phone's UFS.
+ * volume and takes minutes on phone storage.
  */
 __XNU_PRIVATE_EXTERN int do_coredump = 0;       /* default: don't dump cores */
 #else
diff --git a/bsd/kern/kern_proc.c b/bsd/kern/kern_proc.c
index e010821e..9082f6bd 100644
--- a/bsd/kern/kern_proc.c
+++ b/bsd/kern/kern_proc.c
@@ -6687,9 +6687,9 @@ out:
 	return error;
 }
 
-#if !XNU_TARGET_OS_OSX || defined(ARM64_BOARD_CONFIG_SWEET)
+#if !XNU_TARGET_OS_OSX || defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 /*
- * SWEET runs the iOS userland on the macOS config: SpringBoard calls
+ * SWEET and A5XELTE run the iOS userland on the macOS config: SpringBoard calls
  * pid_hibernate when an app leaves the foreground, and nosys (SIGSYS)
  * killed it. Without CONFIG_FREEZE this returns 0, as on iOS.
  */
@@ -6765,7 +6765,7 @@ out:
 	*ret = error;
 	return error;
 }
-#endif /* !XNU_TARGET_OS_OSX || SWEET */
+#endif /* !XNU_TARGET_OS_OSX || SWEET || A5XELTE */
 
 #if SOCKETS
 
diff --git a/bsd/kern/syscalls.master b/bsd/kern/syscalls.master
index c19d42f4..83639e7e 100644
--- a/bsd/kern/syscalls.master
+++ b/bsd/kern/syscalls.master
@@ -650,7 +650,7 @@
 432	AUE_NULL	ALL	{ int audit_session_port(au_asid_t asid, user_addr_t portnamep); }
 433	AUE_NULL	ALL	{ int pid_suspend(int pid); }
 434	AUE_NULL	ALL	{ int pid_resume(int pid); }
-#if CONFIG_EMBEDDED || defined(ARM64_BOARD_CONFIG_SWEET)
+#if CONFIG_EMBEDDED || defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 435	AUE_NULL	ALL	{ int pid_hibernate(int pid); }
 #else
 435     AUE_NULL        ALL     { int nosys(void); }
diff --git a/iokit/KernelConfigTables.cpp b/iokit/KernelConfigTables.cpp
index c1a65e3a..fc3decf1 100644
--- a/iokit/KernelConfigTables.cpp
+++ b/iokit/KernelConfigTables.cpp
@@ -79,7 +79,6 @@ const char * gIOKernelConfigTables =
     "     'IONameMatch'     = 'sweet,display';"
 #endif
     "   },"
-#if !defined(ARM64_BOARD_CONFIG_A5XELTE)
     "   {"
     "     'IOClass'         = SweetHIDButtons;"
     "     'IOProviderClass' = IOResources;"
@@ -90,6 +89,7 @@ const char * gIOKernelConfigTables =
     "     'IOProviderClass' = IOResources;"
     "     'IOMatchCategory' = SweetHIDTouch;"
     "   },"
+#if !defined(ARM64_BOARD_CONFIG_A5XELTE)
     "   {"
     "     'IOClass'         = SweetBattery;"
     "     'IOProviderClass' = IOResources;"
diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
index 34a095ae..32f0a062 100644
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -72,6 +72,8 @@ extern int IODTGetDefault(const char *key, void *infoAddr, unsigned int infoSize
 extern boolean_t cpuid_vmm_present(void);
 #if defined(ARM64_BOARD_CONFIG_A5XELTE)
 extern void a5xelte_emmc_probe(void);
+extern void a5xelte_keys_init(void);
+extern void a5xelte_touch_probe(void);
 #endif
 
 #define ROUNDUP(a, b) (((a) + ((b) - 1)) & (~((b) - 1)))
@@ -799,6 +801,8 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 	}
 
 #if defined(ARM64_BOARD_CONFIG_A5XELTE)
+	a5xelte_keys_init();
+	a5xelte_touch_probe();
 	{
 	uint32_t emmcprobe = 0;
 	PE_parse_boot_argn("emmcprobe", &emmcprobe, sizeof(emmcprobe));
-- 
2.53.0


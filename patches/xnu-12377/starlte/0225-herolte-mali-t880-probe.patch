From c1447fa502de2b044245f99a23e07805b4a917a5 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:34:07 +0200
Subject: [PATCH] patch: 0225-herolte-mali-t880-probe.patch

---
 bsd/conf/files                |   1 +
 bsd/dev/herolte_gpu.c         | 156 ++++++++++++++++++++++++++++++++++
 iokit/bsddev/IOKitBSDInit.cpp |   3 +
 3 files changed, 160 insertions(+)
 create mode 100644 bsd/dev/herolte_gpu.c

diff --git a/bsd/conf/files b/bsd/conf/files
index 9a28c2c3..07b61912 100644
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -108,6 +108,7 @@ bsd/dev/a5xelte_emmc.c			standard
 bsd/dev/herolte_ufs.c			standard
 bsd/dev/herolte_touch.c			standard
 bsd/dev/herolte_battery.c		standard
+bsd/dev/herolte_gpu.c			standard
 bsd/dev/a5xelte_keys.c			standard
 bsd/dev/a5xelte_touch.c			standard
 bsd/dev/sweet_sample.c			standard
diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
index 487bbba7..a256a7b5 100644
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -807,6 +807,9 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 	/* sec_ts on the Exynos 8890 HSI2C (bsd/dev/herolte_touch.c). */
 	extern void herolte_touch_probe(void);
 	herolte_touch_probe();
+	/* Mali-T880 read-only probe (bsd/dev/herolte_gpu.c). */
+	extern void herolte_gpu_probe(void);
+	herolte_gpu_probe();
 #else
 	/* Exynos 7580 I2C touch. */
 	a5xelte_touch_probe();
-- 

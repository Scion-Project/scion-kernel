From 1bb41f34ab6023fd7c82d3bd5b9cc91a8784cb68 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:35:13 +0200
Subject: [PATCH] patch: 0300-starlte-board-target.patch

port: STARLTE appended to the board list; SCTLR SPAN bit goes into the new SCTLR_EL1_REQUIRED (SCTLR_EL1_DEFAULT = REQUIRED | OPTIONAL upstream)
---
 bsd/conf/Makefile.template            |   2 +-
 bsd/conf/files                        |   2 +
 bsd/dev/a5xelte_keys.c                |  15 +
 bsd/dev/herolte_ufs.c                 | 273 ++++++++++-
 bsd/dev/starlte_smp.c                 | 273 +++++++++++
 bsd/dev/starlte_touch.c               | 667 ++++++++++++++++++++++++++
 bsd/dev/sweet_sample.c                |   9 +-
 config/MASTER.arm64.starlte           | 120 +++++
 iokit/Kernel/arm/SweetBattery.cpp     |   5 +-
 iokit/Kernel/arm/SweetCPU.cpp         |  16 +-
 iokit/Kernel/arm/SweetFramebuffer.cpp |  64 +++
 iokit/Kernel/arm/hid/SweetHID.cpp     |  28 +-
 iokit/bsddev/IOKitBSDInit.cpp         |  38 +-
 libkern/conf/Makefile.template        |   2 +-
 makedefs/MakeInc.def                  |   9 +-
 osfmk/arm64/proc_reg.h                |   9 +-
 osfmk/arm64/start.s                   |  18 +-
 osfmk/arm64/sweet_early.c             |   4 +-
 osfmk/kern/exception.c                |  33 ++
 pexpert/pexpert/arm64/A5XELTE.h       |  35 +-
 20 files changed, 1592 insertions(+), 30 deletions(-)
 create mode 100644 bsd/dev/starlte_smp.c
 create mode 100644 bsd/dev/starlte_touch.c
 create mode 100644 config/MASTER.arm64.starlte

diff --git a/bsd/conf/Makefile.template b/bsd/conf/Makefile.template
index a973853d..a4283374 100644
--- a/bsd/conf/Makefile.template
+++ b/bsd/conf/Makefile.template
@@ -45,7 +45,7 @@ CFLAGS+= -include meta_features.h -DDRIVER_PRIVATE \
 SFLAGS+= -include meta_features.h
 
 # This provider is built into SWEET; other boards use their normal kext.
-ifneq ($(filter $(CURRENT_MACHINE_CONFIG),SWEET A5XELTE HEROLTE),)
+ifneq ($(filter $(CURRENT_MACHINE_CONFIG),SWEET A5XELTE HEROLTE STARLTE),)
 SWEET_PTHREAD_ROOT = $(SRCROOT)/bsd/pthread/sweet_libpthread
 SWEET_PTHREAD_INC = -I$(SWEET_PTHREAD_ROOT) -I$(SWEET_PTHREAD_ROOT)/private -I$(SWEET_PTHREAD_ROOT)/include
 sweet_pthread_init.o_INCFLAGS = $(SWEET_PTHREAD_INC)
diff --git a/bsd/conf/files b/bsd/conf/files
index 07b61912..22945546 100644
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -107,6 +107,8 @@ bsd/dev/sweet_ufs.c			standard
 bsd/dev/a5xelte_emmc.c			standard
 bsd/dev/herolte_ufs.c			standard
 bsd/dev/herolte_touch.c			standard
+bsd/dev/starlte_touch.c			standard
+bsd/dev/starlte_smp.c			standard
 bsd/dev/herolte_battery.c		standard
 bsd/dev/herolte_gpu.c			standard
 bsd/dev/a5xelte_keys.c			standard
diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
index a256a7b5..2c28458a 100644
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -800,7 +800,43 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 		}
 	}
 
-#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+	/* Exynos 9810: GPIO keys with S9 pins (a5xelte_keys.c) and the
+	 * S6SY761 touch driver (starlte_touch.c); no S7 PMIC/GPU code.
+	 * Boot-arg ufsprobe=1: read-only UFS host state and LUN 0 GPT. */
+	{
+		extern void starlte_brand_banner(bool full);
+		starlte_brand_banner(true);
+	}
+	a5xelte_keys_init();
+	{
+		extern void starlte_touch_probe(void);
+		starlte_touch_probe();
+		extern void starlte_smp_probe(void);   /* boot-arg starsmpprobe=1 */
+		starlte_smp_probe();
+	}
+	{
+	uint32_t ufsprobe = 0;
+	PE_parse_boot_argn("ufsprobe", &ufsprobe, sizeof(ufsprobe));
+	if (ufsprobe == 1) {
+		extern void herolte_ufs_probe(void);
+		herolte_ufs_probe();
+	}
+	}
+	/* rd=ufsroot0: the ufsroot= partition (default USERDATA), read-only. */
+	if (strcmp(rdBootVar, "ufsroot0") == 0) {
+		extern int herolte_ufs_rootdev(dev_t *dev);
+		OSSafeReleaseNULL(matching);
+		int ufs_error = herolte_ufs_rootdev(root);
+		if (ufs_error) {
+			panic("IOFindBSDRoot: STARLTE UFS root %s unavailable: %d", rdBootVar, ufs_error);
+		}
+		strlcpy(rootName, rdBootVar, rootNameSize);
+		IOLog("BSD root: %s, major %d, minor %d\n", rootName, major(*root), minor(*root));
+		*oflags = 0;
+		goto iofrootx;
+	}
+#elif defined(ARM64_BOARD_CONFIG_A5XELTE)
 	/* GPIO keys: Exynos 7580 or, on HEROLTE, the Exynos 8890 ALIVE pins. */
 	a5xelte_keys_init();
 #if defined(ARM64_BOARD_CONFIG_HEROLTE)
diff --git a/libkern/conf/Makefile.template b/libkern/conf/Makefile.template
index c20cd98c..09bbf4b0 100644
--- a/libkern/conf/Makefile.template
+++ b/libkern/conf/Makefile.template
@@ -19,7 +19,7 @@ include $(MakeInc_def)
 CFLAGS+= -include meta_features.h -DLIBKERN_KERNEL_PRIVATE -DOSALLOCDEBUG=1
 SFLAGS+= -include meta_features.h
 
-ifneq ($(filter $(CURRENT_MACHINE_CONFIG),SWEET A5XELTE HEROLTE),)
+ifneq ($(filter $(CURRENT_MACHINE_CONFIG),SWEET A5XELTE HEROLTE STARLTE),)
 SWEET_AES_ROOT = $(SRCROOT)/libkern/crypto/sweet_bearssl
 SWEET_AES_INC = -I$(SWEET_AES_ROOT)/inc -I$(SWEET_AES_ROOT)/src
 sweet_aes.o_INCFLAGS = $(SWEET_AES_INC)
diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 248949c5..1820ea38 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -29,7 +29,7 @@ SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else ifneq ($(findstring _host,$(RC_ProjectName)),)
 SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else
-SUPPORTED_ARM64_MACHINE_CONFIGS = T6000 T6020 T6030 T6031 T6041 T6050 T8101 T8103 T8112 T8122 T8132 T8142 VMAPPLE SWEET A5XELTE HEROLTE
+SUPPORTED_ARM64_MACHINE_CONFIGS = T6000 T6020 T6030 T6031 T6041 T6050 T8101 T8103 T8112 T8122 T8132 T8142 VMAPPLE SWEET A5XELTE HEROLTE STARLTE
 
 SPTM_ENABLED_SOCS_MacOSX = t6000 t8112 t6020 t8122 t6030 t6031 t6041 t6050 t8132 t8142
 EXCLAVES_ENABLED_SOCS_MacOSX = t8142 t6050
@@ -97,6 +97,9 @@ MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=arm
 MACHINE_FLAGS_ARM64_A5XELTE = -DARM64_BOARD_CONFIG_A5XELTE            -mcpu=cortex-a53 -march=armv8-a+crypto
 # Galaxy S7 (Exynos 8890) boots on a Cortex-A53 and reuses the A5XELTE port.
 MACHINE_FLAGS_ARM64_HEROLTE = -DARM64_BOARD_CONFIG_A5XELTE -DARM64_BOARD_CONFIG_HEROLTE -mcpu=cortex-a53 -march=armv8-a+crypto
+# Galaxy S9 (Exynos 9810) boots on a Cortex-A55 and reuses the HEROLTE port;
+# ARMv8.0 code generation also runs on the Mongoose M3 cores.
+MACHINE_FLAGS_ARM64_STARLTE = -DARM64_BOARD_CONFIG_A5XELTE -DARM64_BOARD_CONFIG_HEROLTE -DARM64_BOARD_CONFIG_STARLTE -mcpu=cortex-a53 -march=armv8-a+crypto
 
 
 #
@@ -375,7 +378,7 @@ ifeq ($(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG),)
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := $(shell echo $(CURRENT_ARCH_CONFIG) | tr A-Z a-z)
 ifneq ($(filter arm64,$(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG)),)
 # These generic ARMv8 targets do not use Apple's arm64e pointer authentication.
-ifeq ($(filter $(CURRENT_MACHINE_CONFIG),SWEET A5XELTE HEROLTE),)
+ifeq ($(filter $(CURRENT_MACHINE_CONFIG),SWEET A5XELTE HEROLTE STARLTE),)
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := arm64e
 endif
 endif
@@ -456,7 +459,7 @@ endif
 # Exynos7580 uses 4 KiB pages: TTBR1 has a 39-bit range. The macOS
 # ARM_LARGE_MEMORY link address at -2 TiB is outside that range. Keep this
 # board inside the existing compact kernel VA layout instead.
-ifneq ($(filter $(CURRENT_MACHINE_CONFIG),A5XELTE HEROLTE),)
+ifneq ($(filter $(CURRENT_MACHINE_CONFIG),A5XELTE HEROLTE STARLTE),)
 LARGE_MEMORY_DEFINE=-UARM_LARGE_MEMORY
 ARM64_PLKSEG_ADDR  =0xfffffff004004000
 ARM64_LINK_ADDR    =0xfffffff007004000
diff --git a/osfmk/arm64/proc_reg.h b/osfmk/arm64/proc_reg.h
index 2c703fa8..a4683375 100644
--- a/osfmk/arm64/proc_reg.h
+++ b/osfmk/arm64/proc_reg.h
@@ -758,8 +758,15 @@
 
 #define SCTLR_OTHER            0
 
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+/* Cortex-A55 has PAN but this port does not manage it: keep it off. */
+#define SCTLR_STARLTE_SPAN      SCTLR_PAN_UNCHANGED
+#else
+#define SCTLR_STARLTE_SPAN      0
+#endif
+
 #define SCTLR_EL1_REQUIRED \
-	(SCTLR_RESERVED | SCTLR_UCI_ENABLED | SCTLR_nTWE_WFE_ENABLED | SCTLR_DZE_ENABLED | \
+	(SCTLR_STARLTE_SPAN | SCTLR_RESERVED | SCTLR_UCI_ENABLED | SCTLR_nTWE_WFE_ENABLED | SCTLR_DZE_ENABLED | \
 	 SCTLR_I_ENABLED | SCTLR_SED_DISABLED | SCTLR_CP15BEN_ENABLED | SCTLR_BT_DEFAULT | \
 	 SCTLR_SA0_ENABLED | SCTLR_SA_ENABLED | SCTLR_C_ENABLED | SCTLR_M_ENABLED |        \
 	 SCTLR_EPAN_DEFAULT | SCTLR_EIS_DEFAULT | SCTLR_EOS_DEFAULT | SCTLR_DSSBS_DEFAULT | \
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 4658b424..44a72206 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -534,7 +534,7 @@ LEXT(start_first_cpu)
 	str		x11, [x10]
 	dsb		sy
 	/* XNU-owned green entry block on the Exynos DECON scanout buffer. */
-	MOV64	x10, (A5XELTE_FB_PA+88*A5XELTE_FB_STRIDE+960)
+	MOV64	x10, (A5XELTE_CONSOLE_PA+88*A5XELTE_FB_STRIDE+960)
 	MOV64	x11, 0xff00ff00
 	mov		x12, #21
 	mov		x15, #A5XELTE_FB_STRIDE
@@ -897,10 +897,16 @@ common_start:
 	MOV64   x0, SCTLR_EL1_DEFAULT
 	MSR_SCTLR_EL1_X0
 	isb		sy
+#if defined(STARLTE)
+	/* Cortex-A55: PSTATE.PAN off (SCTLR.SPAN keeps it off from here). The
+	 * A53-targeted assembler has no PAN name: msr PAN, #0 = 0xd500409f. */
+	.long	0xd500409f
+	isb		sy
+#endif
 
 #if defined(A5XELTE)
 	/* Blue block: the 4 KiB MMU is active and the framebuffer alias works. */
-	MOV64	x10, (A5XELTE_FB_PA+120*A5XELTE_FB_STRIDE+960)
+	MOV64	x10, (A5XELTE_CONSOLE_PA+120*A5XELTE_FB_STRIDE+960)
 	MOV64	x11, 0xff0000ff
 	mov		x12, #21
 	mov		x15, #A5XELTE_FB_STRIDE
@@ -944,7 +950,7 @@ La5_mmu_pixel:
 
 #if defined(A5XELTE)
 	/* fp_enabled: write directly to the DECON scanout alias. */
-	MOV64	x10, (A5XELTE_FB_PA+152*A5XELTE_FB_STRIDE+960)
+	MOV64	x10, (A5XELTE_CONSOLE_PA+152*A5XELTE_FB_STRIDE+960)
 	MOV64	x11, 0xff00ffff
 	mov	x12, #21
 	mov	x15, #A5XELTE_FB_STRIDE
@@ -979,7 +985,7 @@ La5_fp_enabled_pixel:
 
 #if defined(A5XELTE)
 	/* tunables_done: write directly to the DECON scanout alias. */
-	MOV64	x10, (A5XELTE_FB_PA+184*A5XELTE_FB_STRIDE+960)
+	MOV64	x10, (A5XELTE_CONSOLE_PA+184*A5XELTE_FB_STRIDE+960)
 	MOV64	x11, 0xffff00ff
 	mov	x12, #21
 	mov	x15, #A5XELTE_FB_STRIDE
@@ -1025,7 +1031,7 @@ La5_tunables_done_pixel:
 
 #if defined(A5XELTE)
 	/* arm_init_jump: write directly to the DECON scanout alias. */
-	MOV64	x10, (A5XELTE_FB_PA+216*A5XELTE_FB_STRIDE+960)
+	MOV64	x10, (A5XELTE_CONSOLE_PA+216*A5XELTE_FB_STRIDE+960)
 	MOV64	x11, 0xffffff00
 	mov	x12, #21
 	mov	x15, #A5XELTE_FB_STRIDE
@@ -1111,7 +1117,7 @@ arm_init_tramp:
 La5_draw_text:
 	adrp	x3, EXT(iso_font)@page
 	add	x3, x3, EXT(iso_font)@pageoff
-	MOV64	x4, A5XELTE_FB_PA
+	MOV64	x4, A5XELTE_CONSOLE_PA
 	mov	x5, #A5XELTE_FB_STRIDE
 	madd	x4, x2, x5, x4
 	add	x4, x4, x1, lsl #2
diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index 7a9f7899..9f5e7f11 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -1163,6 +1163,39 @@ sweet_sample_task(const char *name, int pid, task_t task)
 	printf("SMP %s[%d] slide 0x%llx mh 0x%llx\n", name, pid, slide, task->mach_header_vm_address);
 
 	task_lock(task);
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+	/* Kernel side of each thread: where is it blocked? The saved kernel
+	 * registers of a thread that is not running sit at kstackptr; walk its
+	 * frame-pointer chain inside its own kernel stack only. */
+	{
+		int kn = 0;
+		extern vm_offset_t vm_kernel_slide;
+		queue_iterate(&task->threads, thread, thread_t, task_threads) {
+			char kl[400];
+			int m = snprintf(kl, sizeof(kl), "SMP %s k%d state 0x%x wait 0x%llx hint %d cont 0x%lx kslide 0x%lx",
+			    name, kn++, thread->state, (uint64_t)thread->wait_event, (int)thread->block_hint,
+			    (unsigned long)VM_KERNEL_UNSLIDE(thread->continuation), (unsigned long)vm_kernel_slide);
+			vm_offset_t lo = thread->kernel_stack, hi = lo + kernel_stack_size;
+			if (thread != current_thread() && thread->machine.kstackptr && lo) {
+				arm_kernel_saved_state_t *ks = (arm_kernel_saved_state_t *)thread->machine.kstackptr;
+				uint64_t kfp = ks->fp;
+				m += snprintf(kl + m, sizeof(kl) - m, " klr 0x%lx kbt",
+				    (unsigned long)VM_KERNEL_UNSLIDE(ks->lr));
+				for (int i = 0; i < 20 && kfp >= lo && kfp + 16 <= hi && (kfp & 7) == 0 &&
+				    m < (int)sizeof(kl) - 20; i++) {
+					uint64_t *f = (uint64_t *)kfp;
+					m += snprintf(kl + m, sizeof(kl) - m, " 0x%lx",
+					    (unsigned long)VM_KERNEL_UNSLIDE(f[1]));
+					if (f[0] <= kfp) {
+						break;
+					}
+					kfp = f[0];
+				}
+			}
+			printf("%s\n", kl);
+		}
+	}
+#endif
 	queue_iterate(&task->threads, thread, thread_t, task_threads) {
 		arm_saved_state_t *ss = find_user_regs(thread);
 		char line[400];

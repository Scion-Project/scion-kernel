From e99896fa9e8cf4e70b96771095109f24bb74eb2c Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Sun, 1 Nov 2026 22:03:10 +0200
Subject: [PATCH] patch: 0332-sweet-gpu-present-828.patch

sweet: the GPU present blob is generated for iOS 26's 828x1792 canvas (iPhone 11; CANVAS=828x1792 tools/gpu/build-g72-tri.sh). With the 1242x2208 blob every frame was refused ("not drawn") and the CPU copied it, ~50 ms a frame.
- starlte_gpu_tri.h: 828x1792 present
---
 bsd/dev/starlte_gpu_tri.h | 20 ++++++++++----------
 1 file changed, 10 insertions(+), 10 deletions(-)

diff --git a/bsd/dev/starlte_gpu_tri.h b/bsd/dev/starlte_gpu_tri.h
index b4f22412..604fc799 100644
--- a/bsd/dev/starlte_gpu_tri.h
+++ b/bsd/dev/starlte_gpu_tri.h
@@ -111,8 +111,8 @@ static const uint32_t sg_tri_blob[SG_TRI_BLOB_WORDS] = {
 #define SG_PRES_TILER_JOB  0x0u
 #define SG_PRES_FRAG_JOB   0x100u
 #define SG_PRES_SURFACE    0x680u   /* Surface With Stride: pointer, row, surface */
-#define SG_PRES_CANVAS_W   1242u
-#define SG_PRES_CANVAS_H   2208u
+#define SG_PRES_CANVAS_W   828u
+#define SG_PRES_CANVAS_H   1792u
 #define SG_PRES_BLOB_WORDS 548u
 static const uint32_t sg_pres_blob[SG_PRES_BLOB_WORDS] = {
 	0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x0001000f, 0x00000000,
@@ -168,12 +168,12 @@ static const uint32_t sg_pres_blob[SG_PRES_BLOB_WORDS] = {

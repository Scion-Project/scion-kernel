From a0d3d6295f57049333f6ff51b9a11c2a8861f05d Mon Sep 17 00:00:00 2001
From: Claudius <claudiusthebot@gmail.com>
Date: Sun, 8 Nov 2026 20:58:48 +0000
Subject: [PATCH] sweet_hfs: build encodings and drop quota for the iOS-target
 STARLTE kernel

---
 bsd/sweet_hfs/core/kext-config.h            | 2 +-
 bsd/sweet_hfs/hfs_encodings/hfs_encodings.h | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/bsd/sweet_hfs/core/kext-config.h b/bsd/sweet_hfs/core/kext-config.h
index 454c35564..5845beebf 100644
--- a/bsd/sweet_hfs/core/kext-config.h
+++ b/bsd/sweet_hfs/core/kext-config.h
@@ -47,7 +47,7 @@
 
 #else // OS X
 
-#define QUOTA 1
+#define QUOTA 0 /* the iPhoneOS-derived STARLTE config has no kernel quota support */
 #define NAMEDSTREAMS 1
 #define CONFIG_HFS_DIRLINK 1
 #define CONFIG_SEARCHFS 1
diff --git a/bsd/sweet_hfs/hfs_encodings/hfs_encodings.h b/bsd/sweet_hfs/hfs_encodings/hfs_encodings.h
index 02b13367a..cf79cc032 100644
--- a/bsd/sweet_hfs/hfs_encodings/hfs_encodings.h
+++ b/bsd/sweet_hfs/hfs_encodings/hfs_encodings.h
@@ -32,7 +32,7 @@
 #ifndef _HFS_ENCODINGS_H_
 #define _HFS_ENCODINGS_H_
 
-#if !TARGET_OS_IPHONE
+#if !TARGET_OS_IPHONE || defined(SWEET_HFS) /* built in on Starbite boards */
 
 #include <sys/appleapiopts.h>
 

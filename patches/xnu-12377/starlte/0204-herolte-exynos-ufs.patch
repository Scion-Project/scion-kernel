From 8858982ae92a517dd01cbb176c69a7724a9e11f5 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:33:51 +0200
Subject: [PATCH] patch: 0204-herolte-exynos-ufs.patch

---
 bsd/conf/files                |   1 +
 bsd/dev/herolte_ufs.c         | 798 ++++++++++++++++++++++++++++++++++
 iokit/bsddev/IOKitBSDInit.cpp |  22 +
 3 files changed, 821 insertions(+)
 create mode 100644 bsd/dev/herolte_ufs.c

diff --git a/bsd/conf/files b/bsd/conf/files
index 93482f36..781a421b 100644
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -105,6 +105,7 @@ bsd/dev/random/randomdev.c		standard
 bsd/dev/memdev.c			standard
 bsd/dev/sweet_ufs.c			standard
 bsd/dev/a5xelte_emmc.c			standard
+bsd/dev/herolte_ufs.c			standard
 bsd/dev/a5xelte_keys.c			standard
 bsd/dev/a5xelte_touch.c			standard
 bsd/dev/sweet_sample.c			standard
diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
index de416d4c..c8abad82 100644
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -813,6 +813,28 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 		a5xelte_emmc_probe();
 	}
 	}
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+	{
+	uint32_t ufsprobe = 0;
+	PE_parse_boot_argn("ufsprobe", &ufsprobe, sizeof(ufsprobe));
+	if (ufsprobe == 1) {
+		extern void herolte_ufs_probe(void);
+		herolte_ufs_probe();
+	}
+	}
+	if (strcmp(rdBootVar, "ufsroot0") == 0) {
+		extern int herolte_ufs_rootdev(dev_t *dev);
+		OSSafeReleaseNULL(matching);
+		int ufs_error = herolte_ufs_rootdev(root);
+		if (ufs_error) {
+			panic("IOFindBSDRoot: HEROLTE UFS root %s unavailable: %d", rdBootVar, ufs_error);
+		}
+		strlcpy(rootName, rdBootVar, rootNameSize);
+		IOLog("BSD root: %s, major %d, minor %d\n", rootName, major(*root), minor(*root));
+		*oflags = 0;
+		goto iofrootx;
+	}
+#endif
 	if (strcmp(rdBootVar, "emmcroot0") == 0) {
 		extern int a5xelte_emmc_rootdev(dev_t *dev);
 		OSSafeReleaseNULL(matching);
-- 
2.53.0


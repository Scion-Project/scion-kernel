From 2e3565de20bcda839cd40c91809f7e23e2e90e12 Mon Sep 17 00:00:00 2001
From: Claudius <claudiusthebot@gmail.com>
Date: Sun, 8 Nov 2026 21:20:59 +0000
Subject: [PATCH] parity: Scion DPU scan-out service (hakios_scanout_*:
 fb_flip/fb_dpp VGF0 scaler/fb_zc/fb_psr) + dpu_probe=1; display carve-out
 0xD8000000-0xDFFFFFFF

---
 bsd/conf/files                  |   1 +
 bsd/dev/hakios.exynos_dpu.c     | 780 ++++++++++++++++++++++++++++++++
 bsd/sys/hakios.exynos9810_mem.h |  29 ++
 iokit/bsddev/IOKitBSDInit.cpp   |   3 +
 4 files changed, 813 insertions(+)
 create mode 100644 bsd/dev/hakios.exynos_dpu.c
 create mode 100644 bsd/sys/hakios.exynos9810_mem.h

diff --git a/bsd/conf/files b/bsd/conf/files
index 2e7f727a3..0648c5544 100644
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -122,6 +122,7 @@ bsd/dev/hakios.exynos_cpufreq.c	standard
 bsd/dev/hakios.exynos_tmu.c		standard
 bsd/dev/hakios.scion_gov.c		standard
 bsd/dev/hakios.exynos_pcie.c		standard
+bsd/dev/hakios.exynos_dpu.c		standard
 bsd/dev/herolte_battery.c		standard
 bsd/dev/herolte_gpu.c			standard
 bsd/dev/a5xelte_keys.c			standard
diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
index d4ea537ac..6e9575ce4 100644
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -822,6 +822,9 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 		/* Boot-arg wifi_pcie=N (1-5): Scion's Wi-Fi stage 1, PCIe channel 0 to the BCM4361 (bsd/dev/hakios.exynos_pcie.c). */
 		extern void hakios_exynos_pcie_init(void);
 		hakios_exynos_pcie_init();
+		/* Boot-arg dpu_probe=1: Scion's DPU scan-out service, its read-only probe (bsd/dev/hakios.exynos_dpu.c). */
+		extern void hakios_exynos_dpu_boot_probe(void);
+		hakios_exynos_dpu_boot_probe();
 		extern void starlte_smp_probe(void);   /* boot-arg starsmpprobe=1 */
 		starlte_smp_probe();
 		/* Mali-G72 read-only probe (bsd/dev/starlte_gpu.c), boot-arg stargpu=0 off. */

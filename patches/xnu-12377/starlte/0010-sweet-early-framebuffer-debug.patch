From 5f8a813481e4c4ed3126349ec1ab9e3a79f8b7f1 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:28:42 +0200
Subject: [PATCH] patch: 0010-sweet-early-framebuffer-debug.patch

port: mark 7 moved: arm_vm_init now follows the gDramBase/pmap_first_pnum setup
---
 osfmk/arm/arm_init.c      |   9 +++
 osfmk/arm64/arm_vm_init.c |   3 +
 osfmk/arm64/start.s       |  36 +++++++++++
 osfmk/arm64/sweet_early.c | 130 ++++++++++++++++++++++++++++++++++++++
 osfmk/arm64/sweet_early.h |  22 +++++++
 osfmk/conf/files.arm64    |   1 +
 osfmk/kern/debug.c        |   8 +++
 7 files changed, 209 insertions(+)
 create mode 100644 osfmk/arm64/sweet_early.c
 create mode 100644 osfmk/arm64/sweet_early.h

diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index 6690846b..ee8ec778 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -58,6 +58,7 @@
 #include <pexpert/arm/consistent_debug.h>
 #include <pexpert/device_tree.h>
 #include <arm64/proc_reg.h>
+#include <arm64/sweet_early.h>
 #include <arm/pmap.h>
 #include <arm/caches_internal.h>
 #include <arm/cpu_internal.h>
@@ -356,6 +357,8 @@ arm_init(
 	DTEntry chosen = NULL;
 	unsigned int dt_entry_size = 0;
 
+	sweet_early_mark(1, "arm_init entered (MMU on)");
+
 	arm_slide_rebase_and_sign_image();
 
 	arm_static_if_init(args);
@@ -376,6 +379,7 @@ arm_init(
 #endif /* defined(HAS_APPLE_PAC) */
 
 	PE_init_platform(FALSE, args); /* Get platform expert set up */
+	sweet_early_mark(2, "PE_init_platform done");
 
 #if __arm64__
 	configure_timer_apple_regs();
@@ -459,6 +463,7 @@ arm_init(
 #endif
 
 	ml_parse_cpu_topology();
+	sweet_early_mark(3, "ml_parse_cpu_topology done");
 
 
 	boot_cpu_id = ml_get_boot_cpu_number();
@@ -490,11 +495,13 @@ arm_init(
 	 */
 	thread->machine.preemption_count = 0;
 	cpu_bootstrap();
+	sweet_early_mark(4, "cpu_bootstrap done");
 
 	rtclock_early_init();
 
 	kernel_debug_string_early("kernel_startup_bootstrap");
 	kernel_startup_bootstrap();
+	sweet_early_mark(5, "kernel_startup_bootstrap done");
 
 	/*
 	 * Initialize the timer callout world
@@ -503,6 +510,7 @@ arm_init(
 
 	cpu_init();
 
+	sweet_early_mark(6, "cpu_init done");
 	processor_bootstrap();
 
 	if (PE_parse_boot_argn("maxmem", &maxmem, sizeof(maxmem))) {
@@ -569,6 +577,7 @@ arm_init(
 	gDramSize = *dram_size;
 	pmap_first_pnum = (ppnum_t)atop(gDramBase);
 
+	sweet_early_mark(7, "entering arm_vm_init");
 	arm_vm_init(xmaxmem, args);
 
 	if (debug_boot_arg) {
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 756af521..8470a5fc 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -41,6 +41,7 @@
 #include <machine/atomic.h>
 #include <arm64/proc_reg.h>
 #include <arm64/lowglobals.h>
+#include <arm64/sweet_early.h>
 #include <arm/cpu_data_internal.h>
 #include <arm/misc_protos.h>
 #include <pexpert/arm64/boot.h>
@@ -2166,6 +2167,8 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 	ml_enable_monitor();
 
+	/* The framebuffer VA=PA mapping belongs to the outgoing TTBR0. */
+	sweet_early_disable();
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
 	flush_mmu_tlb();
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 3a7d3ea1..92f5d4be 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -474,6 +474,25 @@ LEXT(start_first_cpu)
 	mov		x20, x0
 	mov		x21, #0
 
+#if defined(SWEET)
+	/* Stage 0: white 64x32 band, no stack or page tables needed. */
+	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	mov		w1, #-1
+	mov		x2, #32
+	mov		x4, #4320
+Lsweet_mark_row:
+	mov		x3, #64
+	mov		x5, x0
+Lsweet_mark_pixel:
+	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Lsweet_mark_pixel
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Lsweet_mark_row
+	dsb		sy
+#endif
+
 	// Set low reset vector before attempting any loads
 	adrp	x0, EXT(LowExceptionVectorBase)@page
 	add		x0, x0, EXT(LowExceptionVectorBase)@pageoff
@@ -620,6 +639,23 @@ Lkernelcache_base_found:
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
+#if defined(SWEET)
+	/*
+	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
+	 * L2 table. Both framebuffer and RAM use L1 index 0; another call to
+	 * create_bootstrap_mapping would replace the RAM L2 table.
+	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
+	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
+	 */
+	MOV64	x10, 0x9c000000
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
+	add		x13, x25, #(2 * PGBYTES)
+	str		x11, [x13, x12, lsl #TTE_SHIFT]
+#endif
+
 	/* Ensure TTEs are visible */
 	dsb		ish
 
diff --git a/osfmk/conf/files.arm64 b/osfmk/conf/files.arm64
index 878b5154..defad01a 100644
--- a/osfmk/conf/files.arm64
+++ b/osfmk/conf/files.arm64
@@ -52,6 +52,7 @@ osfmk/arm64/dbgwrap.c		standard
 osfmk/arm/arm_timer.c		standard
 osfmk/arm/arm_init.c	optional config_pmap_ppl
 osfmk/arm64/arm_vm_init.c	optional config_pmap_ppl
+osfmk/arm64/sweet_early.c	standard
 osfmk/arm64/arm64_hypercall.c	standard
 osfmk/arm/io_map.c		standard
 osfmk/arm64/loose_ends.c	standard
diff --git a/osfmk/kern/debug.c b/osfmk/kern/debug.c
index 48f9405c..e816c9fd 100644
--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -86,6 +86,9 @@
 #include <stdatomic.h>
 #include <sys/pgo.h>
 #include <console/serial_protos.h>
+#if defined(__arm64__)
+#include <arm64/sweet_early.h>
+#endif
 #include <IOKit/IOBSD.h>
 #include <libkern/crc.h>
 
@@ -1253,6 +1256,11 @@ panic_trap_to_debugger(const char *panic_format_str, va_list *panic_args, unsign
 {
 #pragma clang diagnostic pop
 
+#if defined(SWEET)
+	/* No CPU/thread/debugger state is required for this first panic copy. */
+	sweet_early_panic(panic_format_str, panic_args);
+#endif
+
 #if defined(__x86_64__) && (DEVELOPMENT || DEBUG)
 	read_lbr();
 #endif
-- 

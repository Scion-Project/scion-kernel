From 5bf741dc7df85025135c3ca63fc15427a7d5df54 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Thu, 29 Oct 2026 00:29:45 +0200
Subject: [PATCH] patch: 0315-port-sync-page-phys-64bit.patch

pmap_sync_page_attributes_phys shifted the 32-bit ppnum_t by PAGE_SHIFT in 32 bits, so with 4 KiB pages and RAM at 0x880000000 the flush went to a truncated PA (0x8ce821000 -> 0xce821000) and phystokv_range panicked. Hit when a page becomes write-combined (StarbiteMali buffers). Use ptoa().
---
 osfmk/arm/pmap/pmap.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index f3014a2d..2379e237 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -7251,7 +7251,7 @@ void
 pmap_sync_page_attributes_phys(
 	ppnum_t pp)
 {
-	flush_dcache((vm_offset_t) (pp << PAGE_SHIFT), PAGE_SIZE, TRUE);
+	flush_dcache((vm_offset_t) ptoa(pp), PAGE_SIZE, TRUE);
 }
 
 #if CONFIG_COREDUMP

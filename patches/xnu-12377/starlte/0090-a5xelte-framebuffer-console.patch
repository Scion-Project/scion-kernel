From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:32:33 +0200
Subject: [PATCH] patch: 0090-a5xelte-framebuffer-console.patch

---
 osfmk/arm64/sweet_early.c | 106 ++++++++++++++++++++++++++++++++++++--
 pexpert/arm/pe_serial.c   |   4 ++
 2 files changed, 106 insertions(+), 4 deletions(-)

diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index 8e652432..b424c63b 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -872,7 +872,11 @@ fbcon_probe(void)
 	uint32_t const *val;
 	unsigned int size;
 
+	#if defined(A5XELTE)
+	if (SecureDTFindEntry("name", "a5xelte-fbcon", &entry) != kSuccess ||
+#else
 	if (SecureDTFindEntry("name", "sweet-fbcon", &entry) != kSuccess ||
+#endif
 	    SecureDTGetProperty(entry, "reg", (void const **)&reg, &size) != kSuccess || size < 16) {
 		return;
 	}

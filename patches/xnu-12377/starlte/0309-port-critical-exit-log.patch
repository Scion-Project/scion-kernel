 bsd/dev/herolte_ufs.c     | 319 +++++++++++++++++++++++++++++++++-----
 bsd/kern/kern_exit.c      |  14 ++
 osfmk/arm64/bsd_arm64.c   |  30 ++++
 osfmk/ipc/ipc_kmsg.c      | 110 +++++++++++++
 osfmk/ipc/mach_msg.c      |   6 +
 osfmk/kern/debug.c        |  13 ++
 osfmk/kern/exception.c    |  47 ++++++
 8 files changed, 596 insertions(+), 36 deletions(-)

diff --git a/bsd/dev/arm/systemcalls.c b/bsd/dev/arm/systemcalls.c
index 09067002..07061638 100644
--- a/bsd/dev/arm/systemcalls.c
+++ b/bsd/dev/arm/systemcalls.c
@@ -44,6 +44,70 @@ extern void dtrace_systrace_syscall_return(unsigned short, int, int *);
 extern void
 unix_syscall(struct arm_saved_state * regs, thread_t thread_act, struct proc * proc);
 
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
+/* Remaining trace lines (boot-arg sweettrace, default 0 = off). */
+int sweet_trace_left(void);
+int
+sweet_trace_left(void)
+{
+	static int left = -1;
+	if (left < 0) {
+		int n = 0;
+		PE_parse_boot_argn("sweettrace", &n, sizeof(n));
+		left = n;
+	}
+	return left > 0 ? left-- : 0;
+}
+
+/*
+ * Which process the trace follows: pid 1, or every process whose p_comm
+ * matches boot-arg sweettracename=<name> (first MAXCOMLEN characters).
+ */
+bool sweet_trace_match(const char *comm, int pid);
+bool
+sweet_trace_match(const char *comm, int pid)
+{
+	static char name[MAXCOMLEN + 1];
+	static int state = -1;
+
+	if (state < 0) {
+		state = PE_parse_boot_argn("sweettracename", name, sizeof(name)) ? 1 : 0;
+	}
+	if (state == 0) {
+		return pid == 1;
+	}
+	return strncmp(comm, name, MAXCOMLEN) == 0;
+}
+
+/* Failing syscalls of the traced process are always logged (capped). */
+static int
+sweet_trace_err_left(void)
+{
+	static int left = 3000;
+	return left > 0 ? left-- : 0;
+}
+
+/* The path argument of a failing filesystem syscall, if it has one. */
+static user_addr_t
+sweet_trace_path_arg(int code, const uint64_t *arg)
+{
+	switch (code) {
+	case SYS_open: case SYS_unlink: case SYS_chmod: case SYS_chown:
+	case SYS_access: case SYS_symlink: case SYS_readlink: case SYS_rename:
+	case SYS_mkdir: case SYS_rmdir: case SYS_getattrlist: case SYS_setattrlist:
+	case SYS_getxattr: case SYS_setxattr: case SYS_listxattr: case SYS_fsctl:
+	case SYS_stat64: case SYS_lstat64: case SYS_statfs64:
+		return (user_addr_t)arg[0];
+	case SYS_openat: case SYS_renameat: case SYS_faccessat: case SYS_fchmodat:
+	case SYS_fchownat: case SYS_fstatat64: case SYS_unlinkat: case SYS_readlinkat:
+	case SYS_mkdirat: case SYS_getattrlistat:
+		return (user_addr_t)arg[1];
+	default:
+		return 0;
+	}
+}
+#endif
+
 static int      arm_get_syscall_args(uthread_t, struct arm_saved_state *, const struct sysent *);
 static int      arm_get_u32_syscall_args(uthread_t, arm_saved_state32_t *, const struct sysent *);
 static void     arm_prepare_u32_syscall_return(const struct sysent *, arm_saved_state_t *, uthread_t, int);
@@ -180,6 +244,35 @@ unix_syscall(
 	AUDIT_SYSCALL_ENTER(code, proc, uthread);
 	error = (*(callp->sy_call))(proc, &uthread->uu_arg[0], &(uthread->uu_rval[0]));
 	AUDIT_SYSCALL_EXIT(code, proc, uthread, error);
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
+	/* sweet (0309): boot-arg sweettrace=N logs pid 1's first N syscalls and
+	 * Mach traps (bsd_arm64.c), with arguments and results. */
+	{
+		extern int sweet_trace_left(void);
+		extern bool sweet_trace_match(const char *, int);
+		extern const char *syscallnames[];
+		/* persona(494) calls are logged from every process: user sessions depend on them */
+		if (__improbable(sweet_trace_match(proc->p_comm, pid))) {
+			bool failed = error != 0 && error != EJUSTRETURN && error != ERESTART;
+			if (sweet_trace_left() > 0 || (failed && sweet_trace_err_left() > 0)) {
+				char path[160] = "";
+				user_addr_t pa = failed ? sweet_trace_path_arg(code, uthread->uu_arg) : 0;
+				if (pa != 0) {
+					size_t done;
+					path[0] = ' ';
+					if (copyinstr(pa, path + 1, sizeof(path) - 1, &done) != 0) {
+						path[0] = '\0';
+					}
+				}
+				printf("SYS %s[%d] %s(%d)(0x%llx, 0x%llx, 0x%llx, 0x%llx) = %d / 0x%llx%s\n",
+				    proc->p_comm, pid,
+				    code < nsysent ? syscallnames[code] : "?", code,
+				    uthread->uu_arg[0], uthread->uu_arg[1], uthread->uu_arg[2], uthread->uu_arg[3],
+				    error, *(uint64_t *)(void *)&uthread->uu_rval[0], path);   /* full 64-bit result (mmap) */
+			}
+		}
+	}
+#endif
 
 #if CONFIG_MACF
 skip_syscall:
diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
index 2bc84d61..f423fe34 100644
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -2005,6 +2005,20 @@ proc_handle_critical_exit(proc_t p, int rv)
 		prefix_str = prefix_str_buf;
 	}
 
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
+	/* sweet: proc_prepareexit's crash log comes after this panic; print it
+	 * for the critical process here, then save the console to flash. */
+	if (p == current_proc()) {
+		struct uthread *ut = current_uthread();
+		extern void sweet_crash_log(const char *, int, int, uint64_t, uint64_t);
+		sweet_crash_log(p->p_comm, proc_getpid(p), WTERMSIG(rv),
+		    ((uint64_t)ut->uu_exception << 32) | (uint32_t)ut->uu_code, ut->uu_subcode);
+	}
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+	extern void herolte_log_flush_now(void);
+	herolte_log_flush_now();
+#endif
+#endif
 	proc_crash_coredump(p);
 
 	sync(p, (void *)NULL, (int *)NULL);
diff --git a/osfmk/arm64/bsd_arm64.c b/osfmk/arm64/bsd_arm64.c
index 181b47fe..572b6f0c 100644
--- a/osfmk/arm64/bsd_arm64.c
+++ b/osfmk/arm64/bsd_arm64.c
@@ -296,6 +296,36 @@ mach_syscall(struct arm_saved_state *state)
 
 
 	retval = mach_call(&args);
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
+	{
+		extern int sweet_trace_left(void);
+		extern bool sweet_trace_match(const char *, int);
+		extern int proc_selfpid(void);
+		extern void proc_selfname(char *, int);
+		char comm[17];
+		proc_selfname(comm, sizeof(comm));
+		/* failing traps of the traced process are always logged (capped) */
+		static int err_left = 3000;
+		bool failed = retval != KERN_SUCCESS && call_number != 31 /* mach_msg_trap */ &&
+		    call_number != 47 /* mach_msg2_trap: timeouts are routine */;
+		if (call_number == 31 || call_number == 47) {
+			/* but a send failure is not */
+			failed = (retval & 0xfff00000) == 0x10000000 && retval != 0x10004003;
+		}
+		if (__improbable(sweet_trace_match(comm, proc_selfpid())) &&
+		    (sweet_trace_left() > 0 || (failed && err_left > 0 && err_left--))) {
+			/* vm_allocate (10) / vm_map (15): the address the kernel chose */
+			uint64_t out_addr = 0;
+			if ((call_number == 10 || call_number == 15) && retval == KERN_SUCCESS) {
+				(void)copyin((user_addr_t)args.arg2, &out_addr, sizeof(out_addr));
+			}
+			printf("TRAP %s(-%d)(0x%llx, 0x%llx, 0x%llx, 0x%llx) = 0x%x -> 0x%llx\n",
+			    mach_syscall_name_table[call_number], call_number,
+			    (uint64_t)args.arg1, (uint64_t)args.arg2, (uint64_t)args.arg3, (uint64_t)args.arg4, retval,
+			    out_addr);
+		}
+	}
+#endif
 
 skip_machcall:
 
diff --git a/osfmk/ipc/ipc_kmsg.c b/osfmk/ipc/ipc_kmsg.c
index 190e5d22..b59a64d0 100644
--- a/osfmk/ipc/ipc_kmsg.c
+++ b/osfmk/ipc/ipc_kmsg.c
@@ -126,6 +126,7 @@
 #include <string.h>
 
 #include <sys/kdebug.h>
+#include <pexpert/pexpert.h>
 
 #include <ptrauth.h>
 #if __has_feature(ptrauth_calls)
@@ -4736,6 +4737,112 @@ ipc_kmsg_deflate(
  *		MACH_RCV_INVALID_DATA    Couldn't copy to user message.
  *		the incoming "mr"        Copied data out of message buffer.
  */
+
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
+/*
+ * sweet: boot-arg sweetmsg=1 prints the printable runs of every Mach
+ * message the traced process (sweettracename=) sends or receives, so XPC
+ * dictionaries (keys, strings, error descriptions) can be read off the
+ * console without os_log.
+ */
+extern bool sweet_trace_match(const char *, int);
+extern int proc_selfpid(void);
+extern void proc_selfname(char *, int);
+
+void sweet_msg_dump(const char *dir, mach_vm_address_t uaddr, mach_msg_size_t size);
+
+/* Append the printable runs (>= 5 chars) of buf[0..n) to out; returns new o. */
+static size_t
+sweet_msg_scan(const char *buf, size_t n, char *out, size_t o, size_t osz)
+{
+	size_t i, run;
+	for (i = 0; i < n; ) {
+		for (run = 0; i + run < n && buf[i + run] >= 0x20 && buf[i + run] < 0x7f; run++) {
+		}
+		if (run >= 5) {
+			if (o + run + 3 >= osz) {
+				break;
+			}
+			if (o) {
+				out[o++] = ' '; out[o++] = '|'; out[o++] = ' ';
+			}
+			memcpy(out + o, buf + i, run);
+			o += run;
+		}
+		i += run ? run : 1;
+	}
+	out[o] = '\0';
+	return o;
+}
+
+void
+sweet_msg_dump(const char *dir, mach_vm_address_t uaddr, mach_msg_size_t size)
+{
+	static int enabled = -1;
+	char comm[17];
+	char buf[1536];
+	char out[480];
+	size_t n, o;
+	uint32_t bits, dcount, off;
+
+	if (enabled < 0) {
+		int v = 0;
+		PE_parse_boot_argn("sweetmsg", &v, sizeof(v));
+		enabled = v;
+	}
+	if (!enabled || size < 24) {
+		return;
+	}
+	proc_selfname(comm, sizeof(comm));
+	if (!sweet_trace_match(comm, proc_selfpid())) {
+		return;
+	}
+	n = MIN(size, sizeof(buf));
+	if (copyin(uaddr, buf, n) != 0) {
+		return;
+	}
+	memcpy(&bits, buf, 4);
+	o = sweet_msg_scan(buf, n, out, 0, sizeof(out));
+	printf("MSG%s %s[%d] %u bytes id %u bits 0x%x: %s\n", dir, comm, proc_selfpid(), size,
+	    *(uint32_t *)(void *)(buf + 20), bits, out);
+	if (o == 0 && n >= 48) {
+		/* no text: the header and the first body words in hex */
+		uint32_t *w = (uint32_t *)(void *)buf;
+		printf("MSG%s   hex %08x %08x %08x %08x %08x %08x | %08x %08x %08x %08x %08x %08x\n", dir,
+		    w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8], w[9], w[10], w[11]);
+	}
+	if (!(bits & MACH_MSGH_BITS_COMPLEX) || n < 28) {
+		return;
+	}
+	/* follow out-of-line memory descriptors (user 64-bit layout) */
+	memcpy(&dcount, buf + 24, 4);
+	off = 28;
+	for (uint32_t d = 0; d < dcount && d < 8 && off + 12 <= n; d++) {
+		uint8_t type = (uint8_t)buf[off + 11];
+		if (type == MACH_MSG_OOL_DESCRIPTOR || type == MACH_MSG_OOL_VOLATILE_DESCRIPTOR) {
+			uint64_t addr; uint32_t osize;
+			if (off + 16 > n) {
+				break;
+			}
+			memcpy(&addr, buf + off, 8);
+			memcpy(&osize, buf + off + 12, 4);
+			size_t on = MIN(osize, sizeof(buf));
+			if (on >= 8 && copyin((user_addr_t)addr, buf, on) == 0) {
+				sweet_msg_scan(buf, on, out, 0, sizeof(out));
+				printf("MSG%s   OOL %u bytes: %s\n", dir, osize, out);
+			} else {
+				printf("MSG%s   OOL %u bytes at 0x%llx: unreadable\n", dir, osize, addr);
+			}
+			off += 16;
+		} else if (type == MACH_MSG_PORT_DESCRIPTOR) {
+			off += 12;
+		} else {
+			off += 16;
+		}
+	}
+}
+#endif
+
 mach_msg_return_t
 ipc_kmsg_put_to_user(
 	ipc_kmsg_t              kmsg,     /* scalar or vector */
@@ -4855,6 +4962,9 @@ ipc_kmsg_put_to_user(
 		mr = MACH_RCV_INVALID_DATA;
 		goto out;
 	}
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
+	sweet_msg_dump("<", msg_rcv_addr, usize);
+#endif
 
 out:
 	if (mr == MACH_RCV_INVALID_DATA) {
diff --git a/osfmk/ipc/mach_msg.c b/osfmk/ipc/mach_msg.c
index afaaf38f..4789ec11 100644
--- a/osfmk/ipc/mach_msg.c
+++ b/osfmk/ipc/mach_msg.c
@@ -720,6 +720,12 @@ mach_msg_trap_send(
 		ipc_kmsg_free(kmsg);
 		return mr;
 	}
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
+	{
+		extern void sweet_msg_dump(const char *, mach_vm_address_t, mach_msg_size_t);
+		sweet_msg_dump(">", (mach_vm_address_t)send_uctx->send_msg_addr, send_uctx->send_msg_size);

From 115b5b0b73f7dbf6e56d3fa06cfdaa140ed8ddc0 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:27:12 +0200
Subject: [PATCH] patch: 0004-sweet-machine-config.patch

port: BCM2837 target is gone in xnu-11417 (list now T6000..T8132 VMAPPLE): SWEET appended after VMAPPLE in the config list, flags, Makefile and board_config.
---
 makedefs/MakeInc.def                    |  6 +-
 osfmk/arm64/proc_reg.h                  |  7 +++
 osfmk/arm64/sleh.c                      | 38 +++++++++++++
 osfmk/arm64/start.s                     |  4 +-
 pexpert/arm/pe_fiq.c                    | 30 ++++++++++
 pexpert/pexpert/arm64/Makefile          |  3 +-
 pexpert/pexpert/arm64/SWEET.h           | 75 +++++++++++++++++++++++++
 pexpert/pexpert/arm64/apple_arm64_cpu.h |  3 +
 pexpert/pexpert/arm64/board_config.h    | 11 ++++
 9 files changed, 173 insertions(+), 4 deletions(-)
 create mode 100644 pexpert/pexpert/arm64/SWEET.h

diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index e37762bc..b068f7ef 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -29,7 +29,7 @@ SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else ifneq ($(findstring _host,$(RC_ProjectName)),)
 SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else
-SUPPORTED_ARM64_MACHINE_CONFIGS = T6000 T6020 T6030 T6031 T6041 T6050 T8101 T8103 T8112 T8122 T8132 T8142 VMAPPLE
+SUPPORTED_ARM64_MACHINE_CONFIGS = T6000 T6020 T6030 T6031 T6041 T6050 T8101 T8103 T8112 T8122 T8132 T8142 VMAPPLE SWEET
 
 SPTM_ENABLED_SOCS_MacOSX = t6000 t8112 t6020 t8122 t6030 t6031 t6041 t6050 t8132 t8142
 EXCLAVES_ENABLED_SOCS_MacOSX = t8142 t6050
@@ -93,6 +93,7 @@ MACHINE_FLAGS_ARM64_T8132 = -DARM64_BOARD_CONFIG_T8132			-mcpu=apple-m4
 MACHINE_FLAGS_ARM64_T8142 = -DARM64_BOARD_CONFIG_T8142 			-mcpu=apple-m4+memtag+predres2
 
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a+sme2
+MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=armv8.2-a+crypto
 
 
 #
@@ -370,8 +371,11 @@ ifeq ($(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG),)
 # Without embdedded device map, use a default arch string
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := $(shell echo $(CURRENT_ARCH_CONFIG) | tr A-Z a-z)
 ifneq ($(filter arm64,$(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG)),)
+# sweet's Cortex-A76/A55 have no pointer authentication: stay plain arm64
+ifneq ($(CURRENT_MACHINE_CONFIG),SWEET)
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := arm64e
 endif
+endif
 
 endif
 
diff --git a/osfmk/arm64/proc_reg.h b/osfmk/arm64/proc_reg.h
index f4d148bd..2c703fa8 100644
--- a/osfmk/arm64/proc_reg.h
+++ b/osfmk/arm64/proc_reg.h
@@ -242,6 +242,13 @@
 
 /* D-Cache, 128KB for Acc8 PCore, 8-way. 64KB for ECore, 8-way. */
 #define MMU_CLINE   6                      /* cache line size is 1<<MMU_CLINE (64) */
+#elif defined (SWEET) /* Qualcomm Kryo 470: Cortex-A76 + Cortex-A55 */
+
+/* I-Cache. */
+#define MMU_I_CLINE 6
+
+/* D-Cache. */
+#define MMU_CLINE   6
 
 #elif defined (VMAPPLE)
 
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index 0554aa80..958ac466 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -32,6 +32,7 @@
 #include <arm/misc_protos.h>
 #include <arm/thread.h>
 #include <arm/rtclock.h>
+#include <arm/machine_cpu.h>
 #include <arm/trap_internal.h> /* for IS_ARM_GDB_TRAP() et al */
 #include <arm64/proc_reg.h>
 #include <arm64/machine_machdep.h>
@@ -3008,6 +3009,42 @@ sleh_irq(arm_saved_state_t *state)
 #endif
 
 
+#if defined(SWEET)
+	/*
+	 * sweet: TrustZone owns GIC Group 0, so the timer and IPIs that other
+	 * ARM64 targets take as FIQs arrive here as Group 1 IRQs.
+	 */
+	uint64_t iar = __builtin_arm_rsr64("ICC_IAR1_EL1");
+	uint32_t intid = (uint32_t)(iar & 0xFFFFFF);
+
+	if (intid >= 1020 && intid <= 1023) {
+		return; /* spurious */
+	}
+	if (intid == SWEET_VTIMER_INTID) {
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_TIMER);
+		cdp->cpu_decrementer = -1; /* Large */
+		INTERRUPT_MASKED_DEBUG_START(rtclock_intr, DBG_INTR_TYPE_TIMER);
+		rtclock_intr(TRUE);
+		INTERRUPT_MASKED_DEBUG_END();
+		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+	} else if (intid < 16) {
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_IPI);
+		/* Ack before handling so an IPI raised meanwhile is not lost */
+		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+		__builtin_arm_isb(ISB_SY);
+		cpu_signal_handler();
+	} else {
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_OTHER);
+		if (cdp->interrupt_handler) {
+			cdp->interrupt_handler(cdp->interrupt_target,
+			    cdp->interrupt_refCon,
+			    cdp->interrupt_nub,
+			    intid);
+		}
+		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+	}
+	__builtin_arm_isb(ISB_SY);
+#else
 	sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_OTHER);
 
 #if USE_APPLEARMSMP
@@ -3019,6 +3056,7 @@ sleh_irq(arm_saved_state_t *state)
 	    cdp->interrupt_nub,
 	    cdp->interrupt_source);
 #endif
+#endif /* SWEET */
 
 	entropy_collect();
 
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 6aa6fe46..cd29a719 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -752,11 +752,11 @@ common_start:
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
-#if !VMAPPLE
+#if !VMAPPLE && !defined(SWEET)
 	MOV64	x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
 	bne		.
-#endif /* !VMAPPLE */
+#endif /* !VMAPPLE && !SWEET */
 
 #if (!CONFIG_KERNEL_INTEGRITY || (CONFIG_KERNEL_INTEGRITY && !defined(KERNEL_INTEGRITY_WT)))
 	/* Watchtower
diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 3ad743fc..4ec6989e 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -141,11 +141,25 @@ pe_init_fiq()
 		}
 	}
 
+#if defined(SWEET)
+	/*
+	 * Real hardware with two security states: Group 0 is TrustZone's and
+	 * non-secure writes to it are ignored. Everything we own is Group 1 NS
+	 * and arrives as an IRQ (see sleh_irq). GICR_IGROUPR0 reads as zero
+	 * from the non-secure side even after this write; delivery still works.
+	 */
+	gicr_write32(GICR_IGROUPR0, 0xFFFFFFFF);
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicr_write32(GICR_IPRIORITYR0 + i, 0xA0A0A0A0);
+	}
+	gicr_write32(GICR_ISENABLER0, (1U << SWEET_VTIMER_INTID) | (1U << SWEET_IPI_SGI));
+#else
 	// Configure timers and legacy FIQ to be group 0
 	gicr_write32(GICR_IGROUPR0, 0x81FFFFFF);
 
 	// Enable PPI 27
 	gicr_write32(GICR_ISENABLER0, (1 << 27));
+#endif /* SWEET */
 
 	// Enable system register access
 	uint64_t icc_sre = __builtin_arm_rsr64("ICC_SRE_EL1");
@@ -153,8 +167,12 @@ pe_init_fiq()
 	__builtin_arm_wsr64("ICC_SRE_EL1", icc_sre);
 	__builtin_arm_isb(ISB_SY);
 
+#if defined(SWEET)
+	__builtin_arm_wsr64("ICC_BPR1_EL1", 0);
+#else
 	// Set priority masks and binary point for group 0
 	__builtin_arm_wsr64("ICC_BPR0_EL1", 0);
+#endif /* SWEET */
 	__builtin_arm_wsr64("ICC_PMR_EL1", 0xFF);
 
 	// Set EOI mode of this processor
@@ -162,12 +180,24 @@ pe_init_fiq()
 	icc_ctlr &= ~ICC_CTLR_EOIMODE;
 	__builtin_arm_wsr64("ICC_CTLR_EL1", icc_ctlr);
 
+#if defined(SWEET)
+	// ABL leaves only ARE_NS set; Linux writes ARE_NS | EnableGrp1A | EnableGrp1
+	uint32_t gicd_ctlr = gicd_read32(GICD_CTLR);
+	gicd_ctlr |= GICD_CTLR_ARE_NS | GICD_CTLR_ENABLEGRP1A | GICD_CTLR_ENABLEGRP1;
+	gicd_write32(GICD_CTLR, gicd_ctlr);
+	while (gicd_read32(GICD_CTLR) & GICD_CTLR_RWP) {
+		;
+	}
+	__builtin_arm_wsr64("ICC_IGRPEN1_EL1", 1);
+	__builtin_arm_isb(ISB_SY);
+#else
 	// Enable the forwarding of the vtimer interrupt
 	uint32_t gicd_ctlr = gicd_read32(GICD_CTLR);
 	gicd_ctlr |= GICD_CTLR_ENABLEGRP0;
 	gicd_write32(GICD_CTLR, gicd_ctlr);
 	__builtin_arm_wsr64("ICC_IGRPEN0_EL1", 1);
 	__builtin_arm_isb(ISB_SY);
+#endif /* SWEET */
 }
 #else
 void
diff --git a/pexpert/pexpert/arm64/Makefile b/pexpert/pexpert/arm64/Makefile
index 75938b56..1561d807 100644
--- a/pexpert/pexpert/arm64/Makefile
+++ b/pexpert/pexpert/arm64/Makefile
@@ -33,7 +33,8 @@ PRIVATE_KERNELFILES = \
 	H15.h \
 	H16.h \
 	H17.h \
-	VMAPPLE.h
+	VMAPPLE.h \
+	SWEET.h
 
 
 # Headers installed into System.framework/PrivateHeaders (userspace internal SDK only).

From e431988d761dede5892c960e4ce7a17bce493f88 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:31:24 +0200
Subject: [PATCH] patch: 0078-sweet-smp-8-cores.patch

---
 iokit/Kernel/arm/SweetCPU.cpp  | 7 ++++---
 osfmk/arm64/machine_routines.c | 2 +-
 pexpert/pexpert/arm64/SWEET.h  | 9 +++++++--
 3 files changed, 12 insertions(+), 6 deletions(-)

diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index 5ee33ab7..1176a9b5 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -1155,7 +1155,7 @@ ml_parse_cpu_topology(void)
 	const boolean_t cpumask_boot_arg_present = PE_parse_boot_argn("cpumask", &cpumask_boot_arg, sizeof(cpumask_boot_arg));
 
 #if defined(SWEET)
-	/* Opt in to SMP. Never expose the A76s to this A55-only configuration. */
+	/* Opt in to SMP: cpus=N (N <= SWEET_SMP_MAX_CPUS; cores 6-7 are the A76s). */
 	if (!cpus_boot_arg_present || cpu_boot_arg == 0) {
 		cpu_boot_arg = 1;
 	}

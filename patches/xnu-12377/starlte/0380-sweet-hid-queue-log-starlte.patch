From 80f83e3227bda3077a9ed55b90ee0f63ac3434ad Mon Sep 17 00:00:00 2001
From: Starbite author <starbite@local>
Date: Wed, 4 Nov 2026 15:40:59 +0200
Subject: [PATCH] patch: 0380-sweet-hid-queue-log-starlte.patch - STARLTE: log
 HID user-client queue use (first events, every 100th, drops)

---
 iokit/Kernel/arm/hid/IOHIDEventServiceUserClient.cpp | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/iokit/Kernel/arm/hid/IOHIDEventServiceUserClient.cpp b/iokit/Kernel/arm/hid/IOHIDEventServiceUserClient.cpp
index 13afc4f4..c0196d6b 100644
--- a/iokit/Kernel/arm/hid/IOHIDEventServiceUserClient.cpp
+++ b/iokit/Kernel/arm/hid/IOHIDEventServiceUserClient.cpp
@@ -632,10 +632,17 @@ void IOHIDEventServiceUserClient::enqueueEventGated( IOHIDEvent * event)
         _lastEventTime = mach_continuous_time();
         _lastEventType = event->getType();
         Boolean result = _queue->enqueueEvent(event);
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+        /* is anyone reading? the first events and then every 100th, per client */
+        if (result && (_eventCount <= 5 || (_eventCount % 100) == 0)) {
+            IOLog("SWEET HID: queued event %u (type %d) for %s, %u dropped so far\n", (unsigned)_eventCount,
+                (int)event->getType(), _owner ? _owner->getName() : "?", (unsigned)_droppedEventCount);
+        }
+#endif
         if (result == false) {
             _lastDroppedEventTime = _lastEventTime;
             ++_droppedEventCount;
-#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE) || defined(ARM64_BOARD_CONFIG_STARLTE)
             /* sweet: a full queue means the client is not reading events. */
             if (_droppedEventCount <= 3 || (_droppedEventCount % 200) == 0) {
                 IOLog("SWEET HID: queue full for %s, %u of %u events dropped\n",
-- 

From 1196d6420ce3f90f201cdc1822d29a1a23d66898 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:30:31 +0200
Subject: [PATCH] patch: 0047-sweet-persistent-console-log.patch

port: disableConsoleOutput is now a file-scope extern; hook placed the same way
---
 bsd/dev/sweet_ufs.c            | 112 +++++++++++++++++++++++++++++++++
 osfmk/console/serial_console.c |   8 +++
 2 files changed, 120 insertions(+)

diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
index 7784e725..b3efad49 100644
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -275,9 +275,17 @@ _cnputc(char c, bool poll)
  *             waiting for an interrupt when the hardware device isn't ready
  * @param size The number of characters to print to the console.
  */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+extern void sweet_log_append(const char *c, int size);  /* bsd/dev/sweet_ufs.c */
+#endif
+
 static inline void
 _cnputs(char *c, int size, bool poll)
 {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	sweet_log_append(c, size);
+#endif
+
 	if (disableConsoleOutput) {
 		return;
 	}
-- 
2.53.0


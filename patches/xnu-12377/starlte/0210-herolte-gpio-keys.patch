From 0f85b97b87ec2541f9cbd3796b64d05f553f4b22 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:33:51 +0200
Subject: [PATCH] patch: 0210-herolte-gpio-keys.patch

---
 bsd/dev/a5xelte_keys.c        | 44 +++++++++++++++++++++++++++++++----
 iokit/bsddev/IOKitBSDInit.cpp |  5 ++--
 2 files changed, 42 insertions(+), 7 deletions(-)

diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
index c8abad82..15e81faa 100644
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -801,9 +801,10 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 	}
 
 #if defined(ARM64_BOARD_CONFIG_A5XELTE)
-#if !defined(ARM64_BOARD_CONFIG_HEROLTE)
-	/* Exynos 7580 GPIO/I2C addresses; HEROLTE needs its own drivers. */
+	/* GPIO keys: Exynos 7580 or, on HEROLTE, the Exynos 8890 ALIVE pins. */
 	a5xelte_keys_init();
+#if !defined(ARM64_BOARD_CONFIG_HEROLTE)
+	/* Exynos 7580 I2C touch; HEROLTE needs its own driver. */
 	a5xelte_touch_probe();
 #endif
 	{
-- 

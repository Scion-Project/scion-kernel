From 9ea16bf355ba293eb31c02700dfcef3c0788c9c6 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:33:26 +0200
Subject: [PATCH] patch: 0104-a5xelte-emmc-gpt-probe.patch

---
 bsd/conf/files                |   1 +
 bsd/dev/a5xelte_emmc.c        | 492 ++++++++++++++++++++++++++++++++++
 iokit/bsddev/IOKitBSDInit.cpp |  25 ++
 3 files changed, 518 insertions(+)
 create mode 100644 bsd/dev/a5xelte_emmc.c

diff --git a/bsd/conf/files b/bsd/conf/files
index 23544992..4421e952 100644
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -104,6 +104,7 @@ bsd/dev/random/randomdev.c		standard
 
 bsd/dev/memdev.c			standard
 bsd/dev/sweet_ufs.c			standard
+bsd/dev/a5xelte_emmc.c			standard
 bsd/dev/sweet_sample.c			standard
 bsd/dev/sweet_keys.c			standard
 bsd/dev/sweet_touch.c			standard
diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
index 833d522e..34a095ae 100644
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -70,6 +70,9 @@ extern int mdevgetrange(int devid, uint64_t *base, uint64_t *size);
 extern void di_root_ramfile(IORegistryEntry * entry);
 extern int IODTGetDefault(const char *key, void *infoAddr, unsigned int infoSize);
 extern boolean_t cpuid_vmm_present(void);
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+extern void a5xelte_emmc_probe(void);
+#endif
 
 #define ROUNDUP(a, b) (((a) + ((b) - 1)) & (~((b) - 1)))
 
@@ -795,6 +798,28 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 		}
 	}
 
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+	{
+	uint32_t emmcprobe = 0;
+	PE_parse_boot_argn("emmcprobe", &emmcprobe, sizeof(emmcprobe));
+	if (emmcprobe == 1) {
+		a5xelte_emmc_probe();
+	}
+	}
+	if (strcmp(rdBootVar, "emmcroot0") == 0) {
+		extern int a5xelte_emmc_rootdev(dev_t *dev);
+		OSSafeReleaseNULL(matching);
+		int emmc_error = a5xelte_emmc_rootdev(root);
+		if (emmc_error) {
+			panic("IOFindBSDRoot: A5XELTE eMMC root unavailable: %d", emmc_error);
+		}
+		strlcpy(rootName, rdBootVar, rootNameSize);
+		IOLog("BSD root: %s, major %d, minor %d\n", rootName, major(*root), minor(*root));
+		*oflags = 0;
+		goto iofrootx;
+	}
+#endif
+
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 //
 //	SWEET: root on a GPT partition of the internal UFS (bsd/dev/sweet_ufs.c)
-- 
2.53.0


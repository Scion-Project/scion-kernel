From c25af9a252faa9e1194935f3ebc375f238532b41 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:33:51 +0200
Subject: [PATCH] patch: 0201-herolte-amfi-bridge.patch

build: AMFI policy named "AMFI"; op 90 (dyld policy) answers development-vars only
---
 bsd/kern/bsd_init.c   |  4 ++--
 bsd/kern/sweet_amfi.c | 54 +++++++++++++++++++++++++++++++++++++++----
 2 files changed, 51 insertions(+), 7 deletions(-)

diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index b5072efd..de81e9ee 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -701,8 +701,8 @@ bsd_init(void)
 	bsd_init_kprintf("calling vfsinit\n");
 	vfsinit();
 
-#if defined(ARM64_BOARD_CONFIG_SWEET)
-	/* AMFI's MAC policy is built in on SWEET (bsd/kern/sweet_amfi.c). */
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
+	/* AMFI's MAC policy is built in (bsd/kern/sweet_amfi.c). */
 	extern void sweet_amfi_policy_register(void);
 	sweet_amfi_policy_register();
 #endif

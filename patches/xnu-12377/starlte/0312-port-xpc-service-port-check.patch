From 7012d4035419f5592af19623ba09e67dd2fb6e25 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 20:33:53 +0200
Subject: [PATCH] patch: 0312-port-xpc-service-port-check.patch

mach_port_is_connection_for_service() answers KERN_SUCCESS with filter
policy 0 when no message-filter callbacks are registered (no Sandbox kext)
instead of KERN_NOT_SUPPORTED.  iPadOS 18's libxpc calls it for every new
peer of a service port and rejects the peer on error: containermanagerd and
usermanagerd dropped every client (reply ports died, lsd/backboardd aborted
after retries).
---
 osfmk/ipc/mach_port.c | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/osfmk/ipc/mach_port.c b/osfmk/ipc/mach_port.c
index 7ef6a220..990b0dfd 100644
--- a/osfmk/ipc/mach_port.c
+++ b/osfmk/ipc/mach_port.c
@@ -2970,9 +2970,29 @@ mach_port_is_connection_for_service(
 		return KERN_INVALID_ARGUMENT;
 	}
 
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
+	/*
+	 * sweet: message-filter callbacks come from the Sandbox kext, which
+	 * this kernel does not have, so this returned KERN_NOT_SUPPORTED and
+	 * iPadOS 18's libxpc rejected every new peer connection whose server
+	 * asked (containermanagerd, usermanagerd: clients saw their reply
+	 * ports die, lsd aborted).  With no sandbox there is nothing to
+	 * check: validate the names and answer "no filter policy".
+	 */
+	if (!mach_msg_filter_at_least(MACH_MSG_FILTER_CALLBACKS_VERSION_1)) {
+		ret = ipc_port_translate_receive(space, service_port_name, &service_port);
+		if (ret) {
+			return ret;
+		}
+		ip_mq_unlock(service_port);
+		*filter_policy_id = 0;
+		return KERN_SUCCESS;
+	}
+#else
 	if (!mach_msg_filter_at_least(MACH_MSG_FILTER_CALLBACKS_VERSION_1)) {
 		return KERN_NOT_SUPPORTED;
 	}
+#endif
 
 	ret = ipc_port_translate_receive(space, service_port_name, &service_port);
 	if (ret) {

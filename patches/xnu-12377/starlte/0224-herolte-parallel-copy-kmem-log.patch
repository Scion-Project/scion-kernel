From 1bd4daf5f726986c1f49697dbf68d3241c59dd16 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:34:06 +0200
Subject: [PATCH] patch: 0224-herolte-parallel-copy-kmem-log.patch

port: claims log kept; the locate-space panic hunk dropped: 11417's panic already prints size and range
---
 iokit/Kernel/arm/SweetFramebuffer.cpp | 123 ++++++++++++++++++++++++++
 osfmk/vm/vm_kern.c                    |  11 +++
 2 files changed, 134 insertions(+)

diff --git a/osfmk/vm/vm_kern.c b/osfmk/vm/vm_kern.c
index 34de1af7..2d950928 100644
--- a/osfmk/vm/vm_kern.c
+++ b/osfmk/vm/vm_kern.c
@@ -3043,6 +3043,17 @@ kmem_add_extra_claims(struct mach_vm_range km_range)
 			sp_i.kc_size, /* known_last */ false);
 	}
 	assert((total_claims & PAGE_MASK) == 0);
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+	/* 2 GiB of RAM failed in kmem_range_init: record what is claimed. */
+	printf("HEROLTE KMEM: kernel_map %#llx-%#llx largest_free %#llx claims %#llx (%u) mem %#llx\n",
+	    (uint64_t)kernel_map->min_offset, (uint64_t)kernel_map->max_offset,
+	    (uint64_t)largest_free_size, (uint64_t)total_claims, kmem_claim_count,
+	    (uint64_t)sane_size);
+	for (uint32_t i = 0; i < kmem_claim_count; i++) {
+		printf("HEROLTE KMEM: claim %s %#llx\n", kmem_claims[i].kc_name,
+		    (uint64_t)kmem_claims[i].kc_size);
+	}
+#endif
 
 
 	free_size -= total_claims;
-- 
2.53.0


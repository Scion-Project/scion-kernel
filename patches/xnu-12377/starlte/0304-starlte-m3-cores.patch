From 4de8c0d8b1e713ec7093d9a4d7ca9a4260e454eb Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:35:14 +0200
Subject: [PATCH] patch: 0304-starlte-m3-cores.patch

---
 iokit/Kernel/arm/SweetCPU.cpp  | 54 +++++++++++++++++++++++++++++++---
 osfmk/arm/commpage/commpage.c  | 39 ++++++++++++++++++++++++
 osfmk/arm64/machine_routines.c | 12 ++++++++
 osfmk/arm64/start.s            | 16 +++++++++-
 4 files changed, 116 insertions(+), 5 deletions(-)

diff --git a/osfmk/arm/commpage/commpage.c b/osfmk/arm/commpage/commpage.c
index 29846632..0f905b4b 100644
--- a/osfmk/arm/commpage/commpage.c
+++ b/osfmk/arm/commpage/commpage.c
@@ -389,7 +389,34 @@ _get_commpage_text_priv_address(void)
 }
 
 #if defined(__arm64__)
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_STARLTE) && !defined(STARLTE)
+#error "STARLTE board header not seen: the M3 feature mask would be skipped"
+#endif
+#if defined(STARLTE)
+/*
+ * The S9 boots on a Cortex-A55 (ARMv8.2), but its Mongoose M3 cores are
+ * ARMv8.0: no LSE atomics, RDM, DotProd, FP16, LRCPC, DPB, ... Userland may
+ * run on either, so it is told only what both have: each 4-bit ID field is
+ * the smaller of the two. The M3 values are what Linux reports on the phone
+ * (CPU features: SANITY CHECK lines for CPU4..7).
+ */
+#define STARLTE_M3_ISAR0        0x0000000000011120ULL
+#define STARLTE_M3_ISAR1        0x0000000000000000ULL
+#define STARLTE_M3_MMFR2        0x0000000000000000ULL
+#define STARLTE_M3_PFR0         0x0000000000002222ULL
 
+static uint64_t
+starlte_common_id(uint64_t boot, uint64_t m3)
+{
+	uint64_t common = 0;
+	for (unsigned int s = 0; s < 64; s += 4) {
+		uint64_t a = (boot >> s) & 0xf, b = (m3 >> s) & 0xf;
+		common |= (a < b ? a : b) << s;
+	}
+	return common;
+}
+#endif
 
 /**
  * Initializes all commpage entries and sysctls for EL0 visible features in ID_AA64ISAR0_EL1
@@ -399,6 +426,9 @@ commpage_init_arm_optional_features_isar0(uint64_t *commpage_bits)
 {
 	uint64_t bits = 0;
 	uint64_t isar0 = __builtin_arm_rsr64("ID_AA64ISAR0_EL1");
+#if defined(STARLTE)
+	isar0 = starlte_common_id(isar0, STARLTE_M3_ISAR0);
+#endif
 
 	if ((isar0 & ID_AA64ISAR0_EL1_TS_MASK) >= ID_AA64ISAR0_EL1_TS_FLAGM_EN) {
 		gARM_FEAT_FlagM = 1;
@@ -462,6 +492,9 @@ commpage_init_arm_optional_features_isar1(uint64_t *commpage_bits)
 {
 	uint64_t bits = 0;
 	uint64_t isar1 = __builtin_arm_rsr64("ID_AA64ISAR1_EL1");
+#if defined(STARLTE)
+	isar1 = starlte_common_id(isar1, STARLTE_M3_ISAR1);
+#endif
 	uint64_t sctlr = __builtin_arm_rsr64("SCTLR_EL1");
 
 	if ((isar1 & ID_AA64ISAR1_EL1_SPECRES_MASK) >= ID_AA64ISAR1_EL1_SPECRES_EN &&
@@ -583,6 +616,9 @@ commpage_init_arm_optional_features_mmfr2(uint64_t *commpage_bits)
 {
 	uint64_t bits = 0;
 	uint64_t mmfr2 = __builtin_arm_rsr64("ID_AA64MMFR2_EL1");
+#if defined(STARLTE)
+	mmfr2 = starlte_common_id(mmfr2, STARLTE_M3_MMFR2);
+#endif
 
 	if ((mmfr2 & ID_AA64MMFR2_EL1_AT_MASK) >= ID_AA64MMFR2_EL1_AT_LSE2_EN) {
 		gARM_FEAT_LSE2 = 1;
@@ -600,6 +636,9 @@ commpage_init_arm_optional_features_pfr0(uint64_t *commpage_bits)
 {
 	uint64_t bits = 0;
 	uint64_t pfr0 = __builtin_arm_rsr64("ID_AA64PFR0_EL1");
+#if defined(STARLTE)
+	pfr0 = starlte_common_id(pfr0, STARLTE_M3_PFR0);
+#endif
 
 	if ((pfr0 & ID_AA64PFR0_EL1_CSV3_MASK) >= ID_AA64PFR0_EL1_CSV3_EN) {
 		gARM_FEAT_CSV3 = 1;
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index 1176a9b5..c37d05c0 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -1433,7 +1433,19 @@ ml_get_boot_cluster_type(void)
 int
 ml_get_cpu_number(uint32_t phys_id)
 {
+#if defined(STARLTE)
+	/* Callers pass an ADT reg (bit 31 clear) or a raw MPIDR (bit 31 RES1).
+	 * The Mongoose M3s' MPIDR has no MT bit and the same Aff1:Aff0 as A55
+	 * core 1; their reg carries bit 16 instead, as start.s does. */
+	if (phys_id & (1U << 31)) {
+		phys_id = (phys_id & (MPIDR_AFF1_MASK | MPIDR_AFF0_MASK)) |
+		    ((phys_id & (1U << 24)) ? 0 : 0x10000);
+	} else {
+		phys_id &= 0x10000 | MPIDR_AFF1_MASK | MPIDR_AFF0_MASK;
+	}
+#else
 	phys_id &= MPIDR_AFF1_MASK | MPIDR_AFF0_MASK;
+#endif
 
 	for (unsigned i = 0; i < topology_info.num_cpus; i++) {
 		if (topology_info.cpus[i].phys_id == phys_id) {
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 44a72206..82405e14 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -145,6 +145,14 @@ LEXT(reset_vector)
 	mrs		x15, MPIDR_EL1						// Load MPIDR to get CPU number
 #if HAS_CLUSTER || defined(SWEET)
 	and		x0, x15, #0xFFFF					// Full Aff1:Aff0 (SWEET: core in Aff1)
+#if defined(STARLTE)
+	/* The Mongoose M3 cores have no MT bit: MPIDR 0x80000100..0x80000103,
+	 * the same Aff1:Aff0 as A55 core 1 (0x81000100). Their ADT reg carries
+	 * bit 16 (0x10100..0x10103, mkadt_starlte.py --big). */
+	tbnz	x15, #24, 1f
+	orr		x0, x0, #0x10000
+1:
+#endif
 #else
 	and		x0, x15, #0xFF						// CPU number is in MPIDR Affinity Level 0
 #endif
@@ -899,8 +907,14 @@ common_start:
 	isb		sy
 #if defined(STARLTE)
 	/* Cortex-A55: PSTATE.PAN off (SCTLR.SPAN keeps it off from here). The
-	 * A53-targeted assembler has no PAN name: msr PAN, #0 = 0xd500409f. */
+	 * A53-targeted assembler has no PAN name: msr PAN, #0 = 0xd500409f.
+	 * The Mongoose M3s (ARMv8.0) have no PAN, the msr would be undefined
+	 * there: only when ID_AA64MMFR1_EL1.PAN (S3_0_C0_C7_1 [23:20]) != 0. */
+	mrs		x0, S3_0_C0_C7_1
+	ubfx	x0, x0, #20, #4
+	cbz		x0, 1f
 	.long	0xd500409f
+1:
 	isb		sy
 #endif
 
-- 

From af32d8b29b8374380674c61b11ec45cd99146cd3 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:30:56 +0200
Subject: [PATCH] patch: 0065-sweet-smp-psci.patch

port: topology: die-cluster-id / cluster-core-id now split by cluster->die_cluster_id; cpu_start cleans placed before the new CONFIG_SPTM block
---
 iokit/Kernel/arm/SweetCPU.cpp  | 169 ++++++++++++++++++++++++++-------
 osfmk/arm64/cpu.c              |  28 ++++++
 osfmk/arm64/machine_routines.c |  19 ++++
 osfmk/arm64/start.s            |  60 +++++++++++-
 pexpert/pexpert/arm64/SWEET.h  |   3 +
 5 files changed, 242 insertions(+), 37 deletions(-)

diff --git a/osfmk/arm64/cpu.c b/osfmk/arm64/cpu.c
index 53f9ce51..a8cc5f00 100644
--- a/osfmk/arm64/cpu.c
+++ b/osfmk/arm64/cpu.c
@@ -934,6 +934,19 @@ cpu_start(int cpu)
 
 		flush_dcache((vm_offset_t)&CpuDataEntries[cpu], sizeof(cpu_data_entry_t), FALSE);
 		flush_dcache((vm_offset_t)cpu_data_ptr, sizeof(cpu_data_t), FALSE);
+#if defined(SWEET)
+		/* The reset stub loads these through physical addresses with caches off.
+		 * Use VA range cleans to PoC, including on coherent-I/O builds. */
+		extern uint8_t bootstrap_pagetables[BOOTSTRAP_TABLE_SIZE];
+		CleanPoC_DcacheRegion_Force((vm_offset_t)CpuDataEntries, sizeof(CpuDataEntries));
+		CleanPoC_DcacheRegion_Force((vm_offset_t)cpu_data_ptr, sizeof(cpu_data_t));
+		CleanPoC_DcacheRegion_Force((vm_offset_t)&ResetHandlerData, sizeof(ResetHandlerData));
+		CleanPoC_DcacheRegion_Force((vm_offset_t)BootArgs, sizeof(*BootArgs));
+		CleanPoC_DcacheRegion_Force((vm_offset_t)&sysreg_restore, sizeof(sysreg_restore));
+		CleanPoC_DcacheRegion_Force((vm_offset_t)&cpu_ttep, sizeof(cpu_ttep));
+		CleanPoC_DcacheRegion_Force((vm_offset_t)bootstrap_pagetables, BOOTSTRAP_TABLE_SIZE);
+		__builtin_arm_dsb(DSB_SY);
+#endif
 #if CONFIG_SPTM
 		/**
 		 * On SPTM devices, CTRR is configured entirely by the SPTM. Due to this, this logic
@@ -971,6 +984,21 @@ cpu_start(int cpu)
 }
 
 
+#if defined(SWEET)
+/* Bring-up observer: the self-SGI clears SIGPdisabled after IRQs unmask. */
+boolean_t sweet_cpu_signal_is_enabled(unsigned int cpu);
+boolean_t
+sweet_cpu_signal_is_enabled(unsigned int cpu)
+{
+	if (cpu >= MAX_CPUS) {
+		return FALSE;
+	}
+	cpu_data_t *cdp = CpuDataEntries[cpu].cpu_data_vaddr;
+	return cdp != NULL && !(os_atomic_load(&cdp->cpu_signal, acquire) & SIGPdisabled);
+}
+#endif
+
+
 void
 cpu_timebase_init(boolean_t from_boot)
 {
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index 4406fde0..5ee33ab7 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -1154,6 +1154,16 @@ ml_parse_cpu_topology(void)
 	const boolean_t cpus_boot_arg_present = PE_parse_boot_argn("cpus", &cpu_boot_arg, sizeof(cpu_boot_arg));
 	const boolean_t cpumask_boot_arg_present = PE_parse_boot_argn("cpumask", &cpumask_boot_arg, sizeof(cpumask_boot_arg));
 
+#if defined(SWEET)
+	/* Opt in to SMP. Never expose the A76s to this A55-only configuration. */
+	if (!cpus_boot_arg_present || cpu_boot_arg == 0) {
+		cpu_boot_arg = 1;
+	}
+	if (cpu_boot_arg > SWEET_SMP_MAX_CPUS) {
+		cpu_boot_arg = SWEET_SMP_MAX_CPUS;
+	}
+#endif
+
 	// The cpus=N and cpumask=N boot args cannot be used simultaneously. Flag this
 	// so that we trigger a panic later in the boot process, once serial is enabled.
 	if (cpus_boot_arg_present && cpumask_boot_arg_present) {
@@ -1289,10 +1299,19 @@ ml_parse_cpu_topology(void)
 		}
 #endif
 
+#if defined(SWEET)
+		/* Aff1 encodes the core on SM7150, not an Apple cluster ID. */
+		cpu->die_cluster_id = (int)ml_readprop(child, "die-cluster-id", 0);
+#else
 		cpu->die_cluster_id = (int)ml_readprop(child, "die-cluster-id", MPIDR_CLUSTER_ID(cpu->phys_id));
+#endif
 		cluster->die_cluster_id = cpu->die_cluster_id;
 
+#if defined(SWEET)
+		cpu->cluster_core_id = (int)ml_readprop(child, "cluster-core-id", cpu->phys_id >> 8);
+#else
 		cpu->cluster_core_id = (int)ml_readprop(child, "cluster-core-id", MPIDR_CPU_ID(cpu->phys_id));
+#endif
 
 		cpu->cpu_pset_id = PSET_ID_INVALID; /* initialized by ml_bootstrap_processors() */
 
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 92f5d4be..2a8e5a00 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -143,8 +143,8 @@ LEXT(reset_vector)
 	adrp	x19, EXT(ResetHandlerData)@page			// Get address of the reset handler data
 	add		x19, x19, EXT(ResetHandlerData)@pageoff
 	mrs		x15, MPIDR_EL1						// Load MPIDR to get CPU number
-#if HAS_CLUSTER
-	and		x0, x15, #0xFFFF					// CPU number in Affinity0, cluster ID in Affinity1
+#if HAS_CLUSTER || defined(SWEET)
+	and		x0, x15, #0xFFFF					// Full Aff1:Aff0 (SWEET: core in Aff1)
 #else
 	and		x0, x15, #0xFF						// CPU number is in MPIDR Affinity Level 0
 #endif
@@ -289,6 +289,56 @@ LEXT(LowExceptionVectorBase)
 LEXT(bootstrap_instructions)
 
 #endif /* defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR) || defined(KERNEL_INTEGRITY_PV_CTRR) */
+#if defined(SWEET)
+/* PSCI CPU_ON entry (physical): x0=context_id, no stack, MMU/caches off.
+ * Keep this separate from __start (which requires x0=boot_args PA).
+ * Firmware may return at EL1 or EL2; check before accessing EL1 state.
+ * The EL2 path assumes no resident hypervisor and CNTVOFF_EL2=0 on boot.
+ */
+	.align 2
+	.globl EXT(sweet_secondary_entry)
+LEXT(sweet_secondary_entry)
+	msr		DAIFSet, #0xf
+	mrs		x1, CurrentEL
+	cmp		x1, #0x4
+	b.eq	Lsweet_secondary_el1
+	cmp		x1, #0x8
+	b.ne	Lsweet_secondary_bad_el
+	adrp	x1, EXT(LowExceptionVectorBase)@page
+	add		x1, x1, EXT(LowExceptionVectorBase)@pageoff
+	msr		VBAR_EL2, x1
+	/* No stage 2, AArch64 EL1, no EL2 interrupt or FP/debug traps. */
+	mov		x1, #(1 << 31)
+	msr		HCR_EL2, x1
+	msr		VTTBR_EL2, xzr
+	msr		CPTR_EL2, xzr
+	msr		MDCR_EL2, xzr
+	mov		x1, #3
+	msr		CNTHCTL_EL2, x1
+	msr		CNTVOFF_EL2, xzr
+	/* Permit ICC_SRE_EL1 and GIC CPU interface system-register access. */
+	mrs		x1, ICC_SRE_EL2
+	orr		x1, x1, #1
+	orr		x1, x1, #8
+	msr		ICC_SRE_EL2, x1
+	/* Known Armv8 SCTLR RES1 bits, M/C/I off, little endian. */
+	MOV64	x1, 0x30d00800
+	msr		SCTLR_EL1, x1
+	isb
+	adrp	x1, Lsweet_secondary_el1@page
+	add		x1, x1, Lsweet_secondary_el1@pageoff
+	msr		ELR_EL2, x1
+	mov		x1, #0x3c5			// DAIF masked, AArch64 EL1h
+	msr		SPSR_EL2, x1
+	eret
+Lsweet_secondary_bad_el:
+	b		.
+Lsweet_secondary_el1:
+	/* x0 is deliberately unused; reset_vector selects CPU data by MPIDR. */
+	msr		SPSel, #1
+	b		EXT(LowResetVectorBase)
+#endif /* SWEET */
+
 	.align 2
 	.globl EXT(resume_idle_cpu)
 LEXT(resume_idle_cpu)
@@ -750,6 +800,12 @@ common_start:
 	ic		iallu
 #endif
 
+#if defined(SWEET)
+	/* Complete local TLB/I-cache invalidation before enabling the MMU. */
+	dsb		sy
+	isb
+#endif
+
 	/* If x21 is not 0, then this is either the start_cpu path or
 	 * the resume_idle_cpu path.  cpu_ttep should already be
 	 * populated, so just switch to the kernel_pmap now.

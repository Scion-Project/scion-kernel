From 13e2bf975447108abc704cf035b45df9083b1e89 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:30:19 +0200
Subject: [PATCH] patch: 0024-sweet-mockfs-virtual-ramdisk-io.patch

---
 bsd/miscfs/mockfs/mockfs_fsnode.c | 3 ++-
 bsd/miscfs/mockfs/mockfs_vfsops.c | 7 ++++++-
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/bsd/miscfs/mockfs/mockfs_fsnode.c b/bsd/miscfs/mockfs/mockfs_fsnode.c
index a470fc84..55c851c5 100644
--- a/bsd/miscfs/mockfs/mockfs_fsnode.c
+++ b/bsd/miscfs/mockfs/mockfs_fsnode.c
@@ -345,7 +345,8 @@ mockfs_fsnode_vnode(mockfs_fsnode_t fsnp, vnode_t * vpp)
 				panic("mockfs_fsvnode failed to get ubc_mem_object for a new vnode");
 			}
 
-			rvalue = pager_map_to_phys_contiguous(ubc_mem_object, 0, (mockfs_mnt->mockfs_memdev_base << PAGE_SHIFT), fsnp->size);
+			/* memdev counts in 4K pages, independent of the kernel's PAGE_SHIFT. */
+			rvalue = pager_map_to_phys_contiguous(ubc_mem_object, 0, ((uint64_t)mockfs_mnt->mockfs_memdev_base << 12), fsnp->size);
 
 			if (rvalue) {
 				panic("mockfs_fsnode_vnode failed to create fictitious pages for a memory-backed device; rvalue = %d", rvalue);
diff --git a/bsd/miscfs/mockfs/mockfs_vfsops.c b/bsd/miscfs/mockfs/mockfs_vfsops.c
index 325bb060..9b8429b1 100644
--- a/bsd/miscfs/mockfs/mockfs_vfsops.c
+++ b/bsd/miscfs/mockfs/mockfs_vfsops.c
@@ -102,7 +102,12 @@ mockfs_mountroot(mount_t mp, vnode_t rvp, __unused vfs_context_t ctx)
 		 * For the moment, we won't try to optimize when mi_phys is true.
 		 */
 		if (!mockfs_mount_data->mockfs_physical_memory) {
-			mockfs_mount_data->mockfs_memory_backed = memdev_info.mi_mdev;
+			/*
+			 * Only a physical memory device has an address the pager can map
+			 * directly; a virtual one (IOKit's RAMDisk) goes through normal
+			 * device I/O. mi_base is a physical page number only when mi_phys.
+			 */
+			mockfs_mount_data->mockfs_memory_backed = memdev_info.mi_mdev && memdev_info.mi_phys;
 			mockfs_mount_data->mockfs_physical_memory = memdev_info.mi_phys;
 			mockfs_mount_data->mockfs_memdev_base = memdev_info.mi_base;
 			mockfs_mount_data->mockfs_memdev_size = memdev_info.mi_size;
-- 
2.53.0


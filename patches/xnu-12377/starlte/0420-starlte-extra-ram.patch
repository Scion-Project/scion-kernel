 	}
diff --git a/osfmk/arm/pmap/pmap.h b/osfmk/arm/pmap/pmap.h
index f9e841f85..78765bfe5 100644
--- a/osfmk/arm/pmap/pmap.h
+++ b/osfmk/arm/pmap/pmap.h
@@ -547,6 +547,24 @@ extern pmap_paddr_t kvtophys_nofail(vm_offset_t va);
 extern vm_map_address_t phystokv(pmap_paddr_t pa);
 extern vm_map_address_t phystokv_range(pmap_paddr_t pa, vm_size_t *max_len);
 
+/*
+ * HakiOS/Scion (patch 1512, ported to xnu-12377): RAM the boot loader gives the kernel beside its window
+ * [gPhysBase, gPhysBase + memSize), in the device tree's /chosen "hakios-extra-ram" (pairs of 64-bit base and size),
+ * taken only with boot-arg extra_ram=1. The Galaxy S9's RAM is in two banks (2 GB from 0x80000000 with the firmware's
+ * ranges in it, 2 GB from 0x880000000); the window is in the second, the free pieces of the first come here.
+ * arm_vm_init() reads them, maps them in the physical aperture and gives each page an index after the window's in the
+ * pmap's tables (pa_index); arm_vm_prot_finalize() gives the pages to the VM, as ml_static_mfree() does its own.
+ */
+#define HAKIOS_EXTRA_RAM_MAX 12
+typedef struct {
+	pmap_paddr_t pa;        /* the first byte, PAGE_SIZE aligned */
+	pmap_paddr_t end;       /* past the last byte, PAGE_SIZE aligned */
+	unsigned int pai;       /* the pmap's index (pa_index) of its first page */
+} hakios_extra_ram_t;
+extern hakios_extra_ram_t hakios_extra_ram[HAKIOS_EXTRA_RAM_MAX];
+extern unsigned int hakios_extra_ram_count;     /* ranges in use */
+extern unsigned int hakios_extra_ram_pages;     /* PAGE_SIZE pages in them all */
+
 extern vm_map_address_t pmap_map(vm_map_address_t va, vm_offset_t sa, vm_offset_t ea, vm_prot_t prot, unsigned int flags);
 extern vm_map_address_t pmap_map_high_window_bd( vm_offset_t pa, vm_size_t len, vm_prot_t prot);
 extern kern_return_t pmap_map_block(pmap_t pmap, addr64_t va, ppnum_t pa, uint32_t size, vm_prot_t prot, int attr, unsigned int flags);
diff --git a/osfmk/arm/pmap/pmap_data.c b/osfmk/arm/pmap/pmap_data.c
index 9c758b0e6..6c3659ad1 100644
--- a/osfmk/arm/pmap/pmap_data.c
+++ b/osfmk/arm/pmap/pmap_data.c
@@ -620,7 +620,7 @@ pmap_data_bootstrap(void)
 	 * needed to cover all of kernel-managed physical memory.
 	 */
 	const uint32_t num_leaf_page_tables =
-	    (uint32_t)(mem_size / ((PAGE_SIZE / sizeof(pt_entry_t)) * ARM_PGBYTES));
+	    (uint32_t)((mem_size + ptoa(hakios_extra_ram_pages)) / ((PAGE_SIZE / sizeof(pt_entry_t)) * ARM_PGBYTES));
 
 	/**
 	 * There should be one PTD per page table (times 2 since we want twice the
@@ -635,7 +635,7 @@ pmap_data_bootstrap(void)
 	vm_size_t ptd_root_table_size = num_ptd_pages * PAGE_SIZE;
 
 	/* Number of VM pages that span all of kernel-managed memory. */
-	unsigned int npages = (unsigned int)atop(mem_size);
+	unsigned int npages = (unsigned int)atop(mem_size) + hakios_extra_ram_pages;   /* (HakiOS, patch 1512: and the extra RAM's) */
 
 	/* The pv_head_table and pp_attr_table both have one entry per VM page. */
 	const vm_size_t pp_attr_table_size = npages * sizeof(pp_attr_t);
@@ -1234,8 +1234,9 @@ pmap_enqueue_pages(vm_page_t list)
 	vm_object_lock(pmap_object);
 
 	_vm_page_list_foreach_consume(mem, &list) {
+		/* (HakiOS, patch 1512: pa - gPhysBase, and for the extra RAM beside the window an offset after it) */
 		const vm_object_offset_t offset =
-		    (vm_object_offset_t) ((ptoa(VM_PAGE_GET_PHYS_PAGE(mem))) - gPhysBase);
+		    (vm_object_offset_t) ptoa(pa_index(ptoa(VM_PAGE_GET_PHYS_PAGE(mem))));
 
 		vm_page_insert_internal(mem, pmap_object, offset,
 		    VM_KERN_MEMORY_PTE, VMPI_NONE, &delayed_acct);
@@ -1553,7 +1554,7 @@ pmap_pages_free(pmap_paddr_t pa, __assert_only unsigned size)
 		 * Remove the page from the pmap's VM object and return it back to the
 		 * VM's global free list of pages.
 		 */
-		mem = vm_page_lookup(pmap_object, (pa - gPhysBase));
+		mem = vm_page_lookup(pmap_object, ptoa(pa_index(pa)));   /* (HakiOS, patch 1512) */
 		assert(mem != VM_PAGE_NULL);
 		assert(VM_PAGE_WIRED(mem));
 		vm_page_lock_queues();
@@ -2626,7 +2627,7 @@ pmap_remove_pv(
 	}
 #endif /* PVH_FLAG_EXEC */
 	if (__improbable((pvh_flags & PVH_FLAG_FLUSH_NEEDED) && pvh_test_type(pvh, PVH_TYPE_NULL))) {
-		pmap_flush_noncoherent_page((pmap_paddr_t)ptoa(pai) + vm_first_phys);
+		pmap_flush_noncoherent_page(pai_to_pa(pai));   /* (HakiOS, patch 1512) */
 	}
 
 	*is_internal_p = is_internal;
diff --git a/osfmk/arm/pmap/pmap_data.h b/osfmk/arm/pmap/pmap_data.h
index f66dfba3b..df1e92d26 100644
--- a/osfmk/arm/pmap/pmap_data.h
+++ b/osfmk/arm/pmap/pmap_data.h
@@ -74,7 +74,16 @@ extern pmap_paddr_t vm_first_phys, vm_last_phys;
 static inline bool
 pa_valid(pmap_paddr_t pa)
 {
-	return (pa >= vm_first_phys) && (pa < vm_last_phys);
+	if (__probable((pa >= vm_first_phys) && (pa < vm_last_phys))) {
+		return true;
+	}
+	/* HakiOS (patch 1512): the boot loader's extra RAM beside the window (arm/pmap/pmap.h) is kernel-managed too */
+	for (unsigned int i = 0; i < hakios_extra_ram_count; i++) {
+		if ((pa >= hakios_extra_ram[i].pa) && (pa < hakios_extra_ram[i].end)) {
+			return true;
+		}
+	}
+	return false;
 }
 
 /**
@@ -98,9 +107,33 @@ pa_valid(pmap_paddr_t pa)
 static inline unsigned int
 pa_index(pmap_paddr_t pa)
 {
+	if (__probable((pa >= vm_first_phys) && (pa < vm_last_phys))) {
+		return (unsigned int)atop(pa - vm_first_phys);
+	}
+	/* HakiOS (patch 1512): an extra range's pages come after the window's, in the order of the ranges */
+	for (unsigned int i = 0; i < hakios_extra_ram_count; i++) {
+		if ((pa >= hakios_extra_ram[i].pa) && (pa < hakios_extra_ram[i].end)) {
+			return hakios_extra_ram[i].pai + (unsigned int)atop(pa - hakios_extra_ram[i].pa);
+		}
+	}
 	return (unsigned int)atop(pa - vm_first_phys);
 }
 
+/**
+ * The physical address of a physical address index (the reverse of pa_index()). HakiOS (patch 1512).
+ */
+static inline pmap_paddr_t
+pai_to_pa(unsigned int pai)
+{
+	for (unsigned int i = 0; i < hakios_extra_ram_count; i++) {
+		if ((pai >= hakios_extra_ram[i].pai) &&
+		    (pai - hakios_extra_ram[i].pai < atop(hakios_extra_ram[i].end - hakios_extra_ram[i].pa))) {
+			return hakios_extra_ram[i].pa + ptoa((pmap_paddr_t)(pai - hakios_extra_ram[i].pai));
+		}
+	}
+	return vm_first_phys + ptoa((pmap_paddr_t)pai);
+}
+
 /* See the definition of pv_head_table for more information. */
 extern pv_entry_t **pv_head_table;
 
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 3cf71a827..90d8f0a03 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -367,15 +367,111 @@ typedef struct {
 	vm_size_t len;
 } ptov_table_entry;
 
+/* (HakiOS, patch 1512: and one for each range of the boot loader's extra RAM) */
 #if HAS_MTE
-#define PTOV_TABLE_SIZE 9
+#define PTOV_TABLE_SIZE (9 + HAKIOS_EXTRA_RAM_MAX)
 #else /* HAS_MTE */
-#define PTOV_TABLE_SIZE 8
+#define PTOV_TABLE_SIZE (8 + HAKIOS_EXTRA_RAM_MAX)
 #endif /* HAS_MTE */
 
 SECURITY_READ_ONLY_LATE(static ptov_table_entry)        ptov_table[PTOV_TABLE_SIZE];
 SECURITY_READ_ONLY_LATE(static boolean_t)               kva_active = FALSE;
 
+/*
+ * HakiOS (patch 1512, ported to xnu-12377): the boot loader's extra RAM beside the window (arm/pmap/pmap.h). Read once
+ * from the device tree in arm_vm_init(), before anything is sized from the memory there is. Only with boot-arg
+ * extra_ram=1 (off by default on this tree until a phone run proves it); extra_ram=N with N > 1: at most N MB in all (the
+ * last range taken is cut); extra_ram_mask=BITS takes only the ranges whose bit is set (bit 0: the property's first).
+ * Ranges must lie below the window: 12377's VM finds the pages of RAM outside its vm_pages array in a radix tree that
+ * starts at pmap_first_pnum, which is lowered to the lowest extra page (vm_page_find_canonical()).
+ */
+SECURITY_READ_ONLY_LATE(hakios_extra_ram_t) hakios_extra_ram[HAKIOS_EXTRA_RAM_MAX];
+SECURITY_READ_ONLY_LATE(unsigned int) hakios_extra_ram_count = 0;
+SECURITY_READ_ONLY_LATE(unsigned int) hakios_extra_ram_pages = 0;
+SECURITY_READ_ONLY_LATE(static unsigned int) hakios_extra_ram_refused = 0;
+SECURITY_READ_ONLY_LATE(static unsigned int) hakios_extra_ram_offered = 0;
+
+static void
+hakios_extra_ram_init(void)
+{
+	DTEntry chosen;
+	const uint64_t *ranges;
+	unsigned int size = 0, first_pai = (unsigned int)atop(mem_size);
+	uint32_t on = 0, mask = 0xffffffffu, cap_mb = 0;
+
+	if (!PE_parse_boot_argn("extra_ram", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	(void)PE_parse_boot_argn("extra_ram_mask", &mask, sizeof(mask));
+	cap_mb = on > 1 ? on : 0;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "hakios-extra-ram", (void const **)&ranges, &size) != kSuccess) {
+		return;
+	}
+	uint64_t cap = cap_mb ? ((uint64_t)cap_mb << 20) : UINT64_MAX, taken = 0;
+	for (unsigned int i = 0; i + 1 < size / sizeof(uint64_t) && hakios_extra_ram_count < HAKIOS_EXTRA_RAM_MAX; i += 2) {
+		hakios_extra_ram_offered++;
+		if (!(mask & (1u << ((i / 2) & 31)))) {
+			continue;
+		}
+		pmap_paddr_t pa = round_page(ranges[i]), end = trunc_page(ranges[i] + ranges[i + 1]);
+		bool ok = end > pa && ranges[i] + ranges[i + 1] > ranges[i];
+
+		/* below the window only (vm_page_find_canonical), never the window, nor another range */
+		if (ok && end > gPhysBase) {
+			ok = false;
+		}
+		for (unsigned int j = 0; ok && j < hakios_extra_ram_count; j++) {
+			ok = !(pa < hakios_extra_ram[j].end && end > hakios_extra_ram[j].pa);
+		}
+		if (ok && taken >= cap) {
+			continue;
+		}
+		if (ok && end - pa > cap - taken) {
+			end = pa + trunc_page(cap - taken);
+			ok = end > pa;
+		}
+		if (!ok) {
+			hakios_extra_ram_refused++;     /* (said in arm_vm_prot_finalize(): too early for printf here) */
+			continue;
+		}
+		hakios_extra_ram[hakios_extra_ram_count].pa = pa;
+		hakios_extra_ram[hakios_extra_ram_count].end = end;
+		hakios_extra_ram[hakios_extra_ram_count].pai = first_pai + hakios_extra_ram_pages;
+		hakios_extra_ram_pages += (unsigned int)atop(end - pa);
+		hakios_extra_ram_count++;
+		taken += end - pa;
+		/* 12377: the radix tree of canonical pages outside vm_pages starts here (vm_resident.c) */
+		if ((ppnum_t)atop(pa) < pmap_first_pnum) {
+			pmap_first_pnum = (ppnum_t)atop(pa);
+		}
+	}
+}
+
+/* [pa, pa + len) is all in one of the extra ranges */
+static bool
+hakios_extra_ram_covers(pmap_paddr_t pa, pmap_paddr_t len)
+{
+	for (unsigned int i = 0; i < hakios_extra_ram_count; i++) {
+		if (pa >= hakios_extra_ram[i].pa && pa + len <= hakios_extra_ram[i].end) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* [pa, pa + len) meets one of the extra ranges */
+static bool
+hakios_extra_ram_meets(pmap_paddr_t pa, pmap_paddr_t len)
+{
+	for (unsigned int i = 0; i < hakios_extra_ram_count; i++) {
+		if (pa < hakios_extra_ram[i].end && pa + len > hakios_extra_ram[i].pa) {
+			return true;
+		}
+	}
+	return false;
+}
+
 #define ARM64_PAGE_UNGUARDED (0)
 #define ARM64_PAGE_GUARDED   (1)
 
@@ -1011,7 +1107,9 @@ arm_vm_page_granular_helper(vm_offset_t start, vm_offset_t _end, vm_offset_t va,
 		va &= ~ARM_TT_L2_OFFMASK;
 		pa = va - gVirtBase + gPhysBase - pa_offset;
 
-		if (pa >= real_avail_end) {
+		/* (HakiOS, patch 1512: an extra range may be anywhere, below the window too) */
+		bool extra = hakios_extra_ram_meets(pa, ARM_TT_L2_SIZE);
+		if (pa >= real_avail_end && !extra) {
 			return;
 		}
 
@@ -1038,10 +1136,10 @@ arm_vm_page_granular_helper(vm_offset_t start, vm_offset_t _end, vm_offset_t va,
 		}
 
 		vm_offset_t len = _end - va;
-		if ((pa + len) > real_avail_end) {
+		if (!extra && (pa + len) > real_avail_end) {
 			_end -= (pa + len - real_avail_end);
 		}
-		assert((start - gVirtBase + gPhysBase - pa_offset) >= gPhysBase);
+		assert(extra || (start - gVirtBase + gPhysBase - pa_offset) >= gPhysBase);
 
 		/* Round up to the nearest PAGE_SIZE boundary when creating mappings:
 		 * PAGE_SIZE may be a multiple of ARM_PGBYTES, and we don't want to leave
@@ -1141,7 +1239,7 @@ arm_vm_page_granular_prot(vm_offset_t start, unsigned long size, pmap_paddr_t pa
 
 			tte2 = arm_kva_to_tte(align_start);
 

From 98e6725deee5b3205351472c4e7ecd8b665beadf Mon Sep 17 00:00:00 2001
From: Claudius <claudiusthebot@gmail.com>
Date: Sun, 8 Nov 2026 20:57:03 +0000
Subject: [PATCH] parity: extra RAM (Scion 1512 port) + touch priority/period
 boot-args

---
 bsd/dev/starlte_touch.c        |  30 ++++++-
 osfmk/arm/caches.c             |  20 +++++
 osfmk/arm/pmap/pmap.c          |  13 ++-
 osfmk/arm/pmap/pmap.h          |  18 ++++
 osfmk/arm/pmap/pmap_data.c     |  11 +--
 osfmk/arm/pmap/pmap_data.h     |  35 +++++++-
 osfmk/arm64/arm_vm_init.c      | 153 +++++++++++++++++++++++++++++++--
 osfmk/arm64/machine_routines.c |  26 ++++++
 8 files changed, 287 insertions(+), 19 deletions(-)

diff --git a/bsd/dev/starlte_touch.c b/bsd/dev/starlte_touch.c
index 9eb69ffde..5552ac0a9 100644
--- a/bsd/dev/starlte_touch.c
+++ b/bsd/dev/starlte_touch.c
@@ -33,6 +33,17 @@
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern void sweet_hid_touch(int finger, int down, int x, int y);
 void starlte_touch_probe(void);
+extern kern_return_t kernel_thread_start_priority(thread_continue_t continuation, void *parameter, integer_t priority,
+    thread_t *new_thread);
+
+/*
+ * Scion's touch findings (HakiOS hakios.s6sy761.c, xnu-8796), behind boot-args here (default: as before):
+ *   startouch=N      (N > 1) the polling thread's priority (startouch=0: no touch, 1: as before). Scion runs it at 92 (BASEPRI_PREEMPT, as its display presenter):
+ *                    at the kernel's default it lost the processors to the window server under load and a finger's
+ *                    moves came in bursts (scrolling sticky, long presses by mistake; seen on the S9, 1 November).
+ *   startouch_ms=N   the polling period, 2..20 ms (Scion: 4; here 5 by default).
+ */
+static unsigned st_poll_ms = 5;
 
 #define ST_CMU_PERIC0_PA        0x10400000u     /* gates +0x2018/0x206c/0x20dc/0x20e0, QCH +0x3038 */
 #define ST_SYSREG_PERIC0_PA     0x10411000u     /* +0x1c USI03 mode: 4 = I2C */
@@ -694,7 +705,7 @@ st_thread(__unused void *arg, __unused wait_result_t wr)
 	bool sense = st_cmd(S6_SENSE_ON);
 	st_msleep(20);
 	bool clear = st_cmd(S6_CLEAR_EVENT_STACK);
-	printf("STARLTE TOUCH: sense on %d, clear %d; polling every 5 ms\n", sense, clear);
+	printf("STARLTE TOUCH: sense on %d, clear %d; polling every %u ms\n", sense, clear, st_poll_ms);
 
 	unsigned stuck = 0;
 	for (unsigned tick = 0;; tick++) {
@@ -713,10 +724,10 @@ st_thread(__unused void *arg, __unused wait_result_t wr)
 		} else {
 			stuck = 0;
 		}
-		if (tick % 6000 == 5999) {
+		if (tick % (30000 / st_poll_ms) == (30000 / st_poll_ms) - 1) {
 			printf("STARLTE TOUCH: %u events, %u retries, %u lost\n", st_events, st_retries, st_lost);
 		}
-		st_msleep(5);
+		st_msleep(st_poll_ms);
 	}
 }
 
@@ -876,7 +887,18 @@ starlte_touch_probe(void)
 	}
 	st_alive = ml_io_map(ST_ALIVE_PA, 0x1000);
 	printf("STARLTE TOUCH: INT pin %s at probe\n", st_int_low() ? "low" : "high");
-	if (kernel_thread_start(st_thread, NULL, &thread) == KERN_SUCCESS) {
+	uint32_t pri = on, ms = 0;      /* startouch=N, N > 1: the thread's priority (short: the command line is full) */
+	if (PE_parse_boot_argn("startouch_ms", &ms, sizeof(ms)) && ms >= 2 && ms <= 20) {
+		st_poll_ms = ms;
+	}
+	kern_return_t kr;
+	if (pri >= 2 && pri <= 95) {
+		kr = kernel_thread_start_priority((thread_continue_t)st_thread, NULL, (integer_t)pri, &thread);
+		printf("STARLTE TOUCH: thread at priority %u, every %u ms\n", pri, st_poll_ms);
+	} else {
+		kr = kernel_thread_start(st_thread, NULL, &thread);
+	}
+	if (kr == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
 }
diff --git a/osfmk/arm/caches.c b/osfmk/arm/caches.c
index b5b3ba935..fd335b6e4 100644
--- a/osfmk/arm/caches.c
+++ b/osfmk/arm/caches.c
@@ -47,6 +47,26 @@
 
 #include <arm/misc_protos.h>
 
+/*
+ * HakiOS (patch 1512): the boot loader's extra RAM beside the window (arm/pmap/pmap.h) is in the physical aperture too,
+ * and is RAM: not a page to map through a copy window, nor (cache_sync_page) a reason to clean the whole data cache.
+ */
+static inline bool
+hakios_isphysmem(pmap_paddr_t pa)
+{
+	if (((vm_address_t)pa - gPhysBase) < gPhysSize) {
+		return true;
+	}
+	for (unsigned int i = 0; i < hakios_extra_ram_count; i++) {
+		if ((pa >= hakios_extra_ram[i].pa) && (pa < hakios_extra_ram[i].end)) {
+			return true;
+		}
+	}
+	return false;
+}
+#undef isphysmem
+#define isphysmem(a) hakios_isphysmem((pmap_paddr_t)(a))
+
 /*
  * dcache_incoherent_io_flush64() dcache_incoherent_io_store64() result info
  */

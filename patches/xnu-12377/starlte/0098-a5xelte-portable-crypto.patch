From c203d43f5f1333a08c5b8e3ff56538f3a7a29803 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:33:10 +0200
Subject: [PATCH] patch: 0098-a5xelte-portable-crypto.patch

---
 libkern/crypto/corecrypto_aes.c      | 2 +-
 libkern/crypto/corecrypto_md5.c      | 2 +-
 libkern/crypto/corecrypto_sha1.c     | 2 +-
 libkern/crypto/corecrypto_sha2.c     | 4 ++--
 libkern/crypto/sweet_aes.c           | 2 +-
 libkern/crypto/sweet_aes_ct.c        | 2 +-
 libkern/crypto/sweet_aes_ct_cbcdec.c | 2 +-
 libkern/crypto/sweet_aes_ct_cbcenc.c | 2 +-
 libkern/crypto/sweet_aes_ct_dec.c    | 2 +-
 libkern/crypto/sweet_aes_ct_enc.c    | 2 +-
 libkern/crypto/sweet_dec32be.c       | 2 +-
 libkern/crypto/sweet_dec32le.c       | 2 +-
 libkern/crypto/sweet_dec64be.c       | 2 +-
 libkern/crypto/sweet_enc32be.c       | 2 +-
 libkern/crypto/sweet_enc32le.c       | 2 +-
 libkern/crypto/sweet_enc64be.c       | 2 +-
 libkern/crypto/sweet_md5.c           | 2 +-
 libkern/crypto/sweet_sha1.c          | 2 +-
 libkern/crypto/sweet_sha2big.c       | 2 +-
 19 files changed, 20 insertions(+), 20 deletions(-)

diff --git a/libkern/crypto/corecrypto_aes.c b/libkern/crypto/corecrypto_aes.c
index 384abb64..9f20dd49 100644
--- a/libkern/crypto/corecrypto_aes.c
+++ b/libkern/crypto/corecrypto_aes.c
@@ -32,7 +32,7 @@
 #include <corecrypto/ccaes.h>
 #include <kern/debug.h>
 
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 /* SWEET has a built-in portable AES provider for the legacy CBC/ECB API. */
 extern const struct ccmode_cbc sweet_aes_cbc_encrypt;
 extern const struct ccmode_cbc sweet_aes_cbc_decrypt;
diff --git a/libkern/crypto/corecrypto_md5.c b/libkern/crypto/corecrypto_md5.c
index e9bbc428..65a34eb0 100644
--- a/libkern/crypto/corecrypto_md5.c
+++ b/libkern/crypto/corecrypto_md5.c
@@ -17,7 +17,7 @@ setCount(MD5_CTX *ctx, uint64_t count)
 }
 
 /* Copy a ccdigest ctx into a legacy MD5 context */
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 /*
  * SWEET has no corecrypto kext (g_crypto_funcs stays NULL). MD5 uses
  * BearSSL's portable implementation (libkern/crypto/sweet_md5.c), with
diff --git a/libkern/crypto/corecrypto_sha1.c b/libkern/crypto/corecrypto_sha1.c
index 409533d5..1ec17087 100644
--- a/libkern/crypto/corecrypto_sha1.c
+++ b/libkern/crypto/corecrypto_sha1.c
@@ -16,7 +16,7 @@ setCount(SHA1_CTX *ctx, uint64_t count)
 	ctx->c.b64[0] = count;
 }
 
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 /*
  * SWEET has no corecrypto kext (g_crypto_funcs stays NULL). SHA-1 uses
  * BearSSL's portable implementation (libkern/crypto/sweet_sha1.c), with
diff --git a/libkern/crypto/corecrypto_sha2.c b/libkern/crypto/corecrypto_sha2.c
index c954dd27..37eed681 100644
--- a/libkern/crypto/corecrypto_sha2.c
+++ b/libkern/crypto/corecrypto_sha2.c
@@ -34,7 +34,7 @@
 
 #if defined(CRYPTO_SHA2)
 
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 /*
  * SWEET has no corecrypto kext, so g_crypto_funcs stays NULL. SHA-256 uses
  * XNU's built-in implementation directly, as the SWEET PRNG does; this also
@@ -84,7 +84,7 @@ SHA256_Final(void *digest, SHA256_CTX *ctx)
 	ccdigest_final(di, ctx->ctx, digest);
 }
 
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 #include "sweet_bearssl/inc/bearssl_hash.h"
 
 _Static_assert(sizeof(br_sha384_context) <= sizeof(SHA512_CTX),

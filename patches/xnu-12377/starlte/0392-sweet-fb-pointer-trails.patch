From cbbdc2eff45e6d52d333d1a4667421d8d94e06a1 Mon Sep 17 00:00:00 2001
From: Starbite author <starbite@local>
Date: Thu, 5 Nov 2026 07:54:04 +0200
Subject: [PATCH] patch: 0392-sweet-fb-pointer-trails.patch - a pointer-only
 swap restores the pointer's old rectangle from the last layer 0 first (macOS
 left a trail of pointers)

---
 iokit/Kernel/arm/SweetFramebuffer.cpp | 41 +++++++++++++++++++++++++++
 1 file changed, 41 insertions(+)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 573b39de..96a5cc1d 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -984,6 +984,47 @@ AppleCLCD::present(const uint8_t *rec)
 			}
 		}
 		sweet_fb_blend = layer > 0;
+		/*
+		 * Pointer trails (0392): a pointer move is a swap of layer 1 alone, so the panel still held
+		 * the pointer drawn at its old place. Before drawing it at the new one, the old rectangle is
+		 * copied back from the last full-screen layer 0 (macOS: the desktop composite).
+		 */
+		{
+			static uint32_t baseId;                 /* last layer 0 surface (logical 0,0 full screen) */
+			static int32_t curX, curY, curW, curH;  /* where the pointer was last drawn, logical */
+			static bool haveCur;
+			if (layer == 0 && src != 0 && dx == 0 && dy == 0) {
+				baseId = id;
+				haveCur = false;        /* the full copy below covers any old pointer */
+			} else if (layer > 0 && src != 0 && fScaled && bpe == 4) {
+				if (haveCur && baseId != 0 && !(mask & 1u) &&
+				    (curX != dx || curY != dy)) {
+					SweetSurface *b = sweet_surface_copy(baseId);
+					uintptr_t bsrc = b ? b->kernelAddress() : 0;
+					if (bsrc != 0 && b->bytesPerElement <= 4) {
+						int32_t rx = curX, ry = curY, rw = curW, rh = curH;
+						if (rx + rw > (int32_t)b->width) {
+							rw = (int32_t)b->width - rx;
+						}
+						if (ry + rh > (int32_t)b->height) {
+							rh = (int32_t)b->height - ry;
+						}
+						if (rw > 0 && rh > 0) {
+							sweet_fb_blend = false;
+							scaledCopy(bsrc + b->offset + (uint64_t)ry * b->bytesPerRow + (uint64_t)rx * 4,
+							    b->bytesPerRow, rx, ry, rw, rh);
+							sweet_fb_blend = true;
+						}
+					}
+					OSSafeReleaseNULL(b);
+				}
+				curX = dx;
+				curY = dy;
+				curW = w;
+				curH = h;
+				haveCur = true;
+			}
+		}
 #endif
 		if (src != 0 && bpe == 4 && fScaled) {
 			copied += scaledCopy(src + s->offset + (uint64_t)sy * s->bytesPerRow + (uint64_t)sx * 4,
-- 

From 6b2b8fcadacef24261ca4859a323a7d43b676d76 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:32:26 +0200
Subject: [PATCH] patch: 0085-a5xelte-board-target.patch

port: board lists: BCM2837 gone, A5XELTE appended after SWEET. TODO: config/MASTER.arm64.a5xelte is also an 8796-era copy, rebase at the end.
---
 config/MASTER.arm64.a5xelte          | 115 +++++++++++++++++++++++++++
 makedefs/MakeInc.def                 |   7 +-
 pexpert/pexpert/arm64/A5XELTE.h      |  31 ++++++++
 pexpert/pexpert/arm64/Makefile       |   3 +-
 pexpert/pexpert/arm64/board_config.h |  10 +++
 5 files changed, 162 insertions(+), 4 deletions(-)
 create mode 100644 config/MASTER.arm64.a5xelte
 create mode 100644 pexpert/pexpert/arm64/A5XELTE.h

diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 9f184943..87f28176 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -29,7 +29,7 @@ SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else ifneq ($(findstring _host,$(RC_ProjectName)),)
 SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else
-SUPPORTED_ARM64_MACHINE_CONFIGS = T6000 T6020 T6030 T6031 T6041 T6050 T8101 T8103 T8112 T8122 T8132 T8142 VMAPPLE SWEET
+SUPPORTED_ARM64_MACHINE_CONFIGS = T6000 T6020 T6030 T6031 T6041 T6050 T8101 T8103 T8112 T8122 T8132 T8142 VMAPPLE SWEET A5XELTE
 
 SPTM_ENABLED_SOCS_MacOSX = t6000 t8112 t6020 t8122 t6030 t6031 t6041 t6050 t8132 t8142
 EXCLAVES_ENABLED_SOCS_MacOSX = t8142 t6050
@@ -94,6 +94,7 @@ MACHINE_FLAGS_ARM64_T8142 = -DARM64_BOARD_CONFIG_T8142 			-mcpu=apple-m4+memtag+
 
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a+sme2
 MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=armv8.2-a+crypto
+MACHINE_FLAGS_ARM64_A5XELTE = -DARM64_BOARD_CONFIG_A5XELTE            -march=armv8-a+crypto
 
 
 #
@@ -371,8 +372,8 @@ ifeq ($(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG),)
 # Without embdedded device map, use a default arch string
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := $(shell echo $(CURRENT_ARCH_CONFIG) | tr A-Z a-z)
 ifneq ($(filter arm64,$(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG)),)
-# sweet's Cortex-A76/A55 have no pointer authentication: stay plain arm64
-ifneq ($(CURRENT_MACHINE_CONFIG),SWEET)
+# These generic ARMv8 targets do not use Apple's arm64e pointer authentication.
+ifeq ($(filter $(CURRENT_MACHINE_CONFIG),SWEET A5XELTE),)
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := arm64e
 endif
 endif
diff --git a/pexpert/pexpert/arm64/Makefile b/pexpert/pexpert/arm64/Makefile
index 1561d807..c524202a 100644
--- a/pexpert/pexpert/arm64/Makefile
+++ b/pexpert/pexpert/arm64/Makefile
@@ -34,7 +34,8 @@ PRIVATE_KERNELFILES = \
 	H16.h \
 	H17.h \
 	VMAPPLE.h \
-	SWEET.h
+	SWEET.h \
+	A5XELTE.h
 
 
 # Headers installed into System.framework/PrivateHeaders (userspace internal SDK only).
diff --git a/pexpert/pexpert/arm64/board_config.h b/pexpert/pexpert/arm64/board_config.h
index 56b5fdc1..25115a4a 100644
--- a/pexpert/pexpert/arm64/board_config.h
+++ b/pexpert/pexpert/arm64/board_config.h
@@ -315,6 +315,16 @@
 
 #endif  /* ARM64_BOARD_CONFIG_SWEET */
 
+#ifdef ARM64_BOARD_CONFIG_A5XELTE
+#include <pexpert/arm64/A5XELTE.h>
+
+#define MAX_L2_CLINE                   6
+#define MAX_CPUS                       8
+#define MAX_CPU_CLUSTERS               1
+
+#define CORE_NCTRS                     8
+#endif  /* ARM64_BOARD_CONFIG_A5XELTE */
+
 #ifdef ARM64_BOARD_CONFIG_VMAPPLE
 #include <pexpert/arm64/VMAPPLE.h>
 
-- 
2.53.0


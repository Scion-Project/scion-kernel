From 7897460681655e81e034db179f3f5e49d00ab607 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:33:34 +0200
Subject: [PATCH] patch: 0110-a5xelte-system-bootlog.patch

---
 bsd/dev/a5xelte_emmc.c         | 142 +++++++++++++++++++++++++++++++--
 osfmk/console/serial_console.c |   6 ++
 2 files changed, 142 insertions(+), 6 deletions(-)

diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
index 1bcb427b..ed079ccf 100644
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -278,6 +278,9 @@ _cnputc(char c, bool poll)
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 extern void sweet_log_append(const char *c, int size);  /* bsd/dev/sweet_ufs.c */
 #endif
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+extern void a5xelte_log_append(const char *c, int size); /* bsd/dev/a5xelte_emmc.c */
+#endif
 #if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 /*
  * Set by AppleCLCD (boot-arg sweetfb_noconsole=1) once the GUI presents:
@@ -293,6 +296,9 @@ _cnputs(char *c, int size, bool poll)
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 	sweet_log_append(c, size);
 #endif
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+	a5xelte_log_append(c, size);
+#endif
 #if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
 	if (sweet_console_muted && !panic_active()) {
 		return;
-- 

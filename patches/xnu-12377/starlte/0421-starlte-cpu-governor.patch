From f2316048b288e7fcb9358ce4ef31f5917dfd5af0 Mon Sep 17 00:00:00 2001
From: Claudius <claudiusthebot@gmail.com>
Date: Sun, 8 Nov 2026 20:59:49 +0000
Subject: [PATCH] parity: Scion CPU governor (cpufreq_gov=1) via the one
 Starbite ACPM client

---
 bsd/conf/files                        |    3 +
 bsd/dev/hakios.exynos_acpm_dvfs.c     |  219 ++++
 bsd/dev/hakios.exynos_cpufreq.c       | 1342 +++++++++++++++++++++++++
 bsd/dev/hakios.scion_gov.c            |  135 +++
 bsd/dev/starlte_touch.c               |   63 +-
 bsd/dev/starlte_usbcon.c              |    3 +-
 bsd/sys/hakios.scion_gov.h            |   58 ++
 iokit/Kernel/arm/SweetFramebuffer.cpp |    8 +
 iokit/bsddev/IOKitBSDInit.cpp         |    3 +
 osfmk/arm64/machine_routines.c        |   20 +
 10 files changed, 1851 insertions(+), 3 deletions(-)
 create mode 100644 bsd/dev/hakios.exynos_acpm_dvfs.c
 create mode 100644 bsd/dev/hakios.exynos_cpufreq.c
 create mode 100644 bsd/dev/hakios.scion_gov.c
 create mode 100644 bsd/sys/hakios.scion_gov.h

diff --git a/bsd/conf/files b/bsd/conf/files
index 3ace96fda..b1e7d12b3 100644
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -117,6 +117,9 @@ bsd/dev/hakios.exynos_hsi2c.c		standard
 bsd/dev/starlte_gpu.c			standard
 bsd/dev/starlte_overlay.c		standard
 bsd/dev/starlte_sd.c			standard
+bsd/dev/hakios.exynos_acpm_dvfs.c	standard
+bsd/dev/hakios.exynos_cpufreq.c	standard
+bsd/dev/hakios.scion_gov.c		standard
 bsd/dev/herolte_battery.c		standard
 bsd/dev/herolte_gpu.c			standard
 bsd/dev/a5xelte_keys.c			standard
diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
index 47acdd93f..d7d1b315c 100644
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -812,6 +812,9 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 	{
 		extern void starlte_touch_probe(void);
 		starlte_touch_probe();
+		/* Boot-arg cpufreq_gov=1: the CPU governor (bsd/dev/hakios.exynos_cpufreq.c); off: nothing. */
+		extern bool hakios_exynos_cpufreq_gov_start(void);
+		(void)hakios_exynos_cpufreq_gov_start();
 		extern void starlte_smp_probe(void);   /* boot-arg starsmpprobe=1 */
 		starlte_smp_probe();
 		/* Mali-G72 read-only probe (bsd/dev/starlte_gpu.c), boot-arg stargpu=0 off. */
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index ba0204ed7..3683fe115 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -64,6 +64,26 @@
 #include <pexpert/device_tree.h>
 #include <pexpert/arm64/board_config.h>
 #include <kern/smr.h>
+#include <kern/recount.h>
+#include <kern/processor.h>
+
+/*
+ * How long processor cpu_id has been idle since it started, in mach_absolute_time() units: the CPU governor's load
+ * (bsd/dev/hakios.exynos_cpufreq.c). From HakiOS/Scion (scion-kernel osfmk/arm64/machine_routines.c).
+ */
+bool ml_cpu_idle_time(int cpu_id, uint64_t *idle);
+
+bool
+ml_cpu_idle_time(int cpu_id, uint64_t *idle)
+{
+	struct recount_usage usage = { 0 };
+
+	if (cpu_id < 0 || cpu_id >= MAX_CPUS || processor_array[cpu_id] == PROCESSOR_NULL) {
+		return false;
+	}
+	recount_processor_usage(&processor_array[cpu_id]->pr_recount, &usage, idle);
+	return true;
+}
 
 #include <IOKit/IOPlatformExpert.h>
 #if HIBERNATION

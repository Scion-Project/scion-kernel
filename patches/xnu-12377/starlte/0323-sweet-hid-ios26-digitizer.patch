+	{ 15, 1, 0, 0, 0, 0 },                  /* Home: unlock to the home screen */
+	{ 25, 0, 380, 500, 380, 500 },          /* tap the first widget */
+	{ 35, 1, 0, 0, 0, 0 },                  /* Home: back */
+	{ 40, 0, 1300, 1500, 150, 1500 },       /* swipe to the next page */
+	{ 50, 0, 380, 500, 380, 500 },          /* tap */

+/*
+ * sweet (iOS 26): IOHIDFamily-2238's layout (macOS 26.5 KDK DWARF, 0xa0 bytes):
+ * the IOFixed members became IOHIDDouble and twist moved into the "angle"
+ * union. iOS 26's HID event system parses the serialized event with this
+ * layout; the 1915 one (0x68 bytes) put our bytes into generationCount and
+ * the update masks, and backboardd dropped every touch. The double members
+ * hold IEEE-754 bits (uint64_t): the kernel converts 16.16 fixed values with
+ * integer arithmetic (sweet_fixed_to_dbits / sweet_dbits_to_fixed).
+ */
+typedef uint64_t IOHIDDoubleBits;

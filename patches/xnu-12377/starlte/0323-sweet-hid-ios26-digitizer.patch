+/* 16.16 fixed <-> IEEE-754 double bits, integer arithmetic only (no FP in the kernel). */
+static inline IOHIDDoubleBits
+sweet_fixed_to_dbits(int32_t v)
+{
+    if (v == 0) {
+        return 0;
+    }
+    uint64_t sign = v < 0 ? (1ULL << 63) : 0;
+    uint64_t m = v < 0 ? (uint64_t)(-(int64_t)v) : (uint64_t)v;
+    int msb = 63 - __builtin_clzll(m);
+    uint64_t frac = (m << (52 - msb)) & ((1ULL << 52) - 1);
+    return sign | ((uint64_t)(msb - 16 + 1023) << 52) | frac;
+}
+
+static inline int32_t
+sweet_dbits_to_fixed(IOHIDDoubleBits d)
+{
+    int exp = (int)((d >> 52) & 0x7ff);
+    if (exp == 0) {
+        return 0;
+    }
+    if (exp == 0x7ff) {
+        return (int32_t)0x80000000;      /* kIOFixedNaN */
+    }
+    uint64_t m = (d & ((1ULL << 52) - 1)) | (1ULL << 52);
+    int shift = exp - 1023 - 52 + 16;   /* value * 65536 = m * 2^shift */
+    int64_t v;
+    if (shift >= 0) {
+        v = shift > 10 ? INT32_MAX : (int64_t)(m << shift);
+    } else {
+        v = shift < -63 ? 0 : (int64_t)(m >> -shift);
+    }
+    if (v > INT32_MAX) {
+        v = INT32_MAX;
+    }
+    return (int32_t)((d >> 63) ? -v : v);
+}
 

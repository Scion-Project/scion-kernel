+		int home = homes ? st_script_home[i].home : phone ? st_script_phone[i].home : st_script[i].home;
+		int x0 = homes ? st_script_home[i].x0 : phone ? st_script_phone[i].x0 : st_script[i].x0;
+		int y0 = homes ? st_script_home[i].y0 : phone ? st_script_phone[i].y0 : st_script[i].y0;
+		int x1 = homes ? st_script_home[i].x1 : phone ? st_script_phone[i].x1 : st_script[i].x1;
+		int y1 = homes ? st_script_home[i].y1 : phone ? st_script_phone[i].y1 : st_script[i].y1;
 		uint64_t now_ns;
 		absolutetime_to_nanoseconds(mach_absolute_time(), &now_ns);
 		uint64_t at_ns = start_ns + (uint64_t)at_s * NSEC_PER_SEC;

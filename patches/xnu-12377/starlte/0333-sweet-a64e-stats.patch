From ec7cf534663284a9cd1935def8c5d2a251807b9e Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Sun, 1 Nov 2026 22:16:20 +0200
Subject: [PATCH] patch: 0333-sweet-a64e-stats.patch

sweet: the STARLTE TOP report adds a line with the arm64e instructions emulated in the window (by kind) and the three processes that trapped most, to see what untranslated binaries (outside the shared cache) cost.
- a64e stats in STARLTE TOP
- forward declaration
---
 bsd/dev/starlte_smp.c    | 44 ++++++++++++++++++++++++++++++++++++++++
 osfmk/arm64/sweet_a64e.c | 24 +++++++++++++++++++++-
 2 files changed, 67 insertions(+), 1 deletion(-)

diff --git a/bsd/dev/starlte_smp.c b/bsd/dev/starlte_smp.c
index d9dab4b4..05103a5e 100644
--- a/bsd/dev/starlte_smp.c
+++ b/bsd/dev/starlte_smp.c
@@ -95,6 +95,8 @@ starlte_cpu_clock_report(void)
  */
 extern processor_t thread_bind(processor_t processor);   /* (sched_prim.h: MACH_KERNEL_PRIVATE only) */
 
+static void st_top_a64e(uint64_t window_ns);
+
 /*
  * Which processes use the CPU (the S7 and S9 ports found a Bluetooth audio plug-in polling a
  * missing daemon at 300-460% of the CPUs): every 10 s, each process's CPU time (task, user +
@@ -171,6 +173,7 @@ st_top(void)
 				used[best] = 0;
 			}
 			printf("%s\n", line);
+			st_top_a64e(window_ns);
 		}
 		bcopy(st_top_now, st_top_last, sizeof(st_top_now[0]) * st_top_n);
 		st_top_last_n = st_top_n;
@@ -179,6 +182,47 @@ st_top(void)
 	}
 }
 
+/* arm64e instructions emulated in the window (osfmk/arm64/sweet_a64e.c), and by whom */
+struct sweet_a64e_pid { int pid; uint64_t count; };
+extern uint64_t sweet_a64e_counts[8];
+extern struct sweet_a64e_pid sweet_a64e_pids[32];
+
+static void
+st_top_a64e(uint64_t window_ns)
+{
+	static uint64_t last[8];
+	uint64_t d[8], all = 0;
+	for (unsigned i = 0; i < 8; i++) {
+		uint64_t c = sweet_a64e_counts[i];
+		d[i] = c - last[i];
+		last[i] = c;
+		all += d[i];
+	}
+	char line[256];
+	int n = snprintf(line, sizeof(line), "STARLTE A64E: %llu emulated (%llu/s): ret %llu br %llu ldra %llu other %llu; by pid:",
+	    all, window_ns ? all * NSEC_PER_SEC / window_ns : 0, d[0], d[1], d[2], all - d[0] - d[1] - d[2]);
+	for (unsigned k = 0; k < 3; k++) {
+		unsigned best = 32;
+		for (unsigned i = 0; i < 32; i++) {
+			if (sweet_a64e_pids[i].count != 0 && (best == 32 || sweet_a64e_pids[i].count > sweet_a64e_pids[best].count)) {
+				best = i;
+			}
+		}
+		if (best == 32) {
+			break;
+		}
+		n += snprintf(line + n, sizeof(line) - (size_t)n, " %d:%llu", sweet_a64e_pids[best].pid,
+		    sweet_a64e_pids[best].count);
+		sweet_a64e_pids[best].count = 0;
+	}
+	/* (the rest start again from zero) */
+	for (unsigned i = 0; i < 32; i++) {
+		sweet_a64e_pids[i].count = 0;
+		sweet_a64e_pids[i].pid = 0;
+	}
+	printf("%s\n", line);
+}
+
 static void
 st_cpu_survey(__unused void *arg, __unused wait_result_t wr)
 {
diff --git a/osfmk/arm64/sweet_a64e.c b/osfmk/arm64/sweet_a64e.c
index ba104af3..a8a6312a 100644
--- a/osfmk/arm64/sweet_a64e.c
+++ b/osfmk/arm64/sweet_a64e.c
@@ -29,7 +29,28 @@ bool sweet_a64e_emulate(arm_saved_state_t *state, uint32_t instr);
 extern uint64_t sweet_a64e_fp_addsub(uint64_t a, uint64_t b, uint32_t op_size, uint32_t fpcr,
     uint32_t *fpsr);
 
-static uint64_t sweet_a64e_counts[8];
+uint64_t sweet_a64e_counts[8];
+
+/* Traps by process, for the STARLTE TOP report (bsd/dev/starlte_smp.c): a small open table. */
+#define SWEET_A64E_PIDS 32
+struct sweet_a64e_pid { int pid; uint64_t count; };
+struct sweet_a64e_pid sweet_a64e_pids[SWEET_A64E_PIDS];
+extern int proc_selfpid(void);
+
+static void
+sweet_a64e_count_pid(void)
+{
+	int pid = proc_selfpid();
+	unsigned h = (unsigned)pid % SWEET_A64E_PIDS;
+	for (unsigned i = 0; i < SWEET_A64E_PIDS; i++) {
+		struct sweet_a64e_pid *e = &sweet_a64e_pids[(h + i) % SWEET_A64E_PIDS];
+		if (e->pid == pid || e->pid == 0) {
+			e->pid = pid;
+			e->count++;
+			return;
+		}
+	}
+}
 
 /* r = 31 reads as XZR (sp31 false) or SP (sp31 true). */
 static uint64_t
@@ -163,6 +184,7 @@ emulate_fcadd(arm_saved_state_t *ss, uint32_t w)
 bool
 sweet_a64e_emulate(arm_saved_state_t *ss, uint32_t w)
 {
+	sweet_a64e_count_pid();
 	uint64_t pc = get_saved_state_pc(ss);
 
 	if ((w & 0xFFFFFBFF) == 0xD65F0BFF) {                   /* RETAA, RETAB */

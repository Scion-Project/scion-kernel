From 716c8c736500ab468cb14e97a1d2384a3fa8581e Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:26:29 +0200
Subject: [PATCH] patch: 0003-sweet-framebuffer-serial-console.patch

port: serial_init now matches a serial-device phandle and returns early without one; fbcon is probed before that and initialised on its own. SERIAL_SWEET_FBCON = 0x10 (PI3 UART became PL011 0x4, DCC 0x8).
---
 pexpert/arm/pe_serial.c      | 155 ++++++++++++++++++++++++++++++++++-
 pexpert/pexpert/arm/protos.h |   3 +-
 2 files changed, 156 insertions(+), 2 deletions(-)

diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index 032d9e00..8dffde52 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -751,6 +751,148 @@ static void uart_puts_force_poll_device(
 	const char *str,
 	struct pe_serial_functions *fns);
 
+/*****************************************************************************/
+
+/*
+ * sweet: framebuffer "serial" for boards with no usable UART (the Redmi Note
+ * 10 Pro's debug UART engine runs in SPI mode). kprintf output is drawn onto
+ * the boot framebuffer described by the ADT node "sweet-fbcon":
+ *   reg    = <phys size>       absolute physical address, not arm-io relative
+ *   width, height              pixels
+ *   stride                     bytes per line, 32bpp
+ * Lines wrap back to the top instead of scrolling; the line after the cursor
+ * is kept blank so the newest output is easy to find.
+ */
+
+extern unsigned char iso_font[256 * 16];
+
+#define FBCON_SCALE     2
+#define FBCON_FG        0xffffffffu
+#define FBCON_BG        0xff000000u
+
+static volatile uint32_t *fbcon_base;
+static uint32_t fbcon_width, fbcon_height, fbcon_stride;
+static uint32_t fbcon_cols, fbcon_rows, fbcon_col, fbcon_row;
+
+static void
+fbcon_clear_row(uint32_t row)
+{
+	for (uint32_t y = row * 16 * FBCON_SCALE; y < (row + 1) * 16 * FBCON_SCALE; y++) {
+		volatile uint32_t *line = fbcon_base + y * (fbcon_stride / 4);
+		for (uint32_t x = 0; x < fbcon_width; x++) {
+			line[x] = FBCON_BG;
+		}
+	}
+}
+
+static void
+fbcon_newline(void)
+{
+	fbcon_col = 0;
+	fbcon_row = (fbcon_row + 1) % fbcon_rows;
+	fbcon_clear_row(fbcon_row);
+	fbcon_clear_row((fbcon_row + 1) % fbcon_rows);
+}
+
+static void
+fbcon_init(void)
+{
+	fbcon_cols = fbcon_width / (8 * FBCON_SCALE);
+	fbcon_rows = fbcon_height / (16 * FBCON_SCALE);
+	fbcon_col = fbcon_row = 0;
+	for (uint32_t r = 0; r < fbcon_rows; r++) {
+		fbcon_clear_row(r);
+	}
+}
+
+static unsigned int
+fbcon_transmit_ready(void)
+{
+	return 1;
+}
+
+static void
+fbcon_transmit_data(uint8_t c)
+{
+	if (c == '\r') {
+		fbcon_col = 0;
+		return;
+	}
+	if (c == '\n') {
+		fbcon_newline();
+		return;
+	}
+	if (fbcon_col >= fbcon_cols) {
+		fbcon_newline();
+	}
+	const unsigned char *glyph = iso_font + c * 16;
+	uint32_t x0 = fbcon_col * 8 * FBCON_SCALE, y0 = fbcon_row * 16 * FBCON_SCALE;
+	for (uint32_t gy = 0; gy < 16; gy++) {
+		for (uint32_t sy = 0; sy < FBCON_SCALE; sy++) {
+			volatile uint32_t *line = fbcon_base + (y0 + gy * FBCON_SCALE + sy) * (fbcon_stride / 4) + x0;
+			for (uint32_t gx = 0; gx < 8; gx++) {
+				uint32_t px = (glyph[gy] & (1u << gx)) ? FBCON_FG : FBCON_BG;
+				for (uint32_t sx = 0; sx < FBCON_SCALE; sx++) {
+					line[gx * FBCON_SCALE + sx] = px;
+				}
+			}
+		}
+	}
+	fbcon_col++;
+}
+
+static unsigned int
+fbcon_receive_ready(void)
+{
+	return 0;
+}
+
+static uint8_t
+fbcon_receive_data(void)
+{
+	return 0;
+}
+
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) sweet_fbcon_serial_functions =
+{
+	.init = fbcon_init,
+	.transmit_ready = fbcon_transmit_ready,
+	.transmit_data = fbcon_transmit_data,
+	.receive_ready = fbcon_receive_ready,
+	.receive_data = fbcon_receive_data,
+	.device = SERIAL_SWEET_FBCON
+};
+
+static void
+fbcon_probe(void)
+{
+	DTEntry entry;
+	uint64_t const *reg;
+	uint32_t const *val;
+	unsigned int size;
+
+	if (SecureDTFindEntry("name", "sweet-fbcon", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "reg", (void const **)&reg, &size) != kSuccess || size < 16) {
+		return;
+	}
+	if (SecureDTGetProperty(entry, "width", (void const **)&val, &size) == kSuccess) {
+		fbcon_width = *val;
+	}
+	if (SecureDTGetProperty(entry, "height", (void const **)&val, &size) == kSuccess) {
+		fbcon_height = *val;
+	}
+	if (SecureDTGetProperty(entry, "stride", (void const **)&val, &size) == kSuccess) {
+		fbcon_stride = *val;
+	}
+	if (!fbcon_width || !fbcon_height || fbcon_stride < fbcon_width * 4) {
+		return;
+	}
+	fbcon_base = (volatile uint32_t *)ml_io_map_wcomb(reg[0], reg[1]);
+	if (fbcon_base != NULL) {
+		register_serial_functions(&sweet_fbcon_serial_functions);
+	}
+}
+
 #if HIBERNATION
 /**
  * Transitions the serial driver into a mode that can be run in the hibernation
@@ -908,11 +1050,22 @@ serial_init(void)
 
 	PE_parse_boot_argn("disable-uart-irq", &disable_uart_irq, sizeof(disable_uart_irq));
 
+	fbcon_probe();
+
 	// Get the phandle of the serial device XNU has been configured to use.
 	uint32_t phandle;
 	if (!get_serial_device_phandle(&phandle)) {
 		// XNU has not been configured to use a serial device; return early.
-		return 0;
+		// sweet: unless the framebuffer console registered itself above.
+		if (gPESF == NULL) {
+			return 0;
+		}
+		for (fns = gPESF; fns != NULL; fns = fns->next) {
+			serial_do_transmit = 1;
+			fns->init();
+		}
+		uart_initted = true;
+		return 1;
 	}
 
 	// Look at the "compatible" string in the devicetree node referenced by the
diff --git a/pexpert/pexpert/arm/protos.h b/pexpert/pexpert/arm/protos.h
index f8fcbc29..78d2e5b9 100644
--- a/pexpert/pexpert/arm/protos.h
+++ b/pexpert/pexpert/arm/protos.h
@@ -47,7 +47,8 @@ typedef enum serial_device {
 	SERIAL_APPLE_UART=0x1,
 	SERIAL_DOCKCHANNEL=0x2,
 	SERIAL_PL011_UART=0x4,
-	SERIAL_DCC_UART=0x8
+	SERIAL_DCC_UART=0x8,
+	SERIAL_SWEET_FBCON=0x10
 } serial_device_t;
 
 kern_return_t serial_irq_enable(serial_device_t device);
-- 

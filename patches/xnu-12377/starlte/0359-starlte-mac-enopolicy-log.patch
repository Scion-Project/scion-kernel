From c3d59c4b078ce2378dd7f36dbfd8acda591763e1 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 4 Nov 2026 02:43:33 +0200
Subject: [PATCH] patch: 0359-starlte-mac-enopolicy-log.patch - log
 __mac_syscall calls to policies that are not registered

---
 security/mac_base.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/security/mac_base.c b/security/mac_base.c
index 9f90247f..ce1b571f 100644
--- a/security/mac_base.c
+++ b/security/mac_base.c
@@ -1614,6 +1614,17 @@ __mac_syscall(proc_t p, struct __mac_syscall_args *uap, int *retv __unused)
 	}
 
 done:
+#if defined(ARM64_BOARD_CONFIG_STARLTE)
+	if (error == ENOPOLICY) {
+		/* which MAC policy a new userland asks for that is not here (first 40) */
+		static int left = 40;
+		if (left > 0) {
+			left--;
+			printf("STARBITE MAC: %s[%d] __mac_syscall(\"%s\", %d): no such policy\n", p->p_comm,
+			    proc_getpid(p), target, uap->call);
+		}
+	}
+#endif
 	return error;
 }
 

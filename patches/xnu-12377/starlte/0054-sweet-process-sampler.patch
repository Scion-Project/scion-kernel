From 76ff260833a036570b7785db52d3e7382e3cdcfd Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:30:31 +0200
Subject: [PATCH] patch: 0054-sweet-process-sampler.patch

---
 bsd/conf/files                        |  1 +
 bsd/dev/sweet_sample.c                | 88 +++++++++++++++++++++++++++
 bsd/dev/sweet_ufs.c                   |  2 +
 iokit/Kernel/IOUserClient.cpp         |  4 +-
 iokit/Kernel/arm/SweetFramebuffer.cpp |  5 ++
 osfmk/kern/exception.c                | 50 +++++++++++++++
 6 files changed, 148 insertions(+), 2 deletions(-)
 create mode 100644 bsd/dev/sweet_sample.c

diff --git a/bsd/conf/files b/bsd/conf/files
index 129d337d..3cc59a2e 100644
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -104,6 +104,7 @@ bsd/dev/random/randomdev.c		standard
 
 bsd/dev/memdev.c			standard
 bsd/dev/sweet_ufs.c			standard
+bsd/dev/sweet_sample.c			standard
 bsd/dev/mem.c				standard
 bsd/dev/munge.c 			optional config_requires_u32_munging
 bsd/dev/unix_startup.c			standard
diff --git a/iokit/Kernel/IOUserClient.cpp b/iokit/Kernel/IOUserClient.cpp
index 00c98b98..504a9dfe 100644
--- a/iokit/Kernel/IOUserClient.cpp
+++ b/iokit/Kernel/IOUserClient.cpp
@@ -2732,7 +2732,7 @@ static
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 /*
  * SWEET IOKit trace: registry and matching calls made by the processes
- * named in boot-arg sweetiolog (comma separated, default "backboardd";
+ * named in boot-arg sweetiolog (comma separated, default "backboardd,SpringBoard";
  * "-" turns it off) are printed as "IOK name: ...", at most 400 lines per
  * boot, to find out what a daemon looks for before it gives up.
  */
@@ -2745,7 +2745,7 @@ sweet_iolog(char *name, size_t len)
 {
 	if (!sweet_iolog_parsed) {
 		if (!PE_parse_boot_argn("sweetiolog", sweet_iolog_names, sizeof(sweet_iolog_names))) {
-			strlcpy(sweet_iolog_names, "backboardd", sizeof(sweet_iolog_names));
+			strlcpy(sweet_iolog_names, "backboardd,SpringBoard", sizeof(sweet_iolog_names));
 		}
 		sweet_iolog_parsed = 1;
 	}
diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index 2e64cd14..b5d51f14 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -1113,6 +1113,56 @@ sweet_crash_strings(const char *name)
 	printf("STR done: %llu KiB scanned, %d strings\n", scanned >> 10, lines);
 	kfree_data(buf, 65536);
 }
+/*
+ * SWEET process sampler (bsd/dev/sweet_sample.c): user pc/lr/sp and a frame
+ * pointer backtrace of every thread of a task, from the saved user state.
+ */
+void sweet_sample_task(const char *name, int pid, task_t task);
+
+void
+sweet_sample_task(const char *name, int pid, task_t task)
+{
+	vm_map_t map = get_task_map(task);
+	uint64_t slide = 0;
+	int tn = 0;
+	thread_t thread;
+	vm_shared_region_t sr = vm_shared_region_get(task);
+
+	if (sr != NULL) {
+		slide = sr->sr_slide;
+		vm_shared_region_deallocate(sr);
+	}
+	printf("SMP %s[%d] slide 0x%llx mh 0x%llx\n", name, pid, slide, task->mach_header_vm_address);
+
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		arm_saved_state_t *ss = find_user_regs(thread);
+		char line[220];
+		int n;
+		uint64_t fp;
+
+		if (ss == NULL || !is_saved_state64(ss)) {
+			continue;
+		}
+		fp = get_saved_state_fp(ss);
+		n = snprintf(line, sizeof(line), "SMP %s t%d pc 0x%llx lr 0x%llx sp 0x%llx bt", name, tn++,
+		    get_saved_state_pc(ss), get_saved_state_lr(ss), get_saved_state_sp(ss));
+		for (int i = 0; i < 8 && fp != 0 && (fp & 7) == 0 && n < (int)sizeof(line) - 20; i++) {
+			uint64_t frame[2];
+			if (vm_map_read_user(map, fp, frame, sizeof(frame)) != KERN_SUCCESS) {
+				break;
+			}
+			n += snprintf(line + n, sizeof(line) - n, " 0x%llx", frame[1]);
+			if (frame[0] <= fp) {
+				break;
+			}
+			fp = frame[0];
+		}
+		printf("%s\n", line);
+	}
+	task_unlock(task);
+}
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
 
 kern_return_t

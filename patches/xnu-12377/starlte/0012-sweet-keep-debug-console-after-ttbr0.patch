From 342c051c03134b7fadc0336826e7b5281e8e2090 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:29:01 +0200
Subject: [PATCH] patch: 0012-sweet-keep-debug-console-after-ttbr0.patch

port: include and export-list lines, context moved
---
 osfmk/arm/arm_init.c      |  7 +++++++
 osfmk/arm64/Makefile      |  1 +
 osfmk/arm64/arm_vm_init.c | 41 +++++++++++++++++++++++++++++++++++++--
 osfmk/arm64/sweet_early.c | 27 +++++++++++++++++++-------
 osfmk/arm64/sweet_early.h |  4 +++-
 pexpert/arm/pe_serial.c   |  3 +++
 6 files changed, 73 insertions(+), 10 deletions(-)

diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index ee8ec778..858c1525 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -579,6 +579,7 @@ arm_init(
 
 	sweet_early_mark(7, "entering arm_vm_init");
 	arm_vm_init(xmaxmem, args);
+	sweet_early_mark(15, "arm_vm_init returned");
 
 	if (debug_boot_arg) {
 		patch_low_glo();
@@ -591,9 +592,15 @@ arm_init(
 	PE_consistent_debug_inherit();
 
 	/* Setup debugging output. */
+	sweet_early_mark(16, "calling serial_init");
 	const unsigned int serial_exists = serial_init();
+	sweet_early_mark(19, "serial_init returned");
 	kernel_startup_initialize_upto(STARTUP_SUB_KPRINTF);
 	kprintf("kprintf initialized\n");
+	sweet_early_mark(20, "kprintf startup complete");
+	if (serial_exists) {
+		sweet_early_disable();
+	}
 
 	serialmode = 0;
 	if (PE_parse_boot_argn("serial", &serialmode, sizeof(serialmode))) {
diff --git a/osfmk/arm64/Makefile b/osfmk/arm64/Makefile
index 60f42249..4fdd735d 100644
--- a/osfmk/arm64/Makefile
+++ b/osfmk/arm64/Makefile
@@ -53,6 +53,7 @@ EXPORT_MD_LIST = \
 	machine_remote_time.h \
 	monotonic.h \
 	proc_reg.h \
+	sweet_early.h \
 	asm.h \
 	speculation.h \
 	static_if.h \
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 01cc6c71..9e8f61d8 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1820,6 +1820,32 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
 #define ARM64_PHYSMAP_ALIGNMENT_PADDING (PTOV_TABLE_SIZE * ARM_TT_TWIG_SIZE)
 #endif
 
+#if defined(SWEET)
+/*
+ * The reserved low-globals/kernel region is excluded from VM allocation.
+ * Use the otherwise empty 32MB block above low globals and below gVirtBase
+ * for a Normal-NC framebuffer alias that survives bootstrap TTBR0 teardown.
+ */
+#define SWEET_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
+
+static void
+sweet_early_map_final(void)
+{
+	const vm_map_address_t va = SWEET_EARLY_FB_VA;
+	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
+	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
+	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
+	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
+	assert(*slot == ARM_TTE_EMPTY);
+	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	__asm__ volatile("dsb ishst" ::: "memory");
+}
+#endif
+
 void
 arm_vm_init(uint64_t memory_size, boot_args * args)
 {
@@ -2174,20 +2200,28 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	kasan_init();
 #endif /* KASAN */
 
+#if defined(SWEET)
+	/* phystokv() must still refer to the bootstrap aperture here. */
+	sweet_early_map_final();
+#endif
 	arm_vm_physmap_init(args);
 	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
 
 	ml_enable_monitor();
 
-	/* The framebuffer VA=PA mapping belongs to the outgoing TTBR0. */
-	sweet_early_disable();
+#if defined(SWEET)
+	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */
+	sweet_early_relocate(SWEET_EARLY_FB_VA);
+#endif
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
 	flush_mmu_tlb();
+	sweet_early_mark(10, "TTBR0 off; TLB flushed");
 	kva_active = TRUE;
 	// global table pointers may need to be different due to physical aperture remapping
 	cpu_tte = (tt_entry_t*)(phystokv(cpu_ttep));
 	invalid_tte = (tt_entry_t*)(phystokv(invalid_ttep));
+	sweet_early_mark(11, "physmap table pointers rebound");
 
 	// From here on out, we're off the bootstrap translation tables.
 
@@ -2280,7 +2314,9 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
     }
 #endif
 #endif
+	sweet_early_mark(12, "calling pmap_bootstrap");
 	pmap_bootstrap(dynamic_memory_begin);
+	sweet_early_mark(13, "pmap_bootstrap done");
 
 	disable_preemption();
 
@@ -2331,6 +2367,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 		va_l1 = va_l2_end;
 		cpu_l1_tte++;
 	}
+	sweet_early_mark(14, "early I/O page tables ready");
 
 #if defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR) || defined(KERNEL_INTEGRITY_PV_CTRR)
 	/*
diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index 8dffde52..8e652432 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -26,6 +26,7 @@
 #include <pexpert/arm/consistent_debug.h>
 #include <pexpert/arm64/board_config.h>
 #include <arm64/proc_reg.h>
+#include <arm64/sweet_early.h>
 #include <pexpert/arm/protos.h>
 #include <kern/sched_prim.h>
 #ifdef PL011_UART
@@ -887,7 +888,9 @@ fbcon_probe(void)
 	if (!fbcon_width || !fbcon_height || fbcon_stride < fbcon_width * 4) {
 		return;
 	}
+	sweet_early_mark(17, "fbcon config read; mapping");
 	fbcon_base = (volatile uint32_t *)ml_io_map_wcomb(reg[0], reg[1]);
+	sweet_early_mark(18, "fbcon mapping returned");
 	if (fbcon_base != NULL) {
 		register_serial_functions(&sweet_fbcon_serial_functions);
 	}
-- 
2.53.0


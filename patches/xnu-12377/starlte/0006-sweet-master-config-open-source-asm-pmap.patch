From bc5ad4e4888dff1679f8bb329cd1d58b0daa238f Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:27:23 +0200
Subject: [PATCH] patch: 0006-sweet-master-config-open-source-asm-pmap.patch

---
 config/MASTER.arm64.sweet | 114 ++++++++++++++++++++++++++++++++++++++
 makedefs/MakeInc.def      |   4 ++
 2 files changed, 118 insertions(+)
 create mode 100644 config/MASTER.arm64.sweet

diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index b068f7ef..9f184943 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -1155,9 +1155,13 @@ LD_KERNEL_LIBS	   = -lcc_kext
 LD_KERNEL_ARCHIVES = $(LDFLAGS_KERNEL_SDK) -lfirehose_kernel
 
 # Link binary support library
+# sweet: the generic boards build the open-source asm and pmap instead
+# (nos_arm_asm, nos_arm_pmap); the KDK has no lib<board>.os.<config>.a for them.
 ifneq ($(CURRENT_MACHINE_CONFIG),NONE)
+ifeq ($(filter SWEET A5XELTE HEROLTE STARLTE,$(CURRENT_MACHINE_CONFIG)),)
         LDFLAGS_KERNEL_ONLY += -rdynamic -Wl,-force_load,$(KDKROOT)/System/Library/KernelSupport/lib$(CURRENT_MACHINE_CONFIG).os.$(CURRENT_KERNEL_CONFIG).a
 endif
+endif
 
 #
 # Derive SPTM/TXM and Exclaves enablement from the EDM properties.
-- 
2.53.0


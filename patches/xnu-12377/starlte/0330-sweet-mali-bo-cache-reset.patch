From 63d04e0f5fa312987a474a71550a17c719afde03 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Sun, 1 Nov 2026 21:38:24 +0200
Subject: [PATCH] patch: 0330-sweet-mali-bo-cache-reset.patch

sweet: a GPU buffer's pages go back to the default (cacheable) attributes before the buffer is freed. They were allocated write-combined (pp_attr WCOMB) in the kernel object, whose pages vm_page_free does not reset, so they came back as Normal-NC heap pages in backboardd (PAR attr 0x44), and the LSE atomics of objc_release/os_object_retain on Normal-NC memory took synchronous external aborts (GPU boots 5-7).
- StarbiteMali.cpp: reset cache attributes on close
---
 iokit/Kernel/arm/StarbiteMali.cpp | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/iokit/Kernel/arm/StarbiteMali.cpp b/iokit/Kernel/arm/StarbiteMali.cpp
index 3b3bbed0..1b716679 100644
--- a/iokit/Kernel/arm/StarbiteMali.cpp
+++ b/iokit/Kernel/arm/StarbiteMali.cpp
@@ -30,6 +30,7 @@
 #include <sys/errno.h>
 
 #include "SweetSurface.h"
+extern "C" void pmap_set_cache_attributes(ppnum_t pn, unsigned int cacheattr);
 
 extern "C" {
 int starlte_gpu_user_ready(void);
@@ -246,6 +247,20 @@ StarbiteMaliUserClient::closeBO(sbm_bo *bo)
 	/* an imported surface's pages were wired for the GPU (importSurface) */
 	if (bo->surface != 0 && bo->mem != NULL) {
 		bo->mem->complete();
+	} else if (bo->mem != NULL) {
+		/*
+		 * A buffer of ours was write-combined: its pages keep that attribute when freed
+		 * (kernel-object pages are not reset by vm_page_free), and came back as Normal-NC
+		 * heap in some task, where atomics take an external abort. Default them first.
+		 */
+		IOByteCount length = bo->mem->getLength();
+		for (IOByteCount offset = 0; offset < length; offset += PAGE_SIZE) {
+			IOByteCount len = 0;
+			addr64_t pa = bo->mem->getPhysicalSegment(offset, &len, kIOMemoryMapperNone);
+			if (pa != 0) {
+				pmap_set_cache_attributes((ppnum_t)atop_64(pa), 0);
+			}
+		}
 	}
 	OSSafeReleaseNULL(bo->mem);
 	bo->va = 0;

From 5970b7f992e3867d0e3d590d979b054c062b5dd2 Mon Sep 17 00:00:00 2001
From: Starbite author <starbite@local>
Date: Thu, 5 Nov 2026 03:40:43 +0200
Subject: [PATCH] patch: 0391-sweet-fb-crop.patch - sweetfbcrop=X,Y,W,H: with
 each frame dump, that rectangle at full resolution (readable text on
 unattended boots)

---
 iokit/Kernel/arm/SweetFramebuffer.cpp | 36 +++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index fe699cfd..573b39de 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -879,6 +879,42 @@ AppleCLCD::present(const uint8_t *rec)
 					}
 				}
 				IOLog("SWEET FBDUMP end %d at %llu s\n", done, up / 1000000000ULL);
+				/* sweetfbcrop=X,Y,W,H (0391): with each dump, that rectangle of the layer at full
+				 * resolution, "SWEET FBCROP W H y x0 hex" (12-bit colour, 69 pixels a line) */
+				char crop[64] = "";
+				if (PE_parse_boot_argn("sweetfbcrop", crop, sizeof(crop)) && crop[0]) {
+					uint32_t v[4] = { 0, 0, 0, 0 }, k = 0;
+					for (const char *c = crop; *c && k < 4; c++) {
+						if (*c >= '0' && *c <= '9') {
+							v[k] = v[k] * 10 + (uint32_t)(*c - '0');
+						} else if (*c == ',') {
+							k++;
+						}
+					}
+					uint32_t cx = v[0], cy = v[1], cw = v[2], ch = v[3];
+					if (cx < s->width && cy < s->height) {
+						if (cx + cw > s->width) {
+							cw = s->width - cx;
+						}
+						if (cy + ch > s->height) {
+							ch = s->height - cy;
+						}
+						for (uint32_t y = 0; y < ch; y++) {
+							for (uint32_t x0 = 0; x0 < cw; x0 += 69) {
+								uint32_t n = 0;
+								for (uint32_t x = x0; x < cw && x < x0 + 69; x++) {
+									uint32_t px = *(const volatile uint32_t *)(src + (size_t)(cy + y) * s->bytesPerRow + (cx + x) * 4);
+									line[n++] = hx[(px >> 20) & 0xf];
+									line[n++] = hx[(px >> 12) & 0xf];
+									line[n++] = hx[(px >> 4) & 0xf];
+								}
+								line[n] = 0;
+								IOLog("SWEET FBCROP %u %u %u %u %s\n", cw, ch, y, x0, line);
+							}
+						}
+						IOLog("SWEET FBCROP end %d\n", done);
+					}
+				}
 			}
 		}
 #endif
-- 

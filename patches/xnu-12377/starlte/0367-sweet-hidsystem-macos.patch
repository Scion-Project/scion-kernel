From 3a15c0ece85faac357daad6cfc63dfd31b3b29ad Mon Sep 17 00:00:00 2001
From: Starbite author <starbite@local>
Date: Wed, 4 Nov 2026 03:51:13 +0200
Subject: [PATCH] patch: 0367-sweet-hidsystem-macos.patch - IOHIDSystem +
 IOHIDUserClient for macOS WindowServer (WSInitialize exit(1) "Cannot open the
 HID and display/cursor system."): createShmem (EvOffsets+EvGlobals, version
 4), the 26.5 KDK's 13 legacy methods accepted, kIOHIDGlobalMemory mapping;
 only with a Mac ADT model (or sweethidsys=1)

---
 iokit/Kernel/arm/hid/SweetHIDSystem.cpp | 223 ++++++++++++++++++++++++
 iokit/KernelConfigTables.cpp            |   5 +
 iokit/conf/files.arm64                  |   1 +
 3 files changed, 229 insertions(+)
 create mode 100644 iokit/Kernel/arm/hid/SweetHIDSystem.cpp

diff --git a/iokit/KernelConfigTables.cpp b/iokit/KernelConfigTables.cpp
index 1b4b7d4d..d82e5171 100644
--- a/iokit/KernelConfigTables.cpp
+++ b/iokit/KernelConfigTables.cpp
@@ -89,6 +89,11 @@ const char * gIOKernelConfigTables =
     "     'IOProviderClass' = IOResources;"
     "     'IOMatchCategory' = SweetHIDTouch;"
     "   },"
+    "   {"
+    "     'IOClass'         = IOHIDSystem;"
+    "     'IOProviderClass' = IOResources;"
+    "     'IOMatchCategory' = IOHIDSystem;"
+    "   },"
 #if !defined(ARM64_BOARD_CONFIG_A5XELTE) || defined(ARM64_BOARD_CONFIG_HEROLTE)
     "   {"
     "     'IOClass'         = SweetBattery;"
diff --git a/iokit/conf/files.arm64 b/iokit/conf/files.arm64
index f212ddfe..feb3fe7e 100644
--- a/iokit/conf/files.arm64
+++ b/iokit/conf/files.arm64
@@ -23,3 +23,4 @@ iokit/Kernel/arm/hid/SweetHID.cpp                                optional iokitc
 iokit/Kernel/arm/hid/IOHIDEvent.cpp                              optional iokitcpp
 iokit/Kernel/arm/hid/IOHIDEventServiceQueue.cpp                  optional iokitcpp
 iokit/Kernel/arm/hid/IOHIDEventServiceUserClient.cpp             optional iokitcpp
+iokit/Kernel/arm/hid/SweetHIDSystem.cpp                          optional iokitcpp
-- 

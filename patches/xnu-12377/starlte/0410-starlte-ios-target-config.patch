From a07c22e197e769d6a90a7232a8039691d8ecf57b Mon Sep 17 00:00:00 2001
From: Claudius <claudiusthebot@gmail.com>
Date: Sun, 8 Nov 2026 20:32:47 +0000
Subject: [PATCH] starlte: iPhoneOS-derived option set; HFS keeps OS X features
 when iOS-target

---
 bsd/sweet_hfs/core/kext-config.h |  4 +++-
 config/MASTER.arm64.starlte      | 23 ++++++++++++++---------
 2 files changed, 17 insertions(+), 10 deletions(-)

diff --git a/bsd/sweet_hfs/core/kext-config.h b/bsd/sweet_hfs/core/kext-config.h
index 59088a57c..454c35564 100644
--- a/bsd/sweet_hfs/core/kext-config.h
+++ b/bsd/sweet_hfs/core/kext-config.h
@@ -36,7 +36,9 @@
 
 // #define HFS_LEAK_DEBUG 1
 
-#if (TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR) // iOS (real hardware)
+/* Starbite boards: no AppleKeyStore, so keep the OS X feature set
+ * (no content protection) even when the kernel is built iOS-target. */
+#if (TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR) && 0 // iOS (real hardware)
 
 #define QUOTA 0
 #define CONFIG_PROTECT 1
diff --git a/config/MASTER.arm64.starlte b/config/MASTER.arm64.starlte
index df4fe6588..c0a36b6c7 100644
--- a/config/MASTER.arm64.starlte
+++ b/config/MASTER.arm64.starlte
@@ -1,6 +1,11 @@
 #
 # starlte (SM-G960F, Exynos 9810): the herolte configuration, copied for the
-# STARLTE machine config. herolte and a5xelte notes follow.
+# STARLTE machine config. iOS 27 work: option sets follow
+# MASTER.arm64.iPhoneOS (config_embedded, xsmall, freeze, phantom_cache,
+# secluded memory, taskwatch, skip_precise_user_kernel_time, routefs, MPTCP;
+# no CSR, volfs, firmlinks, mount_vm, encrypted_swap, NFS, AppleDouble,
+# external identity resolver). msgb_large kept for the USB/SD log; medium
+# sizing kept (xsmall caps tasks at 512 and threads at 1536 below 3 GiB RAM). herolte and a5xelte notes follow.
 #
 # herolte (SM-G930F, Exynos 8890): the a5xelte configuration, copied for the
 # HEROLTE machine config. a5xelte notes follow.
@@ -26,7 +31,7 @@
 #  Standard Apple OS Configurations:
 #  -------- ----- -- ---------------
 #
-#  KERNEL_BASE =    [ arm64 config_pmap_ppl medium msgb_large config_requires_u32_munging config_delay_idle_sleep config_proc_udata_storage config_uexc config_darkboot nos_arm_asm nos_arm_pmap ]
+#  KERNEL_BASE = [ arm64 config_pmap_ppl medium msgb_large config_embedded config_requires_u32_munging config_delay_idle_sleep config_proc_udata_storage config_uexc config_darkboot nos_arm_asm nos_arm_pmap ]
 #  KERNEL_RELEASE = [ KERNEL_BASE release ]
 #  KERNEL_DEV =     [ KERNEL_BASE development mach_assert config_xnupost proc_ref_debug config_proc_resource_limits config_ext_paniclog ]
 #  KERNEL_DEBUG =   [ KERNEL_BASE debug mach_assert config_xnupost config_waitq_stats config_workloop_debug config_proc_resource_limits config_ext_paniclog ]
@@ -34,7 +39,7 @@
 #  BSD_RELEASE =    [ BSD_BASE ]
 #  BSD_DEV =        [ BSD_BASE config_vnguard ]
 #  BSD_DEBUG =      [ BSD_BASE config_vnguard ]
-#  FILESYS_BASE =   [ devfs fdesc fifo mockfs sweet_hfs fs_compression config_protect config_mnt_rootsnap config_rosv_startup config_mount_vm config_mount_prebootrecovery config_basesystemroot config_fse quota namedstreams config_imgsrc_access config_triggers config_ext_resolver config_searchfs config_volfs config_appledouble nullfs bindfs config_mnt_suid config_firmlinks config_dataless_files config_union_mounts config_file_leases ]
+#  FILESYS_BASE = [ devfs fdesc fifo mockfs sweet_hfs fs_compression config_protect config_mnt_rootsnap config_fse namedstreams config_imgsrc_access config_triggers config_searchfs nullfs bindfs routefs config_dataless_files config_union_mounts config_file_leases ]
 #  FILESYS_RELEASE= [ FILESYS_BASE ]
 #  FILESYS_DEV =    [ FILESYS_BASE config_iocount_trace ]
 #  FILESYS_DEBUG =  [ FILESYS_BASE config_iocount_trace ]
@@ -55,7 +60,7 @@
 #else /*!(SOC_CONFIG_t8020 || SOC_IS_VIRTUALIZED)*/
 #  HIBERNATION =    [ ]
 #endif /*SOC_CONFIG_t8020 || SOC_IS_VIRTUALIZED*/
-#  IOKIT_BASE =     [ iokit iokitcpp no_kernel_hid config_sleep iokitstats HIBERNATION ]
+#  IOKIT_BASE = [ iokit iokitcpp no_kernel_hid config_sleep iokitstats ]
 #  IOKIT_RELEASE =  [ IOKIT_BASE ]
 #  IOKIT_DEV =      [ IOKIT_BASE iotracking ]
 #  IOKIT_DEBUG =    [ IOKIT_BASE iotracking ]
@@ -74,11 +79,11 @@
 #else
 #  PARAVIRT_BASE =  [ ]
 #endif /*SOC_IS_VIRTUALIZED*/
-#  MACH_BASE =      [ mach config_ecc_logging vc_progress_white importance_inheritance config_atm config_coalitions config_iosched config_sysdiagnose config_telemetry config_mach_bridge_recv_time config_quiesce_counter config_arm_pfz config_user_notification phys_write_acct config_service_port_info config_voucher_deprecated PARAVIRT_BASE ]
+#  MACH_BASE = [ mach config_ecc_logging vc_progress_white importance_inheritance config_atm config_coalitions config_iosched config_sysdiagnose config_telemetry config_mach_bridge_recv_time config_quiesce_counter config_arm_pfz config_io_compression_stats phys_write_acct config_service_port_info config_voucher_deprecated config_skip_precise_user_kernel_time PARAVIRT_BASE ]
 #  MACH_RELEASE =   [ MACH_BASE ]
 #  MACH_DEV =       [ MACH_BASE config_io_accounting importance_trace config_task_suspend_stats ]
 #  MACH_DEBUG =     [ MACH_BASE config_io_accounting importance_trace importance_debug config_task_suspend_stats ]
-#  SCHED_BASE =     [ config_sched_timeshare_core config_sched_deferred_ast config_clutch config_sched_sfi config_sched_auto_join config_preadopt_tg ]
+#  SCHED_BASE = [ config_sched_timeshare_core config_sched_deferred_ast config_clutch config_sched_sfi config_taskwatch config_preadopt_tg ]
 #  SCHED_RELEASE =  [ SCHED_BASE ]
 #  SCHED_DEV =      [ SCHED_BASE ]
 #  SCHED_DEBUG =    [ SCHED_BASE ]
@@ -92,16 +97,16 @@
 #  VM_EXTRA =       [ ]
 #  VM_EXTRA_DEV =   [ ]
 #endif /* MASTER_CONFIG_ENABLE_KERNEL_TAG && MASTER_CONFIG_ENABLE_SPTM */
-#  VM_BASE =        [ vm_pressure_events memorystatus config_code_decryption encrypted_swap config_deferred_reclaim VM_EXTRA ]
+#  VM_BASE = [ vps_dynamic_prio vm_pressure_events jetsam freeze memorystatus config_code_decryption phantom_cache config_secluded_memory config_deferred_reclaim VM_EXTRA ]
 #  VM_RELEASE =     [ VM_BASE ]
 #  VM_DEV =         [ VM_BASE dynamic_codesigning VM_EXTRA_DEV ]
 #  VM_DEBUG =       [ VM_BASE dynamic_codesigning VM_EXTRA_DEV ]
 #  VM_KASAN =       [ VM_BASE dynamic_codesigning config_kasan config_ubsan config_kcov config_ksancov kernel_tagging kernel_tbi ]
-#  SECURITY_BASE  =   [ config_macf config_audit kernel_integrity config_csr config_csr_from_dt config_setuid config_kas_info config_secure_bsd_root config_arcade config_supplemental_signatures second_static_trust_cache reslide_shared_cache ]
+#  SECURITY_BASE  = [ config_macf config_audit kernel_integrity config_setuid config_kas_info config_secure_bsd_root config_supplemental_signatures second_static_trust_cache reslide_shared_cache ]
 #  SECURITY_RELEASE = [ SECURITY_BASE ]
 #  SECURITY_DEV   =   [ SECURITY_BASE ]
 #  SECURITY_DEBUG =   [ SECURITY_BASE ]
-#  BASE =           [ PF VPN NFS ]
+#  BASE = [ PF VPN MULTIPATH ]
 #  RELEASE =        [ BASE KERNEL_RELEASE BSD_RELEASE FILESYS_RELEASE SKYWALK_RELEASE NETWORKING_RELEASE IOKIT_RELEASE LIBKERN_RELEASE    PERF_DBG_RELEASE MACH_RELEASE SCHED_RELEASE VM_RELEASE SECURITY_RELEASE ]
 #  DEVELOPMENT =    [ BASE KERNEL_DEV     BSD_DEV     FILESYS_DEV     SKYWALK_DEV     NETWORKING_DEV     IOKIT_DEV     LIBKERN_DEV        PERF_DBG_DEV     MACH_DEV     SCHED_DEV     VM_DEV     SECURITY_DEV     ]
 #  DEBUG =          [ BASE KERNEL_DEBUG   BSD_DEBUG   FILESYS_DEBUG   SKYWALK_DEBUG   NETWORKING_DEBUG   IOKIT_DEBUG   LIBKERN_DEBUG      PERF_DBG_DEBUG   MACH_DEBUG   SCHED_DEBUG   VM_DEBUG   SECURITY_DEBUG   ]

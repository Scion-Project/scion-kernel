From 9fe500f00eb4dd99c04d28eb8d7f3c752051ad45 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Sun, 1 Nov 2026 18:33:42 +0200
Subject: [PATCH] patch: 0322-sweet-amfi-ios26.patch

AMFI stand-in for iOS 26 userland: __mac_syscall("AMFI", 0x66) =
amfi_launch_constraint_matches_process() answers AICMR_MATCH (libxpc's
lightweight-code-requirement checks asserted on ENOPOLICY with a zeroed
result: backboardd aborted in LightSourceSupport's XPC service). The
first-use log covers ops up to 127.
- starlte_touch.c: sweetswipe=2 = iPhone script (bottom-edge swipes, a tap, Control Center) for iOS 26 touch debugging; IOHIDEventServiceUserClient.cpp logs dropped events
---
 bsd/dev/starlte_touch.c                       | 42 ++++++++++++++-----
 bsd/kern/sweet_amfi.c                         | 31 ++++++++++++--
 .../arm/hid/IOHIDEventServiceUserClient.cpp   |  7 ++++
 3 files changed, 67 insertions(+), 13 deletions(-)

diff --git a/bsd/dev/starlte_touch.c b/bsd/dev/starlte_touch.c
index fbd879a5..802ae4a1 100644
--- a/bsd/dev/starlte_touch.c
+++ b/bsd/dev/starlte_touch.c
@@ -762,8 +762,21 @@ static const struct {
 	{ 92, 0, 1380, 6, 1380, 1500 },         /* Control Center over the home screen (shots at 97, 103 s) */
 };
 
+/* sweetswipe=2: iOS 26 (iPhone 11 UI, no Home button): edge swipes and a tap, for touch debugging. */
+static const struct {
+	unsigned at_s;
+	int home;
+	int x0, y0, x1, y1;
+} st_script_phone[] = {
+	{ 20, 0, 720, 2955, 720, 1500 },        /* swipe up from the bottom edge: unlock */
+	{ 30, 0, 720, 1480, 720, 1480 },        /* a tap in the middle */
+	{ 40, 0, 720, 2880, 720, 1200 },        /* swipe up from just above the edge */
+	{ 50, 0, 1380, 6, 1380, 1500 },         /* Control Center */
+	{ 60, 0, 720, 2955, 720, 1500 },        /* swipe up again */
+};
+
 static void
-st_script_thread(__unused void *arg, __unused wait_result_t wr)
+st_script_thread(void *arg, __unused wait_result_t wr)
 {
 	/* 50 samples 6 ms apart, eased in and out (smoothstep): 24 even steps of 60 px were not taken
 	 * for a swipe from the top edge (boot59), where the user's own swipe was */
@@ -775,31 +788,40 @@ st_script_thread(__unused void *arg, __unused wait_result_t wr)
 	uint64_t start_ns;
 	absolutetime_to_nanoseconds(sweet_fb_first_present, &start_ns);
 	printf("STARLTE TOUCH: first frame on the panel; scripted input starts\n");
-	for (unsigned i = 0; i < sizeof(st_script) / sizeof(st_script[0]); i++) {
+	bool phone = (uintptr_t)arg == 2;
+	unsigned count = phone ? sizeof(st_script_phone) / sizeof(st_script_phone[0]) :
+	    sizeof(st_script) / sizeof(st_script[0]);
+	for (unsigned i = 0; i < count; i++) {
+		unsigned at_s = phone ? st_script_phone[i].at_s : st_script[i].at_s;
+		int home = phone ? st_script_phone[i].home : st_script[i].home;
+		int x0 = phone ? st_script_phone[i].x0 : st_script[i].x0;
+		int y0 = phone ? st_script_phone[i].y0 : st_script[i].y0;
+		int x1 = phone ? st_script_phone[i].x1 : st_script[i].x1;
+		int y1 = phone ? st_script_phone[i].y1 : st_script[i].y1;
 		uint64_t now_ns;
 		absolutetime_to_nanoseconds(mach_absolute_time(), &now_ns);
-		uint64_t at_ns = start_ns + (uint64_t)st_script[i].at_s * NSEC_PER_SEC;
+		uint64_t at_ns = start_ns + (uint64_t)at_s * NSEC_PER_SEC;
 		if (now_ns < at_ns) {
 			st_msleep((unsigned)((at_ns - now_ns) / NSEC_PER_MSEC));
 		}
-		if (st_script[i].home) {
+		if (home) {
 			printf("STARLTE TOUCH: scripted Home press\n");
 			sweet_hid_key(3, 1);
 			st_msleep(80);
 			sweet_hid_key(3, 0);
 			continue;
 		}
-		printf("STARLTE TOUCH: scripted swipe %u: %d,%d -> %d,%d\n", i, st_script[i].x0, st_script[i].y0,
-		    st_script[i].x1, st_script[i].y1);
+		printf("STARLTE TOUCH: scripted swipe %u: %d,%d -> %d,%d\n", i, x0, y0,
+		    x1, y1);
 		for (int k = 0; k <= steps; k++) {
 			int t = k * 1000 / steps;                       /* 0..1000 */
 			int e = t * t / 1000 * (3000 - 2 * t) / 1000;   /* smoothstep, 0..1000 */
-			int x = st_script[i].x0 + (st_script[i].x1 - st_script[i].x0) * e / 1000;
-			int y = st_script[i].y0 + (st_script[i].y1 - st_script[i].y0) * e / 1000;
+			int x = x0 + (x1 - x0) * e / 1000;
+			int y = y0 + (y1 - y0) * e / 1000;
 			sweet_hid_touch(f, 1, x, y);
 			st_msleep(6);
 		}
-		sweet_hid_touch(f, 0, st_script[i].x1, st_script[i].y1);
+		sweet_hid_touch(f, 0, x1, y1);
 	}
 }
 
@@ -811,7 +833,7 @@ starlte_touch_probe(void)
 
 	uint32_t script = 0;
 	if (PE_parse_boot_argn("sweetswipe", &script, sizeof(script)) && script &&
-	    kernel_thread_start(st_script_thread, NULL, &thread) == KERN_SUCCESS) {
+	    kernel_thread_start(st_script_thread, (void *)(uintptr_t)script, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
 	PE_parse_boot_argn("startouch", &on, sizeof(on));
diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index c459e36e..a023c4be 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -323,14 +323,14 @@ sweet_sandbox_syscall(struct proc *p, int call, __unused user_addr_t arg)
  * (1 << 5: a missing library does not kill the process) and interposing
  * (1 << 6). Other ops keep answering ENOPOLICY.
  */
-static uint64_t sweet_amfi_seen;
+static uint64_t sweet_amfi_seen[2];
 
 static int
 sweet_amfi_syscall(struct proc *p, int call, user_addr_t arg)
 {
-	if (call >= 0 && call < 64 && !(sweet_amfi_seen & (1ULL << call))) {
+	if (call >= 0 && call < 128 && !(sweet_amfi_seen[call / 64] & (1ULL << (call % 64)))) {
 		char name[32];
-		sweet_amfi_seen |= 1ULL << call;
+		sweet_amfi_seen[call / 64] |= 1ULL << (call % 64);
 		proc_name(proc_pid(p), name, sizeof(name));
 		printf("SWEET AMFI: %s op %d\n", name, call);
 	}
@@ -345,6 +345,31 @@ sweet_amfi_syscall(struct proc *p, int call, user_addr_t arg)
 		}
 		return copyout(&flags, (user_addr_t)a.output, sizeof(flags));
 	}
+	if (call == 0x66) {
+		/*
+		 * amfi_launch_constraint_matches_process() (iOS 26): does the process
+		 * of an audit token satisfy a lightweight code requirement? libxpc
+		 * asserts that the answer and result.error_code agree (backboardd
+		 * aborted on ENOPOLICY with a zeroed result). Permissive like the rest:
+		 * error_code 0 = AICMR_MATCH.
+		 */
+		struct {
+			uint8_t  token[32];
+			uint64_t lwcr;
+			uint32_t lwcr_size;
+			uint32_t pad;
+			uint64_t result;
+			uint32_t result_size;
+		} a;
+		uint32_t match = 0;
+		if (copyin(arg, &a, sizeof(a)) != 0) {
+			return EFAULT;
+		}
+		if (a.result == 0 || a.result_size < sizeof(match)) {
+			return EINVAL;
+		}
+		return copyout(&match, (user_addr_t)a.result, sizeof(match));
+	}
 	return ENOPOLICY;
 }
 
diff --git a/iokit/Kernel/arm/hid/IOHIDEventServiceUserClient.cpp b/iokit/Kernel/arm/hid/IOHIDEventServiceUserClient.cpp
index 256a9773..13afc4f4 100644
--- a/iokit/Kernel/arm/hid/IOHIDEventServiceUserClient.cpp
+++ b/iokit/Kernel/arm/hid/IOHIDEventServiceUserClient.cpp
@@ -635,6 +635,13 @@ void IOHIDEventServiceUserClient::enqueueEventGated( IOHIDEvent * event)
         if (result == false) {
             _lastDroppedEventTime = _lastEventTime;
             ++_droppedEventCount;
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_A5XELTE)
+            /* sweet: a full queue means the client is not reading events. */
+            if (_droppedEventCount <= 3 || (_droppedEventCount % 200) == 0) {
+                IOLog("SWEET HID: queue full for %s, %u of %u events dropped\n",
+                    _owner ? _owner->getName() : "?", (unsigned)_droppedEventCount, (unsigned)_eventCount);
+            }
+#endif
             IOHID_DEBUG(kIOHIDDebugCode_HIDEventServiceEnqueueFail, event->getTimeStampOfType(kIOHIDEventTimestampTypeDefault), event->getOptions() & kIOHIDEventOptionContinuousTime, 0, 0);
         }
     }

From 9f1f20a2a3fcc0f9ccb97ffdcb10284ea8aa4d20 Mon Sep 17 00:00:00 2001
From: starbite <starbite@local>
Date: Wed, 28 Oct 2026 16:30:20 +0200
Subject: [PATCH] patch: 0039-sweet-coredump-default-off.patch

---
 bsd/kern/kern_core.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/bsd/kern/kern_core.c b/bsd/kern/kern_core.c
index b422eaa7..e939d032 100644
--- a/bsd/kern/kern_core.c
+++ b/bsd/kern/kern_core.c
@@ -34,6 +34,7 @@
  */
 #if CONFIG_COREDUMP || CONFIG_UCOREDUMP
 
+#include <pexpert/arm64/board_config.h>
 #include <mach/vm_param.h>
 #include <mach/thread_status.h>
 #include <sys/content_protection.h>
@@ -86,7 +87,12 @@ kern_return_t thread_getstatus(thread_t act, int flavor,
     thread_state_t tstate, mach_msg_type_number_t *count);
 void task_act_iterate_wth_args(task_t, void (*)(thread_t, void *), void *);
 
-#ifdef SECURE_KERNEL
+#if defined(SECURE_KERNEL) || defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET: off by default (sysctl kern.coredump=1 enables it). A crashing iOS
+ * daemon maps the whole shared region, so one core is gigabytes on the root
+ * volume and takes minutes on the phone's UFS.
+ */
 __XNU_PRIVATE_EXTERN int do_coredump = 0;       /* default: don't dump cores */
 #else
 __XNU_PRIVATE_EXTERN int do_coredump = 1;       /* default: dump cores */
-- 

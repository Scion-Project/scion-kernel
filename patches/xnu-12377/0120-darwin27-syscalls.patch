+/* ARGSUSED */
+int
+fsctlat(proc_t p, struct fsctlat_args *uap, __unused int32_t *retval)
+{
+	int error;
+	struct nameidata nd;
+	uint32_t nameiflags;
+	vnode_t vp = NULL;
+	vfs_context_t ctx = vfs_context_current();
+
+	AUDIT_ARG(fd, uap->fd);
+	AUDIT_ARG(cmd, (int)uap->cmd);
+	AUDIT_ARG(value32, uap->options);

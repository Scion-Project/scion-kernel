+		return EINVAL;
+	}
+	if ((uap->options & (FSOPT_NOFOLLOW | FSOPT_NOFOLLOW_ANY)) == 0) {
+		nameiflags |= FOLLOW;
+	}
+	if (uap->cmd == FSIOC_FIRMLINK_CTL) {
+		nameiflags |= (CN_FIRMLINK_NOFOLLOW | NOCACHE);
+	}

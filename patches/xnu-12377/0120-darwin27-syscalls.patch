+	if (error) {
+		goto done;
+	}
+#endif
+
+	error = fsctl_internal(p, &vp, uap->cmd, (user_addr_t)uap->data, uap->options, ctx);
+
 done:
 	if (vp) {
 		vnode_put(vp);

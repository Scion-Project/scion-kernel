 /*
  * The memory of an IOSurface as a texture, to draw into and to draw with (Darwin on redwood):
  * the kernel's GPU driver makes a buffer of the surface. NULL: the screen is not the GPU's, or
  * the surface is not one plane of 32-bit pixels, blue first, in rows the GPU can address.
  */
+#ifdef OSMESA_GPU
+/*
+ * One plane of a two-plane IOSurface (a video frame: '420v' or '420f', luma then chroma) as a
+ * texture to draw with, R8 or R8G8, in the surface's own memory: without it each new frame was
+ * copied into its textures (12 MB a frame for 1080p, half the window server's time).
+ */
+static struct pipe_resource *
+osmesa_surface_plane_resource(struct pipe_screen *screen,
+                              const struct hakios_surface_plane *p)
+{
+   struct hakios_drm_surface s = { .surface = p->surface };
+   struct pipe_resource templ = {
+      .target = PIPE_TEXTURE_2D,
+      .depth0 = 1,
+      .array_size = 1,
+      .bind = PIPE_BIND_SAMPLER_VIEW,
+   };
+   struct winsys_handle handle = { .type = WINSYS_HANDLE_TYPE_FD };
+
+   if (p->magic != HAKIOS_SURFACE_PLANE_MAGIC || (p->components != 1 && p->components != 2))
+      return NULL;
+   if (gpu_fd < 0 || hakios_drm_surface(gpu_fd, &s) != 0)
+      return NULL;
+   if ((s.pixel_format != 0x34323076 /* '420v' */ && s.pixel_format != 0x34323066 /* '420f' */) ||
+       s.planes != 2)
+      return NULL;
+   if ((uint64_t)s.offset + p->offset + (uint64_t)p->row_bytes * (p->height - 1) +
+       (uint64_t)p->width * p->components > s.size)
+      return NULL;
+   templ.format = p->components == 1 ? PIPE_FORMAT_R8_UNORM : PIPE_FORMAT_R8G8_UNORM;
+   templ.width0 = p->width;
+   templ.height0 = p->height;
+   handle.handle = p->surface;
+   handle.stride = p->row_bytes;
+   handle.offset = s.offset + p->offset;
+   handle.size = s.size;
+   return screen->resource_from_handle(screen, &templ, &handle, 0);
+}
+#endif

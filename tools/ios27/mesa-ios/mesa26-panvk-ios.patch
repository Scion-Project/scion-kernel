+#ifdef __APPLE__
+/* Starbite: StarbiteMali runs one job chain at a time, system-wide, and a submit returns when its
+ * chain is done, so no two batches use their TLS at once: every batch of the device shares one
+ * stack buffer. One per batch (2.6 MiB each on the G72 MP18) piled up in the command pools, 300 MiB
+ * in backboardd alone. A batch needing more than the shared buffer gets its own, as upstream. */
+#define PANVK_SHARED_TLS_SIZE (8u << 20)
+
+static uint64_t
+shared_tls(struct panvk_device *dev, unsigned size)
+{
+   if (size > PANVK_SHARED_TLS_SIZE)
+      return 0;
+   simple_mtx_lock(&dev->shared_tls_lock);
+   if (!dev->shared_tls)
+      panvk_priv_bo_create(dev, PANVK_SHARED_TLS_SIZE,
+                           panvk_device_adjust_bo_flags(dev, PAN_KMOD_BO_FLAG_NO_MMAP),
+                           VK_SYSTEM_ALLOCATION_SCOPE_DEVICE, &dev->shared_tls);
+   uint64_t va = dev->shared_tls ? dev->shared_tls->addr.dev : 0;
+   simple_mtx_unlock(&dev->shared_tls_lock);
+   return va;
+}
+#endif

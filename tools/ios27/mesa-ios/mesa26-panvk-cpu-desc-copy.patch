+
+/* Starbite (iOS): descriptor copies on the CPU (STARBITE_PANVK_CPU_DESC=1; off by default, NOT run on a phone yet).
+ *
+ * On this JM GPU every draw whose shaders take textures, samplers or UBOs from descriptor sets gets a compute job (here, up
+ * to two a draw: the vertex and the fragment shader's) that copies the descriptors into the draw's own tables, one
+ * workgroup a descriptor. The phone's home screen draws about 93 times a frame in 26 passes and its vertex/tiler/compute
+ * chains carry about three jobs a draw. This does the same copy on the CPU instead, when the batch is submitted: the
+ * values are those the job would read (an application may update an update-after-bind set until it submits; a push set
+ * is snapshotted as its upload is, at the draw), written into the same tables, before pan_kmod_flush_bo_map_syncs makes
+ * the batch visible. Only for a primary command buffer's draw whose shader has no image descriptors (their attribute pairs
+ * stay with the job); anything else keeps the job. */
+struct sb_desc_copy {
+   const uint32_t *map;                                   /* the shader's copy table: COPY_DESC_HANDLE(set, index) */
+   uint32_t limits[PANVK_BIFROST_DESC_TABLE_COUNT];       /* where each table's entries end in the map */
+   void *dst[PANVK_BIFROST_DESC_TABLE_COUNT];
+   const struct panvk_descriptor_set *sets[MAX_SETS];     /* read at submission */
+   int64_t snap[MAX_SETS];                                /* a push set: its bytes in sb_desc_snaps, else -1 */
+   uint32_t counts[MAX_SETS];
+};
+
+extern unsigned long long sbdrm_vk_desc_jobs, sbdrm_vk_desc_job_descs, sbdrm_vk_desc_cpu, sbdrm_vk_desc_cpu_descs;
+
+static int
+sb_cpu_desc(void)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *e = getenv("STARBITE_PANVK_CPU_DESC");
+      on = e != NULL && e[0] == '1';
+   }
+   return on;
+}
+
+static bool
+sb_desc_copy_on_cpu(struct panvk_cmd_buffer *cmdbuf, const struct panvk_shader_desc_info *desc_info,
+                    const struct panvk_descriptor_state *desc_state,
+                    const struct panvk_shader_desc_state *shader_desc_state, uint32_t copy_count)
+{
+   struct panvk_batch *batch = cmdbuf->cur_batch;
+
+   if (!sb_cpu_desc() || batch == NULL || cmdbuf->vk.level != VK_COMMAND_BUFFER_LEVEL_PRIMARY ||
+       desc_info->others.count[PANVK_BIFROST_DESC_TABLE_IMG] != 0)
+      return false;
+
+   struct sb_desc_copy c;
+   memset(&c, 0, sizeof(c));
+   c.map = panvk_priv_mem_host_addr(desc_info->others.map);
+   if (c.map == NULL)
+      return false;
+   for (uint32_t i = 0; i < PANVK_BIFROST_DESC_TABLE_COUNT; i++) {
+      c.limits[i] = desc_info->others.count[i] + (i > 0 ? c.limits[i - 1] : 0);
+      c.dst[i] = shader_desc_state->sb_tables_cpu[i];
+      if (desc_info->others.count[i] != 0 && c.dst[i] == NULL)
+         return false;
+   }
+   for (uint32_t i = 0; i < MAX_SETS; i++) {
+      const struct panvk_descriptor_set *set = desc_state->sets[i];
+      c.snap[i] = -1;
+      if (set == NULL)
+         continue;
+      c.counts[i] = set->desc_count;
+      if (set == desc_state->push_sets[i]) {
+         /* The push set's upload (cmd_prepare_push_descs, earlier in this draw's preparation) copied descs.host;
+          * take the same bytes now, since descs.host changes with the next push. */
+         size_t bytes = (size_t)set->desc_count * PANVK_DESCRIPTOR_SIZE;
+         c.snap[i] = (int64_t)batch->sb_desc_snaps.size;
+         void *to = util_dynarray_grow_bytes(&batch->sb_desc_snaps, 1, bytes);
+         if (to == NULL)
+            return false;
+         memcpy(to, set->descs.host, bytes);
+      } else {
+         c.sets[i] = set;
+      }
+   }
+   util_dynarray_append(&batch->sb_desc_copies, c);
+   sbdrm_vk_desc_cpu++;
+   sbdrm_vk_desc_cpu_descs += copy_count;
+   return true;
 }
 
+void
+panvk_per_arch(sb_run_desc_copies)(struct panvk_batch *batch)
+{
+   static const uint32_t size[PANVK_BIFROST_DESC_TABLE_COUNT] = {
+      [PANVK_BIFROST_DESC_TABLE_UBO] = sizeof(struct mali_attribute_packed),
+      [PANVK_BIFROST_DESC_TABLE_TEXTURE] = sizeof(struct mali_texture_packed),
+      [PANVK_BIFROST_DESC_TABLE_SAMPLER] = sizeof(struct mali_sampler_packed),
+   };
+
+   util_dynarray_foreach(&batch->sb_desc_copies, struct sb_desc_copy, c) {
+      uint32_t table = 0, first = 0;
+      const uint32_t end = c->limits[PANVK_BIFROST_DESC_TABLE_COUNT - 1];
+
+      for (uint32_t idx = 0; idx < end; idx++) {
+         while (idx >= c->limits[table]) {
+            first = c->limits[table];
+            table++;
+         }
+         /* Images never come here (sb_desc_copy_on_cpu). */
+         if (table == PANVK_BIFROST_DESC_TABLE_IMG || size[table] == 0)
+            continue;
+         const uint32_t handle = c->map[idx];
+         const uint32_t set = COPY_DESC_HANDLE_EXTRACT_TABLE(handle);
+         const uint32_t src = COPY_DESC_HANDLE_EXTRACT_INDEX(handle);
+         uint8_t *to = (uint8_t *)c->dst[table] + (size_t)(idx - first) * size[table];
+         const uint8_t *base = NULL;
+         if (set < MAX_SETS && src < c->counts[set]) {
+            if (c->snap[set] >= 0)
+               base = (const uint8_t *)batch->sb_desc_snaps.data + c->snap[set];
+            else if (c->sets[set] != NULL)
+               base = c->sets[set]->descs.host;
+         }
+         if (base != NULL)
+            memcpy(to, base + (size_t)src * PANVK_DESCRIPTOR_SIZE, size[table]);
+         else
+            memset(to, 0, size[table]);
+      }
+   }
+}

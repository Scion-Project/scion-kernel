--- a/src/gallium/drivers/panfrost/pan_context.c
+++ b/src/gallium/drivers/panfrost/pan_context.c
@@ -55,6 +55,8 @@
 #include "pan_screen.h"
 #include "pan_util.h"
 
+static int sbgl_norename = -1;
+
 static void
 panfrost_clear(struct pipe_context *pipe, unsigned buffers,
                const struct pipe_scissor_state *scissor_state,
@@ -68,6 +70,20 @@
     * cause the batch to be flushed.
     */
    struct panfrost_context *ctx = pan_context(pipe);
+
+   /* see panfrost_resource_rename_for_clear(); SBGL_NORENAME=1 in the environment: off */
+   if (sbgl_norename < 0)
+      sbgl_norename = getenv("SBGL_NORENAME") != NULL;
+   struct pipe_framebuffer_state *fb = &ctx->pipe_framebuffer;
+   if (!ctx->batch && (buffers & PIPE_CLEAR_COLOR0) && fb->nr_cbufs == 1 && fb->cbufs[0] && !fb->zsbuf &&
+       !sbgl_norename) {
+      struct pipe_surface *surf = fb->cbufs[0];
+      struct panfrost_resource *rsrc = pan_resource(surf->texture);
+      if (surf->u.tex.level == 0 && surf->u.tex.first_layer == 0 && surf->u.tex.last_layer == 0 &&
+          fb->width == rsrc->base.width0 && fb->height == rsrc->base.height0)
+         panfrost_resource_rename_for_clear(ctx, rsrc);
+   }
+
    struct panfrost_batch *batch = panfrost_get_batch_for_fbo(ctx);
    if (!batch)
       return;

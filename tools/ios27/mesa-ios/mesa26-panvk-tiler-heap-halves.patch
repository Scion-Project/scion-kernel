+#ifdef __APPLE__
+      /* Starbite (iOS), STARBITE_PANVK_BINS=<mask in hexadecimal> (unset by default): only these levels of the bin
+       * hierarchy (bit 0: 16-pixel bins, bit 1: 32, ...), and always the coarsest one chosen above. The tiler job
+       * prepares every bin of every level it may use, whatever is drawn: with all eight levels a pass over the whole
+       * panel is about 7,800 bins for a handful of rectangles. What is drawn does not change, only where the lists go. */
+      {
+         static int sb_bins = -1;
+         if (sb_bins < 0) {
+            const char *e = getenv("STARBITE_PANVK_BINS");
+            sb_bins = e != NULL ? (int)(strtoul(e, NULL, 16) & 0xff) : 0;
+         }
+         if (sb_bins != 0 && cfg.hierarchy_mask != 0) {
+            const uint32_t coarsest = 1u << (util_last_bit(cfg.hierarchy_mask) - 1);

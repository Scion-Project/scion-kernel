+#ifdef __APPLE__
+   /* Starbite (iOS), STARBITE_PANVK_PIPE=1 (off by default). Every batch's lists start at the heap's base, so a batch's
+    * vertex/tiler chain may only run once the batch before it has been drawn: the kernel runs one chain at a time. With
+    * this the batches take the two halves of the heap in turn and say which (panvk_queue_submit_batch), and a kernel
+    * that knows the two bits runs a vertex/tiler chain beside the fragment chain of the batch before it when their

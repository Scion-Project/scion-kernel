+         sb_pipe = e != NULL && e[0] == '1';
+      }
+      if (sb_pipe) {
+         batch->sb_heap_half = 1 + (p_atomic_inc_return(&sb_turn) & 1);
+         sb_heap_size /= 2;
+         sb_heap_base += (batch->sb_heap_half - 1) * sb_heap_size;

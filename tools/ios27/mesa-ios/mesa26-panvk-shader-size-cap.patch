+                          nir->info.name ? nir->info.name : "?", instrs,
+                          limit && instrs > limit ? ": too big, pipeline refused" : "");
+         if (fd >= 0) {
+            write(fd, msg, n > 0 ? (size_t)n : 0);
+            close(fd);
+         }
+      }
+      if (limit && instrs > limit)
+         return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+#endif

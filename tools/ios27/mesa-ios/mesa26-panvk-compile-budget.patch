 #include "pan_compiler.h"
+#ifdef __APPLE__
+#include <time.h>
+
+__thread jmp_buf *pan_compile_abort_jmp = NULL;
+__thread uint64_t pan_compile_deadline_ns = 0;
+
+void
+pan_compile_check_deadline(void)
+{
+   if (!pan_compile_abort_jmp || !pan_compile_deadline_ns)
+      return;
+
+   struct timespec t;
+   clock_gettime(CLOCK_MONOTONIC, &t);
+   uint64_t now = (uint64_t)t.tv_sec * 1000000000ull + (uint64_t)t.tv_nsec;
+   if (now > pan_compile_deadline_ns) {
+      jmp_buf *target = pan_compile_abort_jmp;
+      pan_compile_abort_jmp = NULL;
+      longjmp(*target, 1);
+   }
+}
+#endif

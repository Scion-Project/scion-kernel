+/* Starbite (iOS): what closed each batch that had work, counted for the kernel shim's statistics line (starbite_drm.c). */
+extern unsigned sbdrm_vk_why;           /* set by the caller of cmd_close_batch: 1 end of rendering, 2 barrier, 3 before a
+                                         * dispatch, 4 the dispatch, 5 begin rendering, 6 job limit, 7 end of the command
+                                         * buffer, 8 event, 9 query; 0 anything else */
+extern unsigned long long sbdrm_vk_batches[10], sbdrm_vk_jobs, sbdrm_vk_fragless;
+
 void
 panvk_per_arch(cmd_close_batch)(struct panvk_cmd_buffer *cmdbuf)
 {
    struct panvk_batch *batch = cmdbuf->cur_batch;
+   unsigned why = sbdrm_vk_why;
+
+   sbdrm_vk_why = 0;
    if (!batch)
       return;
 
@@ -124,6 +134,11 @@
    struct panvk_physical_device *phys_dev =
       to_panvk_physical_device(dev->vk.physical);
 
+   sbdrm_vk_batches[why < 10 ? why : 0]++;
+   sbdrm_vk_jobs += batch->vtc_jc.job_index;
+   if (!batch->fb.desc.gpu)
+      sbdrm_vk_fragless++;
+
    list_addtail(&batch->node, &cmdbuf->batches);
 
    if (batch->tlsinfo.tls.size) {
@@ -399,6 +414,7 @@
 {
    VK_FROM_HANDLE(panvk_cmd_buffer, cmdbuf, commandBuffer);
 
+   sbdrm_vk_why = 7;
    panvk_per_arch(cmd_close_batch)(cmdbuf);
 
    panvk_pool_flush_maps(&cmdbuf->desc_pool);
@@ -419,6 +435,7 @@
     * barrier flag set to true.
     */
    if (cmdbuf->cur_batch) {
+      sbdrm_vk_why = 2;
       panvk_per_arch(cmd_close_batch)(cmdbuf);
       panvk_per_arch(cmd_open_batch)(cmdbuf);
    }

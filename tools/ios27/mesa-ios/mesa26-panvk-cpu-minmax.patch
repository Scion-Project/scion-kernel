+#ifdef __APPLE__
+/* Starbite (iOS): STARBITE_PANVK_CPU_MINMAX=1 (off by default; NOT run on a phone yet). On this JM GPU a direct indexed draw
+ * goes the indirect way: a write-value job, a compute job that searches its indices for their range, then a helper compute
+ * job (with job prefetch suppressed) that patches the draw's jobs, then the draw, each waiting for the one before. Here
+ * the CPU reads the indices instead, when the command is recorded, if the index buffer's memory is mapped (as Metal's
+ * shared buffers are): only the helper and the draw are left. The range is the search job's (restart indices skipped;
+ * none valid gives the same empty range). Not taken for a buffer that is not mapped, or a range past the bound size.
+ * The indices must be the ones the GPU will read: a buffer written by the GPU before the draw in the same submission
+ * (metal2vulkan's restarted-strip rewrite) would be read stale here; that buffer is device memory, never mapped. */
+extern unsigned long long sbdrm_vk_minmax_cpu, sbdrm_vk_minmax_gpu;
+
+static bool
+sb_cpu_minmax(struct panvk_cmd_buffer *cmdbuf, const struct panvk_draw_info *info, uint32_t first, uint32_t count,
+              uint32_t *min_out, uint32_t *max_out)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *e = getenv("STARBITE_PANVK_CPU_MINMAX");
+      on = e != NULL && e[0] == '1';
+   }
+   if (!on)
+      return false;
+   const struct panvk_buffer *buf = cmdbuf->state.gfx.ib.sb_buf;
+   const uint32_t size = info->index.index_size;
+   if (buf == NULL || buf->sb_mem == NULL || buf->sb_mem->addr.host == NULL || size == 0 ||
+       ((uint64_t)first + count) * size > info->index.buffer_size) {
+      sbdrm_vk_minmax_gpu++;
+      return false;
+   }
+   const uint8_t *base = (const uint8_t *)buf->sb_mem->addr.host + buf->sb_mem_offset + cmdbuf->state.gfx.ib.sb_offset;
+   const bool restart = info->index.restart_enable;
+   uint32_t lo = (uint32_t)(((uint64_t)1 << (size * 8)) - 1), hi = 0;
+   switch (size) {
+#define SB_MINMAX(type, max_value)                                             \
+   {                                                                           \
+      const type *idx = (const type *)base + first;                            \
+      for (uint32_t i = 0; i < count; i++) {                                   \
+         uint32_t v = idx[i];                                                  \
+         if (restart && v == (max_value))                                      \
+            continue;                                                          \
+         lo = MIN2(lo, v);                                                     \
+         hi = MAX2(hi, v);                                                     \
+      }                                                                        \
+      break;                                                                   \
+   }
+   case 4: SB_MINMAX(uint32_t, UINT32_MAX)
+   case 2: SB_MINMAX(uint16_t, UINT16_MAX)
+   case 1: SB_MINMAX(uint8_t, UINT8_MAX)
+#undef SB_MINMAX
+   default:
+      sbdrm_vk_minmax_gpu++;
+      return false;
+   }
+   *min_out = lo;
+   *max_out = hi;
+   sbdrm_vk_minmax_cpu++;
+   return true;
+}
+#endif
+

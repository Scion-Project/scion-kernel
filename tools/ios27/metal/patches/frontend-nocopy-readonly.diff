+// iOS 27: whether this process may never write any of the length bytes at pointer: every page is mapped, readable, and its
+// mapping's maximum protection has no write (CoreAnimation's images that another process shares read-only, VM tag 51).
+static bool neverWritable(const void *pointer,size_t length) {
+ vm_address_t at=(vm_address_t)(uintptr_t)pointer;const vm_address_t end=at+length;
+ if(end<at)return false;
+ while(at<end) {
+  vm_address_t region=at;vm_size_t size=0;mach_port_t object=MACH_PORT_NULL;
+  vm_region_basic_info_data_64_t basic={};mach_msg_type_number_t count=VM_REGION_BASIC_INFO_COUNT_64;
+  if(vm_region_64(mach_task_self(),&region,&size,VM_REGION_BASIC_INFO_64,(vm_region_info_t)&basic,&count,&object)!=KERN_SUCCESS)return false;
+  if(object!=MACH_PORT_NULL)mach_port_deallocate(mach_task_self(),object);
+  if(region>at || !size)return false;
+  if(!(basic.protection&VM_PROT_READ) || (basic.max_protection&VM_PROT_WRITE))return false;
+  at=region+size;
+ }
+ return true;
+}

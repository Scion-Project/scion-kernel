+   vm_region_extended_info_data_t extended={};mach_msg_type_number_t ecount=VM_REGION_EXTENDED_INFO_COUNT;
+   vm_address_t eat=at;vm_size_t esize=0;mach_port_t eobject=MACH_PORT_NULL;
+   const bool found=vm_region_64(mach_task_self(),&at,&size,VM_REGION_BASIC_INFO_64,(vm_region_info_t)&basic,&count,&object)==KERN_SUCCESS;
+   if(object!=MACH_PORT_NULL)mach_port_deallocate(mach_task_self(),object);
+   const bool efound=vm_region_64(mach_task_self(),&eat,&esize,VM_REGION_EXTENDED_INFO,(vm_region_info_t)&extended,&ecount,&eobject)==KERN_SUCCESS;
+   if(eobject!=MACH_PORT_NULL)mach_port_deallocate(mach_task_self(),eobject);

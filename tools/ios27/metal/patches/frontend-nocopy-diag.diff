+   snprintf(line,sizeof line,"native-metal: no-copy memory %#lx+%#lx: region %#lx+%#lx prot %d/%d shared %d share mode %d tag %u%s",
+    (unsigned long)(uintptr_t)pointer,(unsigned long)length,(unsigned long)at,(unsigned long)size,found?basic.protection:-1,found?basic.max_protection:-1,
+    found?(int)basic.shared:-1,efound?(int)extended.share_mode:-1,efound?extended.user_tag:0u,
+    (found && (uintptr_t)pointer>=at && (uintptr_t)pointer+length<=at+size)?"":" (spans regions)");
+   sm2_logs(line);
+  }

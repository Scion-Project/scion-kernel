+// A render pipeline of `d`, its colors in `keep` (bit i, color i) as the descriptor asks and the others through dexr().
+// A pipeline that dexr() changed keeps a copy of the descriptor for sweetExactPipeline.
+static NBRenderPipeline *sweetRenderPipeline(MTLRenderPipelineDescriptor *d,MTLPipelineOption options,unsigned keep,NSError **error) {
+ auto *b=new BuiltRenderDescriptor();unsigned held=0;
+ if(!renderDescriptor(d,b,error,keep,&held)){delete b;return nil;}
+ std::vector<NmbBinaryArchive *> archives;
+ if(!pipelineArchives(d.binaryArchives,archives,error)){delete b;return nil;}
+ const NmbPipelineOptions creation={(uint64_t)options,archives.data(),archives.size()};
+ const uint64_t pipelineBegan=nowUs();
+ const bool logJournal=!gJournalPath.empty();
+ const NBCost costBegan=logJournal?NBCost::now():NBCost{};
+ NmbRenderPipeline *handle=nmb_render_pipeline_new_with_options(gDevice,&b->raw,&creation);delete b;gTimePipeline.add(pipelineBegan);
+ if(logJournal)journalRenderPipeline(d,pipelineBegan,handle?nullptr:nmb_last_error(),NBCost::now().since(costBegan));
+ if(!handle)return failWith<NBRenderPipeline *>(error,@"render pipeline",nil);
+ NBRenderPipeline *state=[NBRenderPipeline new];state.handle=handle;gPipelines++;if(error)*error=nil;
+ if(held){state.dexrColors=held;state.dexrDescriptor=[d copy];state.dexrOptions=options;}
+ return state;
+}
+// `pipeline` made again with its colors in `keep` as its descriptor asked (once for each `keep`; nil, with a line, where
+// the runtime refuses it). Made at the first draw that needs it, as a pipeline the cache knows is cheap and one it does
+// not costs one compile.
+static NBRenderPipeline *sweetExactPipeline(NBRenderPipeline *pipeline,unsigned keep) {
+ @synchronized(pipeline) {
+  if(!pipeline.exact)pipeline.exact=[NSMutableDictionary dictionary];
+  if(NBRenderPipeline *made=pipeline.exact[@(keep)])return made;
+  NSError *error=nil;
+  NBRenderPipeline *made=sweetRenderPipeline(pipeline.dexrDescriptor,pipeline.dexrOptions,keep,&error);
+  static std::atomic<unsigned> lines{0};
+  if(!made)NBLOG(@"native-metal: render pipeline with colors %#x in their extended-range format refused: %@",keep,error);
+  else if(lines.fetch_add(1)<8)
+   sm2_logs([NSString stringWithFormat:@"native-metal: render pipeline made again with colors %#x in their extended-range format (a pass over a surface)",keep].UTF8String);
+  if(made)pipeline.exact[@(keep)]=made;
+  return made;
+ }
+}

# launchd.plist job keys the default build (DAEMON_SET=bp) removes: exactly the hardware-less set of daemons-hw.list, by job key.
# Until 18 Nov 2026 this list carried 119 keys (crash loops, the 84 speed trims of speed/trim-s1.list, CPU hogs); all of those are back on:
# a misbehaving daemon gets a fix or a task, not a trim. One key per line (key = the job plist path; labels are not unique).
/System/Library/LaunchDaemons/com.apple.CommCenter-noncellular.plist          # Apple baseband
/System/Library/LaunchDaemons/com.apple.CommCenter.plist                      # Apple baseband
/System/Library/LaunchDaemons/com.apple.CommCenterMobileHelper.plist          # Apple baseband
/System/Library/LaunchDaemons/com.apple.CommCenterRootHelper.plist            # Apple baseband
/System/Library/LaunchDaemons/com.apple.fairplayd.H2.plist                    # SEP FairPlay
/System/Library/LaunchDaemons/com.apple.fairplaydeviceidentityd.plist         # SEP FairPlay device identity
/System/Library/LaunchDaemons/com.apple.security.cryptexd.plist               # SEP-personalised cryptexes
/System/Library/LaunchDaemons/com.apple.securityresearchdeviceinit.plist      # Apple SoC research fusing
/System/Library/LaunchDaemons/com.apple.aned.plist                            # no Apple Neural Engine
/System/Library/LaunchDaemons/com.apple.nearbyd.plist                         # no UWB chip
/System/Library/LaunchDaemons/com.apple.appledepthd.plist                     # no depth camera
/System/Library/LaunchDaemons/com.apple.watchdogd.plist                       # no Apple hardware watchdog
/System/Library/LaunchDaemons/com.apple.wifip2pd.plist                        # no AWDL
/System/Library/LaunchDaemons/com.apple.replicatord.plist                     # AWDL replication
/System/Library/LaunchDaemons/com.apple.bluetoothd.plist                      # replaced by hakios-inject's bluetoothd (92-audio-bt)
